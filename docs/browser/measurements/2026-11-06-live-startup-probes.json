  "probe_source": "import subprocess,json,time,os,hashlib,socket,struct,datetime\nfrom pathlib import Path\nr=Path('/var/tmp/olo-browser-live-pages');screen='browser-live-pages';assert os.environ.get('OLO_SCREEN')==screen\nrun=lambda *a:subprocess.check_output(['olo-screen',*map(str,a)],text=True)\ndef tree():return next(w for w in json.loads(run('tree',screen,'--json'))if w['app_id']=='olo.browser')\nwindows=json.loads(run('windows',screen));w=next(w for w in windows if w['app_id']=='olo.browser');pid=int((r/'browser.pid').read_text());assert w['pid']==pid\nh=lambda p:hashlib.file_digest(Path(p).open('rb'),'sha256').hexdigest()\nwith socket.socket(socket.AF_UNIX)as s:\n s.connect(os.environ['OLO_SOCKET']);server=struct.unpack('3i',s.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))[0]\nreport=dict(scope='Live public-page diagnostics. Not full journeys, pixel comparison, deterministic replay or website acceptance.',captured_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),browser_pid=pid,browser_sha256=h(f'/proc/{pid}/exe'),server_pid=server,server_sha256=h(f'/proc/{server}/exe'),source_revision=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),website_passes=0,cases=[])\nfor name,url in [('hacker-news','https://news.ycombinator.com/'),('wikipedia','https://en.wikipedia.org/wiki/Web_browser'),('github-rust','https://github.com/rust-lang/rust')]:\n start=time.monotonic();run('set',screen,'--name','Address',url);run('click',screen,'--role','Button','--name','Go');seen=False;last=None\n while True:\n  current=tree();last=current['nodes'][-1].get('name','')\n  if last.startswith(('Loading','Parsing','Styling','Building','Preparing','Laying','Painting','Reading','Fetching')):seen=True\n  elif seen or time.monotonic()-start>.5:break\n  if time.monotonic()-start>45:\n   run('invoke',screen,'stop');current=tree();last='Timed out at45s; stopped';break\n  time.sleep(.1)\n row=dict(id=name,url=url,elapsed_seconds=time.monotonic()-start,status=last,tree=current,result='unaccepted diagnostic')\n report['cases'].append(row);(r/'report.json').write_text(json.dumps(report,indent=2)+'\\n');print(name,round(row['elapsed_seconds'],2),last,flush=True)\n"
}
