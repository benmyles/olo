  "visual": {
    "scope": "Original visible horizontal query-container component; native15 mode/scale reviews, not Chrome pixels or website acceptance.",
    "source": "<!doctype html><title>Container lengths</title><style>\nbody{margin:20px}h1{font-size:24px}p{margin:4px 0;font-size:14px}\n.box{display:block;container-type:inline-size;width:600px;max-width:100%;padding:10px;border-width:1px;border-style:solid;border-color:GrayText}\n.inner{width:50cqi;margin-top:12px}.bar{height:12px;background-color:Highlight;margin-top:4px;margin-bottom:8px}.half{width:50cqi}.quarter{width:25cqi}\n</style><h1>Query-container lengths</h1><div class=box><p>Outer content: 600 CSS pixels</p><p>50cqi</p><div class=\"bar half\"></div><p>25cqi</p><div class=\"bar quarter\"></div><div class=\"box inner\"><p>Nested content: 50cqi of its ancestor</p><p>Half of the nested container</p><div class=\"bar half\"></div></div></div>",
    "driver": "import copy,hashlib,json,os,socket,subprocess\nfrom pathlib import Path\nr=Path('/var/tmp/olo-browser-stripe/containers');screen='browser-stripe-native';assert os.environ['OLO_SCREEN']==screen\nout=r/'visual';out.mkdir(exist_ok=True)\ndef run(*a):return subprocess.check_output(['olo-screen',*map(str,a)],text=True)\ndef ipc(body):\n if body['type']!='get_settings':run('wait',screen,'--free')\n with socket.socket(socket.AF_UNIX)as s:\n  s.connect(os.environ['OLO_SOCKET']);s.sendall((json.dumps(body)+'\\n').encode());return json.loads(s.makefile().readline())\ndef tree():return next(w for w in json.loads(run('tree',screen,'--json'))if w['app_id']=='olo.browser')\nw=next(w for w in json.loads(run('windows',screen))if w['app_id']=='olo.browser');pid=w['pid'];assert os.readlink(f'/proc/{pid}/exe')==str(r/'browser-final')\nrun('set',screen,'--name','Address',r/'visual.html');run('click',screen,'--role','Button','--name','Go');run('wait',screen,'--text','Half of the nested container','--timeout',10000)\noriginal=ipc({'type':'get_settings'})['settings'];rows=[]\ntry:\n for theme in ['light','dark','night']:\n  for scale in [1,1.25,1.5,1.75,2]:\n   settings=copy.deepcopy(original);settings['appearance']['theme']='dark'if theme=='night'else theme;settings['appearance']['night_light']['mode']='on'if theme=='night'else'off';settings['appearance']['night_light']['temperature']=4500;settings['display']['scale']=scale\n   for o in settings['display'].get('outputs',{}).values():o.pop('scale',None)\n   assert ipc({'type':'set_settings','settings':settings})['type']=='ok';run('wait',screen,'--text','Half of the nested container','--timeout',10000);run('wait',screen,'--idle');w=tree();review=json.loads(run('review',screen,'--window',w['window'],'--json'));assert all(not x['findings']for x in review),review;run('look',screen,out/f'{theme}-{scale}.png','--window',w['window'],'--no-pointer');rows.append(dict(theme=theme,scale=scale,review=review,tree=w))\n (out/'report.json').write_text(json.dumps(dict(scope='Original visible horizontal query-container component; native15 mode/scale reviews, not Chrome pixels or website acceptance.',source_sha256=hashlib.sha256((r/'visual.html').read_bytes()).hexdigest(),pid=pid,rows=rows),indent=2)+'\\n');print('Visual reviews',len(rows))\nfinally:ipc({'type':'set_settings','settings':original})\n",
