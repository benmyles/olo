  "binary_sha256": "6f4d4b01194c8dd3f5ede2c9700e5f6c5fbb10b2ca35e587eb80b3160bd23bfb",
  "script": "#!/usr/bin/python3\n\"\"\"Initial integrated flex worker layout cost versus retained-intrinsic control.\nSeven frozen default-feature release processes, one allowed performance CPU.\nCompare identical production layout geometry/source at the same width. This is\nnot a before-engine speedup: the parent rejects flex pages. Excludes parsing,\nstyle/preparation, paint/raster, network, JS, UI/GPU/presentation. Occupied entry\npayload excludes hash capacity/controls/headers/allocator overhead; RSS is separate.\n\"\"\"\nimport hashlib,json,os,select,statistics,subprocess,time\nfrom pathlib import Path\nroot=Path('/var/tmp/olo-browser-stripe/flex-format');binary=root/'flex-flow-after'\nallowed=sorted(os.sched_getaffinity(0))\ndef freq(cpu):\n p=Path(f'/sys/devices/system/cpu/cpu{cpu}/cpufreq/cpuinfo_max_freq');return int(p.read_text())if p.exists()else 0\ncpu=max(allowed,key=freq);os.sched_setaffinity(0,{cpu})\ndef context():\n procs={}\n for p in Path('/proc').iterdir():\n  if p.name.isdigit():\n   try:\n    name=(p/'comm').read_text().strip()\n    if name in ('cargo','rustc'):procs[p.name]=name\n   except OSError:pass\n return dict(at_ns=time.time_ns(),loadavg=os.getloadavg(),build_processes=procs)\nrows,discarded,waits=[],[],[]\nfor repeat in range(7):\n while True:\n  before=context();compilers=[p for p,n in before['build_processes'].items()if n=='rustc']\n  if compilers:\n   waits.append(before);fds=[]\n   try:\n    for pid in compilers:\n     try:fds.append(os.pidfd_open(int(pid)))\n     except ProcessLookupError:pass\n    if fds:select.select(fds,[],[],20)\n   finally:\n    for fd in fds:os.close(fd)\n   continue\n  rss=root/'flex-flow.rss'\n  data=json.loads(subprocess.check_output(['/usr/bin/time','-f','%M','-o',str(rss),str(binary),'50'],text=True))\n  assert data['features']==[]\n  observation=dict(repeat=repeat,before_context=before,after_context=context(),rss_kib=int(rss.read_text()),**data)\n  if 'rustc'in observation['after_context']['build_processes'].values():discarded.append(observation);continue\n  for count,words in [(4,2),(128,2),(1024,2),(4,500)]:\n   group=[r for r in data['rows']if(r['items'],r['word_pairs_per_item'])==(count,words)];assert len(group)==2\n   for k in ['geometry_sha256','source_sha256','geometry_payload_bytes','intrinsic_entry_payload_bytes']:assert group[0][k]==group[1][k],k\n  rows.append(observation);print(repeat,flush=True);break\nsummary=[]\nfor c in rows[0]['rows']:\n group=[x for r in rows for x in r['rows']if(x['items'],x['word_pairs_per_item'],x['mode'])==(c['items'],c['word_pairs_per_item'],c['mode'])]\n summary.append(dict(items=c['items'],word_pairs_per_item=c['word_pairs_per_item'],mode=c['mode'],**{k:statistics.median(x[k]for x in group)for k in ['layout_us','ctor_us','maximum_single_step_us','work','geometry_payload_bytes','intrinsic_entry_payload_bytes']},worst_single_step_us=max(x['maximum_single_step_us']for x in group)))\nPath('docs/browser/measurements/2026-11-06-stripe-flex-format-worker-cost.json').write_text(json.dumps(dict(scope=__doc__,cpu=cpu,allowed_cpus=allowed,binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),script=Path(__file__).read_text(),observations=rows,discarded=discarded,build_waits=waits,summary=summary),indent=2)+'\\n')\nprint(json.dumps(summary),flush=True)\n",
