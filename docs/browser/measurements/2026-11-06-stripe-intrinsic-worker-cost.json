  "script": "#!/usr/bin/python3\n\"\"\"Release worker cost: same-binary materialized-line control vs intrinsic widths.\nOrdinary Latin design-unit measures only, excluding preparation and UI/GPU.\nBoth variants warm and validate both paths, so process peak RSS is not an\nisolated allocation comparison. Numeric/line payloads exclude capacities,\nshared text/fonts, allocator overhead and control shaping caches.\n\"\"\"\nimport hashlib,json,os,select,statistics,subprocess\nfrom pathlib import Path\nroot=Path('/var/tmp/olo-browser-stripe/flex/cost')\nbinary=root/'inline-after'\nallowed=sorted(os.sched_getaffinity(0))\ndef frequency(cpu):\n p=Path(f'/sys/devices/system/cpu/cpu{cpu}/cpufreq/cpuinfo_max_freq')\n return int(p.read_text())if p.exists()else 0\ncpu=max(allowed,key=frequency);os.sched_setaffinity(0,{cpu})\ndef context():\n procs={}\n for p in Path('/proc').iterdir():\n  if p.name.isdigit():\n   try:\n    name=(p/'comm').read_text().strip()\n    if name in ('cargo','rustc'):procs[p.name]=name\n   except OSError:pass\n return dict(loadavg=os.getloadavg(),build_processes=procs)\nrows,discarded,waits=[],[],[]\nfor repeat in range(7):\n for mode in (['materialized','intrinsic']if repeat%2==0 else ['intrinsic','materialized']):\n  while True:\n   before=context();compilers=[p for p,n in before['build_processes'].items()if n=='rustc']\n   if compilers:\n    waits.append(before);fds=[]\n    try:\n     for pid in compilers:\n      try:fds.append(os.pidfd_open(int(pid)))\n      except ProcessLookupError:pass\n     if fds:select.select(fds,[],[],20)\n    finally:\n     for fd in fds:os.close(fd)\n    continue\n   rss=root/'intrinsic.rss'\n   data=json.loads(subprocess.check_output(['/usr/bin/time','-f','%M','-o',str(rss),str(binary),'100',mode],text=True))\n   observation=dict(mode=mode,repeat=repeat,before_context=before,after_context=context(),rss_kib=int(rss.read_text()),**data)\n   if 'rustc'in observation['after_context']['build_processes'].values():discarded.append(observation);continue\n   rows.append(observation);print(repeat,mode,flush=True);break\nsummary={}\nfor words in [500,2500]:\n summary[str(words)]={mode:{k:statistics.median(c[k]for r in rows if r['mode']==mode for c in r['rows']if c['words']==words)for k in ['measure_drop_us','max_ctor_us','max_step_us','numeric_or_line_payload_bytes']}for mode in ['materialized','intrinsic']}\nsource=Path(__file__).read_text()\nPath('docs/browser/measurements/2026-11-06-stripe-intrinsic-worker-cost.json').write_text(json.dumps(dict(scope=__doc__,cpu=cpu,allowed_cpus=allowed,binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),script=source,observations=rows,discarded=discarded,build_waits=waits,summary=summary),indent=2)+'\\n')\nprint(json.dumps(summary),flush=True)\n",
