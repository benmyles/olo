#!/usr/bin/env python3
"""Adversarial window-management fuzzer: drive app_server with random
combinations of every arranging command, shortcut, switcher, workspace
and display change, on real apps, and check after each step that the
desktop is still sane.

  wm-fuzz NAME [--seed N] [--steps N] [--only OPS] [--keep-going] [--quiet] [--tiles]

NAME is a tsession with two or more screens and the shell, e.g.

  tsession start fz 2560x1600,1920x1080 --session --shell
  tools/dev/wm-fuzz fz --steps 400

It opens and closes windows of olo-terminal, olo-styled-edit and
olo-tracker itself. A run is reproducible from its seed (printed first)
as long as the session starts the same way. On a failure it prints the
seed, the step, the last commands and what was wrong, and stops (with
--keep-going it carries on and lists every failure at the end). --only
app_resize,tab_in runs just those steps (the `op_` methods), to go after
one thing.

What is checked, after every step once the windows have settled:

  * app_server answers a ping within a second;
  * every shown window is on a display, with its tab reachable, and none
    is empty;
  * if any window is shown, exactly one has the keyboard, and it is a
    shown one; a hidden or away window never does;
  * commands that shouldn't move other windows don't: activating one,
    Cmd+Tab and Cmd+` however far you cycle, sending to back, hiding or
    showing one, opening a new window (it may join its app's group, but
    nothing else changes, not even the group's size, also when it opens
    with a button held down), going to another workspace and back;
  * round trips come back exactly: zoom and unzoom (also along one
    axis), a tile then Restore, an arrangement then Undo Window
    Arrangement, a window to another workspace and back, a window to the
    next display and back;
  * tiles and zooms stay inside the display's tiling area (`arrangement`),
    and a zoomed window stays there whatever it or its app does after;
  * an app resizing its own window (a new Terminal tab bringing its tab
    strip, closing it again, a bigger or smaller text size) never takes
    it past its display, and doesn't change the size of one zoomed,
    zoomed one way or tiled (Olo holds it to that); a new or closed tab
    doesn't change a window's size at all, flickering included;
  * groups hold together: each has two or more windows, all shown here,
    sharing one frame, their tabs numbered 0..n-1 and laid side by side
    along its top in that order; windows of different apps share one only
    if one was put in by hand; a window taken out by hand stays out until
    put in one again;
  * ⌘-dragging a tab along its group puts it in the place it was let go
    at, and moves nothing; pulled away, the window comes out on its own
    under the pointer and the rest stay put; held over another group's
    (or window's) tabs, it shows as a tab in the place it would take, and
    let go, it is in that group there, exactly as it showed;
  * GroupWindow, UngroupWindow and MoveTab do the same for agents;
  * app_server never panics (its log, which outlives a restart, is
    watched).
"""
import json, os, random, socket, subprocess, sys, time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
TSESSION = os.path.join(ROOT, "tools", "dev", "tsession")
APPS = ["olo-terminal", "olo-styled-edit", "olo-tracker"]
# How to ask each for a window: StyledEdit and Tracker bring theirs forward
# when launched bare (a folder already open, too), as BeOS apps do.
LAUNCH = {"olo-terminal": [[]], "olo-styled-edit": [["--new-window"], []],
          "olo-tracker": [["/"], ["/usr"], ["/etc"], ["/tmp"], ["/usr/share"], ["/var"], []]}

TILES = ["tile-left", "tile-right", "tile-top", "tile-bottom", "tile-top-left", "tile-top-right",
         "tile-bottom-left", "tile-bottom-right", "tile-left-third", "tile-center-third",
         "tile-right-third", "tile-left-two-thirds", "tile-right-two-thirds"]
WINDOW_CMDS = TILES + ["zoom", "zoom-vertical", "zoom-horizontal", "restore", "center", "hide-window",
                       "roll-up", "next-tab", "previous-tab", "next-display", "previous-display"]
ARRANGE_CMDS = ["tile-all", "zoom-all", "cascade-all", "fan-out", "cascade-others", "fan-out-others",
                "undo-arrangement", "show-desktop"]
WORKSPACE_CMDS = ["next-workspace", "previous-workspace", "window-to-next-workspace",
                  "window-to-previous-workspace", "workspace-1", "workspace-2", "workspace-3",
                  "window-to-workspace-1", "window-to-workspace-2", "window-to-workspace-3"]

# Key chords for some of them, pressed as a person would (they act on the
# window with the keyboard, so focus bugs show).
CTRL, SHIFT, ALT, CMD = 29, 42, 56, 125
BTN_LEFT = 0x110
# The window decoration's measures (olo_theme::deco) and ⌘-dragging's
# (app_server's shell/tabdrag.rs).
TAB_H, BOX_INSET, BOX_SIZE = 21, 5, 13
TEAR, TEAR_SIDE, NEAR = 24, 48, 12
# A tab at least this wide has its middle clear of its boxes (and of the
# hit area around them): there it can be taken hold of without closing or
# zooming the window.
TAB_GRIP = 2 * (BOX_INSET + BOX_SIZE + 2) + 8
# A Mac's keys (the default keyboard profile, olo_protocol::shortcuts).
KEYS = {
    "tile-left": [CTRL, ALT, 105], "tile-right": [CTRL, ALT, 106], "tile-top": [CTRL, ALT, 103],
    "tile-bottom": [CTRL, ALT, 108], "tile-top-left": [CTRL, ALT, 22], "tile-bottom-right": [CTRL, ALT, 37],
    "tile-left-third": [CTRL, ALT, 32], "tile-center-third": [CTRL, ALT, 33], "zoom": [CTRL, ALT, 28],
    "zoom-vertical": [CTRL, ALT, SHIFT, 103], "zoom-horizontal": [CTRL, ALT, SHIFT, 105],
    "restore": [CTRL, ALT, 14], "center": [CTRL, ALT, 46], "hide-window": [CMD, 50],
    "roll-up": [CTRL, CMD, 50], "next-tab": [CTRL, 15], "tile-all": [CTRL, CMD, 28],
    "zoom-all": [CTRL, ALT, CMD, 28], "cascade-all": [CTRL, CMD, 43], "fan-out": [CTRL, CMD, 53],
    "undo-arrangement": [CTRL, CMD, 44], "next-workspace": [CTRL, 106],
    "previous-workspace": [CTRL, 105], "window-to-next-workspace": [CTRL, SHIFT, 106],
}


class Failure(Exception):
    pass


class Fuzz:
    def __init__(self, name, seed, quiet):
        self.name = name
        env = json.load(open(os.path.join("/tmp/olo-dev", name, "env.json")))
        self.sock = env["OLO_SOCKET"]
        self.rng = random.Random(seed)
        self.seed = seed
        self.quiet = quiet
        self.history = []
        self.failures = []
        self.step = 0
        outs = self.req({"type": "outputs"})["outputs"]
        self.outputs = [o["name"] for o in outs]
        self.home = {o["name"]: (o["position"], o["scale"]) for o in outs}
        # Windows put in a group by hand (or joined by one), which may
        # share it with other apps', and ones taken out by hand since. (Any
        # window there already may have been, in a run before.)
        self.by_hand, self.alone = set(self.windows()), set()
        # Steps Terminal's text size has been made bigger (less smaller).
        self.text_steps = 0
        self.only = set()
        # Tiled windows seen out of their tiles (each said once), and
        # whether that fails the run (--tiles).
        self.tile_seen, self.tiles_fail = set(), False
        # Each window's part, frame and workspace as last seen (--trace-tiles).
        self.trace_tiles, self.tile_trace = False, {}
        self.last_press = 0.0
        self.server_log = os.path.join("/tmp/olo-dev", name, "app_server.log")
        try:
            self.log_at = os.path.getsize(self.server_log)
        except OSError:
            self.log_at = None

    # ---- talking to app_server ----

    def req(self, r, timeout=5.0):
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(timeout)
        try:
            s.connect(self.sock)
            s.sendall((json.dumps(r) + "\n").encode())
            line = s.makefile().readline()
        except (TimeoutError, socket.timeout, ConnectionError) as e:
            raise Failure(f"app_server didn't answer {r.get('type')}: {e}")
        finally:
            s.close()
        if not line:
            raise Failure(f"app_server closed the connection on {r.get('type')}")
        reply = json.loads(line)
        if reply.get("type") == "error" and not getattr(self, "errors_ok", False):
            raise Failure(f"{r} -> error {reply.get('message')}")
        return reply

    def try_req(self, r):
        """`r`'s reply, an error one too."""
        self.errors_ok = True
        try:
            return self.req(r)
        finally:
            self.errors_ok = False

    def windows(self):
        return {w["id"]: w for w in self.req({"type": "list_windows"})["windows"]}

    def workspace(self):
        """The active display's workspace showing."""
        return self.req({"type": "workspaces"}).get("current", 0)

    def showing(self):
        """Each display's workspace showing (every display has its own):
        the active one's, and by connector."""
        r = self.req({"type": "workspaces"})
        return r.get("current", 0), {d["output"]: d["current"] for d in r.get("displays", [])}

    @staticmethod
    def here(w, cur):
        """`w` is on the workspace its display shows (hidden there or not)."""
        current, by = cur
        return w["workspace"] == by.get(w.get("output"), current)

    def settle(self, timeout=5.0):
        """The windows once they stop changing: none settling (its
        program still to draw what it was asked, `WindowInfo::settling`)
        and nothing changing for a quarter of a second. Every state seen
        on the way, a few milliseconds apart, is kept in `trail` (and
        when, in `trail_at`), so a window that jumps and comes back (a
        flicker) is caught too."""
        t0 = time.time()
        self.trail, self.trail_at = [], []
        last, since = None, time.time()
        while True:
            now = self.windows()
            key = {i: (fr(w), w["minimized"], w["workspace"], w["focused"], w.get("settling", False)) for i, w in now.items()}
            if key != last:
                self.trail.append(now)
                self.trail_at.append(time.time() - t0)
                if hasattr(self, "step_trail"):
                    self.step_trail.append((time.time() - self.step_t0, now))
                last, since = key, time.time()
            elif time.time() - since > 0.25 and not any(w.get("settling") for w in now.values()):
                return now
            elif time.time() - t0 > timeout:
                self.history.append(f"{self.step}: (still settling after {timeout} s: {sorted(i for i, w in now.items() if w.get('settling'))})")
                return now
            time.sleep(0.004)

    def trail_report(self):
        """The step's states so far, each window as it changed: for a
        failure's report."""
        lines, seen = [], {}
        for at, state in getattr(self, "step_trail", []):
            changed = []
            for i, w in sorted(state.items()):
                k = (fr(w), w.get("settling", False), w.get("zoomed"), w.get("tiled"), w.get("group"), w["workspace"], w.get("output"))
                if seen.get(i) != k:
                    seen[i] = k
                    changed.append(f"{i} {fr(w)}{' settling' if k[1] else ''}{' zoomed' if k[2] else ''}{' tiled' if k[3] else ''}"
                                   f"{f' g{k[4]}' if k[4] is not None else ''} ws{k[5]} {k[6]}")
            if changed:
                lines.append(f"{at * 1000:7.1f} ms: " + "; ".join(changed))
        return "\n        ".join(lines[-30:])

    def keys(self, codes):
        ev = [{"type": "key", "key": k, "pressed": True} for k in codes]
        ev += [{"type": "key", "key": k, "pressed": False} for k in reversed(codes)]
        self.req({"type": "synthetic", "events": ev})

    def shortcut(self, sid, window=None):
        r = {"type": "run_shortcut", "id": sid}
        if window is not None:
            r["window"] = window
        self.req(r)

    def spawn(self, app, args=()):
        subprocess.run([TSESSION, "run", self.name, app, *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    # ---- the desktop's shape ----

    def output_rects(self):
        rects = []
        for o in self.req({"type": "outputs"})["outputs"]:
            if o.get("mirror_of"):
                continue
            m, s = o["current_mode"], o["scale"] or 1.0
            w, h = (m["width"], m["height"]) if o.get("rotation", 0) in (0, 180) else (m["height"], m["width"])
            rects.append((o["position"][0], o["position"][1], round(w / s), round(h / s)))
        return rects

    def area(self):
        a = self.req({"type": "arrangement"})
        return a.get("output"), rect(a["area"]) if a.get("area") else None

    # ---- checks ----

    def fail(self, what):
        msg = f"step {self.step} (seed {self.seed}): {what}\n  last: " + "\n        ".join(self.history[-12:])
        msg += "\n  seen: " + self.trail_report()
        if self.keep_going:
            self.failures.append(msg)
            print("FAIL " + msg, flush=True)
        else:
            raise Failure(msg)

    def check_sane(self, wins):
        t = time.time()
        self.req({"type": "ping"}, timeout=1.0)
        if time.time() - t > 1.0:
            self.fail("ping took over a second")
        cur = self.showing()
        outs = self.output_rects()
        shown = [w for w in wins.values() if self.here(w, cur) and not w["minimized"]]
        for w in shown:
            if fr(w) is None:
                self.fail(f"shown window {w['id']} ({w['app_id']}) has no frame")
                continue
            x, y, cw, ch = fr(w)
            if cw <= 0 or ch <= 0:
                self.fail(f"window {w['id']} ({w['app_id']}) is empty: {fr(w)}")
            # Within reach: enough of its top edge on some display to take
            # hold of (it may hang off an edge, as a person can leave it).
            top = (x, y, cw, min(ch, 20))
            if not any(overlap(top, o) >= min(cw, 32) * min(ch, 20) and o[1] <= y for o in outs):
                self.fail(f"window {w['id']} ({w['app_id']}) is off the displays: {fr(w)}; displays {outs}")
        focused = [w for w in wins.values() if w["focused"]]
        # With several displays, none has it when the display in use shows
        # none (the keyboard doesn't go to another display's).
        if len(focused) > 1 or (shown and not focused and len(cur[1]) < 2):
            self.fail(f"{len(focused)} windows have the keyboard with {len(shown)} shown: {[w['id'] for w in focused]}")
        for w in focused:
            if w["minimized"] or not self.here(w, cur):
                self.fail(f"window {w['id']} has the keyboard but is {'hidden' if w['minimized'] else 'on workspace %d' % w['workspace']}")
        self.check_groups(wins, cur)
        self.check_zoomed(wins, cur)
        self.check_tiles(wins, cur)
        self.check_log()

    def check_tiles(self, wins, cur):
        """A tiled window on the active display is where its tile's part
        says (`part`), within a gap; else it jumps there when its tiles
        are next laid out (its workspace shown again). Reported, with
        --tiles failing on it."""
        if self.trace_tiles:
            for w in wins.values():
                now = (tuple(round(v, 3) for v in w["part"]) if w.get("part") else None, fr(w), w["workspace"], w.get("group"), w["minimized"])
                if self.tile_trace.get(w["id"]) != now:
                    print(f"  step {self.step}: window {w['id']} part {now[0]} frame {now[1]} ws {now[2]} group {now[3]} hidden {now[4]}", flush=True)
                    self.tile_trace[w["id"]] = now
        out, area = self.area()
        if not area:
            return
        ax, ay, aw, ah = area
        for w in wins.values():
            if not w.get("part") or w.get("output") != out or not self.here(w, cur) or w["minimized"] or w.get("zoomed") or fr(w) is None:
                continue
            x, y, cw, ch = fr(w)
            px, py, pw, ph = w["part"]
            want = (round(ax + px * aw), round(ay + py * ah), round(pw * aw), round(ph * ah))
            if max(abs(x - want[0]), abs(y - want[1]), abs(x + cw - want[0] - want[2]), abs(y + ch - want[1] - want[3])) > 12:
                key = (w["id"], tuple(w["part"]), fr(w))
                if key not in self.tile_seen:
                    self.tile_seen.add(key)
                    msg = f"window {w['id']} ({w['app_id']}) at {fr(w)} isn't its tile's part {tuple(round(v, 3) for v in w['part'])} = {want}"
                    if self.tiles_fail:
                        self.fail(msg)
                    else:
                        print(f"  step {self.step}: {msg}", flush=True)

    def check_zoomed(self, wins, cur):
        """A zoomed window on the active display fills (at most) its tiling
        area, whatever happened since it was zoomed."""
        zoomed = [w for w in wins.values() if w.get("zoomed") and self.here(w, cur) and not w["minimized"] and fr(w)]
        if not zoomed:
            return
        out, area = self.area()
        for w in zoomed:
            if area and overlap(fr(w), area) and not contains(area, fr(w)):
                self.fail(f"zoomed window {w['id']} ({w['app_id']}) {fr(w)} sticks out of the tiling area {area} on {out}")

    def check_log(self):
        """No panic in app_server's log since the last look (olo-session
        would start it again, and the windows come back, hiding it)."""
        if self.log_at is None:
            return
        try:
            with open(self.server_log, "rb") as f:
                f.seek(self.log_at)
                new = f.read().decode(errors="replace")
        except OSError:
            return
        self.log_at += len(new.encode())
        for line in new.splitlines():
            if "panicked" in line:
                self.fail(f"app_server panicked: {line.strip()}")

    def check_groups(self, wins, cur):
        groups = {}
        for i, w in wins.items():
            g = w.get("group")
            if g is None:
                if w.get("tab") is not None:
                    self.fail(f"window {i} has tab place {w['tab']} but no group")
                continue
            if w["minimized"] or not self.here(w, cur):
                self.fail(f"window {i} is {'hidden' if w['minimized'] else 'away'} but in group {g}")
            groups.setdefault(g, []).append(i)
        for g, m in groups.items():
            if len(m) < 2:
                self.fail(f"group {g} is just window {m[0]}")
                continue
            order = sorted(m, key=lambda i: wins[i].get("tab") or 0)
            if [wins[i].get("tab") for i in order] != list(range(len(m))):
                self.fail(f"group {g}'s tab places are {[(i, wins[i].get('tab')) for i in order]}")
            frames = {fr(wins[i]) for i in m}
            if len(frames) > 1:
                self.fail(f"group {g}'s windows don't share a frame: " + ", ".join(f"{i} {fr(wins[i])}" for i in order))
                continue
            x, y, fw, _ = frames.pop()
            end = x
            for i in order:
                t = wins[i].get("tab_frame")
                if not t or t["y"] != y or t["height"] != TAB_H or t["x"] < end or t["x"] + t["width"] > x + fw:
                    self.fail(f"group {g}'s tabs aren't side by side along its top {(x, y, fw)} in order: "
                              + ", ".join(f"{o} {tab_rect(wins[o])}" for o in order))
                    break
                end = t["x"] + t["width"]
            apps = {wins[i]["app_id"] for i in m}
            if len(apps) > 1 and not set(m) & self.by_hand:
                self.fail(f"group {g} mixes {sorted(apps)} though none of {order} was put in it by hand")
        for i in sorted(self.alone):
            if i in wins and wins[i].get("group") is not None:
                self.fail(f"window {i}, taken out of its group by hand, is in group {wins[i]['group']} again")

    def check_round_trip(self, what, before, after, moving):
        """Everything back as it was; only `moving` moved on the way."""
        moved = {i: (fr(before[i]), fr(after[i])) for i in before
                 if i in after and fr(before[i]) and fr(after[i]) and fr(before[i]) != fr(after[i])}
        if moved:
            self.fail(f"{what} didn't come back: " + ", ".join(f"{i} ({before[i]['app_id']}) {a} -> {b}" for i, (a, b) in moved.items()))
            return
        self.check_steady(what, before, moving)

    def check_unchanged(self, what, before, after, skip=()):
        moved = {i: (fr(before[i]), fr(after[i])) for i in before
                 if i in after and i not in skip and fr(before[i]) and fr(after[i]) and fr(before[i]) != fr(after[i])
                 and before[i]["workspace"] == after[i]["workspace"]}
        if moved:
            self.fail(f"{what} moved other windows: " + ", ".join(f"{i} ({before[i]['app_id']}) {a} -> {b}" for i, (a, b) in moved.items()))
            return
        self.check_steady(what, before, skip)

    def check_steady(self, what, before, skip=()):
        """No window outside `skip` changed on the way, even for a moment."""
        for state in getattr(self, "trail", []):
            flick = {i: (fr(before[i]), fr(w)) for i, w in state.items()
                     if i in before and i not in skip and fr(before[i]) and fr(w) and fr(before[i]) != fr(w)}
            if flick:
                self.fail(f"{what} flickered other windows: " + ", ".join(f"{i} ({before[i]['app_id']}) {a} -> {b} and back" for i, (a, b) in flick.items()))
                return

    def check_back(self, what, wid, before, after):
        if wid in before and wid in after and fr(before[wid]) and fr(before[wid]) != fr(after[wid]):
            self.fail(f"{what} didn't come back: window {wid} ({before[wid]['app_id']}) {fr(before[wid])} -> {fr(after[wid])}")

    def check_inside_area(self, what, wid, wins):
        out, area = self.area()
        w = wins.get(wid)
        if not w or not area or w["minimized"] or fr(w) is None:
            return
        x, y, cw, ch = fr(w)
        ax, ay, aw, ah = area
        # Only if it is on the active display (the one `arrangement` describes).
        if overlap(fr(w), area) == 0:
            return
        if x < ax or y < ay or x + cw > ax + aw or y + ch > ay + ah:
            # A window can't be smaller than its minimum: only fail when it
            # sticks out past the area's far edges by more than that slack.
            self.fail(f"{what}: window {wid} ({w['app_id']}) {fr(w)} sticks out of the tiling area {area} on {out}")

    # ---- what a step can do ----

    def mates(self, wins, w):
        """`w` and the windows in its group, which follow it."""
        if w not in wins:
            return {w}
        return set(self.group_of(wins, w))

    def group_of(self, wins, w):
        """The windows in `w`'s group in the order of their tabs (just `w`
        if it is in none)."""
        g = wins[w].get("group")
        if g is None:
            return [w]
        return sorted((i for i, o in wins.items() if o.get("group") == g), key=lambda i: wins[i].get("tab") or 0)

    def groups(self, wins):
        """The groups, each in tab order, by number."""
        out = {}
        for i in sorted(wins, key=lambda i: wins[i].get("tab") or 0):
            if wins[i].get("group") is not None:
                out.setdefault(wins[i]["group"], []).append(i)
        return out

    def shown(self, wins):
        cur = self.showing()
        return [i for i, w in wins.items() if self.here(w, cur) and not w["minimized"]]

    def pick(self, ids):
        return self.rng.choice(sorted(ids)) if ids else None

    def log(self, what):
        self.history.append(f"{self.step}: {what}")
        if not self.quiet:
            print(f"{self.step:4d} {what}", flush=True)

    def run_step(self):
        self.step += 1
        self.step_trail, self.step_t0 = [], time.time()
        wins = self.windows()
        shown = self.shown(wins)
        ops = [
            (12, self.op_shortcut), (6, self.op_keys), (5, self.op_arrange), (4, self.op_activate),
            (5, self.op_twitch), (2, self.op_twitch_windows), (3, self.op_send_to_back), (3, self.op_hide_show),
            (3, self.op_open), (1, self.op_close), (3, self.op_workspace_trip), (2, self.op_workspace_cmd),
            (4, self.op_zoom_trip), (5, self.op_tile_trip), (3, self.op_arrange_trip), (2, self.op_window_ws_trip),
            (2, self.op_display_trip), (1, self.op_displays), (2, self.op_place),
            (4, self.op_tab_along), (3, self.op_tab_out), (4, self.op_tab_in),
            (2, self.op_group_window), (2, self.op_ungroup_window), (2, self.op_move_tab),
            (4, self.op_app_resize),
        ]
        if self.only:
            ops = [(w, op) for w, op in ops if op.__name__[3:] in self.only]
        if len(wins) < 3:
            ops = [(1, self.op_open)]
        total = sum(w for w, _ in ops)
        n = self.rng.uniform(0, total)
        for weight, op in ops:
            n -= weight
            if n <= 0:
                break
        op(wins, shown)

    def op_shortcut(self, wins, shown):
        sid = self.rng.choice(WINDOW_CMDS)
        w = self.pick(shown) if self.rng.random() < 0.8 else None
        self.log(f"shortcut {sid} on {w}")
        self.shortcut(sid, w)
        after = self.settle()
        self.check_sane(after)
        if sid in TILES and w in after and not after[w]["minimized"]:
            self.check_inside_area(sid, w, after)

    def op_keys(self, wins, shown):
        sid = self.rng.choice(sorted(KEYS))
        self.log(f"keys {sid}")
        self.keys(KEYS[sid])
        self.check_sane(self.settle())

    def op_arrange(self, wins, shown):
        sid = self.rng.choice(ARRANGE_CMDS)
        w = self.pick(shown)
        self.log(f"arrange {sid} (with {w})")
        if w is not None:
            self.req({"type": "activate", "id": w})
        self.shortcut(sid, w)
        self.check_sane(self.settle())

    def op_activate(self, wins, shown):
        w = self.pick(wins)
        if w is None:
            return
        self.log(f"activate {w} ({wins[w]['app_id']}{', hidden' if wins[w]['minimized'] else ''}, ws {wins[w]['workspace']})")
        cur = self.showing()
        self.req({"type": "activate", "id": w})
        after = self.settle()
        self.check_sane(after)
        if self.here(wins[w], cur):
            self.check_unchanged(f"activating {w}", wins, after, skip={w})
        if not after[w]["focused"]:
            self.fail(f"activated window {w} doesn't have the keyboard")

    def twitch(self, key, n, back):
        mods = [CMD] + ([SHIFT] if back else [])
        ev = [{"type": "key", "key": k, "pressed": True} for k in mods]
        for _ in range(n):
            ev += [{"type": "key", "key": key, "pressed": True}, {"type": "key", "key": key, "pressed": False}]
            if self.rng.random() < 0.3:
                # Wander with the arrows too.
                arrow = self.rng.choice([103, 105, 106, 108])
                ev += [{"type": "key", "key": arrow, "pressed": True}, {"type": "key", "key": arrow, "pressed": False}]
        ev += [{"type": "key", "key": k, "pressed": False} for k in reversed(mods)]
        if self.rng.random() < 0.5:
            # One key at a time, with the loop turning between them, as typed.
            for e in ev:
                self.req({"type": "synthetic", "events": [e]})
                time.sleep(0.03)
        else:
            self.req({"type": "synthetic", "events": ev})

    def check_twitch(self, what, wins, after):
        self.check_sane(after)
        # The chosen window: the focused one now. Every other one is as it
        # was: where it was, hidden if it was, on its workspace.
        chosen = [i for i, w in after.items() if w["focused"]]
        for i, w in wins.items():
            if i in chosen or i not in after:
                continue
            a = after[i]
            if a["minimized"] != w["minimized"]:
                self.fail(f"{what}: window {i} ({w['app_id']}) was {'hidden' if w['minimized'] else 'shown'} and is now {'hidden' if a['minimized'] else 'shown'}")
            if a["workspace"] != w["workspace"]:
                self.fail(f"{what}: window {i} moved from workspace {w['workspace']} to {a['workspace']}")
        ws_before = {i: w["workspace"] for i, w in wins.items()}
        moved = {i: (fr(wins[i]), fr(after[i])) for i in wins
                 if i in after and i not in chosen and fr(wins[i]) and fr(after[i]) and fr(wins[i]) != fr(after[i])}
        if moved:
            self.fail(f"{what} (chose {chosen}) moved windows: " + ", ".join(f"{i} ({wins[i]['app_id']}, ws {ws_before[i]}) {a} -> {b}" for i, (a, b) in moved.items())
                      + "\n  before: " + state(wins) + "\n  after:  " + state(after))
        else:
            self.check_steady(what, wins, skip=set(chosen))

    def op_twitch(self, wins, shown):
        n, back = self.rng.randint(1, 5), self.rng.random() < 0.25
        self.log(f"cmd-tab x{n}{' back' if back else ''}")
        self.twitch(15, n, back)
        self.check_twitch(f"Cmd+Tab x{n}", wins, self.settle())

    def op_twitch_windows(self, wins, shown):
        n = self.rng.randint(1, 3)
        self.log(f"cmd-` x{n}")
        self.twitch(41, n, False)
        self.check_twitch(f"Cmd+` x{n}", wins, self.settle())

    def op_send_to_back(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        self.log(f"send {w} to back")
        self.req({"type": "send_to_back", "id": w})
        after = self.settle()
        self.check_sane(after)
        self.check_unchanged(f"sending {w} to back", wins, after)

    def op_hide_show(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        self.log(f"hide {w} ({wins[w]['app_id']}) and show it again")
        self.req({"type": "minimize", "id": w})
        mid = self.settle()
        self.check_sane(mid)
        self.check_unchanged(f"hiding {w}", wins, mid, skip=self.mates(wins, w))
        self.req({"type": "activate", "id": w})
        after = self.settle()
        self.check_sane(after)
        self.check_unchanged(f"hiding and showing {w}", wins, after, skip=self.mates(wins, w))
        # It comes back where it was, unless it was in a group (which
        # it goes back to, wherever that is now).
        if wins[w].get("group") is None:
            self.check_back(f"hiding and showing {w}", w, wins, after)

    def op_open(self, wins, shown):
        app = self.rng.choice(APPS)
        args = self.rng.choice(LAUNCH[app])
        # Now and then with a button held down in a Terminal (selecting):
        # the pointer is grabbed meanwhile, as it is after a menu until
        # it next moves, and the new window must still take its group's
        # size, not the group the new window's.
        terms = [w for w in wins.values() if w["focused"] and w["app_id"] == "olo.terminal" and w.get("content")]
        held = terms and self.rng.random() < 0.3
        if held:
            # Another Terminal, into a group sized by hand (not the size a
            # new window opens at).
            app, args = "olo-terminal", []
            x, y, w, h = fr(terms[0])
            w, h = (w - 37, h - 23) if w > 500 and h > 300 else (w + 37, h + 23)
            self.req({"type": "place", "id": terms[0]["id"], "frame": {"x": x, "y": y, "width": w, "height": h}})
            wins = self.settle()
            terms = [t for t in wins.values() if t["id"] == terms[0]["id"] and t.get("content")]
            held = bool(terms)
        self.log(f"open {' '.join([app, *args])}" + (" (a button held down)" if held else ""))
        if held:
            c = rect(terms[0]["content"])
            self.req({"type": "synthetic", "events": [
                {"type": "move", "x": c[0] + c[2] / 2, "y": c[1] + c[3] / 2},
                {"type": "button", "button": BTN_LEFT, "pressed": True}]})
        self.spawn(app, args)
        t0, seen = time.time(), []
        app_id = "olo." + app[4:]
        while time.time() - t0 < 4:
            now = self.windows()
            if not seen or now != seen[-1]:
                seen.append(now)
            if set(now) - set(wins):
                break
            time.sleep(0.004)
        if held:
            self.settle()
            seen += self.trail
            self.req({"type": "synthetic", "events": [{"type": "button", "button": BTN_LEFT, "pressed": False}]})
            self.last_press = time.time()
        after = self.settle()
        self.trail = seen + self.trail
        self.check_sane(after)
        new = set(after) - set(wins)
        if not new:
            # Brought one of its windows forward instead.
            front = [i for i, w in after.items() if w["focused"]]
            if not front or after[front[0]]["app_id"] != app_id:
                self.fail(f"launching {app} {args} showed none of its windows (focused: {front})")
            self.check_unchanged(f"launching {app} again", wins, after, skip=set(front) | self.mates(after, front[0]) if front else set())
            return
        self.check_unchanged(f"opening {app}", wins, after, skip=new)
        for n in new:
            if not after[n]["focused"]:
                self.fail(f"new window {n} ({after[n]['app_id']}) doesn't have the keyboard")

    def op_close(self, wins, shown):
        if len(wins) <= 3:
            return
        w = self.pick(shown)
        if w is None:
            return
        self.log(f"close {w} ({wins[w]['app_id']})")
        self.req({"type": "close", "id": w})
        after = self.settle()
        if w in after:
            # StyledEdit asks before closing a changed document; leave it.
            return
        self.check_sane(after)
        self.check_unchanged(f"closing {w}", wins, after)

    def op_workspace_trip(self, wins, shown):
        ws = self.workspace()
        to = self.rng.choice([i for i in range(4) if i != ws])
        self.log(f"workspace {ws} -> {to} -> {ws}")
        self.req({"type": "switch_workspace", "index": to})
        mid = self.settle()
        self.check_sane(mid)
        self.req({"type": "switch_workspace", "index": ws})
        after = self.settle()
        self.check_sane(after)
        self.check_round_trip(f"going to workspace {to} and back", wins, after, set())

    def op_workspace_cmd(self, wins, shown):
        sid = self.rng.choice(WORKSPACE_CMDS)
        w = self.pick(shown)
        self.log(f"shortcut {sid} on {w}")
        self.shortcut(sid, w)
        self.check_sane(self.settle())

    def op_zoom_trip(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        how = self.rng.choice(["zoom", "zoom-vertical", "zoom-horizontal", "ipc-zoom"])
        self.log(f"{how} {w} ({wins[w]['app_id']}) and back")
        for _ in range(2):
            if how == "ipc-zoom":
                self.req({"type": "toggle_zoom", "id": w})
            else:
                self.shortcut(how, w)
            mid = self.settle()
            self.check_sane(mid)
            # (Zoomed by the first toggle, unless it was zoomed already.)
            if _ == 0 and how in ("zoom", "ipc-zoom") and not wins[w].get("zoomed"):
                self.check_inside_area(how, w, mid)
            # Each toggle flips it (`WindowInfo::zoomed`).
            expected = bool(wins[w].get("zoomed")) != (_ == 0)
            if how in ("zoom", "ipc-zoom") and w in mid and bool(mid[w].get("zoomed")) != expected:
                self.fail(f"{how} on {w}: zoomed is {bool(mid[w].get('zoomed'))} after toggling {_ + 1} times")
        self.check_round_trip(f"{how} twice on {w}", wins, mid, self.mates(wins, w))

    def op_tile_trip(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        tiles = self.rng.sample(TILES, self.rng.randint(1, 3))
        # (Not Center: where it centers is the window's own place then.)
        extra = self.rng.choice([None, None, "zoom", "zoom-vertical", "zoom-horizontal"])
        self.log(f"restore {w} ({wins[w]['app_id']}), {' then '.join(tiles + ([extra] if extra else []))}, then restore")
        # From its own frame (Restore first), and back to it.
        self.shortcut("restore", w)
        own = self.settle()
        self.check_sane(own)
        self.check_unchanged(f"restoring {w}", wins, own, skip=self.mates(wins, w))
        for t in tiles + ([extra] if extra else []):
            self.shortcut(t, w)
            mid = self.settle()
            self.check_sane(mid)
            if t in TILES or t == "zoom":
                self.check_inside_area(t, w, mid)
        self.shortcut("restore", w)
        after = self.settle()
        self.check_sane(after)
        self.check_round_trip(f"{'/'.join(tiles + ([extra] if extra else []))} then restore on {w}", own, after, self.mates(own, w))

    def op_arrange_trip(self, wins, shown):
        if len(shown) < 2:
            return
        sid = self.rng.choice(["tile-all", "cascade-all", "fan-out", "zoom-all", "cascade-others", "fan-out-others"])
        w = self.pick(shown)
        self.log(f"{sid} (with {w}) then undo")
        self.req({"type": "activate", "id": w})
        before = self.settle()
        self.shortcut(sid, w)
        mid = self.settle()
        self.check_sane(mid)
        if sid == "tile-all":
            for i in self.shown(mid):
                self.check_inside_area(sid, i, mid)
        self.shortcut("undo-arrangement", w)
        after = self.settle()
        self.check_sane(after)
        self.check_round_trip(f"{sid} then undo", before, after, set(before))

    def op_window_ws_trip(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        # Along its own display's workspaces.
        current, by = self.showing()
        out = wins[w].get("output")
        ws = by.get(out, current)
        to = self.rng.choice([i for i in range(4) if i != ws])
        self.log(f"window {w} to workspace {to} and back")
        self.req({"type": "move_to_workspace", "id": w, "index": to})
        mid = self.settle()
        self.check_sane(mid)
        self.check_unchanged(f"moving {w} away", wins, mid, skip=self.mates(wins, w))
        self.req({"type": "switch_workspace", "index": to, "output": out})
        self.settle()
        self.req({"type": "move_to_workspace", "id": w, "index": ws})
        self.req({"type": "switch_workspace", "index": ws, "output": out})
        after = self.settle()
        self.check_sane(after)
        self.check_unchanged(f"moving {w} away and back", wins, after, skip=self.mates(wins, w))
        if wins[w].get("group") is None:
            self.check_back(f"moving {w} to workspace {to} and back", w, wins, after)

    def op_display_trip(self, wins, shown):
        w = self.pick(shown)
        if w is None or len(self.output_rects()) < 2:
            return
        self.log(f"{w} ({wins[w]['app_id']}) to the next display and back")
        self.shortcut("next-display", w)
        mid = self.settle()
        self.check_sane(mid)
        self.check_unchanged(f"{w} to the next display", wins, mid, skip=self.mates(wins, w))
        self.shortcut("previous-display", w)
        after = self.settle()
        self.check_sane(after)
        self.check_round_trip(f"{w} to the next display and back", wins, after, self.mates(wins, w))

    def op_displays(self, wins, shown):
        if len(self.outputs) < 2:
            return
        name = self.rng.choice(self.outputs[1:])
        what = self.rng.choice(["move", "scale", "mirror", "home"])
        cfg = {"mode": None, "scale": None, "position": None, "rotation": None, "mirror": None}
        if what == "move":
            cfg["position"] = self.rng.choice([[1280, 0], [1280, 400], [-960, 0], [0, 800], [200, -540]])
        elif what == "scale":
            cfg["scale"] = self.rng.choice([1.0, 1.5, 2.0])
        elif what == "mirror":
            cfg["mirror"] = self.req({"type": "outputs"})["outputs"][0]["key"]
        else:
            pos, scale = self.home[name]
            cfg.update(position=pos, scale=scale, mirror="")
        self.log(f"display {name}: {what} {json.dumps({k: v for k, v in cfg.items() if v is not None})}")
        self.req({"type": "configure_output", "name": name, "config": cfg})
        self.check_sane(self.settle())

    def op_place(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        outs = self.output_rects()
        ox, oy, ow, oh = self.rng.choice(outs)
        frame = {"x": ox + self.rng.randint(-200, ow), "y": oy + self.rng.randint(-50, oh),
                 "width": self.rng.randint(80, ow + 200), "height": self.rng.randint(60, oh + 200)}
        self.log(f"place {w} at {frame}")
        self.req({"type": "place", "id": w, "frame": frame})
        after = self.settle()
        self.check_sane(after)
        self.check_unchanged(f"placing {w}", wins, after, skip=self.mates(wins, w))

    # ---- apps resizing their windows ----

    def op_app_resize(self, wins, shown):
        """Terminal resizing its own window: a new tab (its tab strip
        comes), closing it again (the strip goes), a bigger or smaller
        text size (every Terminal window keeps its grid). First the
        window is left as it is, zoomed, zoomed one way, tiled, or made
        as tall as its display on its own (filling the screen is where
        growing went past it)."""
        terms = [i for i in shown if wins[i]["app_id"] == "olo.terminal"]
        w = self.pick(terms)
        if w is None:
            return
        how = self.rng.choice(["as it is", "zoom", "zoom-vertical", "tile-left", "tile-top", "tall"])
        if self.text_steps >= 2:
            what = self.rng.choice(["new tab", "new tab, closed", "smaller text"])
        elif self.text_steps <= -1:
            what = self.rng.choice(["new tab", "new tab, closed", "bigger text"])
        else:
            what = self.rng.choice(["new tab", "new tab, closed", "bigger text", "smaller text"])
        self.log(f"Terminal {w}, {how}: {what}")
        if how == "tall":
            self.shortcut("restore", w)
            now = self.settle()
            if w not in now or fr(now[w]) is None:
                return
            home = max(self.output_rects(), key=lambda o: overlap(fr(now[w]), o))
            frame = {"x": home[0] + home[2] // 4, "y": home[1], "width": min(home[2] // 2, 1000), "height": home[3]}
            self.req({"type": "place", "id": w, "frame": frame})
        elif how != "as it is" and not (how == "zoom" and wins[w].get("zoomed")):
            self.shortcut(how, w)
        self.req({"type": "activate", "id": w})
        before = self.settle()
        self.check_sane(before)
        if w not in before or not before[w]["focused"] or fr(before[w]) is None:
            return
        # Zoomed or tiled, it keeps its size; zoomed vertically, its
        # height (its width is its own: a Terminal keeps its columns).
        held = how in ("zoom", "tile-left", "tile-top") or before[w].get("zoomed")
        tall = how == "zoom-vertical" and not held
        if what.startswith("new tab"):
            self.keys([CMD, SHIFT, 20])
            mid = self.settle()
            self.check_sane(mid)
            self.check_steady(f"a new tab in {w}", before)
            self.check_unchanged(f"a new tab in {w}", before, mid)
            if what.endswith("closed") and w in mid and mid[w]["focused"]:
                time.sleep(0.3)
                self.keys([CMD, SHIFT, 17])
                after = self.settle()
                self.check_sane(after)
                if w not in after:
                    self.fail(f"closing the new tab in {w} closed the window")
                self.check_steady(f"closing the new tab in {w}", mid)
                self.check_unchanged(f"closing the new tab in {w}", mid, after)
            return
        bigger = what == "bigger text"
        self.text_steps += 1 if bigger else -1
        self.keys([CMD, SHIFT, 13 if bigger else 12])
        after = self.settle()
        self.check_sane(after)
        terms = [i for i in terms if i in before and i in after and fr(before[i]) and fr(after[i])]
        self.check_unchanged(what, before, after, skip=set().union(*(self.mates(before, i) for i in terms)))
        outs = self.output_rects()
        for i in terms:
            if fr(after[i]) == fr(before[i]):
                continue
            home = max(outs, key=lambda o: overlap(fr(after[i]), o))
            if not contains(home, fr(after[i])):
                self.fail(f"{what}: Terminal window {i} went from {fr(before[i])} to {fr(after[i])}, past its display {home}")
            if before[i].get("zoomed"):
                self.fail(f"{what}: zoomed Terminal window {i} changed size: {fr(before[i])} -> {fr(after[i])}")
        if held and fr(after.get(w, {})) != fr(before[w]):
            self.fail(f"{what}: Terminal window {w} ({how}) didn't keep its size: {fr(before[w])} -> {fr(after.get(w, {}))}")
        a, b = fr(before[w]), fr(after.get(w, {}))
        if tall and b and (a[1], a[3]) != (b[1], b[3]):
            self.fail(f"{what}: Terminal window {w} ({how}) didn't keep its height: {a} -> {b}")
        # A zoomed one keeps it all along (no flicker).
        for i in terms:
            if before[i].get("zoomed"):
                for t in self.trail:
                    if i in t and fr(t[i]) and fr(t[i]) != fr(before[i]):
                        self.fail(f"{what}: zoomed Terminal window {i} flickered to {fr(t[i])} (from {fr(before[i])})")
                        break

    # ---- groups by hand ----

    def hold_ready(self, w):
        """`w` in front, ready to be ⌘-dragged by its tab: the windows
        then, where to take hold of its tab, and its display's tiling
        area; None if its tab can't be taken hold of (too narrow to miss
        its boxes, or not inside the tiling area: off its display, or
        under Deskbar)."""
        self.req({"type": "activate", "id": w})
        wins = self.settle()
        if w not in wins or wins[w]["minimized"] or not wins[w]["focused"]:
            return None
        t = wins[w].get("tab_frame")
        if not t or t["width"] < TAB_GRIP:
            return None
        at = (t["x"] + t["width"] / 2, t["y"] + t["height"] / 2)
        _, area = self.area()
        if not area or not inside(at, area):
            return None
        return wins, at, area

    def cmd_drag(self, start, path, before_letting_go=None):
        """⌘-drag from `start` through the points of `path`, as a person
        would: ⌘ down, press, move a step at a time, let go, ⌘ up. Returns
        what `before_letting_go` (if any) does, at the end of the path."""
        # (Two presses on a tab in a moment are a double-click: rolling up.)
        time.sleep(max(0.0, 0.45 - (time.time() - self.last_press)))
        self.last_press = time.time()
        ev = lambda e: self.req({"type": "synthetic", "events": [e]})
        ev({"type": "move", "x": start[0], "y": start[1]})
        ev({"type": "key", "key": CMD, "pressed": True})
        ev({"type": "button", "button": BTN_LEFT, "pressed": True})
        # (The drag starts once the loop turns.)
        time.sleep(0.03)
        x, y = start
        for tx, ty in path:
            n = max(2, int(max(abs(tx - x), abs(ty - y)) / 40))
            for k in range(1, n + 1):
                ev({"type": "move", "x": x + (tx - x) * k / n, "y": y + (ty - y) * k / n})
            x, y = tx, ty
            time.sleep(0.01)
        seen = before_letting_go() if before_letting_go else None
        ev({"type": "button", "button": BTN_LEFT, "pressed": False})
        ev({"type": "key", "key": CMD, "pressed": False})
        self.last_press = time.time()
        return seen

    def pull_away(self, at, frame):
        """A point straight above or below `at`, on a tab bar of `frame`,
        far enough from it for the tab to come out; on a display."""
        for dy in self.rng.sample([70, -70], 2):
            p = (at[0], at[1] + dy)
            if self.on_display(p):
                return p
        return None

    def on_display(self, p):
        return any(inside(p, o) for o in self.output_rects())

    def bands(self, wins, but):
        """Each shown window's tab bar, and as near to it as a held tab
        goes in there (`NEAR`), but `but`'s."""
        cur = self.showing()
        out = []
        for i, w in wins.items():
            if i in but or w["minimized"] or not self.here(w, cur) or not fr(w):
                continue
            x, y, cw, _ = fr(w)
            out.append((x, y - NEAR, cw, TAB_H + 2 * NEAR))
        return out

    def op_tab_along(self, wins, shown):
        groups = [g for g in self.groups(wins).values() if g[0] in shown]
        if not groups:
            return
        w = self.rng.choice(self.rng.choice(groups))
        ready = self.hold_ready(w)
        if not ready:
            return
        wins, at, _ = ready
        g = self.group_of(wins, w)
        if len(g) < 2:
            return
        x, y, fw, _ = fr(wins[w])
        others = [i for i in g if i != w]
        wanted = [wins[i]["tab_frame"]["width"] for i in others]
        to_place = self.rng.randrange(len(g))
        sx, sw = tab_slot(wanted, wins[w]["tab_frame"]["width"], fw, to_place)
        # Its middle over that place's, a little up or down along the bar.
        to = (x + sx + sw / 2, at[1] + self.rng.uniform(-8, 8))
        if not self.on_display(to):
            return
        self.log(f"cmd-drag {w}'s tab from place {g.index(w)} to {to_place} along group {wins[w]['group']} {g}")
        self.cmd_drag(at, [to])
        after = self.settle()
        self.check_sane(after)
        want = others[:to_place] + [w] + others[to_place:]
        if w not in after or self.group_of(after, w) != want:
            self.fail(f"cmd-dragging {w}'s tab to place {to_place}: the group is {self.group_of(after, w) if w in after else '?'}, not {want}")
        self.check_unchanged(f"cmd-dragging {w}'s tab along its group", wins, after)

    def op_tab_out(self, wins, shown):
        groups = [g for g in self.groups(wins).values() if g[0] in shown]
        if not groups:
            return
        w = self.rng.choice(self.rng.choice(groups))
        ready = self.hold_ready(w)
        if not ready:
            return
        wins, at, _ = ready
        g = self.group_of(wins, w)
        if len(g) < 2:
            return
        away = self.pull_away(at, fr(wins[w]))
        if not away:
            return
        # Let go somewhere on a display clear of every tab bar (over one, it
        # would go in there), maybe by way of others.
        bands = self.bands(wins, {w})
        spots = []
        for _ in range(40):
            ox, oy, ow, oh = self.rng.choice(self.output_rects())
            p = (ox + self.rng.uniform(40, max(41, ow - 40)), oy + self.rng.uniform(40, max(41, oh - 40)))
            if not any(inside(p, b) for b in bands):
                spots.append(p)
                if len(spots) > self.rng.randrange(3):
                    break
        if not spots:
            return
        to = spots[-1]
        self.log(f"cmd-drag {w}'s tab out of group {wins[w]['group']} {g} to {fmt(to)}" + (f" by way of {[fmt(p) for p in spots[:-1]]}" if len(spots) > 1 else ""))
        self.cmd_drag(at, [away] + spots)
        self.alone.add(w)
        self.by_hand.discard(w)
        after = self.settle()
        self.check_sane(after)
        if w not in after:
            return
        rest = [i for i in g if i != w]
        if after[w].get("group") is not None:
            self.fail(f"{w}, cmd-dragged out of its group, is in group {after[w]['group']}")
        if len(rest) > 1 and self.group_of(after, rest[0]) != rest:
            self.fail(f"the rest of {w}'s group {rest} came apart: now {self.group_of(after, rest[0])}")
        # The pointer still on its tab, which is the size it was.
        t = tab_rect(after[w])
        if not t or not inside(to, (t[0] - 1, t[1] - 1, t[2] + 2, t[3] + 2)):
            self.fail(f"{w}, let go at {fmt(to)} after cmd-dragging it out, has its tab at {t}")
        if fr(after[w]) and fr(after[w])[2:] != fr(wins[w])[2:]:
            self.fail(f"{w}, cmd-dragged out of its group, changed size: {fr(wins[w])} -> {fr(after[w])}")
        self.check_unchanged(f"cmd-dragging {w} out of its group", wins, after, skip={w})

    def op_tab_in(self, wins, shown):
        if len(shown) < 2:
            return
        w = self.pick(shown)
        targets = [i for i in shown if i not in self.mates(wins, w)]
        if not targets:
            return
        t = self.pick(targets)
        # Its group in front, then w's in front of that: only w's can hide
        # it.
        self.req({"type": "activate", "id": t})
        self.settle()
        _, t_area = self.area()
        ready = self.hold_ready(w)
        if not ready or not t_area:
            return
        wins, at, _ = ready
        if t not in wins or wins[t]["minimized"] or t in self.mates(wins, w) or not fr(wins[t]):
            return
        tg = self.group_of(wins, t)
        x, y, fw, _ = fr(wins[t])
        cover = [fr(wins[i]) for i in self.mates(wins, w) if i != w]
        cover = [(cx, cy - NEAR, cw, ch + NEAR) for cx, cy, cw, ch in cover]
        # Over its tab bar; on its very tab if it is a dialog or panel, which
        # hides what is behind it only there (else a group behind it could
        # be there to go in).
        bar = (x + 2, y - NEAR + 2, fw - 4, TAB_H + 2 * NEAR - 4)
        if not wins[t].get("groupable"):
            tx, ty, tw, th = tab_rect(wins[t])
            bar = (tx + 1, ty + 1, tw - 2, th - 2)
        to = None
        for _ in range(20):
            p = (bar[0] + self.rng.uniform(0, max(1, bar[2])), bar[1] + self.rng.uniform(0, max(1, bar[3])))
            if inside(p, t_area) and not any(inside(p, c) for c in cover):
                to = p
                break
        away = self.pull_away(at, fr(wins[w]))
        if not to or not away:
            return
        # (A dialog or panel is never grouped: ⌘-dragging one moves it, as
        # any drag does, and one is no place to go in.)
        joins = wins[w].get("groupable") and wins[t].get("groupable")
        name = lambda i: f"{i} ({wins[i]['app_id']}{'' if wins[i].get('groupable') else ', not groupable'}, group {wins[i].get('group')})"
        self.log(f"cmd-drag {name(w)} onto {name(t)}'s tabs {tg} at {fmt(to)}")
        shown_as = self.cmd_drag(at, [away, to], self.windows)
        if joins:
            self.by_hand |= {w, t}
            self.alone -= {w, t}
        elif wins[w].get("group") is not None:
            self.alone.add(w)
        after = self.settle()
        self.check_sane(after)
        if w not in after or t not in after:
            return
        if not joins:
            if after[w].get("group") is not None or self.group_of(after, t) != tg:
                self.fail(f"{name(w)} let go over {name(t)}'s tabs went in: {self.group_of(after, w)}")
            return
        # Held there, it showed as a tab among theirs, in its place.
        held = tab_rect(shown_as.get(w, {}))
        theirs = [tab_rect(shown_as[i]) for i in tg if i in shown_as]
        if not held or held[1] != y or held[0] < x or held[0] + held[2] > x + fw or any(r and overlap(held, r) for r in theirs):
            self.fail(f"{w} held over {t}'s tabs showed its tab at {held}, not among theirs {theirs} along {(x, y, fw)}")
        got = self.group_of(after, w)
        if after[w].get("group") is None or set(got) != set(tg) | {w} or [i for i in got if i != w] != tg:
            self.fail(f"{w} let go over {t}'s tabs: its group is {got}, not {tg} with it")
        # Where it showed it would go.
        elif held and tab_rect(after[w]) != held:
            self.fail(f"{w} showed its tab at {held} over {t}'s, but went in at {tab_rect(after[w])}")
        self.check_unchanged(f"cmd-dragging {w} into {t}'s group", wins, after, skip={w})

    def op_group_window(self, wins, shown):
        if len(shown) < 2:
            return
        w = self.pick(shown)
        t = self.pick([i for i in shown if i != w])
        joins = wins[w].get("groupable") and wins[t].get("groupable")
        tg = [i for i in self.group_of(wins, t) if i != w]
        index = self.rng.choice([None] + list(range(len(tg) + 2)))
        self.log(f"group_window {w} ({wins[w]['app_id']}) with {t} ({wins[t]['app_id']}, group {tg}) at {index}")
        r = {"type": "group_window", "id": w, "with": t}
        if index is not None:
            r["index"] = index
        reply = self.try_req(r)
        if reply.get("type") != "error" and joins:
            self.by_hand |= {w, t}
            self.alone -= {w, t}
        after = self.settle()
        self.check_sane(after)
        if (reply.get("type") == "error") == bool(joins):
            self.fail(f"group_window {w} with {t}: {reply.get('message', 'done')}, though {w} is {'' if wins[w].get('groupable') else 'not '}groupable and {t} {'is' if wins[t].get('groupable') else 'is not'}")
        if reply.get("type") == "error":
            self.check_unchanged(f"group_window {w} with {t}, refused", wins, after)
            return
        at = len(tg) if index is None else min(index, len(tg))
        want = tg[:at] + [w] + tg[at:]
        if w in after and self.group_of(after, w) != want:
            self.fail(f"group_window {w} with {t} at {index}: the group is {self.group_of(after, w)}, not {want}")
        if w in after and not after[w]["focused"]:
            self.fail(f"group_window {w} with {t}: {w} doesn't have the keyboard")
        # The group may grow to what its new window can be at the least
        # (a group is no smaller than its biggest member's least size),
        # where it is, and no more.
        grown = set()
        least = wins[w].get("least")
        for i in tg:
            a, b = fr(wins.get(i, {})), fr(after.get(i, {}))
            if least and a and b and a != b and b[:2] == a[:2] and b[2:] == (max(a[2], least[0]), max(a[3], least[1])):
                grown.add(i)
        self.check_unchanged(f"group_window {w} with {t}", wins, after, skip={w} | grown)

    def op_ungroup_window(self, wins, shown):
        groups = [g for g in self.groups(wins).values() if g[0] in shown]
        if not groups:
            return
        w = self.rng.choice(self.rng.choice(groups))
        rest = [i for i in self.group_of(wins, w) if i != w]
        self.log(f"ungroup_window {w} (group {wins[w]['group']} {self.group_of(wins, w)})")
        self.req({"type": "ungroup_window", "id": w})
        self.alone.add(w)
        self.by_hand.discard(w)
        after = self.settle()
        self.check_sane(after)
        if w not in after:
            return
        if after[w].get("group") is not None:
            self.fail(f"ungroup_window {w}: it is in group {after[w]['group']}")
        if not after[w]["focused"]:
            self.fail(f"ungroup_window {w}: it doesn't have the keyboard")
        # Stepped out from the group as a cascade, at its size.
        if fr(after[w]) == fr(wins[w]) or fr(after[w])[2:] != fr(wins[w])[2:]:
            self.fail(f"ungroup_window {w}: {fr(wins[w])} -> {fr(after[w])}")
        if len(rest) > 1 and self.group_of(after, rest[0]) != rest:
            self.fail(f"ungroup_window {w}: the rest of its group {rest} came apart: now {self.group_of(after, rest[0])}")
        self.check_unchanged(f"ungroup_window {w}", wins, after, skip={w})

    def op_move_tab(self, wins, shown):
        groups = [g for g in self.groups(wins).values() if g[0] in shown]
        if not groups:
            return
        g = self.rng.choice(groups)
        w = self.rng.choice(g)
        index = self.rng.randrange(len(g) + 1)
        self.log(f"move_tab {w} to {index} in group {wins[w]['group']} {g}")
        self.req({"type": "move_tab", "id": w, "index": index})
        after = self.settle()
        self.check_sane(after)
        others = [i for i in g if i != w]
        want = others[:index] + [w] + others[index:]
        if w in after and self.group_of(after, w) != want:
            self.fail(f"move_tab {w} to {index}: the group is {self.group_of(after, w)}, not {want}")
        self.check_unchanged(f"move_tab {w}", wins, after)

    def run(self, steps, keep_going):
        self.keep_going = keep_going
        print(f"wm-fuzz {self.name}: seed {self.seed}, {steps} steps", flush=True)
        try:
            for _ in range(steps):
                self.run_step()
        except Failure as e:
            print(f"FAIL {e}", flush=True)
            return 1
        if self.failures:
            print(f"\n{len(self.failures)} failures (seed {self.seed})")
            return 1
        print(f"ok: {steps} steps (seed {self.seed})")
        return 0


def state(wins):
    return "; ".join(f"{i} {w['app_id'][4:]} ws{w['workspace']}{' hidden' if w['minimized'] else ''}{' *' if w['focused'] else ''} {fr(w)}"
                     for i, w in sorted(wins.items()))


def rect(f):
    return (f["x"], f["y"], f["width"], f["height"])


def fr(w):
    """Its frame; None while it is hidden or on another workspace."""
    return rect(w["frame"]) if w.get("frame") else None


def tab_rect(w):
    t = w.get("tab_frame")
    return rect(t) if t else None


def contains(r, f):
    """Rectangle `f` is all inside `r`."""
    return r[0] <= f[0] and r[1] <= f[1] and f[0] + f[2] <= r[0] + r[2] and f[1] + f[3] <= r[1] + r[3]


def inside(p, r):
    return r[0] <= p[0] < r[0] + r[2] and r[1] <= p[1] < r[1] + r[3]


def fmt(p):
    return f"({p[0]:.0f}, {p[1]:.0f})"


def tab_bar(wanted, frame_w):
    """Each tab's offset and width along a group's top (as app_server's
    shell/groups.rs `tab_bar` lays them)."""
    n = len(wanted)
    if not n:
        return []
    if sum(wanted) <= frame_w:
        widths = list(wanted)
    else:
        each = max(frame_w // n, 1)
        widths = [each] * (n - 1) + [max(frame_w - each * (n - 1), 1)]
    out, x = [], 0
    for w in widths:
        out.append((x, w))
        x += w
    return out


def tab_slot(wanted, width, frame_w, place):
    """The offset and width a tab `width` wide has at `place` among tabs
    wanting `wanted`."""
    return tab_bar(wanted[:place] + [width] + wanted[place:], frame_w)[place]


def overlap(a, b):
    w = min(a[0] + a[2], b[0] + b[2]) - max(a[0], b[0])
    h = min(a[1] + a[3], b[1] + b[3]) - max(a[1], b[1])
    return max(w, 0) * max(h, 0)


def main():
    a = sys.argv[1:]
    if not a or a[0].startswith("-"):
        sys.exit(__doc__)
    name = a[0]
    seed = int(a[a.index("--seed") + 1]) if "--seed" in a else random.randrange(1 << 30)
    steps = int(a[a.index("--steps") + 1]) if "--steps" in a else 200
    fuzz = Fuzz(name, seed, "--quiet" in a)
    fuzz.tiles_fail = "--tiles" in a
    fuzz.trace_tiles = "--trace-tiles" in a
    if "--only" in a:
        fuzz.only = set(a[a.index("--only") + 1].split(","))
        unknown = fuzz.only - {m[3:] for m in dir(fuzz) if m.startswith("op_")}
        if unknown:
            sys.exit(f"wm-fuzz: no such step: {', '.join(sorted(unknown))}")
    sys.exit(fuzz.run(steps, "--keep-going" in a))


if __name__ == "__main__":
    main()
