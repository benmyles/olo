#!/usr/bin/python3
"""Run a window-manager fuzzer over many seeds at once, each in its own
headless session (release build), and say which failed.

  fuzz-sweep [--seeds 1-16|1,4,9] [--jobs N] [--steps N] [--fuzzer auto-fuzz|wm-fuzz]
             [--confirm] [--keep] [-- FUZZER_ARGS…]

Every seed runs at once by default (`--jobs`: the machine's cores): a
sweep of 16 takes about as long as one seed alone. Each session is
`tsession start sweepN 3024x1890 --scale 1.75 --session --shell` (as the
fuzzers' docs say), stopped and its folder in /tmp/olo-dev removed when
its seed is done (`--keep` keeps the failures', for their logs).
`--confirm` runs each failure again alone, after the rest: one that
passes alone was the load's (a timing check missed under 16 sessions),
one that fails again is a fault. Arguments after `--` go to the fuzzer
(`--reloads`, `--floats`, `--only drag,open`). Each seed's whole output
is in /var/tmp/olo-fuzz/sweep-SEED.txt.

  tools/dev/fuzz-sweep -- --reloads             # seeds 1-16, 120 steps, with reloads
  tools/dev/fuzz-sweep --seeds 1-32 --confirm -- --reloads --floats
"""
import concurrent.futures as cf
import os
import re
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
TSESSION = os.path.join(HERE, "tsession")
OUT = "/var/tmp/olo-fuzz"


def seeds_of(spec):
    out = []
    for part in spec.split(","):
        if "-" in part:
            a, b = part.split("-")
            out += range(int(a), int(b) + 1)
        elif part:
            out.append(int(part))
    return out


def run(seed, fuzzer, steps, extra, keep, tag="sweep"):
    """One seed in a session of its own: (seed, passed, the result line)."""
    name = f"{tag}{seed}"
    env = dict(os.environ, TSESSION_PROFILE="release")
    # (Never the person's display: the session's own, or nothing.)
    env.pop("WAYLAND_DISPLAY", None)
    env.pop("OLO_SOCKET", None)
    subprocess.run(["/usr/bin/python3", TSESSION, "stop", name], env=env, capture_output=True)
    started = subprocess.run(["/usr/bin/python3", TSESSION, "start", name, "3024x1890", "--scale", "1.75", "--session", "--shell"], env=env, capture_output=True, text=True)
    path = os.path.join(OUT, f"{tag}-{seed}.txt")
    if started.returncode != 0:
        return seed, False, f"the session didn't start: {(started.stderr or started.stdout).strip()[-200:]}"
    t0 = time.time()
    with open(path, "w") as out:
        r = subprocess.run(["/usr/bin/python3", os.path.join(HERE, fuzzer), name, "--seed", str(seed), "--steps", str(steps), "--quiet", *extra], env=env, stdout=out, stderr=subprocess.STDOUT, timeout=3600)
    text = open(path).read()
    line = next((l for l in text.splitlines() if l.startswith(("FAIL", "ok:"))), f"exit {r.returncode}, no result")
    passed = line.startswith("ok:") and r.returncode == 0
    subprocess.run(["/usr/bin/python3", TSESSION, "stop", name], env=env, capture_output=True)
    if passed or not keep:
        shutil.rmtree(f"/tmp/olo-dev/{name}", ignore_errors=True)
    return seed, passed, f"{line[:300]} ({time.time() - t0:.0f} s)"


def main():
    args = sys.argv[1:]
    extra = []
    if "--" in args:
        i = args.index("--")
        args, extra = args[:i], args[i + 1:]

    def opt(name, default):
        return args[args.index(name) + 1] if name in args else default

    if "-h" in args or "--help" in args:
        sys.exit(__doc__)
    seeds = seeds_of(opt("--seeds", "1-16"))
    jobs = int(opt("--jobs", os.cpu_count() or 4))
    steps = int(opt("--steps", "120"))
    fuzzer = opt("--fuzzer", "auto-fuzz")
    keep = "--keep" in args
    os.makedirs(OUT, exist_ok=True)
    t0 = time.time()
    print(f"fuzz-sweep: {fuzzer} {' '.join(extra)}, seeds {seeds[0]}–{seeds[-1]} ({len(seeds)}), {steps} steps, {jobs} at once", flush=True)
    failed = []
    def staggered(i, seed):
        # (Starts half a second apart: sixteen sessions starting in the
        # same instant left windows not yet drawn at the first look.)
        time.sleep(0.5 * (i % jobs))
        return run(seed, fuzzer, steps, extra, keep)

    with cf.ThreadPoolExecutor(max_workers=jobs) as pool:
        for f in cf.as_completed([pool.submit(staggered, i, s) for i, s in enumerate(seeds)]):
            seed, passed, line = f.result()
            print(f"  {seed:3}: {line}", flush=True)
            if not passed:
                failed.append(seed)
    print(f"{len(seeds) - len(failed)} of {len(seeds)} passed in {time.time() - t0:.0f} s", flush=True)
    if failed and "--confirm" in args:
        print(f"again, alone: {', '.join(map(str, sorted(failed)))}", flush=True)
        still = []
        for seed in sorted(failed):
            _, passed, line = run(seed, fuzzer, steps, extra, keep, tag="alone")
            print(f"  {seed:3}: {'the load (passes alone)' if passed else 'a fault'}: {line}", flush=True)
            if not passed:
                still.append(seed)
        failed = still
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
