#!/usr/bin/python3
"""Adversarial QA of auto-tiling on a test desktop (Ben, 2026-11-15: "your
own adversarial live qa trying to break it by doing weird stuff ...
changing between them all in unexpected ways"): random operations, as a
person and an agent could do them in any order (apps opening and closing,
every tiling and arranging shortcut, two at once with no wait, layouts
and main places on either display, windowing modes, workspaces, windows
moved between them, minimizing and bringing back, scale changes), and
after each the invariants: app_server answers; on every auto-tiled
display, its tiled windows each have a part, the parts lie in the area
and never overlap, the windows are on the display, and two overlap only
where a least size holds one past its part; no window there is neither
tiled nor floating.

    tile-qa NAME [--steps N] [--seed S] [--dense]

NAME is a running tsession (`tsession start NAME 2560x1440,1920x1200
--scale 1 --home DIR`, apps from target/debug). --dense keeps it on one
workspace of one display, auto-tiled (turned on again when an arranging
command turns it to Standard), for many tiles at once. A failure prints
the step, what's wrong and the operations before it; the seed replays it.
"""
import argparse, importlib.machinery, importlib.util, json, os, random, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_loader("tsession", importlib.machinery.SourceFileLoader("tsession", os.path.join(HERE, "tsession")))
ts = importlib.util.module_from_spec(spec)
spec.loader.exec_module(ts)

ap = argparse.ArgumentParser(description="Adversarial QA of auto-tiling on a tsession desktop")
ap.add_argument("name")
ap.add_argument("--steps", type=int, default=200)
ap.add_argument("--seed", type=int, default=1)
ap.add_argument("--dense", action="store_true")
args = ap.parse_args()
name, steps, seed = args.name, args.steps, args.seed
rng = random.Random(seed)
# Files for Styled Edit, in the session's home (or its folder).
HOME = ts.load_env(name).get("HOME") or ts.sdir(name)
for f in ("n1.txt", "n2.txt"):
    path = os.path.join(HOME, f)
    if not os.path.exists(path):
        open(path, "w").write(f"{f}\n")
APPS = [
    ["olo-styled-edit", f"{HOME}/n1.txt"],
    ["olo-styled-edit", f"{HOME}/n2.txt"],
    ["OLO_KACHE_DEMO=1", "olo-kache"],
    ["olo-disk-usage"],
    ["olo-logs"],
    ["olo-deskcalc"],
    ["OLO_DOCTOR_HELPER=off", "olo-doctor"],
]
SHORTCUTS = "bigger-main smaller-main more-main-windows fewer-main-windows rotate-tiles rotate-tiles-back flip-tiles-across flip-tiles-up-down even-out-tiles toggle-split more-gap less-gap make-main swap-main focus-left focus-down focus-up focus-right swap-left swap-down swap-up swap-right resize-left resize-right resize-up resize-down next-layout previous-layout tile-all smart-tile zoom-all cascade-all fan-out undo-arrangement redo-arrangement tile-left tile-right-third zoom restore float-window hide-window next-display next-tab".split()
LAYOUTS = ["main_and_stack", "halves", "columns", "rows", "grid", "spiral"]
PLACES = ["Left", "Right", "Top", "Bottom", "LeftTwoThirds", "CenterTwoThirds", "RightThird", "TopLeft", "BottomRight"]
MODES = ["auto_tiling"] * 6 + ["standard", "focus"]


def ipc(req):
    for _ in range(50):
        try:
            return ts.ipc(name, req)
        except (ConnectionError, FileNotFoundError, json.JSONDecodeError):
            time.sleep(0.1)
    raise SystemExit(f"app_server stopped answering after {req}")


def windows():
    return ipc({"type": "list_windows"})["windows"]


def outputs():
    out = {}
    for o in ipc({"type": "outputs"})["outputs"]:
        m = o.get("current_mode") or {}
        s = o.get("scale") or 1
        out[o["name"]] = (o["position"][0], o["position"][1], m.get("width", 0) / s, m.get("height", 0) / s)
    return out


def modes():
    return {d["output"]: d for d in ipc({"type": "windowing_mode"})["displays"]}


SEEN = {"checks": 0, "pairs": 0, "layouts": set()}


SMART = [False]


def check(what):
    outs, ms, ws = outputs(), modes(), windows()
    SMART[0] = ipc({"type": "get_settings"})["settings"]["tiling"].get("smart_gaps", False)
    SEEN["checks"] += 1
    problems = []
    for o, d in ms.items():
        if d["mode"] != "auto_tiling":
            continue
        tiles = [w for w in ws if w.get("output") == o and w.get("workspace", 0) == d["workspace"] and not w.get("minimized") and not w.get("floating") and not w.get("behind") and w.get("tiled") and w.get("frame")]
        ox, oy, ow, oh = outs[o]
        for w in tiles:
            f = w["frame"]
            fits = f["width"] <= ow and f["height"] <= oh
            if fits and (f["x"] < ox - 1 or f["y"] < oy - 1 or f["x"] + f["width"] > ox + ow + 1 or f["y"] + f["height"] > oy + oh + 1):
                problems.append(f"{w['id']} {w['title'][:12]} outside {o} {outs[o]}: {f}")
            if f["width"] <= 0 or f["height"] <= 0:
                problems.append(f"{w['id']} empty: {f}")
        SEEN["pairs"] += len(tiles) * (len(tiles) - 1) // 2
        if len(tiles) > 2:
            SEEN["layouts"].add(d["layout"])
        # Smart gaps: a tile alone fills its display (no Deskbar in a
        # tsession without --shell).
        if SMART[0] and len(tiles) == 1 and tiles[0]["frame"] != {"x": ox, "y": oy, "width": ow, "height": oh} and all(isinstance(v, int) or float(v).is_integer() for v in (ox, oy, ow, oh)):
            f = tiles[0]["frame"]
            if (f["x"], f["y"], f["width"], f["height"]) != (int(ox), int(oy), int(ow), int(oh)):
                problems.append(f"{tiles[0]['id']} {tiles[0]['title'][:12]} alone with smart gaps at {f}, not the display {outs[o]}")
        # The tiling area: the display less the margin (8).
        ax, ay, aw, ah = ox + 8, oy + 8, ow - 16, oh - 16
        def held(w):
            # Bigger than its part: its least size holds it.
            p, f = w.get("part"), w["frame"]
            return p is not None and (f["width"] > p[2] * aw + 2 or f["height"] > p[3] * ah + 2)
        for i, a in enumerate(tiles):
            pa = a.get("part")
            if pa is None:
                problems.append(f"{a['id']} {a['title'][:12]} tiled with no part ({d['layout']})")
                continue
            if min(pa) < -1e-3 or pa[0] + pa[2] > 1.001 or pa[1] + pa[3] > 1.001:
                problems.append(f"{a['id']} {a['title'][:12]} part outside: {pa}")
            for b in tiles[i + 1:]:
                pb = b.get("part")
                if pb is not None:
                    px_ = min(pa[0] + pa[2], pb[0] + pb[2]) - max(pa[0], pb[0])
                    py_ = min(pa[1] + pa[3], pb[1] + pb[3]) - max(pa[1], pb[1])
                    if px_ > 1e-3 and py_ > 1e-3:
                        problems.append(f"parts overlap: {a['id']} {a['title'][:12]} {pa} and {b['id']} {b['title'][:12]} {pb} ({d['layout']})")
                fa, fb = a["frame"], b["frame"]
                ox_ = min(fa["x"] + fa["width"], fb["x"] + fb["width"]) - max(fa["x"], fb["x"])
                oy_ = min(fa["y"] + fa["height"], fb["y"] + fb["height"]) - max(fa["y"], fb["y"])
                if ox_ > 1 and oy_ > 1 and not held(a) and not held(b):
                    problems.append(f"{a['id']} {a['title'][:12]} {fa} overlaps {b['id']} {b['title'][:12]} {fb}, neither held by its least size ({d['layout']})")
        # A window on an auto-tiled workspace that's neither tiled nor floating.
        for w in ws:
            if w.get("output") == o and w.get("workspace", 0) == d["workspace"] and not w.get("minimized") and not w.get("floating") and not w.get("tiled") and not w.get("behind"):
                problems.append(f"{w['id']} {w['title'][:12]} neither tiled nor floating on {o} ({d['layout']})")
    return problems


def settle():
    # Wait until the frames stop changing (a round of sizes in flight), 3 s at most.
    last, t0 = None, time.time()
    while time.time() - t0 < 3:
        now = json.dumps([(w["id"], w.get("frame")) for w in windows()])
        if now == last:
            return
        last = now
        time.sleep(0.35)


DENSE = args.dense
log = []
pids = []
fails = 0
for step in range(steps):
    ws = windows()
    shown = [w for w in ws if not w.get("minimized")]
    r = rng.random()
    # Dense: windows stay on one workspace and display, auto-tiled, at 1×
    # (no workspace, move, mode, minimize or scale steps: shortcuts instead).
    if DENSE and (0.72 <= r < 0.86 or 0.91 <= r < 0.97):
        r = 0.3
    if (r < 0.18 and len(ws) < 8) or not ws:
        app = rng.choice(APPS)
        op = f"run {' '.join(app)}"
        with open(os.devnull, "w") as quiet:
            out, sys.stdout = sys.stdout, quiet
            try:
                ts.run(name, list(app))
            finally:
                sys.stdout = out
        time.sleep(1.5)
    elif r < 0.20 and ws:
        w = rng.choice(ws)
        op = f"close {w['id']} {w['title'][:12]}"
        ipc({"type": "close", "id": w["id"]})
    elif r < 0.60:
        sc = rng.choice(SHORTCUTS)
        op = f"shortcut {sc}"
        ipc({"type": "run_shortcut", "id": sc})
    elif r < 0.68:
        l = rng.choice(LAYOUTS)
        o = rng.choice(list(outputs()))
        op = f"layout {l} on {o}"
        ipc({"type": "set_tiling_layout", "layout": l, "output": o})
    elif r < 0.69:
        # Where new windows go: first, after the active one, last.
        st = ipc({"type": "get_settings"})["settings"]
        st["tiling"]["new_windows"] = rng.choice(["first", "after_active", "last"])
        op = f"new windows {st['tiling']['new_windows']}"
        ipc({"type": "set_settings", "settings": st})
    elif r < 0.70:
        # Smart gaps on or off: a window alone fills its display, or not.
        st = ipc({"type": "get_settings"})["settings"]
        st["tiling"]["smart_gaps"] = not st["tiling"].get("smart_gaps", False)
        op = f"smart gaps {'on' if st['tiling']['smart_gaps'] else 'off'}"
        ipc({"type": "set_settings", "settings": st})
    elif r < 0.72:
        p = rng.choice(PLACES)
        op = f"main place {p}"
        ipc({"type": "set_main_place", "place": p})
    elif r < 0.77:
        m = rng.choice(MODES)
        o = rng.choice(list(outputs()))
        op = f"mode {m} on {o}"
        ipc({"type": "set_windowing_mode", "mode": m, "output": o})
    elif r < 0.82:
        i = rng.randrange(2)
        o = rng.choice(list(outputs()))
        op = f"workspace {i} on {o}"
        ipc({"type": "switch_workspace", "index": i, "output": o})
    elif r < 0.86 and ws:
        w = rng.choice(ws)
        i = rng.randrange(2)
        op = f"move {w['id']} to workspace {i}"
        ipc({"type": "move_to_workspace", "id": w["id"], "index": i})
    elif r < 0.91 and ws:
        w = rng.choice(ws)
        op = f"activate {w['id']} {w['title'][:12]}{' (minimized)' if w['minimized'] else ''}"
        ipc({"type": "activate", "id": w["id"]})
    elif r < 0.95 and shown:
        w = rng.choice(shown)
        op = f"minimize {w['id']} {w['title'][:12]}"
        ipc({"type": "minimize", "id": w["id"]})
    elif r < 0.97:
        s = rng.choice(["1", "1.5", "2", "1.25"])
        op = f"scale {s}"
        subprocess.run(["/usr/bin/python3", os.path.join(HERE, "tsession"), "scale", name, s], capture_output=True, timeout=60)
    else:
        # Two quick ones with no wait between: what a fast hand does.
        a, b = rng.choice(SHORTCUTS), rng.choice(SHORTCUTS)
        op = f"quick {a} {b}"
        ipc({"type": "run_shortcut", "id": a})
        ipc({"type": "run_shortcut", "id": b})
    settle()
    if DENSE and any(d["mode"] != "auto_tiling" for d in modes().values()):
        ipc({"type": "set_windowing_mode", "mode": "auto_tiling"})
        op += " (then auto-tiling again)"
        settle()
    log.append(op)
    problems = check(op)
    if problems:
        # Again after a moment: a round of sizes may still be landing.
        time.sleep(1.5)
        problems = check(op)
    if problems:
        fails += 1
        print(f"step {step}: after {op}:")
        for p in problems:
            print("   ", p)
        print("    last ops:", " | ".join(log[-6:]))
        if fails >= 5:
            break
print(f"{len(log)} steps, {fails} with problems; {SEEN['pairs']} tile pairs checked; layouts seen with 3+ tiles: {sorted(SEEN['layouts'])}")
sys.exit(1 if fails else 0)
