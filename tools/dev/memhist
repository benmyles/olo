#!/usr/bin/env python3
"""Who copies memory and who allocates it, by the function that asked:
for a kit app whose profile says "libc" and not whose (tools/dev/memhist.c;
HACKING, "Fast and light").

  memhist run NAME [VAR=VAL…] CMD [ARGS…]
        start CMD in test session NAME with the probe (not counting
        yet); prints its pid
  memhist count PID
        start counting, or stop (the same signal toggles it): around the
        work to be looked at
  memhist report PID [--per N] [--top N]
        what was counted, the biggest copy sites and the busiest
        allocation sites named (one addr2line run; it reads the
        program's debug info, so it takes a while on a big binary);
        --per N divides by N (frames, steps), --top N lists that many
        (20)

A release build has the debug info it needs. The probe's copies are
slower than glibc's own: count under it, time without it. Its numbers
are exact, and the same from run to run for the same work.

  tools/dev/tsession start t --home /var/tmp/olo-bench/home
  tools/dev/memhist run t olo-logs            # → pid
  tools/dev/memhist count PID; (drive it); tools/dev/memhist count PID
  tools/dev/memhist report PID --per 216
"""
import os, re, signal, subprocess, sys, time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
TSESSION = os.path.join(ROOT, "tools", "dev", "tsession")
SCRATCH = "/var/tmp/olo-memhist"
PROBE = os.path.join(SCRATCH, "memhist.so")
SOURCE = os.path.join(ROOT, "tools", "dev", "memhist.c")


def build():
    os.makedirs(SCRATCH, exist_ok=True)
    if os.path.exists(PROBE) and os.path.getmtime(PROBE) >= os.path.getmtime(SOURCE):
        return
    r = subprocess.run(["cc", "-O2", "-fPIC", "-shared", "-fno-builtin", "-o", PROBE, SOURCE, "-ldl"], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"memhist: couldn't build the probe: {r.stderr.strip()}")


def out_of(pid):
    return os.path.join(SCRATCH, f"{pid}.txt")


def probed(pid):
    """Only a process started with the probe is signalled: SIGUSR1 ends
    one that doesn't handle it."""
    try:
        env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
    except OSError:
        sys.exit(f"memhist: no process {pid}")
    if f"LD_PRELOAD={PROBE}".encode() not in env:
        sys.exit(f"memhist: {pid} wasn't started with the probe (memhist run)")


def run(args):
    if len(args) < 2:
        sys.exit(__doc__)
    build()
    name, rest = args[0], args[1:]
    cmd = next(a for a in rest if "=" not in a)
    # (Its output file is named by its pid, which isn't known yet: by a
    # stamp, linked to the pid once it's there.)
    stamp = os.path.join(SCRATCH, f"run-{os.getpid()}.txt")
    r = subprocess.run(["/usr/bin/python3", TSESSION, "run", name, f"LD_PRELOAD={PROBE}", f"MEMHIST_OUT={stamp}", *rest], env=dict(os.environ), capture_output=True, text=True)
    m = re.search(r"pid (\d+)", r.stdout)
    if not m:
        sys.exit(f"memhist: {cmd} didn't start: {(r.stdout + r.stderr).strip()}")
    pid = m.group(1)
    open(os.path.join(SCRATCH, f"{pid}.where"), "w").write(stamp)
    print(pid)


def count(args):
    pid = int(args[0])
    probed(pid)
    os.kill(pid, signal.SIGUSR1)


def report(args):
    pid = int(args[0])
    per = int(args[args.index("--per") + 1]) if "--per" in args else 1
    top = int(args[args.index("--top") + 1]) if "--top" in args else 20
    probed(pid)
    where = open(os.path.join(SCRATCH, f"{pid}.where")).read().strip()
    if os.path.exists(where):
        os.remove(where)
    os.kill(pid, signal.SIGUSR2)
    for _ in range(50):
        if os.path.exists(where) and os.path.getsize(where) > 0:
            break
        time.sleep(0.1)
    else:
        sys.exit("memhist: nothing was written (was anything counted?)")
    time.sleep(0.2)
    binary = os.path.realpath(f"/proc/{pid}/exe")
    copies, allocs = [], []
    for line in open(where):
        f = line.split()
        if f[0] == "A":
            allocs.append((int(f[1]), int(f[2]), f[3], int(f[4], 16)))
        else:
            copies.append((int(f[0]), int(f[1]), f[2], int(f[3], 16)))
    copies.sort(reverse=True)
    allocs.sort(key=lambda r: -r[1])
    ours = [r for r in copies[:top] + allocs[:top] if os.path.realpath(r[2]) == binary]
    addrs = sorted({r[3] - 1 for r in ours})
    names, cur = {}, None
    if addrs:
        lines = subprocess.run(["addr2line", "-f", "-i", "-C", "-a", "-e", binary] + [hex(a) for a in addrs], capture_output=True, text=True).stdout.splitlines()
        i = 0
        while i < len(lines):
            if lines[i].startswith("0x"):
                cur = int(lines[i], 16)
                names[cur] = []
                i += 1
                continue
            where_line = lines[i + 1] if i + 1 < len(lines) else ""
            where_line = re.sub(r"^/proc/self/cwd/|^/home/[^/]+/\.cargo/registry/src/[^/]+/|^/rustc/[0-9a-f]+/library/", "", where_line).split(" ")[0]
            names[cur].append((lines[i], where_line))
            i += 2
    # (The allocator's and the containers' own frames say nothing: the
    # first frame that isn't one of theirs is who asked.)
    theirs = re.compile(r"^(<?alloc::|<?core::|__rust|__rdl|<?std::|<?hashbrown|<?smallvec|alloc_impl|grow_impl|exchange_malloc|<u8 as|<\[u8\]>|to_vec|finish_grow|try_allocate|allocate|grow$|with_capacity|from_iter|spec_|extend_|push|reserve|new_uninit|box_new|clone$|to_owned$|into$|from$|read<|next<|fold<|try_fold<|\{closure)")

    def who(r):
        if r not in ours:
            return os.path.basename(r[2])
        frames = names.get(r[3] - 1, [])
        own = [f for f in frames if not theirs.match(f[0])]
        return " <- ".join(f"{fn[:90]} @ {w[-40:]}" for fn, w in (own or frames)[:2]) or hex(r[3])

    tb, tc = sum(r[0] for r in copies), sum(r[1] for r in copies)
    ab, ac = sum(r[0] for r in allocs), sum(r[1] for r in allocs)
    unit = "" if per == 1 else f" a step (of {per})"
    print(f"copies: {tb / 1024 / per:.0f} KB in {tc // per} calls{unit}; allocations: {ac // per}, {ab / 1024 / per:.0f} KB{unit}")
    print("== copies (KB, calls, bytes each)")
    for r in copies[:top]:
        print(f"{r[0] / 1024 / per:8.0f} KB {r[1] // per:6d}x {r[0] // max(r[1], 1):6d} B  {who(r)}")
    print("== allocations (calls, bytes each)")
    for r in allocs[:top]:
        print(f"{r[1] // per:6d}x {r[0] // max(r[1], 1):6d} B  {who(r)}")


def main():
    a = sys.argv[1:]
    if len(a) < 2 or a[0] not in ("run", "count", "report"):
        sys.exit(__doc__)
    {"run": run, "count": count, "report": report}[a[0]](a[1:])


if __name__ == "__main__":
    main()
