#!/bin/bash
# A second pair of eyes on what a change looks like (Ben, 2026-11-18:
# "provide all screenshots of changes to a codex agent … using astra 6.2
# on medium for a second review / set of eyes to identify anything you
# missed"): Codex (gpt-6.2-astra, medium reasoning) is shown the pictures
# and says what a careful designer would catch that the layout lint and
# `tsession review` can't: a line set right under another, uneven gaps,
# edges and baselines not lined up, text cut or crowded, something out of
# keeping with the rest of the window.
#
#   tools/dev/codex-look [--about "WHAT CHANGED"] PICTURE.png…
#
# PICTUREs: the change's pictures (headless: tools/dev/tsession shot),
# each state and scale worth seeing, in a folder of yours under /var/tmp.
# It prints its findings and writes them to codex-look.md beside the
# first picture. It only looks (a read-only sandbox, no tools wanted):
# check each finding against the picture yourself, and fix what's real.
set -u
about=""
if [ "${1:-}" = "--about" ]; then
    about=${2:-}
    shift 2
fi
if [ $# -eq 0 ]; then
    echo "usage: tools/dev/codex-look [--about \"WHAT CHANGED\"] PICTURE.png…" >&2
    exit 2
fi
images=()
for p in "$@"; do
    case "$p" in
        /tmp/*) echo "codex-look: $p is in RAM (/tmp); keep pictures under /var/tmp" >&2; exit 2 ;;
    esac
    [ -s "$p" ] || { echo "codex-look: no picture $p" >&2; exit 2; }
    images+=(-i "$p")
done
if ! command -v codex > /dev/null; then
    echo "codex-look: no codex on PATH (the Codex CLI, signed in)" >&2
    exit 2
fi
out=$(cd "$(dirname "$1")" && pwd)/codex-look.md
names=$(for p in "$@"; do basename "$p"; done | paste -sd, - | sed 's/,/, /g')
{
    cat <<PROMPT
You are a second pair of eyes on screenshots of a change to Olo, a
BeOS-inspired desktop whose every window is meant to be pixel-perfect.
The agent that made the change has looked already; find what it missed.
Judge the pictures as a meticulous visual designer would:
- spacing: text or controls set right against what's above or beside
  them, gaps that differ where they should match, a box's content not
  inset evenly;
- alignment: edges, baselines and columns that should line up and
  don't, by even a pixel;
- text: cut short, wrapped badly (a word alone on a line), overlapping,
  too faint to read, words or capitals out of keeping;
- consistency: a control, colour or weight that doesn't match the same
  thing elsewhere in the window, or BeOS's way of doing it;
- anything else that looks unfinished or wrong.
Don't run commands or read files: look at the pictures. For each problem
say which picture, where in it, what's wrong, and what it should be. If
you find nothing, say so plainly; don't invent.

The pictures, in order: $names.
PROMPT
    if [ -n "$about" ]; then
        printf '\nWhat changed: %s\n' "$about"
    fi
} | codex exec -m gpt-6.2-astra -c 'model_reasoning_effort="medium"' -s read-only --skip-git-repo-check --color never "${images[@]}" -o "$out" - > "${out%.md}.log" 2>&1
rc=$?
if [ -s "$out" ]; then
    cat "$out"
else
    echo "codex-look: no answer (ended with $rc); see ${out%.md}.log" >&2
fi
exit $rc
