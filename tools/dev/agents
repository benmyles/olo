def session(name, cwd, env, program, native=None):
    """Where one agent's program runs, nothing of the person's screen in
    its reach: a child tab of the lead's Rex tab (`native`: what `olo
    agent start` is asked for, its agent first), or a tmux session of
    its own (`program`; one tmux server for them all, its options from
    CONF)."""
    if native and rex_here():
        args = ["start", *native[:1], "--name", name, "--title", name, "--cwd", cwd, "--desktop", "none", "--env", f"OLO_SUBAGENT={name}"]
        for e in env:
            args += ["--env", e]
        for u in UNSET:
            args += ["--unset-env", u]
        minded = os.environ.get("OLO_AGENTS_MINDER") != "off" and os.path.exists(MINDER_RULES)
        if minded:
            args += ["--minder", MINDER, "--rules", MINDER_RULES]
        r = olo(*args, "--json", *native[1:], check=True)
        try:
            said = json.loads(r.stdout)
        except ValueError:
            sys.exit(f"agents: olo agent start {name}: {r.stdout.strip() or r.stderr.strip()}")
        m = meta(name) or {}
        m.update({"via": "rex", "rex_id": said.get("id") or name, "window": said.get("window_id"), "minded": minded})
        save_meta(name, m)
