    env = ["env", *[x for u in UNSET for x in ("-u", u)], f"OLO_SUBAGENT={name}", *env]
    tmux("new-session", "-d", "-s", name, "-x", "200", "-y", "60", "-c", cwd, *env, *program, check=True)


def launch_opus(name, cwd, brief):
    """Opus 5.5, for a design review: the Claude CLI in a session here,
    able to read and write files in `cwd` and to do nothing else.
    (--restricted: no tool that runs anything, the file tools kept to
    that folder, and none of the person's settings, hooks or MCP
    servers; so nothing it does needs leave. The brief is its first
    message, after an option that takes no value: `--tools` and
    `--add-dir` take as many as follow them, and took the brief for a
    folder's name, 2026-11-22.)"""
    # (As a child tab its first message is short and names its brief's
    # file, written beside the pictures: its rules are a page.)
    first = f"Read {cwd}/brief.md (the rules, then what it is and what changed) and do what it says."
    session(name, cwd, [], ["claude", "--model", OPUS, "--effort", "max", "--restricted", "--strict-mcp-config", "--tools", "Read,Write",
                            "--permission-mode", "acceptEdits", "--disable-slash-commands", brief],
            native=["claude", "--model", OPUS, "--effort", "max", "--permission-mode", "acceptEdits", "--strict-mcp-config", "--prompt", first,
                    "--", "--restricted", "--tools", "Read,Write", "--disable-slash-commands"])


def launch_astra(name, cwd):
    """Astra 6.2 at high, for the look at pictures: the Codex CLI in a
    session here, drawn inline so its screen reads as text. It may write
    in `cwd` and nowhere else, has no network, and is never asked leave
    nor asks it (`-a never`: what its sandbox refuses is refused); none
    of the person's Codex hooks run, and it starts no agents. (`cwd` is
    said to be trusted for this run alone: unsaid, Codex asks whether to
    trust a folder it hasn't been in, and waits.)"""
    session(name, cwd, [], ["codex", "-m", ASTRA, "-c", 'model_reasoning_effort="high"', "-s", "workspace-write", "-a", "never",
                            "--disable", "multi_agent", "--disable", "multi_agent_v2", "--disable", "hooks", "--no-alt-screen", "-C", cwd,
