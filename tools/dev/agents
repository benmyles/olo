def allow():
    """Every prefix that goes ahead: Olo's tools as they are run, from
    the repository or by their whole path, with python or without."""
    out = READING + CARGO + GIT
    for t in TOOLS:
        for path in (f"tools/dev/{t}", f"./tools/dev/{t}", f"{ROOT}/tools/dev/{t}"):
            out += [path, f"/usr/bin/python3 {path}"]
    return out


def settings(folders, commands=True, own=()):
    """An agent's settings, for its run alone: its folders trusted (agy
    asks at its start otherwise, and waits), what it may run (nothing
    without asking, for one that only looks at pictures). In the
    folders that are its `own` (its folder here, an investigator's
    scratch) a command's output may be sent to a file unasked. (Not
    `rm` there: a rule matches a command by its whole words, so
    `command(rm FOLDER/)` allows nothing; a file removed there asks,
    and the minder says yes in seconds.)"""
    # (A look reads and no more: it listed its own folder of pictures,
    # and that waited on the minder.)
    yes = [f"command({c})" for c in (allow() if commands is True else READING if commands == "read" else [])]
    yes += [f"write_file({d})" for d in own] if commands is True else []
    return {"trustedWorkspaces": folders, "permissions": {"allow": yes, "deny": [f"command({c})" for c in DENY]}}


# The server's options, read whenever it starts (it ends with its last
# session): each pane kept once agy ends, to read; long histories.
CONF = "set-option -g remain-on-exit on\nset-option -g history-limit 200000\n"


def tmux(*args, check=False):
    conf = os.path.join(HOME, "tmux.conf")
    if not os.path.exists(conf):
        os.makedirs(HOME, exist_ok=True)
        open(conf, "w").write(CONF)
    r = subprocess.run(["tmux", "-L", SOCKET, "-f", conf, *args], capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"agents: tmux {' '.join(args)}: {r.stderr.strip()}")
    return r


def folder(name):
    return os.path.join(HOME, name)


def meta(name):
    try:
        return json.load(open(os.path.join(folder(name), "meta.json")))
    except (OSError, ValueError):
        return None


def save_meta(name, m):
    tmp = os.path.join(folder(name), "meta.json.new")
    json.dump(m, open(tmp, "w"), indent=1)
    os.replace(tmp, os.path.join(folder(name), "meta.json"))


def names():
    try:
        return sorted(n for n in os.listdir(HOME) if meta(n))
    except OSError:
        return []


def screen(name, lines=None):
    """Its screen as text (the last `lines` of its history, if given),
    less its banner."""
    args = ["capture-pane", "-p", "-J", "-t", f"={name}:0.0"]
    if lines:
        args[1:1] = ["-S", f"-{lines}"]
    r = tmux(*args)
    if r.returncode:
        return None
    return "\n".join(l for l in r.stdout.splitlines() if not BANNER.search(l)).rstrip()


def cli(name):
    """Which program it is: agy, or claude."""
    return (meta(name) or {}).get("cli", "agy")


def state(name):
    """gone, exited, asking, working or idle (its turn over, waiting)."""
    # (A session that isn't there: `display-message` answers nothing and
    # succeeds, and a bare name matches another's by its start; `=` is the
    # name exactly.)
    if tmux("has-session", "-t", f"={name}").returncode:
        return "gone"
    r = tmux("display-message", "-p", "-t", f"={name}:0.0", "#{pane_dead}")
    if r.returncode:
        return "gone"
    if r.stdout.strip() == "1":
        return "exited"
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    if any(ASKING[cli(name)] in l for l in lines[-14:]):
        return "asking"
    if lines and WORKING[cli(name)] in lines[-1]:
        return "working"
    # (Codex, codex-cli 0.171, drawn inline: "Working (12s • esc to
    # interrupt)" stands above its field and the line under that, so it
    # is never the last line.)
    if cli(name) == "codex" and any(WORKING["codex"] in l for l in lines[-8:]):
        return "working"
    # (agy with a message queued for it: its last line is about the
    # queue, "Press up to edit queued messages", and its spinner still
    # turns above the field. Read as idle, a look that was thinking was
    # reported finished, 2026-11-22.)
    if cli(name) == "agy" and any(SPINNER.match(l) for l in lines[-8:]):
        return "working"
    return "idle"


def asked(name):
    """What it asks, as it shows it, and its choices as (key, words)."""
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    end = max((i for i, l in enumerate(lines) if ASKING[cli(name)] in l), default=None)
    if end is None:
        return [], []
    # (The question: from the rule drawn above it, a line of ─.)
    start = max((i for i, l in enumerate(lines[:end]) if set(l.strip()) == {RULE}), default=max(0, end - 12)) + 1
    choices = [(m.group(1), m.group(2).strip()) for m in (re.match(r"^\s*[>❯]?\s*(\d)\.\s+(.*)$", l) for l in lines[start:end]) if m]
    return lines[start:end], choices


def progress(name):
    """A hash of what it has said, less what changes by itself."""
    s = screen(name, 400) or ""
    kept = "\n".join(l for l in s.splitlines() if not VOLATILE.search(l))
    return hashlib.sha1(kept.encode()).hexdigest()


def seen(name):
    """What you've looked at: `watch` says only what's new since."""
    m = meta(name)
    if m:
        m["seen"] = progress(name)
        m["seen_state"] = state(name)
        save_meta(name, m)


def live(n):
    return state(n) not in ("gone", "exited")


def refuse_nested():
    if os.environ.get("OLO_SUBAGENT"):
        sys.exit("agents: you are a subagent; you can't start or steer agents. Do your task, or stop and ask the lead.")


