def trusted_meta_path(name):
    if not NAMED.fullmatch(name or ""):
        sys.exit(f"agents: `{name}` isn't a helper's name (lowercase letters, digits and dashes; never a path)")
    return os.path.join(HOME, ".meta", f"{name}.json")


def trusted_meta(name):
    """Parent-owned helper metadata stored outside the helper's writable folder."""
    try:
        return json.load(open(trusted_meta_path(name)))
    except (OSError, ValueError):
        return None


def save_trusted_meta(name, m):
    meta_dir = os.path.join(HOME, ".meta")
    os.makedirs(meta_dir, mode=0o700, exist_ok=True)
    path = trusted_meta_path(name)
    tmp = f"{path}.new.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(m, f, indent=1)
    os.replace(tmp, path)


def delete_trusted_meta(name):
    with contextlib.suppress(OSError):
        os.remove(trusted_meta_path(name))


def subtree_ids(refresh=False):
    """`(owned, all_known, live_ids, me, owned_windows)` from `olo agent list
    --all --fast --json`, where `owned` contains strictly THIS tab's descendant
    tree (walked from `parent_window_id` when `parent_certain` is true). Returns
    None if the lookup fails or caller window identity is uncertain so callers
    fail closed and never tidy or claim another tab's helpers."""
    if not rex_here():
        return None
    if refresh or _SUBTREE_IDS[0] is None:
        r = olo("list", "--all", "--fast", "--json", timeout=40)
        try:
            said = json.loads(r.stdout) if r.returncode == 0 else None
        except ValueError:
            said = None
        if isinstance(said, dict) and isinstance(said.get("subagents"), list) and said.get("parent_certain") and said.get("parent_window_id"):
            subs = said["subagents"]
            me = said["parent_window_id"]
            all_known = {s.get("id") for s in subs if s.get("id")}
            live_ids = {s.get("id") for s in subs if s.get("id") and s.get("state") != "exited" and s.get("exited_at") is None}
            by_parent = {}
            for s in subs:
                by_parent.setdefault(s.get("parent_window_id"), []).append(s)
            owned, owned_wins, stack = set(), {me}, [me]
            while stack:
                w = stack.pop()
                for s in by_parent.get(w, ()):
                    sid = s.get("id")
                    if sid and sid not in owned:
                        owned.add(sid)
                        if s.get("window_id"):
                            owned_wins.add(s["window_id"])
                            stack.append(s["window_id"])
            _SUBTREE_IDS[0] = (owned, all_known, live_ids, me, owned_wins)
        else:
            _SUBTREE_IDS[0] = False
    return None if _SUBTREE_IDS[0] is False else _SUBTREE_IDS[0]


def is_ours(name, allow_trimmed=False):
    """Whether `name` belongs to this tab's subtree / repository checkout.
    Fails closed when ownership or checkout root is missing/uncertain so
    multiple leads sharing /var/tmp/olo-agents never touch each other's
    helpers. Only `sweep_builds`/`tidy` pass `allow_trimmed=True` so trimmed
    ended Rex records launched by THIS tab/subtree stay sweepable."""
    tm = trusted_meta(name)
    m = tm if tm is not None else (meta(name) or {})
    root = m.get("root")
    if not root or os.path.realpath(root) != os.path.realpath(ROOT):
        return False
    if m.get("via") == "rex":
        info = subtree_ids()
        if info is None:
            return False
        owned, all_known, _live_ids, _me, owned_wins = info
        rid = m.get("rex_id")
        if not rid:
            return False
        if rid in owned:
            return True
        if rid in all_known:
            return False
        if not (allow_trimmed and m.get("ended")):
            return False
        owner_win = m.get("owner_window")
        return owner_win is None or owner_win in owned_wins
    return True


@contextlib.contextmanager
def agents_lock():
    """Serialize helper admission and scratch folder lifecycle across
    concurrent leads/minders sharing HOME, refreshing subtree cache on entry."""
    os.makedirs(HOME, exist_ok=True)
    f = open(os.path.join(HOME, ".agents.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        _SUBTREE_IDS[0] = None
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def check_collision(name):
    """Refuse overwriting or removing any existing scratch directory not
    positively owned by this tab/checkout (including ended foreign records
    and directories missing readable metadata)."""
    d = folder(name)
    tm = trusted_meta(name)
    m = tm if tm is not None else meta(name)
    if m is None:
        if os.path.exists(d):
            sys.exit(f"agents: `{name}` already exists at {d} without readable metadata: inspect or remove it manually, or choose another name")
        return
    if is_ours(name):
        return
    who = m.get("root") or "another session"
    sys.exit(f"agents: `{name}` belongs to {who} ({d}): choose another name or set OLO_AGENTS_DIR")


def olo(*args, check=False, timeout=180):
    """`olo agent ARGS…`, asked of the host's agents service."""
    try:
        r = subprocess.run([OLO, "agent", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        r = subprocess.CompletedProcess([OLO, "agent", *args], 1, "", str(e))
    if check and r.returncode:
        sys.exit(f"agents: olo agent {' '.join(args[:2])}: {(r.stderr or r.stdout).strip()}")
    return r


def rex_here():
    """Whether a new agent here is a child tab of this pane's tab: in a
    Rex pane whose host answers `olo agent` by itself (asked once)."""
    if not _REX:
        ok = os.environ.get("OLO_AGENTS_VIA") != "tmux" and bool(os.environ.get("REX_BLOCK")) and os.path.exists(OLO)
        _REX.append(ok and olo("list", "--fast", "--json", timeout=40).returncode == 0)
    return _REX[0]


def via(name):
    """How it was started: "rex" (a child tab) or "tmux"."""
    return (meta(name) or {}).get("via", "tmux")


def child(name):
    """What `olo agent` knows it by: its id (a name is another's too,
    once this one has ended and one like it is started)."""
    return (meta(name) or {}).get("rex_id") or name


def press(name, key):
    """A key pressed in it (named as tmux names keys)."""
    if via(name) == "rex":
        # (As a key, never as text: text is pasted where the program
        # takes pastes, and a pasted "1" answers no question; and text is
        # refused while a child asks leave. A choice's own key is meant
        # (`--force`): which choice may be taken is this tool's to decide,
        # and it has, before it presses. The first approval of a child
        # tab went unanswered twice over, 2026-11-26.)
        olo("send", child(name), "--force", "--key", OLO_KEYS.get(key, key), check=True)
    else:
        tmux("send-keys", "-t", f"={name}:0.0", key, check=True)


def paste(name, text):
    """Text put in its field as one paste, so a new line in it is a new
    line and not a send."""
    if via(name) == "rex":
        olo("send", child(name), "--paste", "--text", text, check=True)
        return
    r = subprocess.run(["tmux", "-L", SOCKET, "load-buffer", "-b", "olo-say", "-"], input=text, text=True, capture_output=True)
    if r.returncode:
        sys.exit(f"agents: tmux load-buffer: {r.stderr.strip()}")
    tmux("paste-buffer", "-p", "-d", "-b", "olo-say", "-t", f"={name}:0.0", check=True)


def cursor_now():
    """Where the service's log of what happened stands (`watch --since`)."""
    try:
        return int(json.loads(olo("list", "--fast", "--json", timeout=40).stdout).get("cursor", 0))
    except (ValueError, TypeError, AttributeError):
        return 0


def wait_for_news(waited, cursor):
    """The wait between two looks at the agents `waited` (those still
    there). Child tabs: on `olo agent watch`, which returns the moment
    one of them asks, comes to rest, fails or ends, and after ten
    seconds otherwise (the loop's own clocks: a turn that is really
    over, one that shows nothing new); no screen is read meanwhile.
    With a tmux one among them, or the service not answering: five
    seconds, as it was. The cursor to wait from next."""
    ids = [child(n) for n in waited if via(n) == "rex"]
    if not ids or len(ids) != len(waited):
        time.sleep(5)
        return cursor
    r = olo("watch", *ids, "--since", str(cursor), "--on", "question,approval,idle,done,error,exit,escalation", "--timeout", "10", "--json", timeout=60)
    try:
        said = json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
    except ValueError:
        said = {}
    # (What a helper's minder hands back: kept for the lead, by the
    # helper's name here.)
    for event in ([said] if said.get("event") else []) + list(said.get("events") or []):
        if event.get("event") == "escalation":
            name = next((n for n in waited if child(n) in (event.get("id"), event.get("name"))), event.get("name"))
            ESCALATED[name] = (ESCALATED.get(name, "") + "\n" + str(event.get("last_message") or event.get("message") or event.get("text") or "")).strip()
    if r.returncode not in (0, 124) or "cursor" not in said:
        # (It couldn't be asked: never a loop that spins on a refusal.)
        time.sleep(5)
        return cursor
    return int(said["cursor"])


def tmux(*args, check=False):
    conf = os.path.join(HOME, "tmux.conf")
    if not os.path.exists(conf):
        os.makedirs(HOME, exist_ok=True)
        open(conf, "w").write(CONF)
    r = subprocess.run(["tmux", "-L", SOCKET, "-f", conf, *args], capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"agents: tmux {' '.join(args)}: {r.stderr.strip()}")
    return r


# A helper's name: one word of the tool's own kind, never a path.
NAMED = re.compile(r"[a-z0-9][a-z0-9-]{0,62}")


def folder(name):
    # (`forget` removes this folder whole, and a path given for a name
    # named any folder there is: an absolute one takes HOME's place in
    # the join, `..` climbs out of it. Checked here, where every command
    # that takes a name comes through. Found by a code review,
    # 2026-11-27, before anyone had pasted one.)
    if not NAMED.fullmatch(name or ""):
        sys.exit(f"agents: `{name}` isn't a helper's name (lowercase letters, digits and dashes; never a path)")
    return os.path.join(HOME, name)


def meta(name):
    try:
        return json.load(open(os.path.join(folder(name), "meta.json")))
    except (OSError, ValueError):
        return None


def save_meta(name, m):
    """(An agent's folder may go while this runs: a look's own front
    door removes it the moment its review is kept, and another
    invocation of this tool, tidying as it starts something, was
    writing there at that moment: `agents start` ended in a traceback
    and started nothing, 2026-11-27. A folder that is gone has nothing
    to be written down.)"""
    tmp = os.path.join(folder(name), f"meta.json.new.{os.getpid()}")
    try:
        with open(tmp, "w") as f:
            json.dump(m, f, indent=1)
        os.replace(tmp, os.path.join(folder(name), "meta.json"))
    except FileNotFoundError:
        if os.path.isdir(folder(name)):
            raise


def names():
    try:
        return sorted(n for n in os.listdir(HOME) if NAMED.fullmatch(n) and meta(n))
    except OSError:
        return []


def screen(name, lines=None):
    """Its screen as text (the last `lines` of its history, if given),
    less its banner."""
    if via(name) == "rex":
        # (All it has said where lines are asked for, the service's most
        # at once; else what it shows now.)
        r = olo("read", child(name), "--scrollback", "--lines", str(min(lines, 5000))) if lines else olo("read", child(name))
    else:
        args = ["capture-pane", "-p", "-J", "-t", f"={name}:0.0"]
        if lines:
            args[1:1] = ["-S", f"-{lines}"]
        r = tmux(*args)
    if r.returncode:
        return None
    return "\n".join(l for l in r.stdout.splitlines() if not BANNER.search(l)).rstrip()


def cli(name):
    """Which program it is: agy, or claude."""
    return (meta(name) or {}).get("cli", "agy")


def state(name):
    """gone, exited, starting (Claude Code asking to trust its own
    folder, which the tool answers: no one's question), asking, working
    or idle (its turn over, waiting)."""
    # (A session that isn't there: `display-message` answers nothing and
    # succeeds, and a bare name matches another's by its start; `=` is the
    # name exactly.)
    own_run = at_work = False
    if via(name) == "rex":
        # (The service's word for whether it is there and runs; what it
        # is doing is read from its screen here, as for a tmux one: the
        # lists of what may go ahead are this tool's.)
        r = olo("status", child(name), "--json")
        if r.returncode != 0:
            err_txt = (r.stderr or r.stdout or "").lower()
            if "not found" in err_txt or "no subagent" in err_txt or "unknown subagent" in err_txt:
                return "gone"
            return "unknown"
        try:
            said = json.loads(r.stdout)
        except ValueError:
            return "unknown"
        if not isinstance(said, dict):
            return "unknown"
        if said.get("state") == "exited" or said.get("running") is False:
            # (The service keeps a child it has stopped, as exited, where
            # tmux forgets a session it killed: one this tool has ended
            # already is gone, not to be ended and announced again at
            # every `list` and `watch`. A minder was told twenty times
            # that a helper's session had been closed, 2026-11-26.)
            return "gone" if (meta(name) or {}).get("ended") else "exited"
        # (Its turn ended on a run of its own that still goes, a test or
        # a build it will be woken by: the service knows, `waiting_on`.)
        # (But for what is the agent program's own: Codex keeps a helper
        # of its own for as long as it runs, `codex-code-mode-host`,
        # which the service told as the agent's run until 2026-11-27: a
        # reviewer that had written its review and said DONE read as
        # working for good, and its front door never saw it finish.)
        # (And its word that it is at work, where the screen as read
        # here doesn't say so: a Codex with a long message waiting in its
        # field, or between two of its steps, has its status line out of
        # the lines looked at below, or none; the service goes by its
        # conversation's file then. Read as idle here all the same, a
        # reviewer at work was told as "finished a turn", and DONE where
        # an earlier result stood: a code review, 2026-11-27.)
        at_work = said.get("state") == "working"
        runs = [str(b.get("cmd") or "") for b in said.get("background_shells") or []]
        own_run = said.get("waiting_on") == "own_run" and not (runs and all("codex-code-mode-host" in c or "/.codex/packages/" in c.split(" ")[0] for c in runs))
    else:
        if tmux("has-session", "-t", f"={name}").returncode:
            return "gone"
        r = tmux("display-message", "-p", "-t", f"={name}:0.0", "#{pane_dead}")
        if r.returncode:
            return "gone"
        if r.stdout.strip() == "1":
            return "exited"
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    # (Read as asking, a look starting on a new folder was shown to a
    # minder as a question for two seconds, 2026-11-25.)
    if cli(name) == "claude" and any("Yes, I trust this folder" in l for l in lines) and any(folder(name) in l for l in lines):
        return "starting"
    if any(ASKING[cli(name)] in l for l in lines[-14:]):
        return "asking"
    if lines and WORKING[cli(name)] in lines[-1]:
        return "working"
    # (Codex, codex-cli 0.171, drawn inline: "Working (12s • esc to
    # interrupt)" stands above its field and the line under that, so it
    # is never the last line.)
    if cli(name) == "codex" and any(WORKING["codex"] in l for l in lines[-8:]):
        return "working"
    # (agy with a message queued for it: its last line is about the
    # queue, "Press up to edit queued messages", and its spinner still
    # turns above the field. Read as idle, a look that was thinking was
    # reported finished, 2026-11-22.)
    if cli(name) == "agy" and any(SPINNER.match(l) for l in lines[-8:]):
        return "working"
    # (At rest on a run of its own: at work, to whoever waits on it. Read
    # as idle, a builder that waited two minutes on its own tests was told
    # to the lead as "finished a turn" at every watch, 2026-11-27. agy
    # says so in its footer, "1 task(s)": its tasks run under its own
    # daemon, where the service doesn't find them among its processes.)
    if cli(name) == "agy" and any(re.search(r"\b[1-9][0-9]* task\(s\)", l) for l in lines[-3:]):
        own_run = True
    return "working" if own_run or at_work else "idle"


def at_rest(name):
    """Whether the agents service itself says a child's turn is over
    (done, or idle with nothing asked): its own reading of the agent's
    conversation, where this tool reads the screen."""
    if via(name) != "rex":
        return False
    r = olo("status", child(name), "--json")
    try:
        said = json.loads(r.stdout) if r.returncode == 0 else {}
    except ValueError:
        said = {}
    return said.get("state") in ("done", "idle") and not said.get("approval")


def minded(name, m):
    """Whether a minder answers for it now: the service's own word where
    non-null, else this tool's record (`minded` set when launched under
    an `agy` minder with OLO_MINDER)."""
    if via(name) == "rex":
        r = olo("status", child(name), "--json")
        try:
            said = json.loads(r.stdout) if r.returncode == 0 else None
        except ValueError:
            said = None
        if isinstance(said, dict) and said.get("minder") is not None:
            return bool(said["minder"])
    return bool(m.get("minded"))


def asked(name):
    """What it asks, as it shows it, and its choices as (key, words)."""
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    end = max((i for i, l in enumerate(lines) if ASKING[cli(name)] in l), default=None)
    if end is None:
        return [], []
    # (The question: from the rule drawn above it, a line of ─.)
    start = max((i for i, l in enumerate(lines[:end]) if is_rule(l)), default=max(0, end - 12)) + 1
    choices = [(m.group(2), m.group(3).strip()) for m in (CHOICE.match(l) for l in lines[start:end]) if m]
    return lines[start:end], choices


# A choice of a question as an agent draws it: its mark where it has it
# (Claude Code's ❯, Antigravity's >, Codex's ›, which was missing here
# until 2026-11-27: Codex's marked choice wasn't read as one), its
# number, its words.
CHOICE = re.compile(r"^\s*([>❯›])?\s*(\d)\.\s+(.*)$")


def progress(name):
    """A hash of what it has said, less what changes by itself."""
    s = screen(name, 400) or ""
    kept = "\n".join(l for l in s.splitlines() if not VOLATILE.search(l))
    return hashlib.sha1(kept.encode()).hexdigest()


def seen(name):
    """What you've looked at: `watch` says only what's new since."""
    m = meta(name)
    if m:
        m["seen"] = progress(name)
        m["seen_state"] = state(name)
        save_meta(name, m)


def live(n):
    return state(n) not in ("gone", "exited")


