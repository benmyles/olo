def launch_astra_review(name, cwd):
    """Astra 6.2 at max, for a code review: the Codex CLI in a child tab
    (a tmux session where there is no Rex pane), working in `cwd`, its
    own folder. Its sandbox lets it read the disk and write only there,
    with no network; it is never asked leave nor asks it (`never`: what
    the sandbox refuses is refused), none of the person's Codex hooks
    run, and it starts no agents.

    "Only there" took two settings more than `workspace-write`: Codex
    adds /tmp and the folder TMPDIR names to what may be written, and
    TMPDIR here is /var/tmp, where the tree under review, the other
    helpers' folders and the kept reviews all are. Its own review found
    it (2026-11-27: "the reviewer can write to the tree it is
    reviewing"), and it was so: from the reviewer's sandbox a file was
    made in a neighbouring folder under /var/tmp and in /tmp; with the
    two exclusions both are refused and its own folder is written
    (`codex sandbox -c … -- sh -c 'touch …'`, how to check it again).
    Its temporary files go in a folder of its own."""
    first = f"Read {cwd}/brief.md (the rules, then what changed) and do what it says."
    os.makedirs(os.path.join(cwd, "tmp"), exist_ok=True)
    plain = ["--disable", "multi_agent", "--disable", "multi_agent_v2", "--disable", "hooks", "--no-alt-screen", "-c", f'projects."{cwd}".trust_level="trusted"',
             "-c", "sandbox_workspace_write.exclude_tmpdir_env_var=true", "-c", "sandbox_workspace_write.exclude_slash_tmp=true"]
    session(name, cwd, [f"TMPDIR={os.path.join(cwd, 'tmp')}"], ["codex", "-m", ASTRA, "-c", 'model_reasoning_effort="max"', "-s", "workspace-write", "-a", "never", *plain, "-C", cwd, first],
            native=["codex", "--model", ASTRA, "--effort", "max", "--sandbox", "workspace-write", "--approval", "never", "--prompt", first, "--", *plain])


def launch(name, d, cwd, others, target=None, commands=True, again=None):
    """An agy of its own in a tmux session, working in `cwd` (and
    reading `d`, its folder here, and `others`): started on its brief,
    with what it may run, and nothing of the person's screen in reach."""
    folders = list(dict.fromkeys([cwd, d, *others]))
    json.dump(settings(folders, commands, own=[d, *others]), open(os.path.join(d, "settings.json"), "w"), indent=1)
    env = [f"CARGO_TARGET_DIR={target}"] if target else []
    # (accept-edits: its edits go ahead, its commands by ALLOW and DENY,
    # the rest asks. Not agy's `auto` mode, which decides for itself what
    # is safe and runs it outside its sandbox when the sandbox refuses:
    # a `sudo -n true` went through unasked, tried 2026-11-22. The
    # settings are this run's alone, the person's neither read for the
    # lists nor written.)
    add = [a for x in folders[1:] for a in ("--add-dir", x)]
    first = f"Read {d}/brief.md (the rules, then your task) and do what it says."
    # (`again`: its own conversation taken up where it was left, by the
    # id its CLI knows it by, and told these words: `resume`.)
    taken_up = []
    if again:
        taken_up, first = ["--resume", again[0]], again[1]
    agy = ["agy", "--model", MODEL, *taken_up, "--mode", "accept-edits", "--settings", os.path.join(d, "settings.json"), *add, "-i", first]
    session(name, cwd, env, agy, native=["agy", "--model", MODEL, "--effort", MODEL.rsplit("-", 1)[-1], "--mode", "accept-edits",
                                         "--settings", os.path.join(d, "settings.json"), *add, *taken_up, "--prompt", first])


# Looks, code reviews and second investigators at once, apart from the
# workers. (Three until 2026-11-27: a change now has three reviewers,
# two of its pictures and one of its code, and every session on this
# computer counts in the same folder; a second session's two looks
# left room for one.)
HELPERS_MOST = 6
# The most diff a code review is given: what is more is generated, or a
# folder named by mistake, and is read into memory whole here.
REVIEW_MOST = 16 * 2**20


def room(name, program="agy", kind="worker"):
    """Refuse a name in use, or a sixth worker (CLAUDE.md's five
    subagents at once); those running. A look or a second investigator
    (`kind` "helper") is counted apart, three of them at most: a review
    waited on five translators, 2026-11-24."""
    if not shutil.which(program):
        sys.exit(f"agents: no {program} on PATH ({ {'agy': 'the Antigravity CLI', 'codex': 'the Codex CLI'}.get(program, 'the Claude CLI')}, signed in)")
    running = [n for n in names() if live(n)]
    if name in running:
        sys.exit(f"agents: {name} is running")
    # (One that has finished, its result written and its turn over, holds
    # no place: a minder told to start a queue of nine, five at a time and
    # stopping none, was refused the sixth by two that were done.)
    working = [n for n in running if not (finished(n) and state(n) == "idle")]
    # (A worker's meta names its crate; a look or an investigator's don't.)
    same = [n for n in working if bool((meta(n) or {}).get("crate")) == (kind == "worker")]
    most = MOST if kind == "worker" else HELPERS_MOST
    if len(same) >= most:
        what = "workers" if kind == "worker" else "looks and investigators"
        sys.exit(f"agents: {most} {what} are working ({', '.join(same)}): stop one first")
    return running


def start(name, crate, brief):
    refuse_nested()
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", name):
        sys.exit("agents: a NAME of lowercase letters, digits and dashes")
    crate_dir = os.path.normpath(os.path.join(ROOT, crate))
    # (A scope that isn't a crate, a data file or a folder of them: a
    # language's word catalog, say, five translated at once. Nothing of
    # it is built; its own task says how it is checked.)
    is_crate = os.path.isfile(os.path.join(crate_dir, "Cargo.toml"))
    if not is_crate and not os.path.exists(crate_dir):
        sys.exit(f"agents: no {crate} in the repository")
    if not is_crate and not os.path.realpath(crate_dir).startswith(os.path.realpath(ROOT) + os.sep):
        sys.exit(f"agents: {crate} is outside the repository")
    crate = os.path.relpath(crate_dir, ROOT)
    task = open(brief).read().strip()
    if not task:
        sys.exit("agents: the brief is empty")
    for n in room(name):
        other = meta(n).get("crate")
        if other and (other == crate or other.startswith(crate + "/") or crate.startswith(other + "/")):
            sys.exit(f"agents: {n} is working in {other}: one agent to a crate")
    package = next((l.split('"')[1] for l in open(os.path.join(crate_dir, "Cargo.toml")) if l.startswith("name")), crate) if is_crate else None
    d = folder(name)
    if os.path.exists(d):
        shutil.rmtree(d)
    os.makedirs(os.path.join(d, "target"))
    open(os.path.join(d, "task.md"), "w").write(task + "\n")
    rules = RULES.format(root=ROOT, crate=crate, package=package or "-", name=name, dir=d, approvals=APPROVALS)
    if not is_crate:
        # (Its scope a file or a folder, not a crate: the rules' crate words read for it.)
        rules = rules.replace(f"- Change files under {crate}/ only", f"- Change {crate} only (it isn't a crate: build nothing of Olo's unless the task says how it is checked)")
    open(os.path.join(d, "brief.md"), "w").write(rules + task + "\n")
    save_meta(name, {"crate": crate, "package": package, "started": time.time(), "seen": "", "seen_state": "", "done": os.path.join(d, "report.md")})
    launch(name, d, ROOT, [], os.path.join(d, "target"))
    print(f"agents: {name} started on {crate} ({package}); its folder is {d}")
    print(f"agents: now wait on `tools/dev/agents watch` to hear from it (a lead: in the background; a minder: `watch --for 2`)")


def investigate(brief, where, wait=True):
    """Start a second investigator on `brief` (or find the one started
    on it), then wait until it needs the lead or has answered; with
    `wait` false (`--no-wait`, a minder's way), start it and return: the
    minder's `watch` is the one wait, so each question is said once (a
    minder waiting with both was told each twice and started this again
    twelve times, 2026-11-24)."""
    refuse_nested()
    brief = os.path.abspath(brief)
    if not os.path.isfile(brief) or not open(brief).read().strip():
        sys.exit("usage: tools/dev/agy-help BRIEF.md [DIR]   (the brief: a file that says what's wrong and what's known)")
    work = os.path.abspath(where or os.path.dirname(brief))
    if work == "/tmp" or work.startswith("/tmp/"):
        sys.exit(f"agents: {work} is in RAM (/tmp); use a folder under /var/tmp")
    if not os.path.isdir(work):
        sys.exit(f"agents: no folder {work}")
    # (Its name: the folder's, so the same brief finds the same helper.)
    name = ("help-" + re.sub(r"[^a-z0-9]+", "-", os.path.basename(work).lower()).strip("-"))[:31].rstrip("-")
    m = meta(name)
    if not (m and m.get("work") == work and live(name)):
        room(name, kind="helper")
        d = folder(name)
        if os.path.exists(d):
            shutil.rmtree(d)
        os.makedirs(d)
        for old in ("answer.md",):
            if os.path.exists(os.path.join(work, old)):
                os.replace(os.path.join(work, old), os.path.join(work, old + ".before"))
        open(os.path.join(d, "brief.md"), "w").write(HELP_RULES.format(root=ROOT, dir=work, approvals=APPROVALS) + open(brief).read().strip() + "\n")
        save_meta(name, {"work": work, "started": time.time(), "seen": "", "seen_state": "", "done": os.path.join(work, "answer.md")})
        launch(name, d, ROOT, [work], os.path.join(work, "target"))
        print(f"agents: {name} started on {brief}; its answer will be {work}/answer.md, its notes {work}/notes.md", flush=True)
    else:
        print(f"agents: {name} is on it already" + ("; waiting for it" if wait else ""), flush=True)
    if not wait:
        print(f"agents: wait for {name} with `tools/dev/agents watch --only help-` (its questions, and DONE with {work}/answer.md)", flush=True)
        sys.exit(0)
    sys.exit(watch(15, only=name))


# How long an ended agent's builds are kept after the last of them.
BUILDS_KEPT = 24 * 3600


def last_build(target):
    """When anything was last built in `target`: the newest of its profile
    folders' own times and their build folders' (a build makes or renames
    something in one of them), None if it holds none."""
    times = []
    try:
        profiles = [e.path for e in os.scandir(target) if e.is_dir(follow_symlinks=False)]
    except OSError:
        return None
    for d in profiles:
        for sub in ("", "build", "deps", "examples", "incremental"):
            try:
                times.append(os.lstat(os.path.join(d, sub)).st_mtime)
            except OSError:
                pass
    return max(times) if times else None


def sweep_builds(now=None, home=None, is_live=None):
    """Remove target/ from every ended agent's folder whose last build is
    over a day old; what was removed, as (name, bytes). Never an agent's
    own doing (it has no business in another's folder)."""
    if os.environ.get("OLO_SUBAGENT"):
        return []
    now = time.time() if now is None else now
    home = HOME if home is None else home
    is_live = live if is_live is None else is_live
    gone = []
    try:
        agents = sorted(os.listdir(home))
    except OSError:
        return gone
    for n in agents:
        target = os.path.join(home, n, "target")
        # (A folder of ours: with its record, and a target/ that is a real
        # folder, not a link to somewhere else.)
        if not os.path.isfile(os.path.join(home, n, "meta.json")) or os.path.islink(target) or not os.path.isdir(target):
            continue
        built = last_build(target)
        if is_live(n) or (built is not None and now - built < BUILDS_KEPT):
            continue
        size = sum(os.lstat(os.path.join(d, f)).st_blocks * 512 for d, _, fs in os.walk(target) for f in fs)
        shutil.rmtree(target, ignore_errors=True)
        if not os.path.exists(target):
            gone.append((n, size))
    return gone


def say_swept(gone):
    for n, size in gone:
        print(f"agents: {n} ended over a day ago: its builds removed ({size / 2**30:.1f} GB; its report and the rest stay until `agents forget {n}`)", file=sys.stderr)


def look(args):
    """Start a look at pictures (or find the one started on them), wait
    until it needs the lead or has written its review, and print it.
    Gemini 4 Neon's look (at xhigh) at what's wrong by a pixel, or with
    `--by opus` Opus 5.5's review (at max) of the design itself.
    (`--by astra`: Astra 6.2's, by name only.)"""
    refuse_nested()
    # (Neon's by default, with Opus's beside it: Ben, 2026-11-25,
    # "everything should be either opus 5.5 max or neon 4 xhigh". Astra's
    # only when asked by name.)
    by, about = "gemini", ""
    while len(args) >= 2 and args[0] in ("--by", "--about"):
        if args[0] == "--by":
            by = args[1]
        else:
            about = args[1]
        args = args[2:]
    if by not in ("astra", "gemini", "opus"):
        sys.exit("agents: look [--by gemini], or --by opus (--by astra by name)")
    front = {"astra": "astra-look", "gemini": "agy-look", "opus": "opus-look"}[by]
    # (Codex not signed in on this computer: it would start at its sign-in
    # screen and wait there. Signing in is the person's: said at once.
    # The dev server, 2026-11-24.)
    if by == "astra":
        status = subprocess.run(["codex", "login", "status"], capture_output=True, text=True)
        if status.returncode != 0 or "Not logged in" in status.stdout + status.stderr:
            sys.exit("agents: Codex isn't signed in on this computer, so Astra can't look: the person signs in (`codex login`, or `codex login --device-auth` over SSH)")
    if not args or args[0].startswith("--"):
        sys.exit(f'usage: tools/dev/{front} [--about "WHAT IT IS, WHAT CHANGED"] PICTURE.png…')
    pictures = []
    for a in args:
        full = os.path.abspath(a)
        if full.startswith("/tmp/"):
            sys.exit(f"agents: {a} is in RAM (/tmp); keep pictures under /var/tmp")
        if not os.path.isfile(full) or not os.path.getsize(full):
            sys.exit(f"agents: no picture {a}")
        pictures.append(full)
    work = os.path.dirname(pictures[0])
    out = os.path.join(work, front + ".md")
    name = ({"astra": "astra-", "gemini": "agy-", "opus": "opus-"}[by] + re.sub(r"[^a-z0-9]+", "-", os.path.basename(work).lower()).strip("-"))[:31].rstrip("-")
    m = meta(name)
    if m and live(name) and (m.get("pictures"), m.get("about")) != (pictures, about):
        sys.exit(f"agents: {name} is looking at other pictures there: wait for it, or `tools/dev/agents stop {name}`")
    d = folder(name)
    review = os.path.join(d, "review.md")
    if not (m and live(name)):
        room(name, {"astra": "codex", "gemini": "agy", "opus": "claude"}[by], kind="helper")
        if os.path.exists(d):
            shutil.rmtree(d)
        os.makedirs(d)
        if os.path.exists(out):
            os.remove(out)
        # (It works in its folder here, on copies of the pictures: one
        # folder to read whatever folders they came from, nothing of the
        # project loaded, nothing of yours in its reach but them.)
        copies = []
        for i, pic in enumerate(pictures):
            base = os.path.basename(pic)
            if [os.path.basename(x) for x in pictures].count(base) > 1:
                base = f"{i + 1:02d}-{base}"
            subprocess.run(["cp", "--reflink=auto", pic, os.path.join(d, base)], check=True)
            copies.append(os.path.join(d, base))
        said = {"out": review, "pictures": "\n".join(copies)}
        # ("kept": where its front door puts the review once it is
        # written, beside the pictures: its own folder goes with it.)
        record = {"work": work, "pictures": pictures, "about": about, "started": time.time(), "seen": "", "seen_state": "", "done": review, "kept": out}
        if by == "astra":
            brief = LOOK_RULES.format(**said) + (f"\nWhat changed: {about}\n" if about else "")
            open(os.path.join(d, "brief.md"), "w").write(brief)
            save_meta(name, {**record, "cli": "codex"})
            launch_astra(name, d)
        elif by == "gemini":
            brief = LOOK_RULES.format(**said) + (f"\nWhat changed: {about}\n" if about else "")
            open(os.path.join(d, "brief.md"), "w").write(brief)
            save_meta(name, {**record, "cli": "agy"})
            launch(name, d, d, [], commands="read")
        else:
            brief = OPUS_RULES.format(**said) + (f"\nWhat it is, and what changed: {about}\n" if about else "")
            open(os.path.join(d, "brief.md"), "w").write(brief)
            save_meta(name, {**record, "cli": "claude"})
            launch_opus(name, d, brief)
        print(f"agents: {name} is looking at {len(pictures)} picture{'s' if len(pictures) != 1 else ''}; its review will be {out}", flush=True)
    else:
        print(f"agents: {name} is on them already; waiting for it", flush=True)
    rc = watch(15, only=name)
    if rc == 0:
        # (Done: its review beside the first picture and printed, what
        # it did kept beside that, and the session ended with its
        # folder, so it doesn't count among those running.)
        shutil.copyfile(review, out)
        if via(name) == "rex":
            # (All a child tab said is kept by the service as it stops
            # it: a read gives its last screen and little more, and the
            # first native look's log began partway through its review.)
            end(name)
            kept = os.path.join(d, "transcript.txt")
            if os.path.exists(kept):
                shutil.copyfile(kept, out[:-3] + ".log")
        else:
            open(out[:-3] + ".log", "w").write((screen(name, 200000) or "") + "\n")
        print(open(out).read().rstrip())
        end(name)
        shutil.rmtree(d, ignore_errors=True)
    sys.exit(rc)


def review(args):
    """Start a code review of a change (or find the one started on it),
    wait until it needs the lead or has written its review, and print
    it: Astra 6.2 at max, in the Codex CLI (Ben, 2026-11-27: "a code
    review from a codex subagent running astra 6.2 on max for all
    changes"). The change is a range of commits, or with `--working`
    what isn't committed (of the PATHs given, or everything)."""
    refuse_nested()
    about, tree, working, dry = "", ROOT, False, False
    while args and args[0] in ("--about", "--tree", "--working", "--dry-run"):
        if args[0] == "--dry-run":
            dry, args = True, args[1:]
        elif args[0] == "--working":
            working, args = True, args[1:]
        elif len(args) < 2:
            break
        elif args[0] == "--about":
            about, args = args[1], args[2:]
        else:
            tree, args = os.path.abspath(args[1]), args[2:]
    usage = ('usage: tools/dev/astra-review [--about "WHAT IT IS, WHAT CHANGED"] [--tree DIR] [--dry-run] FROM..TO [PATH…]\n'
             '       tools/dev/astra-review [--about …] [--tree DIR] [--dry-run] --working [PATH…]')
    if (not working and not args) or any(a.startswith("-") for a in args):
        sys.exit(usage)
    # (Git asked in bytes, each asking checked, its own diff and no
    # other: a name git quotes (`café.rs`) was passed back with the
    # quotes and its file left out of the review without a word; a
    # failed asking gave an empty part; a range that began with a dash
    # was an option to `git diff`. A code review of this tool,
    # 2026-11-27.)
    def git(*a, ok=(0,)):
        try:
            ran = subprocess.run(["git", "-C", tree, "--literal-pathspecs", "-c", "core.quotepath=off", *a], capture_output=True, stdin=subprocess.DEVNULL, timeout=120)
        except subprocess.TimeoutExpired:
            sys.exit(f"agents: git {a[0]} in {tree} hadn't answered in two minutes: nothing reviewed")
        if ran.returncode not in ok:
            sys.exit(f"agents: git {' '.join(a[:3])} in {tree}: {ran.stderr.decode(errors='replace').strip()[:300] or f'status {ran.returncode}'}")
        return ran.stdout
    def commit(rev):
        ran = subprocess.run(["git", "-C", tree, "rev-parse", "--verify", "--quiet", "--end-of-options", rev + "^{commit}"], capture_output=True, timeout=120)
        if ran.returncode:
            sys.exit(f"agents: no commit `{rev}` in {tree}")
        return ran.stdout.decode().strip()
    plain = ("--no-ext-diff", "--no-textconv")
    if working:
        of, paths = "what isn't committed", args
        head = commit("HEAD")
        diff = git("diff", *plain, head, "--", *paths)
        changed = git("diff", "--name-only", "-z", head, "--", *paths).split(b"\0")
        # (New files nobody has added yet: whole, as a diff shows them. By
        # a path that is plainly one: a file named `-` is standard input
        # to `git diff --no-index`.)
        for new in git("ls-files", "-z", "--others", "--exclude-standard", "--", *paths).split(b"\0"):
            if new:
                diff += git("diff", *plain, "--no-index", "--", "/dev/null", os.path.join(".", os.fsdecode(new)), ok=(0, 1))
                changed.append(new)
        commits = b""
        at = (f"It is of the working tree over commit {head}, read at {time.strftime('%H:%M:%S', time.gmtime())} UTC: others may be changing "
              "files there while you read, so where a file in the tree doesn't match the diff, go by the diff and say so.")
    else:
        of, paths = args[0], args[1:]
        ends = of.split("..")
        if len(ends) != 2 or not all(ends):
            sys.exit(f"agents: a range is FROM..TO, two commits (`{of}` isn't): for one commit, COMMIT^..COMMIT\n" + usage)
        first, last = commit(ends[0]), commit(ends[1])
        diff = git("diff", *plain, first, last, "--", *paths)
        changed = git("diff", "--name-only", "-z", first, last, "--", *paths).split(b"\0")
        commits = git("log", "--reverse", "--format=commit %h%n%n%s%n%n%b%n", f"{first}..{last}", "--", *paths)
        of = f"{first[:12]}..{last[:12]}"
        at = (f"The change ends at commit {last}: the tree may have moved on since, so read a file as it was reviewed with "
              f"`git -C {tree} show {last}:PATH`, and where the tree's copy differs from that, go by the commit.")
    if not diff.strip():
        sys.exit(f"agents: nothing to review ({of}" + (f", {' '.join(paths)}" if paths else "") + f" in {tree}: no difference)")
    if len(diff) > REVIEW_MOST:
        sys.exit(f"agents: {len(diff) / 2**20:.0f} MiB of diff ({of}): more than a review reads ({REVIEW_MOST // 2**20} MiB). Name the paths to be reviewed, or leave out what is generated")
    # (Named by what it reads, the diff's own bytes and nothing of how it
    # was asked for: the same change asked again, by its range or from
    # the working tree, is the same review.)
    digest = hashlib.sha256(diff).hexdigest()
    name = "astra-" + digest[:10]
    lines = diff.count(b"\n")
    if dry:
        # (What would be reviewed, and nothing started: the files as the
        # diff names them.)
        files = [os.fsdecode(f) for f in changed if f]
        print(f"agents: dry run: {name} would review {of}: {lines} lines of diff in {len(files)} files\n  " + "\n  ".join(files))
        return
    kept = os.path.join(REVIEWS, name)
    out = os.path.join(kept, "astra-review.md")
    os.makedirs(kept, mode=0o700, exist_ok=True)
    # One asking owns a review from its start to its keeping: two at
    # once each found "none running", and the second removed the folder
    # the first had just filled; or both waited, and both kept, stopped
    # and removed it. The second waits here for the first's, and reads
    # what it kept. (The lock is beside the kept review, not in the
    # folder that is removed.)
    lock = open(os.path.join(REVIEWS, f".{name}.lock"), "w")
    until, said_waiting = time.time() + 3 * 3600, False
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if not said_waiting:
                said_waiting = True
                print(f"agents: {name} is being waited for by another asking of this same review: waiting for theirs", flush=True)
            if time.time() > until:
                sys.exit(f"agents: three hours, and the other asking of {name} hasn't ended: look (tools/dev/agents list)")
            time.sleep(2)
    asked_file = os.path.join(kept, "asked.json")

    def kept_already():
        """The review of these very bytes, where one is kept whole."""
        if not whole(out):
            return False
        there = os.path.join(kept, "change.diff")
        if whole(there) and open(there, "rb").read() != diff:
            sys.exit(f"agents: {kept} holds the review of another change whose name begins the same ({digest[:10]}): move it aside and ask again")
        try:
            before = json.load(open(asked_file))
        except (OSError, ValueError):
            before = {}
        print(f"agents: this very change was reviewed already ({out}):", flush=True)
        if before.get("about") and before.get("about") != about:
            print(f"agents: (asked then with other words of it: {before['about'][:300]})", flush=True)
        print(open(out).read().rstrip())
        return True

    if kept_already():
        return
    m = meta(name)
    d = folder(name)
    written = os.path.join(d, "review.md")
    if not (m and live(name)):
        # (A review written whose front door ended before keeping it, or
        # whose reviewer had exited by the time it looked: kept now. The
        # same change asked again used to remove the folder, and the only
        # copy of the review with it.)
        if m and whole(written):
            publish(written, out)
            if whole(os.path.join(d, "transcript.txt")):
                publish(os.path.join(d, "transcript.txt"), out[:-3] + ".log")
            print(f"agents: {name} had written its review and it was never kept: kept now ({out}):", flush=True)
            print(open(out).read().rstrip())
            shutil.rmtree(d, ignore_errors=True)
            return
        # (Asked here, not at the start: a review that is kept is read
        # by a lead who isn't signed in, too.)
        if not shutil.which("codex"):
            sys.exit("agents: no codex on PATH (the Codex CLI, signed in): Astra can't review")
        status = subprocess.run(["codex", "login", "status"], capture_output=True, text=True)
        if status.returncode != 0 or "Not logged in" in status.stdout + status.stderr:
            sys.exit("agents: Codex isn't signed in on this computer, so Astra can't review: the person signs in (`codex login`, or `codex login --device-auth` over SSH)")
        room(name, "codex", kind="helper")
        if os.path.exists(d):
            shutil.rmtree(d)
        os.makedirs(d, mode=0o700)
        said = {"diff": os.path.join(d, "change.diff"), "commits": os.path.join(d, "commits.txt"), "tree": tree, "out": written, "at": at}
        open(said["diff"], "wb").write(diff)
        open(said["commits"], "wb").write(commits or b"(Not committed yet: there is no message. What the lead says of it is below.)\n")
        publish(said["diff"], os.path.join(kept, "change.diff"))
        json.dump({"of": of, "paths": paths, "tree": tree, "about": about, "sha256": digest, "asked": time.time()}, open(asked_file, "w"), indent=1)
        brief = REVIEW_RULES.format(**said) + (f"\nWhat it is, and what changed, in the lead's words: {about}\n" if about else "")
        open(os.path.join(d, "brief.md"), "w").write(brief)
        save_meta(name, {"work": kept, "review_of": of + (f" ({' '.join(paths)})" if paths else ""), "about": about, "started": time.time(), "seen": "", "seen_state": "", "done": written, "kept": out, "cli": "codex", "kind": "review"})
        launch_astra_review(name, d)
        print(f"agents: {name} is reviewing {of} ({lines} lines of diff); its review will be {out}", flush=True)
    else:
        print(f"agents: {name} is on it already; waiting for it", flush=True)
    rc = watch(20, only=name)
    # (Its review written, however the wait ended: an exited reviewer
    # with its review in its folder ended the wait with 1 and nothing
    # kept.)
    if rc == 0 or (whole(written) and not live(name)):
        screen_said = None if via(name) == "rex" else (screen(name, 200000) or "") + "\n"
        # (Ended once; no test sessions swept by its name: it may start
        # none, and another helper's name may begin with its own.)
        ended = end(name, sessions=False)
        publish(written, out)
        log = os.path.join(d, "transcript.txt")
        if screen_said is not None:
            open(log, "w").write(screen_said)
        if whole(log):
            publish(log, out[:-3] + ".log")
        print(open(out).read().rstrip())
        if ended:
            shutil.rmtree(d, ignore_errors=True)
        rc = 0
    sys.exit(rc)


def ago(t):
    s = int(time.time() - t)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def done_file(n):
    m = meta(n) or {}
    return m.get("done") or os.path.join(folder(n), "report.md")


def whole(path):
    """Whether `path` is a file of its own with something in it: not a
    link to another, not a folder, not empty."""
    try:
        st = os.lstat(path)
    except (OSError, TypeError):
        return False
    return stat.S_ISREG(st.st_mode) and st.st_size > 0


def finished(n):
    """Whether its result is written: a file with something in it,
    written since the lead last told it anything. (A builder given a
    second task was called DONE by its first task's report, each time
    its screen came to rest, while it worked on the second; and a file
    made and still empty passed for a result: 2026-11-27.)"""
    f = done_file(n)
    return whole(f) and os.lstat(f).st_mtime >= ((meta(n) or {}).get("said_at") or 0)


def list_():
    rows = names()
    if not rows:
        print("agents: none")
        return
    for n in rows:
        m = meta(n)
        st = state(n)
        # (Its turn over and its result written: done. Idle without it:
        # a question, or waiting to be told more.)
        st = "done" if st == "idle" and finished(n) else st
        # (In its first moments it shows its prompt before it has begun:
        # not a turn over. The watch waits as long for it.)
        st = "starting" if st == "idle" and time.time() - m.get("started", 0) < 30 else st
        on = m.get("crate") or (f"pictures ({m.get('work', '?')})" if m.get("pictures") else f"code ({m['review_of']})" if m.get("review_of") else f"a bug ({m.get('work', '?')})")
        done = f" {os.path.basename(done_file(n))}" if os.path.exists(done_file(n)) else ""
        print(f"{n:16} {st:8} {on:28} started {ago(m['started'])} ago{done}")


def shown(text, most=3000):
    return "\n".join(l for l in (text or "").splitlines() if l.strip())[-most:]


def trusts_own_folder(name):
    """Claude Code asking whether to trust the folder it was started in,
    where that is the agent's own here (the first time on a computer:
    once trusted, a folder is remembered): answered Yes by the tool, so a
    look started on a new computer doesn't wait on it (Opus's look,
    2026-11-24, on the dev server). Whether it answered."""
    if cli(name) != "claude":
        return False
    text = screen(name) or ""
    if "Yes, I trust this folder" not in text or folder(name) not in text:
        return False

    def marked():
        """The choice its mark stands on: "yes", "no", or None (the question is gone)."""
        for line in (screen(name) or "").splitlines():
            line = line.strip()
            if line.startswith("❯") and "Yes, I trust this folder" in line:
                return "yes"
            if line.startswith("❯") and "No, exit" in line:
                return "no"
        return None

    # Its choices are "❯ No, exit" then "Yes, I trust this folder", unnumbered,
    # and Enter takes the one the mark stands on. Answered by where the mark is
    # seen to stand, never by timing: the question takes no key in its first
    # moments (a Down pressed as it showed was lost, one 0.3 s later moved the
    # mark: tried, 2026-11-27), so "Down, wait, Enter" confirmed "No, exit" and
    # a look ended one second after its start, with nothing to say why.
    for _ in range(10):
        at = marked()
        if at == "yes":
            press(name, "C-m")
            print(f"agents: {name}: its own folder trusted ({folder(name)})")
            return True
        if at is None:
            return False
        press(name, "Down")
        time.sleep(0.3)
    print(f"agents: {name} asks whether to trust its own folder ({folder(name)}), and its mark wouldn't move to Yes: answer it (`agents keys {name} down enter`, once `agents peek {name}` shows the mark on Yes)")
    return False


def watch(stuck_min, only=None, at_most=None, among=None):
    """Return once an agent needs you; print who and why. With `only`,
    that one alone, and how to go on; 0 if it has answered. With
    `at_most`, after that many minutes if nothing has. With `among`, the
    agents whose names begin with one of those alone (a minder's own: one
    minder was woken over and over by another's agent asking leave)."""
    last = {}
    idle_since = {}
    asking_since = {}
    began = told = time.time()
    cursor = cursor_now() if rex_here() else 0
    while True:
        alerts = []
        waited = []
        # (Looked at before the time is up: a question that came in the
        # last moments was said as "nothing has needed you", and waited a
        # minute on a minder that took it at its word, 2026-11-24.)
        out_of_time = bool(at_most) and time.time() - began >= at_most * 60
        rows = [n for n in names() if only in (None, n) and (not among or any(n.startswith(p) for p in among))]
        if not any(state(n) in ("starting", "working", "asking", "idle") for n in rows):
            # (One waited for alone: how it ended, which "none running"
            # didn't say; a look stopped partway read as one that had
            # finished, a minder found, 2026-11-26.)
            if only and meta(only):
                result = done_file(only)
                if os.path.exists(result):
                    print(f"agents: {only} has ended; its result is {result}")
                else:
                    print(f"agents: {only} has ended WITHOUT its result ({result}): it was stopped, or its program exited; `tools/dev/agents log {only}` has what it said, if its folder is still there")
            else:
                print("agents: none running")
            return 1 if only else 0
        for n in rows:
            st = state(n)
            m = meta(n) or {}
            if st not in ("gone", "exited"):
                waited.append(n)
            if st == "starting":
                trusts_own_folder(n)
                continue
            # (What its minder handed back: the lead's, at once.)
            if n in ESCALATED:
                alerts.append((n, f"is handed back to you by its minder (answer it: tools/dev/agents approve {n} y|no, `answer`, `say`)", ESCALATED.pop(n)))
            elif st == "asking":
                # (One with a minder is its minder's to answer first: the
                # lead hears of it if the minder hands it back, or if it
                # still stands after a minute and a half.)
                has_minder = minded(n, m)
                if has_minder and time.time() - asking_since.setdefault(n, time.time()) < MINDER_HAS:
                    continue
                question = asked(n)[0]
                again = second_time(n, question)
                unanswered = " (its minder hasn't answered it)" if has_minder else ""
                alerts.append((n, f"asks you{unanswered} (tools/dev/agents approve {n} y|p|no, or `answer {n} N`)" + (f": {again}" if again else ""), "\n".join(question)))
            if st != "asking":
                asking_since.pop(n, None)
            if st == "asking" or n in ESCALATED:
                pass
            elif st == "exited" and m.get("seen_state") != "exited":
                # (One whose result is written has ended as it should: a
                # look's front door ends its session once the review is
                # kept, and a watcher that came by just after was told
                # "has exited", the word for a program that died, which
                # a minder's rules hand back as a failure, 2026-11-26.)
                result = next((f for f in (m.get("kept"), done_file(n)) if f and os.path.exists(f)), None)
                alerts.append((n, f"is DONE ({result})", "") if result else (n, "has exited", screen(n, 40)))
            elif st == "idle":
                # (A moment to start; and a turn that's really over, not
                # the gap between two steps.)
                if time.time() - m.get("started", 0) < 30:
                    continue
                if time.time() - idle_since.setdefault(n, time.time()) < 15:
                    continue
                p = progress(n)
                has_result = finished(n)
                # (One waited for alone that has its result is done,
                # whether or not it was looked at meanwhile.)
                if p != m.get("seen") or (only and has_result):
                    # (A look's review is named where it is kept: the file
                    # in its own folder is gone a moment after, with the
                    # folder, and a minder was pointed at nothing.)
                    said = f"is DONE ({m.get('kept') or done_file(n)})" if has_result else "finished a turn (a question, or waiting)"
                    alerts.append((n, said, screen(n, 40)))
                    if has_result and not only:
                        # (Said once: a watcher of several isn't called
                        # back by the same finished one at every wait.
                        # Not by a front door's wait for its one: that
                        # used up the notice a minder's watch was to
                        # get, and the minder waited on, 2026-11-24.)
                        seen(n)
            if st != "idle":
                idle_since.pop(n, None)
            if st == "working":
                p = progress(n)
                t, was = last.get(n, (time.time(), p))
                if p != was:
                    t = time.time()
                last[n] = (t, p)
                if time.time() - t >= stuck_min * 60:
                    alerts.append((n, f"has shown nothing new for {stuck_min} minutes while working", screen(n, 30)))
        if alerts:
            # (One waited for alone, and done: what it wrote is what its
            # front door prints, not its screen besides.)
            # (At rest by this tool's reading or by the service's own
            # word: its minder's "it has finished" came a moment before
            # the screen read as at rest, and a review's front door took
            # it for a question and ended without keeping the review.)
            over = bool(only) and finished(only) and (state(only) == "idle" or at_rest(only))
            for n, why, text in alerts:
                print(f"=== {n} {why}")
                if not over:
                    print(shown(text))
                    print()
            if only:
                if over:
                    return 0
                print(f"agents: {only} is waiting on you, which isn't a failure (the 3 this ends with says so): answer it (approve, answer, say), then run this again to go on waiting for it")
                return 3
            return 0
        if out_of_time:
            print(f"agents: nothing has needed you in {at_most} minutes; run it again to go on waiting")
            return 0
        if time.time() - told >= 60:
            told = time.time()
            say_tidied(tidy())
            for n in rows:
                if live(n):
                    print(f"… {n}: {state(n)}, {ago((meta(n) or {}).get('started', told))} since its start: {latest(n)}", flush=True)
        cursor = wait_for_news(waited, cursor)


def latest(name):
    """What it is doing, or the last of what it has said: above its field.
    Its spinner's line where one turns (the step it is on), else its last
    line but its plan's steps, done or to do (agy lists them under its
    work, "○ Write report.md": read as the latest, a worker on its second
    step of six looked stuck writing its report for ten minutes, a
    minder found, 2026-11-24)."""
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    if cli(name) == "codex":
        # (Codex draws no rules round its field: its last lines are the
        # field and two of status, and those were told as what it was
        # doing. What it does and says each begins with a bullet; while
        # it works, the last is "Working (12s • esc to interrupt)".)
        said = [l.strip() for l in lines if re.match(r"\s*•\s", l)]
        done = [l for l in said if WORKING["codex"] not in l]
        if said:
            return ((done[-1] + " · " if done else "") + (said[-1].lstrip("• ") if WORKING["codex"] in said[-1] else ""))[:160].rstrip(" ·")
    rules = [i for i, l in enumerate(lines) if is_rule(l)]
    said = [l for l in (lines[:rules[-2]] if len(rules) >= 2 else lines) if not re.match(r"\s*└ Tip:", l) and not NOTICE.search(l)]
    turning = [l for l in said if SPINNER.match(l)]
    if turning:
        return turning[-1].strip()[:160]
    said = [l for l in said if not re.match(r"\s*[○◯☐✓✔☑]\s", l)] or said
    return said[-1].strip()[:160] if said else ""


def peek(name, lines):
    # (Its last `lines` lines that say something: taken of a longer
    # stretch, since a screen's foot is mostly blank. Claude Code's last
    # forty lines were its spinner and its empty field, and a look at
    # work read as one doing nothing, 2026-11-26.)
    s = screen(name, max(lines * 6, 240))
    if s is None:
        sys.exit(f"agents: no {name}")
    print("\n".join([l for l in s.splitlines() if l.strip()][-lines:]))
    print(f"--- {name}: {state(name)}")
    seen(name)


def log(name):
    s = screen(name, 200000)
    if s is None:
        sys.exit(f"agents: no {name}")
    print(s)
    seen(name)


def field_of(text):
    """What a screen's field holds: the lines between the two rules that
    have the field between them, the nearest pair from the foot whose
    first line is a field's own (`>`, `\u276f`; agy's `!` and `:`).
    (Not "the last two rules": agy draws its running tasks under its
    field with a rule under them, and those were taken for the field,
    which then never looked empty: `say` pressed Enter four times and
    said the words were still there, 2026-11-27.)"""
    lines = [l for l in (text or "").splitlines() if l.strip()]
    rules = [i for i, l in enumerate(lines) if is_rule(l)]
    for upper, lower in reversed(list(zip(rules, rules[1:]))):
        inside = [l.strip() for l in lines[upper + 1:lower]]
        if inside and inside[0][:1] in (">", "\u276f", "!", ":"):
            held = " ".join(inside)[1:].strip()
            # (Empty, it shows its mode's hint there.)
            return "" if "shift+tab to cycle" in held else held
    return ""


def field(name):
    return field_of(screen(name))


def say(name, text, now=False):
    """A message to it. While it works, its program queues the message
    for the end of the step it is on; `now` has it delivered at once
    (agy: alt+m), which is what stops a long think."""
    refuse_nested()
    st = state(name)
    if st in ("gone", "exited"):
        sys.exit(f"agents: {name} isn't running")
    if st == "asking":
        sys.exit(f"agents: {name} is asking you something: answer that first (agents approve {name} y|p|no, agents answer {name} N)")
    # (When it was last told anything, written down before the words go:
    # a result written before that is of what it was asked before
    # (`finished`), and one written a moment after must count.)
    m = meta(name)
    if m is not None:
        m["said_at"] = time.time()
        save_meta(name, m)
    # (As one paste, so a new line in it is a new line and not a send;
    # then Enter by itself, a moment later.)
    paste(name, text)
    time.sleep(0.5 + len(text) / 1500)
    # (Enter once, and its field waited for: pressed again only where the
    # field is seen to hold these very words still, and then once. It was
    # pressed up to four times, a second and a half apart, for as long as
    # anything at all stood where the field was looked for: on a busy
    # computer the later ones went into whatever the program showed next.)
    words = " ".join(text.split())[:24]

    def sent(within):
        until = time.time() + within
        while time.time() < until:
            held = field(name)
            if not held or words not in " ".join(held.split()):
                return True
            time.sleep(0.4)
        return False

    press(name, "C-m")
    if not sent(6):
        press(name, "C-m")
        if not sent(6):
            sys.exit(f"agents: said to {name}, but its field still holds the words: look (agents peek {name})")
    queued = "to send immediately" in "\n".join((screen(name) or "").splitlines()[-12:])
    if queued and now:
        press(name, "M-m")
        time.sleep(1.0)
    seen(name)
    print(f"agents: said to {name}" + ("" if not queued else " (delivered at once)" if now else f": queued until the step it is on ends (`agents say {name} --now …` delivers at once)"))


def service_asks(name):
    """What the agents service reads of what a child asks: the question,
    its choices each with its number, its whole label and what it means
    (`kind`), and the box's own key; None where it reads no question it
    would answer (a box it can't read for certain is one)."""
    r = olo("status", child(name), "--json")
    try:
        said = json.loads(r.stdout) if r.returncode == 0 else {}
    except ValueError:
        said = {}
    return said.get("approval") or None


def answer(name, how):
    """Answer what it asks: y, p, no, or the number of a choice.

    A child tab is answered by the agents service and by nothing else:
    the choice is the service's own reading of the box (each choice
    whole, with what it means), the answer is asked for by its meaning
    and for that very box (`olo agent approve --once|--session|--no
    --box KEY`: the service moves the mark, sees it on the choice, and
    only then presses Return; another box that stands by then is not
    answered), and where the service declines, nothing is done here.
    This tool used to read the choices off the screen itself, a line
    each, and where the service declined it counted rows down from the
    first and pressed Return: a label wrapped onto a second line lost
    its "(Persist to settings.json)" and passed for a choice that keeps
    nothing; with the mark elsewhere it confirmed whatever the mark
    stood on (two code reviews, 2026-11-27). A choice that keeps
    something for good, or changes the agent's mode, is not given from
    here: in its tab, by the person or by the lead with `agents keys`
    once its mark has been seen."""
    refuse_nested()
    if state(name) != "asking":
        sys.exit(f"agents: {name} isn't asking for anything ({state(name)})")
    text, choices = asked(name)
    print("\n".join(text))
    again = second_time(name, text)
    if again:
        print(f"agents: {again}")
    kind = {"y": "once", "yes": "once", "p": "allow_session", "no": "no", "n": "no"}.get(how)
    if not how.isdigit() and not kind:
        sys.exit("agents: approve with y, p or no; or `answer NAME N` for the Nth choice")
    before = screen(name, 400) or ""
    if via(name) == "rex":
        ap = service_asks(name)
        if not ap:
            sys.exit(f"agents: the agents service reads no question of {name}'s that it would answer (a box it can't read for certain, or none any more): nothing done. Look (agents peek {name}); answer in its tab, or with `agents keys {name} …` once you have seen where its mark stands")
        mine = next((c for c in ap.get("choices", []) if (str(c.get("number")) == how if how.isdigit() else c.get("kind") == kind)), None)
        if not mine:
            sys.exit(f"agents: no such choice in what {name} asks, as the service reads it ({', '.join(str(c.get('number')) + ' ' + str(c.get('kind')) for c in ap.get('choices', []))}): look (agents peek {name})")
        flag = {"once": "--once", "allow_session": "--session", "no": "--no"}.get(mine.get("kind"))
        if not flag:
            sys.exit(f"agents: that choice ({mine.get('number')}. {str(mine.get('label'))[:120]}) is one that {'is kept for good' if mine.get('kind') == 'dont_ask_again' else 'changes the agent’s mode' if mine.get('kind') == 'switch_mode' else 'the service has no word for'}: not from here (y allows this once)")
        r = olo("approve", child(name), flag, *(["--box", ap["box"]] if ap.get("box") else []), "--json")
        said = f"{mine.get('number')}. {mine.get('label')}"
        if r.returncode != 0:
            # (What the service did before it gave up is its to say: it
            # may have moved the mark, or pressed Escape.)
            print(f"agents: the service didn't answer {name} ({(r.stderr or r.stdout).strip()[:400]}): look (agents peek {name}) before answering again", file=sys.stderr)
            return 4
    else:
        pick = next((c for c in choices if c[0] == how), None) if how.isdigit() else None
        if not how.isdigit():
            # (agy 1.5.14: "Yes, run command"; "Yes, and always allow in this
            # conversation for commands that start with '…'"; the same
            # "(Persist to settings.json)"; "No, cancel".)
            want = {"once": lambda w: w.startswith("Yes") and "always" not in w and "auto mode" not in w,
                    "allow_session": lambda w: w.startswith("Yes") and "in this conversation" in w,
                    "no": lambda w: w.startswith("No")}[kind]
            pick = next((c for c in choices if want(c[1])), None)
        if not pick:
            sys.exit(f"agents: no such choice in what {name} asks: look (agents peek {name}), and answer with `agents answer {name} N`, or where its choices have no numbers move to one and confirm (`agents keys {name} down enter`)")
        # (In tmux a choice is taken by its own key, a digit; its label is
        # read with the lines under it, where its words go on.)
        if any(x in whole_label(text, pick[0]) for x in SAVES):
            sys.exit("agents: that choice changes the person's own settings or the agent's mode: not from here (y allows this once)")
        press(name, pick[0])
        said = pick[1]
    # (Whether it took: its screen moves on. The same question again after
    # that is a second asking, not this one left up: an agent that ran a
    # script asked to run it again, and the minder took it for an answer
    # that hadn't taken, 2026-11-24.)
    until = time.time() + 3
    while (screen(name, 400) or "") == before and time.time() < until:
        time.sleep(0.2)
    seen(name)
    m = meta(name)
    if m is not None:
        m["answered"] = {"text": "\n".join(text), "at": time.time()}
        save_meta(name, m)
    print(f"agents: answered {name}: {said}")
    if (screen(name, 400) or "") == before:
        print(f"agents: {name}'s screen hasn't changed since: look (agents peek {name}) before answering again")
        return 4
    time.sleep(0.5)
    if state(name) == "asking" and asked(name)[0] == text:
        print(f"agents: {name} asks the same again: a second time (its screen moved on in between), to be answered as one")


def whole_label(text, number):
    """A choice's words with the lines under it that go on with them, to
    the next choice: as the question's lines show them."""
    out, on = [], False
    for l in text:
        m = CHOICE.match(l)
        if m:
            on = m.group(2) == number
            if on:
                out.append(m.group(3).strip())
        elif on:
            out.append(l.strip())
    return " ".join(out)


def second_time(name, question):
    """Said where an agent asks what it was answered before: it ran that,
    and asks to run it again (a script run twice), a new question to be
    answered as one, not the first left up. (Seen only after `approve`
    had returned: the second asking came two seconds after the first was
    answered, 2026-11-24.)"""
    before = (meta(name) or {}).get("answered") or {}
    if question and before.get("text") == "\n".join(question):
        return f"the same as it asked {int(time.time() - before.get('at', time.time()))} s ago and was answered: a second time, to be answered as one"
    return None


KEYS = {"up": "Up", "down": "Down", "left": "Left", "right": "Right", "enter": "C-m", "esc": "Escape", "escape": "Escape", "tab": "Tab", "space": "Space"}


def keys(name, which):
    """Press keys in it, one after another: for a question whose choices
    have no numbers (move to one and confirm), or to cancel what it's
    doing (esc)."""
    refuse_nested()
    if not live(name):
        sys.exit(f"agents: {name} isn't running")
    send = [KEYS.get(k.lower()) or (k if re.fullmatch(r"[0-9a-z]", k) else None) for k in which]
    if None in send:
        sys.exit(f"agents: keys are {', '.join(KEYS)}, a digit or a letter")
    for k in send:
        press(name, k)
        time.sleep(0.3)
    time.sleep(0.5)
    print("\n".join(l for l in (screen(name, 16) or "").splitlines() if l.strip()))
    print(f"--- {name}: {state(name)}")
    seen(name)


def end(name, sessions=True):
    """End its session, whatever state it is in: what it said kept in
    its folder (transcript.txt) first, and any headless test session it
    left running (it names them agy-NAME…) stopped with it (`sessions`:
    not for a code reviewer, which may start none, and whose name may be
    the start of another helper's). Whether it is ended: a child the
    service wouldn't stop is said, and its record isn't marked ended
    (it was, and its folder removed, with the child still running: a
    code review, 2026-11-27)."""
    d = folder(name)
    ended = True
    # (A code reviewer's is never swept, whoever ends it: `stop`, the
    # tidy and its own front door alike.)
    sessions = sessions and not (meta(name) or {}).get("review_of")
    if via(name) == "rex":
        # (The service keeps all it said as it stops it; its tab closes.)
        kept = ["--save", os.path.join(d, "transcript.txt")] if os.path.isdir(d) else []
        # (What its CLI knows its conversation by, kept while the service
        # still says: its record there is trimmed in time, and `resume`
        # then has only this to take the conversation up by.)
        seen_by = olo("status", child(name), "--json")
        try:
            its = json.loads(seen_by.stdout).get("cli_session_id") if seen_by.returncode == 0 else None
        except ValueError:
            its = None
        m0 = meta(name)
        if its and m0 is not None and m0.get("cli_session") != its:
            m0["cli_session"] = its
            save_meta(name, m0)
        if state(name) != "gone":
            r = olo("stop", child(name), "--force", "--json", *kept)
            # (Its own word that it ended: it answers without an error and
            # `ended: false` where its program outlived the time it gave it.)
            try:
                stopped = json.loads(r.stdout) if r.returncode == 0 else {}
            except ValueError:
                stopped = {}
            still = stopped.get("ended") is False
            # (The stop's own answer has the conversation's id where the
            # status before it had none yet: an agy stopped as it began
            # its first conversation. A code review, 2026-11-27.)
            its = stopped.get("cli_session_id")
            m0 = meta(name)
            if its and m0 is not None and m0.get("cli_session") != its:
                m0["cli_session"] = its
                save_meta(name, m0)
            if (r.returncode != 0 or still) and state(name) not in ("gone", "exited"):
                ended = False
                print(f"agents: {name} couldn't be stopped ({(r.stderr or r.stdout).strip()[:200]}): it runs still; `olo agent stop {child(name)}` and look", file=sys.stderr)
    else:
        text = screen(name, 200000)
        if text and os.path.isdir(d):
            open(os.path.join(d, "transcript.txt"), "w").write(text + "\n")
        tmux("kill-session", "-t", f"={name}")
    tsession = os.path.join(ROOT, "tools/dev/tsession")
    try:
        listed = subprocess.run(["/usr/bin/python3", tsession, "list"], capture_output=True, text=True, timeout=20).stdout if sessions else ""
        for line in listed.splitlines():
            its = line.split()
            if its and (its[0] == f"agy-{name}" or its[0].startswith(f"agy-{name}-")) and "ended" not in its[1:]:
                subprocess.run(["/usr/bin/python3", tsession, "stop", its[0]], capture_output=True, timeout=60)
                print(f"agents: stopped {name}'s test session {its[0]}", file=sys.stderr)
    except (OSError, subprocess.SubprocessError):
        pass
    m = meta(name)
    if m and ended:
        m["seen_state"] = "exited"
        m["ended"] = time.time()
        save_meta(name, m)
    return ended

def stop(name):
    refuse_nested()
    end(name)
    print(f"agents: {name} stopped; its folder {folder(name)} stays (its report or answer, its brief, transcript.txt)")


# An agent nobody needs any more is ended, not left at its prompt (Ben,
# 2026-11-22: "make sure that the tmux agents / screens are getting
# properly stopped when they are no longer needed"): one whose program
# has exited; one that wrote its result this long ago and has sat since;
# one that has sat idle without a result this long. Its folder (result,
# transcript) stays; a folder whose agent ended this long ago goes too.
DONE_KEPT = 30 * 60
IDLE_KEPT = 3 * 3600
FOLDER_KEPT = 7 * 24 * 3600


def tidy(now=None):
    """End what is no longer needed; what was done, as lines to print."""
    if os.environ.get("OLO_SUBAGENT"):
        return []
    now = time.time() if now is None else now
    said = []
    for n in names():
        # (Every session on this computer keeps its helpers in this one
        # folder, and another's may be forgotten between the listing and
        # the look at it: a review's front door ended on exactly that,
        # its reviewer still at work with nothing waiting on it,
        # 2026-11-27. One that has gone is nothing to tidy.)
        try:
            tidy_one(n, now, said)
        except OSError:
            continue
    return said


def tidy_one(n, now, said):
    m = meta(n) or {}
    st = state(n)
    if st == "exited":
        end(n)
        said.append(f"{n}: its program had ended; its session closed (transcript.txt in {folder(n)})")
    elif st == "idle":
        p = progress(n)
        if p != m.get("still"):
            m["still"], m["still_since"] = p, now
            save_meta(n, m)
            return
        sat = now - m.get("still_since", now)
        has_result = finished(n)
        if (has_result and sat >= DONE_KEPT) or sat >= IDLE_KEPT:
            end(n)
            said.append(f"{n}: {'done' if has_result else 'idle'} and untouched for {int(sat // 60)} minutes; stopped (its folder {folder(n)} stays)")
    elif st == "gone":
        ended = m.get("ended") or os.path.getmtime(os.path.join(folder(n), "meta.json"))
        if now - ended >= FOLDER_KEPT:
            # (What it wrote is kept first, as `forget` keeps it.)
            kept = keep_result(n)
            shutil.rmtree(folder(n), ignore_errors=True)
            said.append(f"{n}: ended over a week ago; its folder removed" + (f" (its result kept at {kept})" if kept else ""))
    return said


def say_tidied(said):
    for line in said:
        print(f"agents: {line}", file=sys.stderr)


def publish(src, dst):
    """A result put where it is kept, whole or not at all: read from a
    file of its own (never through a link), written beside its place
    under another name and moved there in one step, so a disk that
    fills or a copy cut short leaves no half of a review under the
    review's name (which the next asking would have served as the
    review, and `forget` taken for it kept). A link standing at `dst`
    is replaced, not written through. For the person alone to read."""
    if not whole(src):
        raise OSError(f"{src} isn't a file with something in it")
    data = open(src, "rb").read()
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    part = f"{dst}.{os.getpid()}.part"
    with contextlib.suppress(FileNotFoundError):
        os.remove(part)
    with os.fdopen(os.open(part, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(part, dst)


def keep_result(name):
    """A look's or a review's result put where it is kept (beside the
    pictures, with the diff) if its front door never got to: the path,
    or None where there is nothing to keep or it is kept already, whole
    (the same bytes: an empty or a shorter file at its place is not it
    kept). Where another result stands there, both are kept."""
    m = meta(name) or {}
    written, kept = m.get("done"), m.get("kept")
    if not (written and kept) or not whole(written):
        return None
    # (Its record is in its own folder, which it can write: what it
    # names is believed only as far as a result of its own, in its own
    # folder, going to a place outside the repository.)
    inside = lambda path, root: os.path.realpath(path).startswith(os.path.realpath(root) + os.sep)
    if not inside(written, folder(name)) or inside(kept, ROOT):
        print(f"agents: {name}'s record names {written} to be kept at {kept}: not its own result, or a place in the repository; nothing kept", file=sys.stderr)
        return None
    if whole(kept):
        if open(kept, "rb").read() == open(written, "rb").read():
            return None
        root, ext = os.path.splitext(kept)
        kept = f"{root}.{int(os.lstat(written).st_mtime)}{ext}"
    publish(written, kept)
    return kept


def resume(name, text, result=None, session=None):
    """A helper that was stopped, brought back with its conversation and
    told `text` (`olo agent resume`: started again with what it was
    started with, in its own session of its CLI), with a minder as at
    its start; `result`, the file it is to write this time (its report
    of the task before is not this one's). A builder is stopped when its
    task is done, to give its tabs back, and what its work is found to
    need comes after: its second pass is its own to make, knowing what
    it knows (2026-11-27: done by hand the first time, its record here
    left pointing at the child that had ended)."""
    refuse_nested()
    m = meta(name)
    if not m:
        sys.exit(f"agents: no {name} here to bring back (tools/dev/agents list)")
    if live(name):
        sys.exit(f"agents: {name} is running: `agents say {name} …` tells it more")
    if via(name) != "rex" or not rex_here():
        sys.exit(f"agents: {name} was a tmux session, or this isn't a Rex pane: only a child tab can be brought back with its conversation; start it anew with a brief that says what it did")
    # (Told from here on: what it writes while the service still answers
    # this asking is written since. Taken after, a quick helper's result
    # was "from before" for good. A code review, 2026-11-27.)
    told_at = time.time()
    r = olo("resume", child(name), "--prompt", text, "--json")
    try:
        said = json.loads(r.stdout) if r.returncode == 0 else {}
    except ValueError:
        said = {}
    if not said.get("id"):
        # The service keeps an ended child's record only so long (its
        # list is trimmed as children come and go: two builders stopped
        # in the morning had none by noon, 2026-11-27). The conversation
        # itself is the CLI's, by its own id: a worker is started anew on
        # it, as at its start (its folder, its settings, its builds).
        session = session or m.get("cli_session")
        if not (session and m.get("crate")):
            sys.exit(f"agents: {name} couldn't be brought back ({(r.stderr or r.stdout).strip()[:300]})" + ("" if session else f"; and its conversation's id isn't known here: `agents resume {name} --session ID …` with it (the service's events.jsonl has it as cli_session_id), or start it anew with a brief that says what it did"))
        d = folder(name)
        launch(name, d, ROOT, [], os.path.join(d, "target"), again=(session, text))
        m = meta(name)
        m.update({"seen": "", "seen_state": "", "said_at": told_at, "cli_session": session})
        m.pop("ended", None)
        if result:
            m["done"] = os.path.abspath(result)
        save_meta(name, m)
        print(f"agents: {name} is back, by its conversation's own id (the service had its record no more), and told; now wait on `tools/dev/agents watch`")
        return
    minded = os.environ.get("OLO_AGENTS_MINDER") != "off" and os.path.exists(MINDER_RULES)
    # (Brought back with what it was started with, a minder too: the
    # service says which in its answer. Asked for another on top, the one
    # just started was stopped for it. A code review, 2026-11-27.)
    if minded and said.get("minder") and not said.get("minder_error"):
        pass
    elif minded:
        asked = olo("mind", said["id"], "--with", MINDER, "--rules", MINDER_RULES, "--json")
        if asked.returncode != 0:
            print(f"agents: {name} runs WITHOUT a minder ({(asked.stderr or asked.stdout).strip()[:200]}): what it asks comes to you; `olo agent mind {said['id']} --with {MINDER} --rules {MINDER_RULES}` once there is room", file=sys.stderr, flush=True)
            minded = False
    m.update({"rex_id": said["id"], "window": said.get("window_id"), "minded": minded, "seen": "", "seen_state": "", "said_at": told_at})
    m.pop("ended", None)
    if result:
        m["done"] = os.path.abspath(result)
    save_meta(name, m)
    print(f"agents: {name} is back with its conversation, and told; now wait on `tools/dev/agents watch`")


def forget(name):
    refuse_nested()
    if live(name):
        sys.exit(f"agents: {name} is running: stop it first")
    # (What it wrote is kept before its folder goes. A review's front
    # door had ended early, its review still in the folder alone, and
    # the folder was removed with it: put back from the lead's own
    # reading of it, 2026-11-27.)
    kept = keep_result(name)
    if kept:
        print(f"agents: {name}'s result wasn't kept yet: it is now, at {kept}")
    # (A helper's own folder, which has its record: never a folder that
    # only bears a name. And what couldn't be removed is said.)
    where = folder(name)
    if not os.path.isfile(os.path.join(where, "meta.json")) or os.path.islink(where):
        sys.exit(f"agents: {name} isn't a helper of this tool's ({where} has no record of one): nothing removed")
    left = []
    shutil.rmtree(where, onerror=lambda _f, path, _e: left.append(path))
    print(f"agents: {name}'s folder removed" if not left else f"agents: {name}'s folder couldn't be removed whole ({len(left)} left, the first {left[0]})")


def allowed():
    print("Goes ahead without asking (a command that starts so; several piped or joined, when each does):")
    print("  " + "\n  ".join(allow()))
    print("Refused without asking:")
    print("  " + "\n  ".join(DENY))
    print("Anything else asks the lead.")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = a[0], a[1:]
    # (Not before a dry run, which changes nothing: it stopped idle
    # helpers and removed old builds on its way to saying what a review
    # would read.)
    if cmd in ("start", "list", "watch", "investigate", "look", "review", "tidy") and "--dry-run" not in rest:
        say_swept(sweep_builds())
        say_tidied(tidy())
    if cmd == "start" and len(rest) == 3:
        start(*rest)
    elif cmd == "investigate" and len([r for r in rest if r != "--no-wait"]) in (1, 2):
        given = [r for r in rest if r != "--no-wait"]
        investigate(given[0], given[1] if len(given) > 1 else None, wait="--no-wait" not in rest)
    elif cmd == "look":
        look(rest)
    elif cmd == "review":
        review(rest)
    elif cmd == "list":
        list_()
    elif cmd == "watch":
        among = [p for p in rest[rest.index("--only") + 1].split(",") if p] if "--only" in rest else None
        watch(int(rest[rest.index("--stuck") + 1]) if "--stuck" in rest else 15, at_most=int(rest[rest.index("--for") + 1]) if "--for" in rest else None, among=among)
    elif cmd == "peek" and rest:
        peek(rest[0], int(rest[1]) if len(rest) > 1 else 60)
    elif cmd == "log" and rest:
        log(rest[0])
    elif cmd == "say" and len(rest) >= 3 and rest[1] == "--now":
        say(rest[0], " ".join(rest[2:]), now=True)
    elif cmd == "say" and len(rest) >= 2:
        say(rest[0], " ".join(rest[1:]))
    elif cmd == "approve" and rest:
        sys.exit(answer(rest[0], rest[1] if len(rest) > 1 else "y") or 0)
    elif cmd == "answer" and len(rest) == 2 and rest[1].isdigit():
        sys.exit(answer(rest[0], rest[1]) or 0)
    elif cmd == "keys" and len(rest) >= 2:
        keys(rest[0], rest[1:])
    elif cmd == "stop" and rest:
        stop(rest[0])
    elif cmd == "resume" and len(rest) >= 2:
        # resume NAME [--result FILE] [--session ID] TEXT…
        words, result, session = rest[1:], None, None
        while len(words) >= 2 and words[0] in ("--result", "--session"):
            if words[0] == "--result":
                result = words[1]
            else:
                session = words[1]
            words = words[2:]
        # (With nothing to tell it, `--session ID` itself was the
        # message. A code review, 2026-11-27.)
        if not " ".join(words).strip() or words[0] in ("--result", "--session"):
            sys.exit("agents: resume NAME [--result FILE] [--session ID] TEXT…: what to tell it is missing")
        resume(rest[0], " ".join(words), result, session)
    elif cmd == "forget" and rest:
        forget(rest[0])
    elif cmd == "attach" and rest:
        if via(rest[0]) == "rex":
            print(f"olo agent focus {child(rest[0])}    (its tab, under yours in Rex)")
        else:
            print(f"tmux -L {SOCKET} attach -r -t {rest[0]}")
    elif cmd == "allowed":
        allowed()
    elif cmd == "tidy":
        print("agents: tidied (what was ended is said above; `agents list` shows what runs)")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
