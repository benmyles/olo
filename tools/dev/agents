def allow():
    """Every prefix that goes ahead: Olo's tools as they are run, from
    the repository or by their whole path, with python or without."""
    out = READING + CARGO + GIT + ABOUT_AGENTS
    for t in TOOLS:
        for path in (f"tools/dev/{t}", f"./tools/dev/{t}", f"{ROOT}/tools/dev/{t}"):
            out += [path, f"/usr/bin/python3 {path}"]
    return out


def settings(folders, commands=True, own=()):
    """An agent's settings, for its run alone: its folders trusted (agy
    asks at its start otherwise, and waits), what it may run (nothing
    without asking, for one that only looks at pictures). In the
    folders that are its `own` (its folder here, an investigator's
    scratch) a command's output may be sent to a file unasked. (Not
    `rm` there: a rule matches a command by its whole words, so
    `command(rm FOLDER/)` allows nothing; a file removed there asks,
    and the minder says yes in seconds.)"""
    # (A look reads and no more: it listed its own folder of pictures,
    # and that waited on the minder.)
    yes = [f"command({c})" for c in (allow() if commands is True else READING if commands == "read" else [])]
    yes += [f"write_file({d})" for d in own] if commands is True else []
    return {"trustedWorkspaces": folders, "permissions": {"allow": yes, "deny": [f"command({c})" for c in DENY]}}


