def is_rule(line):
    """A rule drawn across the screen. Claude Code writes its session's
    name into the rule over its field while it works (a child tab is
    started with a name), so a rule is a line that is mostly rule, not
    one of nothing else: read as no rule, a helper's line a minute was
    its footer, "accept edits on …", for the whole of a ten-minute look
    (the minders' reports, 2026-11-26)."""
    t = line.strip()
    return t.count(RULE) >= 20 and t.count(RULE) >= 0.6 * len(t)
