def allow():
    """Every prefix that goes ahead: Olo's tools as they are run, from
    the repository or by their whole path, with python or without."""
    out = READING + CARGO + GIT + ABOUT_AGENTS
    for t in TOOLS:
        for path in (f"tools/dev/{t}", f"./tools/dev/{t}", f"{ROOT}/tools/dev/{t}"):
            out += [path, f"/usr/bin/python3 {path}"]
    return out


def minder_allow():
    """What the agy Neon 4 high minder may run without asking: read-only
    inspection, read-only git, scoped `olo agent` coordination subcommands
    (never `prune`, and never arbitrary `olo agent start` — launches go
    through `tools/dev/agents` wrappers), and the helper/reviewer tools."""
    out = READING_RO + GIT + [
        "olo agent list", "olo agent status", "olo agent read", "olo agent watch",
        "olo agent resume", "olo agent approve", "olo agent send",
        "olo agent stop", "olo agent escalate", "olo agent focus",
    ]
    for t in ("agents", "agent-board", "astra-review", "agy-review", "agy-look", "opus-look", "agy-help", "tsession list"):
        for path in (f"tools/dev/{t}", f"./tools/dev/{t}", f"{ROOT}/tools/dev/{t}"):
            out += [path, f"/usr/bin/python3 {path}"]
    return out


def settings(folders, commands=True, own=()):
    """An agent's settings, for its run alone: its folders trusted (agy
    asks at its start otherwise, and waits), what it may run.
      commands=True     builder / investigator (READING + CARGO + GIT + TOOLS)
      commands="review" agy code reviewer (READING_RO + GIT, write_file in own only, Default mode)
      commands="read"   agy picture look (READING_RO, write_file in own only, Default mode)
      commands="minder" agy Neon 4 high minder (orchestrates builders & reviewers, write_file in own only, Default mode)
    """
    own_real = [os.path.realpath(d) for d in own]
    # Never emit a write_file deny on an ancestor of an allowed `own` dir
    # (e.g. HOME is an ancestor of HOME/minder, and deny takes precedence
    # over allow in agy, which would block the minder's own state.json).
    non_own = [f for f in folders if not any(_inside(o, f) for o in own_real)]
    if commands == "minder":
        yes = [f"command({c})" for c in minder_allow()] + [f"write_file({d})" for d in own]
        deny = [f"command({c})" for c in MINDER_DENY] + [f"write_file({f})" for f in non_own]
    else:
        allowed_cmds = (
            allow() if commands is True
            else (READING_RO + GIT) if commands == "review"
            else READING_RO if commands == "read"
            else []
        )
        yes = [f"command({c})" for c in allowed_cmds]
        yes += [f"write_file({d})" for d in own] if commands in (True, "review", "read") else []
        deny = [f"command({c})" for c in DENY]
        if commands in ("review", "read"):
            deny += [f"write_file({f})" for f in non_own]
    cfg = {"trustedWorkspaces": folders, "permissions": {"allow": yes, "deny": deny}}
    # Explicitly select agy's Default mode ("agentMode": "") for review/read/minder
    # so agy never falls back to Auto mode (which auto-approves repo edits).
    if commands in ("review", "read", "minder"):
        cfg["agentMode"] = ""
    return cfg


