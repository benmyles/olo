def session(name, cwd, env, program):
    """A tmux session of its own for one agent's program, nothing of
    the person's screen in its reach. (One tmux server for them all,
    its options from CONF.)"""
    env = ["env", "-u", "WAYLAND_DISPLAY", "-u", "DISPLAY", "-u", "OLO_SOCKET", "-u", "CLAUDECODE", "-u", "CLAUDE_CODE_ENTRYPOINT", f"OLO_SUBAGENT={name}", *env]
    tmux("new-session", "-d", "-s", name, "-x", "200", "-y", "60", "-c", cwd, *env, *program, check=True)


def launch_opus(name, cwd, brief):
    """Opus 5.5, for a design review: the Claude CLI in a session here,
    able to read and write files in `cwd` and to do nothing else.
    (--restricted: no tool that runs anything, the file tools kept to
    that folder, and none of the person's settings, hooks or MCP
    servers; so nothing it does needs leave. The brief is its first
    message, after an option that takes no value: `--tools` and
    `--add-dir` take as many as follow them, and took the brief for a
    folder's name, 2026-11-22.)"""
    session(name, cwd, [], ["claude", "--model", OPUS, "--effort", "high", "--restricted", "--strict-mcp-config", "--tools", "Read,Write",
                            "--permission-mode", "acceptEdits", "--disable-slash-commands", brief])


def launch_astra(name, cwd):
    """Astra 6.2 at high, for the look at pictures: the Codex CLI in a
    session here, drawn inline so its screen reads as text. It may write
    in `cwd` and nowhere else, has no network, and is never asked leave
    nor asks it (`-a never`: what its sandbox refuses is refused); none
    of the person's Codex hooks run, and it starts no agents. (`cwd` is
    said to be trusted for this run alone: unsaid, Codex asks whether to
    trust a folder it hasn't been in, and waits.)"""
    session(name, cwd, [], ["codex", "-m", ASTRA, "-c", 'model_reasoning_effort="high"', "-s", "workspace-write", "-a", "never",
                            "--disable", "multi_agent", "--disable", "multi_agent_v2", "--disable", "hooks", "--no-alt-screen", "-C", cwd,
                            "-c", f'projects."{cwd}".trust_level="trusted"', f"Read {cwd}/brief.md (the rules, then what changed) and do what it says."])


def launch(name, d, cwd, others, target=None, commands=True):
    """An agy of its own in a tmux session, working in `cwd` (and
    reading `d`, its folder here, and `others`): started on its brief,
    with what it may run, and nothing of the person's screen in reach."""
    folders = list(dict.fromkeys([cwd, d, *others]))
    json.dump(settings(folders, commands, own=[d, *others]), open(os.path.join(d, "settings.json"), "w"), indent=1)
    env = [f"CARGO_TARGET_DIR={target}"] if target else []
    # (accept-edits: its edits go ahead, its commands by ALLOW and DENY,
    # the rest asks. Not agy's `auto` mode, which decides for itself what
    # is safe and runs it outside its sandbox when the sandbox refuses:
    # a `sudo -n true` went through unasked, tried 2026-11-22. The
    # settings are this run's alone, the person's neither read for the
    # lists nor written.)
    add = [a for x in folders[1:] for a in ("--add-dir", x)]
    agy = ["agy", "--model", MODEL, "--mode", "accept-edits", "--settings", os.path.join(d, "settings.json"), *add,
           "-i", f"Read {d}/brief.md (the rules, then your task) and do what it says."]
    session(name, cwd, env, agy)


def room(name, program="agy"):
    """Refuse a name in use, or a sixth agent; those running."""
    if not shutil.which(program):
        sys.exit(f"agents: no {program} on PATH ({ {'agy': 'the Antigravity CLI', 'codex': 'the Codex CLI'}.get(program, 'the Claude CLI')}, signed in)")
    running = [n for n in names() if live(n)]
    if name in running:
        sys.exit(f"agents: {name} is running")
    if len(running) >= MOST:
        sys.exit(f"agents: {MOST} are running ({', '.join(running)}): stop one first")
    return running


def start(name, crate, brief):
    refuse_nested()
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", name):
        sys.exit("agents: a NAME of lowercase letters, digits and dashes")
    crate_dir = os.path.normpath(os.path.join(ROOT, crate))
    if not os.path.isfile(os.path.join(crate_dir, "Cargo.toml")):
        sys.exit(f"agents: {crate} isn't a crate (no Cargo.toml in it)")
    crate = os.path.relpath(crate_dir, ROOT)
    task = open(brief).read().strip()
    if not task:
        sys.exit("agents: the brief is empty")
    for n in room(name):
        other = meta(n).get("crate")
        if other and (other == crate or other.startswith(crate + "/") or crate.startswith(other + "/")):
            sys.exit(f"agents: {n} is working in {other}: one agent to a crate")
    package = next((l.split('"')[1] for l in open(os.path.join(crate_dir, "Cargo.toml")) if l.startswith("name")), crate)
    d = folder(name)
    if os.path.exists(d):
        shutil.rmtree(d)
    os.makedirs(os.path.join(d, "target"))
    open(os.path.join(d, "task.md"), "w").write(task + "\n")
    open(os.path.join(d, "brief.md"), "w").write(RULES.format(root=ROOT, crate=crate, package=package, name=name, dir=d, approvals=APPROVALS) + task + "\n")
    save_meta(name, {"crate": crate, "package": package, "started": time.time(), "seen": "", "seen_state": "", "done": os.path.join(d, "report.md")})
    launch(name, d, ROOT, [], os.path.join(d, "target"))
    print(f"agents: {name} started on {crate} ({package}); its folder is {d}")
    print(f"agents: now wait on `tools/dev/agents watch` to hear from it (a lead: in the background; a minder: `watch --for 2`)")


def investigate(brief, where):
    """Start a second investigator on `brief` (or find the one started
    on it), then wait until it needs the lead or has answered."""
    refuse_nested()
    brief = os.path.abspath(brief)
    if not os.path.isfile(brief) or not open(brief).read().strip():
        sys.exit("usage: tools/dev/agy-help BRIEF.md [DIR]   (the brief: a file that says what's wrong and what's known)")
    work = os.path.abspath(where or os.path.dirname(brief))
    if work == "/tmp" or work.startswith("/tmp/"):
        sys.exit(f"agents: {work} is in RAM (/tmp); use a folder under /var/tmp")
    if not os.path.isdir(work):
        sys.exit(f"agents: no folder {work}")
    # (Its name: the folder's, so the same brief finds the same helper.)
    name = ("help-" + re.sub(r"[^a-z0-9]+", "-", os.path.basename(work).lower()).strip("-"))[:31].rstrip("-")
    m = meta(name)
    if not (m and m.get("work") == work and live(name)):
        room(name)
        d = folder(name)
        if os.path.exists(d):
            shutil.rmtree(d)
        os.makedirs(d)
        for old in ("answer.md",):
            if os.path.exists(os.path.join(work, old)):
                os.replace(os.path.join(work, old), os.path.join(work, old + ".before"))
        open(os.path.join(d, "brief.md"), "w").write(HELP_RULES.format(root=ROOT, dir=work, approvals=APPROVALS) + open(brief).read().strip() + "\n")
        save_meta(name, {"work": work, "started": time.time(), "seen": "", "seen_state": "", "done": os.path.join(work, "answer.md")})
        launch(name, d, ROOT, [work], os.path.join(work, "target"))
        print(f"agents: {name} started on {brief}; its answer will be {work}/answer.md, its notes {work}/notes.md", flush=True)
    else:
        print(f"agents: {name} is on it already; waiting for it", flush=True)
    sys.exit(watch(15, only=name))


# How long an ended agent's builds are kept after the last of them.
BUILDS_KEPT = 24 * 3600


def last_build(target):
    """When anything was last built in `target`: the newest of its profile
    folders' own times and their build folders' (a build makes or renames
    something in one of them), None if it holds none."""
    times = []
    try:
        profiles = [e.path for e in os.scandir(target) if e.is_dir(follow_symlinks=False)]
    except OSError:
        return None
    for d in profiles:
        for sub in ("", "build", "deps", "examples", "incremental"):
            try:
                times.append(os.lstat(os.path.join(d, sub)).st_mtime)
            except OSError:
                pass
    return max(times) if times else None


def sweep_builds(now=None, home=None, is_live=None):
    """Remove target/ from every ended agent's folder whose last build is
    over a day old; what was removed, as (name, bytes). Never an agent's
    own doing (it has no business in another's folder)."""
    if os.environ.get("OLO_SUBAGENT"):
        return []
    now = time.time() if now is None else now
    home = HOME if home is None else home
    is_live = live if is_live is None else is_live
    gone = []
    try:
        agents = sorted(os.listdir(home))
    except OSError:
        return gone
    for n in agents:
        target = os.path.join(home, n, "target")
        # (A folder of ours: with its record, and a target/ that is a real
        # folder, not a link to somewhere else.)
        if not os.path.isfile(os.path.join(home, n, "meta.json")) or os.path.islink(target) or not os.path.isdir(target):
            continue
        built = last_build(target)
        if is_live(n) or (built is not None and now - built < BUILDS_KEPT):
            continue
        size = sum(os.lstat(os.path.join(d, f)).st_blocks * 512 for d, _, fs in os.walk(target) for f in fs)
        shutil.rmtree(target, ignore_errors=True)
        if not os.path.exists(target):
            gone.append((n, size))
    return gone


def say_swept(gone):
    for n, size in gone:
        print(f"agents: {n} ended over a day ago: its builds removed ({size / 2**30:.1f} GB; its report and the rest stay until `agents forget {n}`)", file=sys.stderr)


def look(args):
    """Start a look at pictures (or find the one started on them), wait
    until it needs the lead or has written its review, and print it.
    Astra 6.2's look at what's wrong by a pixel, or with `--by opus`
    Opus 5.5's review of the design itself. (`--by gemini`: Gemini 4
    Neon's look, as it was for a day; kept for a comparison, not the
    rule.)"""
    refuse_nested()
    by, about = "astra", ""
    while len(args) >= 2 and args[0] in ("--by", "--about"):
        if args[0] == "--by":
            by = args[1]
        else:
            about = args[1]
        args = args[2:]
    if by not in ("astra", "gemini", "opus"):
        sys.exit("agents: look --by astra, or --by opus")
    front = {"astra": "astra-look", "gemini": "agy-look", "opus": "opus-look"}[by]
    if not args or args[0].startswith("--"):
        sys.exit(f'usage: tools/dev/{front} [--about "WHAT IT IS, WHAT CHANGED"] PICTURE.png…')
    pictures = []
    for a in args:
        full = os.path.abspath(a)
        if full.startswith("/tmp/"):
            sys.exit(f"agents: {a} is in RAM (/tmp); keep pictures under /var/tmp")
        if not os.path.isfile(full) or not os.path.getsize(full):
            sys.exit(f"agents: no picture {a}")
        pictures.append(full)
    work = os.path.dirname(pictures[0])
    out = os.path.join(work, front + ".md")
    name = ({"astra": "astra-", "gemini": "agy-", "opus": "opus-"}[by] + re.sub(r"[^a-z0-9]+", "-", os.path.basename(work).lower()).strip("-"))[:31].rstrip("-")
    m = meta(name)
    if m and live(name) and (m.get("pictures"), m.get("about")) != (pictures, about):
        sys.exit(f"agents: {name} is looking at other pictures there: wait for it, or `tools/dev/agents stop {name}`")
    d = folder(name)
    review = os.path.join(d, "review.md")
    if not (m and live(name)):
        room(name, {"astra": "codex", "gemini": "agy", "opus": "claude"}[by])
        if os.path.exists(d):
            shutil.rmtree(d)
        os.makedirs(d)
        if os.path.exists(out):
            os.remove(out)
        # (It works in its folder here, on copies of the pictures: one
        # folder to read whatever folders they came from, nothing of the
        # project loaded, nothing of yours in its reach but them.)
        copies = []
        for i, pic in enumerate(pictures):
            base = os.path.basename(pic)
            if [os.path.basename(x) for x in pictures].count(base) > 1:
                base = f"{i + 1:02d}-{base}"
            subprocess.run(["cp", "--reflink=auto", pic, os.path.join(d, base)], check=True)
            copies.append(os.path.join(d, base))
        said = {"out": review, "pictures": "\n".join(copies)}
        record = {"work": work, "pictures": pictures, "about": about, "started": time.time(), "seen": "", "seen_state": "", "done": review}
        if by == "astra":
            brief = LOOK_RULES.format(**said) + (f"\nWhat changed: {about}\n" if about else "")
            open(os.path.join(d, "brief.md"), "w").write(brief)
            save_meta(name, {**record, "cli": "codex"})
            launch_astra(name, d)
        elif by == "gemini":
            brief = LOOK_RULES.format(**said) + (f"\nWhat changed: {about}\n" if about else "")
            open(os.path.join(d, "brief.md"), "w").write(brief)
            save_meta(name, {**record, "cli": "agy"})
            launch(name, d, d, [], commands="read")
        else:
            brief = OPUS_RULES.format(**said) + (f"\nWhat it is, and what changed: {about}\n" if about else "")
            open(os.path.join(d, "brief.md"), "w").write(brief)
            save_meta(name, {**record, "cli": "claude"})
            launch_opus(name, d, brief)
        print(f"agents: {name} is looking at {len(pictures)} picture{'s' if len(pictures) != 1 else ''}; its review will be {out}", flush=True)
    else:
        print(f"agents: {name} is on them already; waiting for it", flush=True)
    rc = watch(15, only=name)
    if rc == 0:
        # (Done: its review beside the first picture and printed, what
        # it did kept beside that, and the session ended with its
        # folder, so it doesn't count among those running.)
        shutil.copyfile(review, out)
        open(out[:-3] + ".log", "w").write((screen(name, 200000) or "") + "\n")
        print(open(out).read().rstrip())
        end(name)
        shutil.rmtree(d, ignore_errors=True)
    sys.exit(rc)


def ago(t):
    s = int(time.time() - t)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def done_file(n):
    m = meta(n) or {}
    return m.get("done") or os.path.join(folder(n), "report.md")


def list_():
    rows = names()
    if not rows:
        print("agents: none")
        return
    for n in rows:
        m = meta(n)
        st = state(n)
        # (Its turn over and its result written: done. Idle without it:
        # a question, or waiting to be told more.)
        st = "done" if st == "idle" and os.path.exists(done_file(n)) else st
        on = m.get("crate") or (f"pictures ({m.get('work', '?')})" if m.get("pictures") else f"a bug ({m.get('work', '?')})")
        done = f" {os.path.basename(done_file(n))}" if os.path.exists(done_file(n)) else ""
        print(f"{n:16} {st:8} {on:28} started {ago(m['started'])} ago{done}")


def shown(text, most=3000):
    return "\n".join(l for l in (text or "").splitlines() if l.strip())[-most:]


def watch(stuck_min, only=None, at_most=None):
    """Return once an agent needs you; print who and why. With `only`,
    that one alone, and how to go on; 0 if it has answered. With
    `at_most`, after that many minutes if nothing has."""
    last = {}
    idle_since = {}
    began = told = time.time()
    while True:
        alerts = []
        if at_most and time.time() - began >= at_most * 60:
            print(f"agents: nothing has needed you in {at_most} minutes; run it again to go on waiting")
            return 0
        rows = [n for n in names() if only in (None, n)]
        if not any(state(n) in ("working", "asking", "idle") for n in rows):
            print("agents: none running")
            return 1 if only else 0
        for n in rows:
            st = state(n)
            m = meta(n) or {}
            if st == "asking":
                alerts.append((n, f"asks you (tools/dev/agents approve {n} y|p|no, or `answer {n} N`)", "\n".join(asked(n)[0])))
            elif st == "exited" and m.get("seen_state") != "exited":
                alerts.append((n, "has exited", screen(n, 40)))
            elif st == "idle":
                # (A moment to start; and a turn that's really over, not
                # the gap between two steps.)
                if time.time() - m.get("started", 0) < 30:
                    continue
                if time.time() - idle_since.setdefault(n, time.time()) < 15:
                    continue
                p = progress(n)
                finished = os.path.exists(done_file(n))
                # (One waited for alone that has its result is done,
                # whether or not it was looked at meanwhile.)
                if p != m.get("seen") or (only and finished):
                    said = f"is DONE ({done_file(n)})" if finished else "finished a turn (a question, or waiting)"
                    alerts.append((n, said, screen(n, 40)))
                    if finished:
                        # (Said once: a watcher of several isn't called
                        # back by the same finished one at every wait.)
                        seen(n)
            if st != "idle":
                idle_since.pop(n, None)
            if st == "working":
                p = progress(n)
                t, was = last.get(n, (time.time(), p))
                if p != was:
                    t = time.time()
                last[n] = (t, p)
                if time.time() - t >= stuck_min * 60:
                    alerts.append((n, f"has shown nothing new for {stuck_min} minutes while working", screen(n, 30)))
        if alerts:
            # (One waited for alone, and done: what it wrote is what its
            # front door prints, not its screen besides.)
            finished = bool(only) and os.path.exists(done_file(only)) and state(only) == "idle"
            for n, why, text in alerts:
                print(f"=== {n} {why}")
                if not finished:
                    print(shown(text))
                    print()
            if only:
                if finished:
                    return 0
                print(f"agents: answer it (approve, answer, say), then run this again to go on waiting for {only}")
                return 3
            return 0
        if time.time() - told >= 60:
            told = time.time()
            say_tidied(tidy())
            for n in rows:
                if live(n):
                    print(f"… {n}: {state(n)}, {ago((meta(n) or {}).get('started', told))} since its start: {latest(n)}", flush=True)
        time.sleep(5)


def latest(name):
    """The last line of what it has said or is doing: above its field."""
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    rules = [i for i, l in enumerate(lines) if set(l.strip()) == {RULE}]
    said = [l for l in (lines[:rules[-2]] if len(rules) >= 2 else lines) if not re.match(r"\s*└ Tip:", l)]
    return said[-1].strip()[:160] if said else ""


def peek(name, lines):
    s = screen(name, lines)
    if s is None:
        sys.exit(f"agents: no {name}")
    print("\n".join(l for l in s.splitlines() if l.strip()))
    print(f"--- {name}: {state(name)}")
    seen(name)


def log(name):
    s = screen(name, 200000)
    if s is None:
        sys.exit(f"agents: no {name}")
    print(s)
    seen(name)


def field(name):
    """What its field holds: the lines between the last two rules."""
    lines = [l for l in (screen(name) or "").splitlines() if l.strip()]
    rules = [i for i, l in enumerate(lines) if set(l.strip()) == {RULE}]
    if len(rules) < 2:
        return ""
    held = " ".join(l.strip() for l in lines[rules[-2] + 1:rules[-1]])
    held = held[1:].strip() if held[:1] in (">", "\u276f") else held
    # (Empty, it shows its mode's hint there.)
    return "" if "shift+tab to cycle" in held else held


def say(name, text, now=False):
    """A message to it. While it works, its program queues the message
    for the end of the step it is on; `now` has it delivered at once
    (agy: alt+m), which is what stops a long think."""
    refuse_nested()
    st = state(name)
    if st in ("gone", "exited"):
        sys.exit(f"agents: {name} isn't running")
    if st == "asking":
        sys.exit(f"agents: {name} is asking you something: answer that first (agents approve {name} y|p|no, agents answer {name} N)")
    # (As one paste, so a new line in it is a new line and not a send;
    # then Enter by itself, a moment later.)
    target = f"={name}:0.0"
    r = subprocess.run(["tmux", "-L", SOCKET, "load-buffer", "-b", "olo-say", "-"], input=text, text=True, capture_output=True)
    if r.returncode:
        sys.exit(f"agents: tmux load-buffer: {r.stderr.strip()}")
    tmux("paste-buffer", "-p", "-d", "-b", "olo-say", "-t", target, check=True)
    time.sleep(0.5 + len(text) / 1500)
    for _ in range(4):
        tmux("send-keys", "-t", target, "C-m", check=True)
        time.sleep(1.5)
        if not field(name):
            break
    else:
        sys.exit(f"agents: said to {name}, but its field still holds the words: look (agents peek {name})")
    queued = "to send immediately" in "\n".join((screen(name) or "").splitlines()[-12:])
    if queued and now:
        tmux("send-keys", "-t", target, "M-m", check=True)
        time.sleep(1.0)
    seen(name)
    print(f"agents: said to {name}" + ("" if not queued else " (delivered at once)" if now else f": queued until the step it is on ends (`agents say {name} --now …` delivers at once)"))


def answer(name, how):
    """Answer what it asks: y, p, no, or the number of a choice."""
    refuse_nested()
    if state(name) != "asking":
        sys.exit(f"agents: {name} isn't asking for anything ({state(name)})")
    text, choices = asked(name)
    print("\n".join(text))
    if how.isdigit():
        pick = next((c for c in choices if c[0] == how), None)
    else:
        kind = {"y": "y", "yes": "y", "p": "p", "no": "n", "n": "n"}.get(how)
        if not kind:
            sys.exit("agents: approve with y, p or no; or `answer NAME N` for the Nth choice")
        # (agy 1.5.14: "Yes, run command"; "Yes, and always allow in this
        # conversation for commands that start with '…'"; the same
        # "(Persist to settings.json)"; "No, cancel".)
        want = {"y": lambda w: w.startswith("Yes") and "always" not in w and "auto mode" not in w,
                "p": lambda w: w.startswith("Yes") and "in this conversation" in w,
                "n": lambda w: w.startswith("No")}[kind]
        pick = next((c for c in choices if want(c[1])), None)
    if not pick:
        sys.exit(f"agents: no such choice in what {name} asks: look (agents peek {name}), and answer with `agents answer {name} N`, or where its choices have no numbers move to one and confirm it (`agents keys {name} down enter`)")
    if any(x in pick[1] for x in SAVES):
        sys.exit("agents: that choice changes the person's own settings or the agent's mode: not from here (y allows this once)")
    tmux("send-keys", "-t", f"={name}:0.0", pick[0], check=True)
    time.sleep(0.5)
    seen(name)
    print(f"agents: answered {name}: {pick[1]}")


KEYS = {"up": "Up", "down": "Down", "left": "Left", "right": "Right", "enter": "C-m", "esc": "Escape", "escape": "Escape", "tab": "Tab", "space": "Space"}


def keys(name, which):
    """Press keys in it, one after another: for a question whose choices
    have no numbers (move to one and confirm), or to cancel what it's
    doing (esc)."""
    refuse_nested()
    if not live(name):
        sys.exit(f"agents: {name} isn't running")
    send = [KEYS.get(k.lower()) or (k if re.fullmatch(r"[0-9a-z]", k) else None) for k in which]
    if None in send:
        sys.exit(f"agents: keys are {', '.join(KEYS)}, a digit or a letter")
    for k in send:
        tmux("send-keys", "-t", f"={name}:0.0", k, check=True)
        time.sleep(0.3)
    time.sleep(0.5)
    print("\n".join(l for l in (screen(name, 16) or "").splitlines() if l.strip()))
    print(f"--- {name}: {state(name)}")
    seen(name)


def end(name):
    """End its session, whatever state it is in: what it said kept in
    its folder (transcript.txt) first, and any headless test session it
    left running (it names them agy-NAME…) stopped with it."""
    d = folder(name)
    text = screen(name, 200000)
    if text and os.path.isdir(d):
        open(os.path.join(d, "transcript.txt"), "w").write(text + "\n")
    tmux("kill-session", "-t", f"={name}")
    tsession = os.path.join(ROOT, "tools/dev/tsession")
    try:
        listed = subprocess.run(["/usr/bin/python3", tsession, "list"], capture_output=True, text=True, timeout=20).stdout
        for line in listed.splitlines():
            its = line.split()
            if its and (its[0] == f"agy-{name}" or its[0].startswith(f"agy-{name}-")) and "ended" not in its[1:]:
                subprocess.run(["/usr/bin/python3", tsession, "stop", its[0]], capture_output=True, timeout=60)
                print(f"agents: stopped {name}'s test session {its[0]}", file=sys.stderr)
    except (OSError, subprocess.SubprocessError):
        pass
    m = meta(name)
    if m:
        m["seen_state"] = "exited"
        m["ended"] = time.time()
        save_meta(name, m)


def stop(name):
    refuse_nested()
    end(name)
    print(f"agents: {name} stopped; its folder {folder(name)} stays (its report or answer, its brief, transcript.txt)")


# An agent nobody needs any more is ended, not left at its prompt (Ben,
# 2026-11-22: "make sure that the tmux agents / screens are getting
# properly stopped when they are no longer needed"): one whose program
# has exited; one that wrote its result this long ago and has sat since;
# one that has sat idle without a result this long. Its folder (result,
# transcript) stays; a folder whose agent ended this long ago goes too.
DONE_KEPT = 30 * 60
IDLE_KEPT = 3 * 3600
FOLDER_KEPT = 7 * 24 * 3600


def tidy(now=None):
    """End what is no longer needed; what was done, as lines to print."""
    if os.environ.get("OLO_SUBAGENT"):
        return []
    now = time.time() if now is None else now
    said = []
    for n in names():
        m = meta(n) or {}
        st = state(n)
        if st == "exited":
            end(n)
            said.append(f"{n}: its program had ended; its session closed (transcript.txt in {folder(n)})")
        elif st == "idle":
            p = progress(n)
            if p != m.get("still"):
                m["still"], m["still_since"] = p, now
                save_meta(n, m)
                continue
            sat = now - m.get("still_since", now)
            finished = os.path.exists(done_file(n))
            if (finished and sat >= DONE_KEPT) or sat >= IDLE_KEPT:
                end(n)
                said.append(f"{n}: {'done' if finished else 'idle'} and untouched for {int(sat // 60)} minutes; stopped (its folder {folder(n)} stays)")
        elif st == "gone":
            ended = m.get("ended") or os.path.getmtime(os.path.join(folder(n), "meta.json"))
            if now - ended >= FOLDER_KEPT:
                shutil.rmtree(folder(n), ignore_errors=True)
                said.append(f"{n}: ended over a week ago; its folder removed")
    return said


def say_tidied(said):
    for line in said:
        print(f"agents: {line}", file=sys.stderr)


def forget(name):
    refuse_nested()
    if live(name):
        sys.exit(f"agents: {name} is running: stop it first")
    shutil.rmtree(folder(name), ignore_errors=True)
    print(f"agents: {name}'s folder removed")


def allowed():
    print("Goes ahead without asking (a command that starts so; several piped or joined, when each does):")
    print("  " + "\n  ".join(allow()))
    print("Refused without asking:")
    print("  " + "\n  ".join(DENY))
    print("Anything else asks the lead.")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = a[0], a[1:]
    if cmd in ("start", "list", "watch", "investigate", "look", "tidy"):
        say_swept(sweep_builds())
        say_tidied(tidy())
    if cmd == "start" and len(rest) == 3:
        start(*rest)
    elif cmd == "investigate" and len(rest) in (1, 2):
        investigate(rest[0], rest[1] if len(rest) > 1 else None)
    elif cmd == "look":
        look(rest)
    elif cmd == "list":
        list_()
    elif cmd == "watch":
        watch(int(rest[rest.index("--stuck") + 1]) if "--stuck" in rest else 15, at_most=int(rest[rest.index("--for") + 1]) if "--for" in rest else None)
    elif cmd == "peek" and rest:
        peek(rest[0], int(rest[1]) if len(rest) > 1 else 60)
    elif cmd == "log" and rest:
        log(rest[0])
    elif cmd == "say" and len(rest) >= 3 and rest[1] == "--now":
        say(rest[0], " ".join(rest[2:]), now=True)
    elif cmd == "say" and len(rest) >= 2:
        say(rest[0], " ".join(rest[1:]))
    elif cmd == "approve" and rest:
        answer(rest[0], rest[1] if len(rest) > 1 else "y")
    elif cmd == "answer" and len(rest) == 2 and rest[1].isdigit():
        answer(rest[0], rest[1])
    elif cmd == "keys" and len(rest) >= 2:
        keys(rest[0], rest[1:])
    elif cmd == "stop" and rest:
        stop(rest[0])
    elif cmd == "forget" and rest:
        forget(rest[0])
    elif cmd == "attach" and rest:
        print(f"tmux -L {SOCKET} attach -r -t {rest[0]}")
    elif cmd == "allowed":
        allowed()
    elif cmd == "tidy":
        print("agents: tidied (what was ended is said above; `agents list` shows what runs)")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
