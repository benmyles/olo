#!/usr/bin/env python3
"""The README's pictures, made again (Ben, 2026-11-07: "a full collection
of screenshots in light/dark and different themes and make sure they
cover all the different apps, features, agent functionality etc").

  tools/dev/readme-shots [SCENE...]     (default: every scene)

A headless session of its own (`tsession --session --shell`: Deskbar and
the desktop) at 2560×1600 and 1.5×, release builds, and a sample home
folder (`fixture-home`: nothing of anyone's). Each scene sets the look
it wants, opens and places its windows, waits for them to settle and
saves `docs/img/NAME.jpg` (JPEG, no chroma subsampling: the windows'
text stays sharp). Apps that would show this computer's own (the
journal, processes, devices, accounts) are left out or shown on demo
data. Look at every picture before committing it.

Build first: `cargo build --release --workspace`. Run with
/usr/bin/python3 (it has PIL).
"""

import json
import os
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
TSESSION = os.path.join(ROOT, "tools/dev/tsession")
OUT = os.path.join(ROOT, "docs/img")
WORK = "/var/tmp/olo-readme-shots"
HOME = os.path.join(WORK, "home")
NAME = "readme"
SIZE, SCALE = (2560, 1600), 1.5
# The screen in points.
W, H = int(SIZE[0] / SCALE), int(SIZE[1] / SCALE)
DESKBAR = 172


def ts(*args, check=False):
    env = dict(os.environ, TSESSION_PROFILE="release")
    for k in ("WAYLAND_DISPLAY", "OLO_SOCKET", "OLO_SESSION", "OLO_SESSION_PID", "OLO_REAL_SESSION"):
        env.pop(k, None)
    r = subprocess.run(["/usr/bin/python3", TSESSION, *args], capture_output=True, text=True, env=env, cwd=ROOT)
    if check and r.returncode:
        sys.exit(f"tsession {' '.join(args)}: {r.stderr or r.stdout}")
    return r.stdout


def ipc(obj):
    out = ts("ipc", NAME, json.dumps(obj))
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {}


def settings(change):
    s = ipc({"type": "get_settings"}).get("settings", {})
    change(s)
    ipc({"type": "set_settings", "settings": s})


def windows():
    return ipc({"type": "list_windows"}).get("windows", [])


def run(*cmd, env=None):
    extra = [f"{k}={v}" for k, v in (env or {}).items()]
    ts("run", NAME, *extra, *cmd)


def wait_for(pick, timeout=15):
    """The first window `pick` takes, once there."""
    until = time.time() + timeout
    while time.time() < until:
        for w in windows():
            if pick(w):
                return w
        time.sleep(0.3)
    sys.exit(f"no window came: {pick}")


def by_app(app, title=None):
    return lambda w: w["app_id"] == app and (title is None or w["title"] == title)


def activate(w):
    ipc({"type": "activate", "id": w["id"]})
    time.sleep(0.5)


def place(w, x, y, width, height):
    ipc({"type": "place", "id": w["id"], "frame": {"x": int(x), "y": int(y), "width": int(width), "height": int(height)}})


def close_all():
    for w in windows():
        ipc({"type": "close", "id": w["id"]})
    time.sleep(1.5)
    # (One that asks before it closes: ended by its process, a test's own.)
    for w in windows():
        try:
            env = open(f"/proc/{w['pid']}/environ", "rb").read()
        except OSError:
            continue
        if f"WAYLAND_DISPLAY={DISPLAY}".encode() in env.split(b"\0"):
            os.kill(w["pid"], 15)
    time.sleep(1)


def look(theme="light", icons="bebox", colors="theme", wallpaper=None):
    def change(s):
        a = s["appearance"]
        a["theme"] = theme
        a["icon_theme"] = icons
        a["colors"] = colors
        s["wallpaper"] = wallpaper or f"pack:{icons}"
    settings(change)
    time.sleep(2)


def widgets(ws):
    settings(lambda s: s.__setitem__("deskbar", {"widgets": ws}))


def shot(name, crop=None, width=None):
    """docs/img/NAME.jpg of the screen (or `crop`, in points), `width`
    pixels across if given."""
    from PIL import Image

    png = os.path.join(WORK, f"{name}.png")
    args = ["shot", NAME, png]
    if crop:
        args += [str(int(v)) for v in crop]
    ts(*args, check=True)
    im = Image.open(png).convert("RGB")
    if width and im.width > width:
        im = im.resize((width, round(im.height * width / im.width)), Image.LANCZOS)
    path = os.path.join(OUT, f"{name}.jpg")
    im.save(path, quality=90, subsampling=0, optimize=True)
    print(f"{path} ({im.width}×{im.height}, {os.path.getsize(path) // 1024} KB)")


def settle(seconds=2.5):
    time.sleep(seconds)


# ---- the scenes ---------------------------------------------------------------

def desktop_windows():
    """Tracker, StyledEdit, Terminal and DeskCalc on the first workspace."""
    run("olo-tracker", HOME)
    tracker = wait_for(by_app("olo.tracker", "Home"))
    run("olo-styled-edit", os.path.join(HOME, "Documents", "Welcome.md"))
    edit = wait_for(by_app("olo.styled-edit"))
    term = terminal()
    run("olo-deskcalc")
    calc = wait_for(by_app("olo.deskcalc"))
    place(tracker, 30, 70, 790, 420)
    place(edit, 150, 520, 620, 430)
    place(term, 850, 90, 560, 380)
    place(calc, 830, 520, 260, 330)
    settle()
    # A command in Terminal, to show it working.
    activate(term)
    ts("type", NAME, "ls Pictures Documents\n")
    activate(calc)
    ts("type", NAME, "355/113\n")
    # Tracker's Pictures, its first picture's preview in the next column.
    activate(tracker)
    ts("type", NAME, "Pic")
    settle(1)
    ts("key", NAME, "106")
    settle(1.5)
    return tracker, edit, term, calc


def terminal(*cmd):
    """A Terminal in the sample home, its shell plain bash (no rc files:
    the login shell's own prompt and title say who and where this
    computer is), its prompt "~ $"."""
    run("olo-terminal", "-w", HOME, "-e", "bash", "--norc", "--noprofile", "-i", *cmd, env={"PS1": "\\w \\$ ", "HOME": HOME})
    return wait_for(by_app("olo.terminal"))


