CLEAR = 1630


def frame_of(w):
    """Where a window is now, tab and border included (points)."""
    return next((x["frame"] for x in windows() if x["id"] == w["id"]), w["frame"])


def shot_of(name, *ws, pad=44, width=None):
    """The picture cropped to these windows and a margin of wallpaper
    round them (no Deskbar, no desktop icons: the window is the subject)."""
    fs = [frame_of(w) for w in ws]
    x0, y0 = max(0, min(f["x"] for f in fs) - pad), max(0, min(f["y"] for f in fs) - pad)
    x1, y1 = min(CLEAR, max(f["x"] + f["width"] for f in fs) + pad), min(H, max(f["y"] + f["height"] for f in fs) + pad)
    shot(name, crop=(x0, y0, x1 - x0, y1 - y0), width=width)


def tuck(w, right=CLEAR - 44, bottom=None):
    """A window moved so that its right edge (and its foot) stand at
    these: whatever size it chose for itself, it ends inside the picture."""
    f = frame_of(w)
    bottom = H - 44 if bottom is None else bottom
    # (`place` takes where its content begins: 12 in and 30 down from
    # the frame's corner, its border and its tab; and its size as it is
    # now, not as it was when it opened.)
    place(w, right - f["width"] + 12, bottom - f["height"] + 30, f["width"], f["height"])


def one(app, *cmd, env=None, at=(100, 70), size=(), title=None):
    """A program started and its window placed: the window."""
    run(*cmd, env=env)
    w = wait_for(by_app(app, title))
    place(w, at[0], at[1], *size)
    return w


