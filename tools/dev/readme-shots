# A coding agent's stand-in, named as one (Terminal knows an agent by its
# program's name): it titles its tab as an agent without the tool does,
# shows what Terminal's hook tells an agent as it starts there (the real
# words), and waits. Nothing of any agent's own interface is drawn.
STAND_IN = r"""#!/bin/bash
olo-terminal --tab-title "$*" >/dev/null 2>&1
clear
if [ -n "$ASKS" ]; then
    # Asking leave to go on, as an agent does (the words Auto Approve
    # answers: a question, its first answer Yes, chosen).
    printf '\n  \e[2m(A stand-in for a coding agent, asking leave to go on.)\e[0m\n\n'
    printf '  Run the tests before committing?\n\n      cargo test --workspace\n\n'
    printf ' Do you want to proceed?\n \xe2\x9d\xaf 1. Yes\n   2. No\n'
    read -r _
    printf '\n  Yes: running the tests.\n'
    exec sleep 100000
fi
printf '\n\e[2m  What Olo Terminal tells a coding agent as it starts in this tab (the home folder written ~):\e[0m\n\n'
printf '{"session_id":"shots-%s","cwd":"%s","hook_event_name":"SessionStart"}' "$$" "$PWD" | olo-terminal --agent-context | sed "s|$HOME|~|g" | fold -s -w 104 | sed 's/^/  /'
exec -a "$(basename "$0")" sleep 100000 2>/dev/null || sleep 100000
"""


def agents_world():
    """Two repositories and a worktree in the sample home, the stand-ins
    on a PATH of their own, and Terminal's settings for agents on (their
    hooks go nowhere: the sample home has no agent set up)."""
    src = os.path.join(HOME, "src")
    shutil.rmtree(src, ignore_errors=True)
    shutil.rmtree(os.path.join(HOME, "worktrees"), ignore_errors=True)
    git = lambda d, *a: subprocess.run(["/usr/bin/git", "-C", d, "-c", "user.name=Mira", "-c", "user.email=mira@example.com", *a], check=True, capture_output=True)
    for repo in ("shop-web", "shop-api"):
        d = os.path.join(src, repo)
        os.makedirs(d)
        git(d, "init", "-q", "-b", "main")
        with open(os.path.join(d, "README.md"), "w") as f:
            f.write(f"# {repo}\n")
        git(d, "add", ".")
        git(d, "commit", "-q", "-m", "Start")
    os.makedirs(os.path.join(HOME, "worktrees", "shop-api"))
    git(os.path.join(src, "shop-api"), "worktree", "add", "-q", "-b", "refunds", os.path.join(HOME, "worktrees", "shop-api", "refunds"))
    bin = os.path.join(WORK, "bin")
    os.makedirs(bin, exist_ok=True)
    for name, text in (("claude", STAND_IN), ("codex", STAND_IN)):
        with open(os.path.join(bin, name), "w") as f:
            f.write(text)
        os.chmod(os.path.join(bin, name), 0o755)
    settings(lambda s: s["terminal"].update(agent_context=True, agent_titles=True, agent_screens=False))
    return src, bin


def menu_items():
    """Terminal's menu items as the screen lists them (path, label,
    command, checked…), the front window's."""
    found = []

    def walk(v):
        if isinstance(v, dict):
            if "command" in v and "label" in v:
                found.append(v)
            for x in v.values():
                walk(x)
        elif isinstance(v, list):
            for x in v:
                walk(x)

    try:
        walk(json.loads(screen("menus")))
    except json.JSONDecodeError:
        pass
    return found


