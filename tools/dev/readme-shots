# The screen's environment, once started (`olo-screen env`).
SCREEN_ENV = {}


def env_for_screens(run_dir=RUN):
    """olo-screen's environment: this tree's build first, the sample home,
    a runtime folder of the shots' own; nothing of the person's session."""
    env = dict(os.environ, XDG_RUNTIME_DIR=run_dir, HOME=HOME, PATH=RELEASE + ":" + os.environ.get("PATH", ""))
    # Nor the host's Rex server and agents service: a Rex on the screen
    # finds no server and keeps its agents in the shots' own folder (as
    # every tsession: a build of the tree served the live socket once,
    # 2026-11-26).
    env.update(REX_SERVER_SOCKET="unix://" + os.path.join(WORK, "no-rex-server.sock"), OLO_REX_AGENTS_DIR=os.path.join(WORK, "rex-agents"))
    # This tree's data (icons, fonts, wallpapers), whatever build is
    # pictured: a build made somewhere else finds none beside it, and
    # its desktop comes up with no icons, no wallpaper and the system's
    # fonts. And the desktop's disk by a name of the pictures' own, not
    # this computer's (a dev server's name is nobody's to publish).
    env.update(OLO_DATA=os.path.join(ROOT, "data"), OLO_TRACKER_DEMO_VOLUME="Olo")
    # And its Deskbar as a person's: an agent's screen shows no live
    # widgets and no seconds (nobody sits at it), and these pictures are
    # of a person's desktop.
    env.update(OLO_DESKBAR_DEMO_PERSON="1")
    env.update(software())
    # (Nor the person's coding agents' settings: Terminal's settings for
    # agents write hooks where these point.)
    for k in ("WAYLAND_DISPLAY", "OLO_SOCKET", "OLO_SESSION", "OLO_SESSION_PID", "OLO_REAL_SESSION", "OLO_SCREEN", "DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "CLAUDE_CONFIG_DIR", "CODEX_HOME"):
        env.pop(k, None)
    return env


def software():
    """What makes a screen and its programs draw on the processors, where
    there is no GPU to draw on (a dev server: no render node in /dev/dri)
    or OLO_SHOTS_SOFTWARE=1 says so: as tools/dev/tsession sets it."""
    import glob
    import re

    if os.environ.get("OLO_SHOTS_SOFTWARE") != "1" and glob.glob("/dev/dri/renderD*"):
        return {}
    env = {"OLO_HEADLESS_RENDERER": "software", "LIBGL_ALWAYS_SOFTWARE": "1", "GALLIUM_DRIVER": "llvmpipe", "VK_LOADER_DRIVERS_SELECT": "lvp*"}
    for folder in ("/etc/glvnd/egl_vendor.d", "/usr/share/glvnd/egl_vendor.d"):
        for n in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
            try:
                lib = json.load(open(os.path.join(folder, n)))["ICD"]["library_path"]
            except (OSError, ValueError, KeyError):
                continue
            if isinstance(lib, str) and re.fullmatch(r"libEGL_mesa\.so(?:\.\d+)*", os.path.basename(lib)):
                env["__EGL_VENDOR_LIBRARY_FILENAMES"] = os.path.join(folder, n)
                return env
    sys.exit("readme-shots: no GPU here and no Mesa EGL to draw in software with (mesa's EGL vendor file)")


def screen(*args, run_dir=RUN, name=NAME, check=False):
    """`olo-screen ARGS` on the shots' screen (NAME is put after the verb)."""
    argv = [os.path.join(RELEASE, "olo-screen"), args[0]]
    if args[0] not in ("list",):
        argv.append(name)
    argv += [str(a) for a in args[1:]]
    r = subprocess.run(argv, env=env_for_screens(run_dir), capture_output=True, text=True, timeout=120)
    if check and r.returncode:
        sys.exit(f"olo-screen {' '.join(argv[1:])}: {r.stderr or r.stdout}")
    return r.stdout


def ipc(obj):
    """app_server's IPC on the screen (a line of JSON each way)."""
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(20)
    try:
        s.connect(SCREEN_ENV["OLO_SOCKET"])
        s.sendall((json.dumps(obj) + "\n").encode())
        line = s.makefile().readline()
    finally:
        s.close()
    try:
        return json.loads(line) if line else {}
    except json.JSONDecodeError:
        return {}


def settings(change):
    s = ipc({"type": "get_settings"}).get("settings", {})
    change(s)
    ipc({"type": "set_settings", "settings": s})


def windows():
    return ipc({"type": "list_windows"}).get("windows", [])


def run(*cmd, env=None):
    """A program on the screen, with `env` added (through env(1): the
    screen starts what it's given)."""
    extra = [f"{k}={v}" for k, v in (env or {}).items()]
    screen("run", *(["env", *extra] if extra else []), *cmd)


def wait_for(pick, timeout=20):
    """The first window `pick` takes, once there."""
    until = time.time() + timeout
    while time.time() < until:
        for w in windows():
            if pick(w):
                return w
        time.sleep(0.3)
    sys.exit(f"no window came: {pick.__doc__ or pick}")


def by_app(app, title=None):
    def pick(w):
        return w["app_id"] == app and (title is None or w["title"] == title)

    pick.__doc__ = f"{app} {title or ''}"
    return pick


def activate(w):
    ipc({"type": "activate", "id": w["id"]})
    time.sleep(0.5)


def place(w, x, y, width=None, height=None):
    f = w["frame"]
    ipc({"type": "place", "id": w["id"], "frame": {"x": int(x), "y": int(y), "width": int(width or f["width"]), "height": int(height or f["height"])}})


def close_all():
    for w in windows():
        ipc({"type": "close", "id": w["id"]})
    time.sleep(1.5)
    # (One that asks before it closes: ended by its process, the screen's own.)
    for w in windows():
        try:
            env = open(f"/proc/{w['pid']}/environ", "rb").read()
        except OSError:
            continue
        if f"OLO_SOCKET={SCREEN_ENV['OLO_SOCKET']}".encode() in env.split(b"\0"):
            os.kill(w["pid"], 15)
    time.sleep(1)


def key(*chords):
    for c in chords:
        screen("key", c)


def type_text(text):
    screen("type", text)


def look(theme="light", icons="classic", wallpaper=None):
    """Light or dark (`theme`), in the theme `icons` names (its id:
    classic, platinum, beos, dracula, …), on `wallpaper` (else the
    theme's own)."""
    def change(s):
        a = s["appearance"]
        a["theme"] = theme
        a["look"] = icons
        s["wallpaper"] = wallpaper or next((t["wallpaper"] for t in ipc({"type": "looks"}).get("themes", []) if t["id"] == icons), None)

    settings(change)
    time.sleep(2.5)


def widgets(ws):
    settings(lambda s: s.__setitem__("deskbar", {"widgets": ws}))


def grab(name, crop=None):
    """The screen (or `crop`, in points) as a PIL picture, device pixels."""
    from PIL import Image

    png = os.path.join(WORK, f"{name}.png")
    args = ["look", png, "--no-pointer"]
    if crop:
        args += ["--crop", ",".join(str(int(v)) for v in crop)]
    if os.path.exists(png):
        os.remove(png)
    said = screen(*args, check=True)
    if not os.path.exists(png):
        sys.exit(f"olo-screen look wrote no picture for {name}: {said.strip()[:300]}")
    return Image.open(png).convert("RGB")


def save(im, name, width=None):
    """docs/img/NAME.png: lossless (Ben, 2026-11-16: "zero visual
    artifacts"; the website serves them as lossless WebP), the JPEG from
    before taken away."""
    from PIL import Image

    if width and im.width > width:
        im = im.resize((width, round(im.height * width / im.width)), Image.LANCZOS)
    path = os.path.join(OUT, f"{name}.png")
    im.save(path, optimize=True)
    old = os.path.join(OUT, f"{name}.jpg")
    if os.path.exists(old):
        os.remove(old)
    print(f"{os.path.relpath(path, ROOT)} ({im.width}×{im.height}, {os.path.getsize(path) // 1024} KB)")


def shot(name, crop=None, width=None):
    save(grab(name, crop), name, width)


def settle(seconds=2.5):
    time.sleep(seconds)


