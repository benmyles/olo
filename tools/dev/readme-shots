    {"id": 4, "measure": {"kind": "network", "interface": None, "down": True, "up": True}, "place": "top", "look": "graph", "size": "medium", "hue": "teal"},
    {"id": 5, "measure": {"kind": "memory", "swap": False}, "place": "top", "look": "meter", "size": "small", "hue": "green"},
]


