def start():
    shutil.rmtree(WORK, ignore_errors=True)
    os.makedirs(RUN, mode=0o700)
    subprocess.run([os.path.join(ROOT, "tools/dev/fixture-home"), HOME], check=True, capture_output=True, env=dict(os.environ, PATH="/usr/bin:" + os.environ.get("PATH", "")))
    # A document to show, and some of Olo's own pictures to show in it.
    with open(os.path.join(HOME, "Documents", "Welcome.md"), "w") as f:
        f.write(WELCOME)
    from PIL import Image

    # Olo's own pictures, at their full 4K (a picture fitted to a window
    # on a 2× screen is drawn from all its pixels), and a tall one for
    # Quick Look.
    def wallpaper(name):
        folder = os.path.join(ROOT, "data/wallpapers/4k")
        return next((os.path.join(folder, f"{name}.{x}") for x in ("webp", "png", "jpg") if os.path.exists(os.path.join(folder, f"{name}.{x}"))), None)

    for name, label in [("olo-glass", "Glass"), ("olo-orbit", "Orbit"), ("olo-dunes", "Dunes"), ("olo-halo", "Halo"), ("olo-shapes", "Shapes"), ("olo-ribbons", "Ribbons")]:
        if src := wallpaper(name):
            Image.open(src).convert("RGB").save(os.path.join(HOME, "Pictures", label + ".jpg"), quality=95, subsampling=0)
    if src := wallpaper("olo-shapes"):
        Image.open(src).convert("RGB").crop((0, 0, 1620, 2160)).save(os.path.join(HOME, "Pictures", "Poster.jpg"), quality=95, subsampling=0)
    for old in ("house.jpg", "holiday.png"):
        if os.path.exists(os.path.join(HOME, "Pictures", old)):
            os.remove(os.path.join(HOME, "Pictures", old))
    # (`--size` is in points.)
    out = screen("start", "--size", f"{W}x{H}", "--scale", str(SCALE), check=True)
    print(out.strip()[:200])
    SCREEN_ENV.update(dict(line.split("=", 1) for line in screen("env").replace("export ", "").split("\n") if "=" in line))
    for k, v in list(SCREEN_ENV.items()):
        SCREEN_ENV[k] = v.strip().strip("'\"")
    if "OLO_SOCKET" not in SCREEN_ENV:
        sys.exit(f"the screen's environment has no OLO_SOCKET: {SCREEN_ENV}")
    time.sleep(6)
    # Nothing locks, blanks or sleeps the screen while the scenes run.
    settings(lambda s: s.update(power=dict(s.get("power", {}), display_off_minutes=0, sleep_minutes=0, lock_on_display_off=False), screen_saver=dict(s.get("screen_saver", {}), enabled=False, lock=False)))


def stop():
    screen("stop")
    # `olo-screen stop` can leave processes behind (docs/AGENT-NOTES.md):
    # end, by pid, what still has this screen's socket.
    mine = f"OLO_SOCKET={SCREEN_ENV.get('OLO_SOCKET', '-')}".encode()
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if mine in open(f"/proc/{pid}/environ", "rb").read().split(b"\0"):
                os.kill(int(pid), 15)
        except OSError:
            pass


