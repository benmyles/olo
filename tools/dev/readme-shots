def scene_agents():
    """Agent Screens: an agent's screen of its own beside the person's
    desktop. Its runtime folder is a private one, so only this demo's
    screen is listed (the computer's own agents' screens never are)."""
    run_dir = os.path.join(WORK, "run")
    os.makedirs(run_dir, mode=0o700, exist_ok=True)
    env = dict(os.environ, XDG_RUNTIME_DIR=run_dir, HOME=HOME, PATH=os.path.join(ROOT, "target/release") + ":" + os.environ.get("PATH", ""))
    for k in ("WAYLAND_DISPLAY", "OLO_SOCKET", "OLO_SESSION", "OLO_SESSION_PID", "OLO_REAL_SESSION", "OLO_SCREEN", "DBUS_SESSION_BUS_ADDRESS"):
        env.pop(k, None)
    screen = lambda *a: subprocess.run([os.path.join(ROOT, "target/release/olo-screen"), *a], env=env, capture_output=True, text=True)
    screen("stop", "research")
    print(screen("start", "research", "--size", "1280x800").stdout.strip()[:200])
    screen("run", "research", "olo-styled-edit", os.path.join(HOME, "Documents", "Welcome.md"))
    screen("run", "research", "olo-tracker", HOME)
    time.sleep(6)
    close_all()
    widgets(DESKBAR_WIDGETS)
    look("light")
    run("olo-screen", env={"XDG_RUNTIME_DIR": run_dir, "WAYLAND_DISPLAY": f"/run/user/{os.getuid()}/{DISPLAY}"})
    viewer = wait_for(lambda w: w["app_id"] == "olo.screen")
    place(viewer, 40, 50, 1350, 960)
    settle(6)
    shot("olo-agent-screens")
    screen("stop", "research")


SCENES = {
    "desktop": scene_desktop,
    "themes": scene_themes,
    "apps": scene_apps,
    "preferences": scene_preferences,
    "features": scene_features,
    "activity": scene_activity,
    "agents": scene_agents,
}


def start():
    shutil.rmtree(WORK, ignore_errors=True)
    os.makedirs(WORK)
    subprocess.run([os.path.join(ROOT, "tools/dev/fixture-home"), HOME], check=True, capture_output=True, env=dict(os.environ, PATH="/usr/bin:" + os.environ.get("PATH", "")))
    # A document to show.
    with open(os.path.join(HOME, "Documents", "Welcome.md"), "w") as f:
        f.write(WELCOME)
    ts("stop", NAME)
    # (What the session's apps kept from a run before: DeskCalc's sum.)
    shutil.rmtree(f"/tmp/olo-dev/{NAME}", ignore_errors=True)
    out = ts("start", NAME, f"{SIZE[0]}x{SIZE[1]}", "--scale", str(SCALE), "--session", "--shell", "--home", HOME, check=True)
    global DISPLAY
    DISPLAY = out.split(":")[1].split()[0] if ":" in out else ""
    time.sleep(6)


DISPLAY = ""

WELCOME = """# Welcome to Olo

A desktop in the spirit of **BeOS**, written in Rust for Wayland.

## What's here

- **Tracker**, spatial folders with columns, lists and icons
- **Deskbar**, with live widgets for the processor, network and memory
- **StyledEdit**, **Terminal**, **DeskCalc** and the **Viewer**
- Light, dark and night modes, and ten themes

## Shortcuts

| Keys | What it does |
|------|--------------|
| ⌘ Space | The command palette |
| ⌃ ⌃ | Keyboard hints |
| ⌃ Space | The overview |

> Every part is native and shares one kit, so it all looks and feels
> the same, and nothing ever makes you wait.
"""

if __name__ == "__main__":
    wanted = sys.argv[1:] or list(SCENES)
    start()
    try:
        for s in wanted:
            print(f"== {s}")
            SCENES[s]()
    finally:
        ts("stop", NAME)
