def end_stand_ins():
    """The coding agents' stand-ins on the screen, ended (by pid: what has
    this screen's socket and one of their names)."""
    mine = f"OLO_SOCKET={SCREEN_ENV['OLO_SOCKET']}".encode()
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if open(f"/proc/{pid}/comm").read().strip() in ("claude", "codex", "sleep") and mine in open(f"/proc/{pid}/environ", "rb").read().split(b"\0"):
                os.kill(int(pid), 15)
        except OSError:
            pass
    time.sleep(1.5)


def where(role, name):
    """Where the screen's tree has a `role` whose name starts with `name`:
    (x, y, width, height), or None."""
    import re

    for line in screen("tree").split("\n"):
        m = re.match(r'\s*(\w+) "([^"]*)".* at (-?\d+),(-?\d+) (\d+)x(\d+)', line)
        if m and m.group(1) == role and m.group(2).startswith(name):
            return tuple(int(v) for v in m.groups()[2:])
    return None


def debug(name):
    """With OLO_SHOTS_DEBUG set: the tree's lines and the screen as it
    is, kept in the work folder (to see a scene's steps while making it)."""
    if os.environ.get("OLO_SHOTS_DEBUG"):
