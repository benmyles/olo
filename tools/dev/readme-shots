def scene_installer():
    """Olo's Installer, on a made-up stock Fedora (`OLO_SETUP_DEMO`:
    Begin installs nothing): one full-screen program, its licence agreed
    to, ready to begin. The picture is the screen's middle, the window
    and the ground round it."""
    close_all()
    widgets([])
    look("light", wallpaper=DESKTOP_WALLPAPER)
    run("olo-installer", env={"OLO_SETUP_DEMO": "done"})
    wait_for(by_app("olo.installer"))
    settle(3)
    screen("click", "--role", "Button", "--name", "Agree")
    settle(3)
    # Its window is drawn in one surface that covers the screen: found as
    # what isn't the ground's colour, and the picture cut 16:10 round it.
    from PIL import ImageChops, Image

    full = grab("olo-installer")
    ground = Image.new("RGB", full.size, full.getpixel((8, 8)))
    x0, y0, x1, y1 = ImageChops.difference(full, ground).getbbox()
    cw = min(full.width, max(round((x1 - x0) * 1.9), 1920))
    ch = min(full.height, round(cw * 10 / 16))
    x = min(max(0, (x0 + x1) // 2 - cw // 2), full.width - cw)
    y = min(max(0, (y0 + y1) // 2 - ch // 2), full.height - ch)
    save(full.crop((x, y, x + cw, y + ch)), "olo-installer")


