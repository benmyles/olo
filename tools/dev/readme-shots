THEMES = [("bebox", "light"), ("soft-be", "light"), ("toybox", "dark"), ("papercraft", "light"), ("enamel", "dark"), ("halftone", "light"), ("cube", "dark"), ("platinum", "light"), ("workbench", "light"), ("classic", "dark")]


def grab(name, crop=None):
    from PIL import Image

    png = os.path.join(WORK, f"{name}.png")
    args = ["shot", NAME, png]
    if crop:
        args += [str(int(v)) for v in crop]
    ts(*args, check=True)
    return Image.open(png).convert("RGB")


def save(im, name, width=None):
    from PIL import Image

    if width and im.width > width:
        im = im.resize((width, round(im.height * width / im.width)), Image.LANCZOS)
    path = os.path.join(OUT, f"{name}.jpg")
    im.save(path, quality=90, subsampling=0, optimize=True)
    print(f"{path} ({im.width}×{im.height}, {os.path.getsize(path) // 1024} KB)")


def scene_themes():
    """The desktop in each of the ten themes, five by two, in the
    Themes panel's order."""
    from PIL import Image

    close_all()
    widgets(DESKBAR_WIDGETS)
    look("light")
    desktop_windows()
    tiles = []
    for icons, mode in THEMES:
        look(mode, icons)
        settle(3)
        tiles.append(grab(f"theme-{icons}").resize((640, 400), Image.LANCZOS))
    gap = 10
    sheet = Image.new("RGB", (5 * 640 + 4 * gap, 2 * 400 + gap), (128, 128, 128))
    for i, t in enumerate(tiles):
        sheet.paste(t, ((i % 5) * (640 + gap), (i // 5) * (400 + gap)))
    save(sheet, "olo-themes")
    look("light")


def frame_of(w):
    f = w["frame"]
    return (f["x"] - 16, f["y"] - 16, f["width"] + 32, f["height"] + 32)


