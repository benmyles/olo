def sh(*args, check=False):
    env = dict(os.environ)
    for k in ("WAYLAND_DISPLAY", "OLO_SOCKET", "OLO_SESSION", "OLO_SESSION_PID", "OLO_REAL_SESSION"):
        env.pop(k, None)
    env["TSESSION_PROFILE"] = PROFILE
    r = subprocess.run(["/usr/bin/python3", TSESSION, *args], capture_output=True, text=True, env=env)
    if check and r.returncode:
        raise RuntimeError(f"tsession {' '.join(args)}: {r.stderr or r.stdout}")
    return r.stdout


def session_env(name):
    return json.load(open(os.path.join(BASE, name, "env.json")))


def ipc(name, req):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(5)
    try:
        s.connect(session_env(name)["OLO_SOCKET"])
    except OSError as e:
        # (A socket that isn't there says only "No such file or directory",
        # of no file: a push was refused with that and nothing else to go
        # by, 2026-11-22. It is the session's window server that is gone.)
        raise RuntimeError(f"the session's app_server isn't there to ask {req.get('type')} of ({e.strerror or e}): it has ended, or crashed") from e
    s.sendall((json.dumps(req) + "\n").encode())
    a = s.makefile().readline()
    s.close()
    return json.loads(a or "{}")


KEPT = os.path.join(BASE, "ui-lint-kept")


def keep_failed(name, home):
    """What a session whose lint failed leaves behind, kept where it can
    be read after the run has removed the session: its logs (the app's,
    its window server's), how it was started, and what crashed in it.
    The newest five; where they are."""
    import glob
    import shutil
    kept = os.path.join(KEPT, f"{time.strftime('%Y%m%d-%H%M%S')}-{name}")
    try:
        os.makedirs(kept, exist_ok=True)
        for src in glob.glob(os.path.join(BASE, name, "*.log")) + glob.glob(os.path.join(BASE, name, "*.json")):
            shutil.copy(src, kept)
        crashes = os.path.join(home, ".local/state/olo/crashes")
        if os.path.isdir(crashes):
            shutil.copytree(crashes, os.path.join(kept, "crashes"), dirs_exist_ok=True)
        for old in sorted(os.listdir(KEPT))[:-5]:
            shutil.rmtree(os.path.join(KEPT, old), ignore_errors=True)
    except OSError:
        pass
    return kept


def ask_app(pid, req, timeout=6):
    path = os.path.join(RUNTIME, f"olo-menus-{pid}.sock")
    if not os.path.exists(path):
        return None
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(timeout)
    try:
        s.connect(path)
        s.sendall((json.dumps(req) + "\n").encode())
        return json.loads(s.makefile().readline() or "null")
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def ours(pid, home):
    """A process of this run's (its HOME is ours): the only kind killed."""
    try:
        return f"HOME={home}" in open(f"/proc/{pid}/environ").read().split("\0")
    except OSError:
        return False


def pids_of(exe, home):
    out = []
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                if os.path.basename(os.readlink(f"/proc/{p}/exe")).removesuffix(" (deleted)") == exe and ours(int(p), home):
                    out.append(int(p))
            except OSError:
                pass
    return out


def windows_of(name, pid):
    return [w for w in ipc(name, {"type": "list_windows"}).get("windows", []) if w.get("pid") == pid]


def review(pid, layers):
    found = []
    for w in ask_app(pid, {"review": True}, timeout=8) or []:
        if w.get("layer") and not layers:
            continue
        for f in w["findings"]:
            found.append((w.get("layer") or w["title"], f))
    return found


def tabs(name, pid):
    """Each window's tabs not shown: (window title, tab name, x, y) in
    global logical coordinates, to click."""
    out = []
    wins = {w["title"]: w for w in windows_of(name, pid)}
    for tree in ask_app(pid, {"tree": True}) or []:
        nodes = tree.get("nodes", [])
        title = nodes[0].get("name") if nodes else None
        w = wins.get(title)
        if not w:
            continue
        for n in nodes:
            if n.get("role") == "Tab" and not n.get("selected") and n.get("clickable"):
                out.append((title, n.get("name"), w["content"]["x"] + n["x"] + n["width"] / 2, w["content"]["y"] + n["y"] + n["height"] / 2))
    return out


# (One for each place builds are: another's results neither taken nor
# written over.)
CACHE = os.path.join(os.path.expanduser("~"), ".cache/olo-dev", "ui-lint.json" if "CARGO_TARGET_DIR" not in os.environ else f"ui-lint-{hashlib.sha1(os.environ['CARGO_TARGET_DIR'].encode()).hexdigest()[:12]}.json")


def stamp(path):
    """A build's identity without reading it: cargo writes a new file (a
    new inode and time) whenever it links it again."""
    try:
        st = os.stat(path)
        return f"{st.st_size}:{st.st_mtime_ns}:{st.st_ino}"
    except OSError:
        return "missing"


def signature(exe, screen, scales, show_review, tiles=False):
    """What an app's lint depends on: its build, app_server's, the fake
    sound server's, the lint's own scripts and how it's run."""
    h = hashlib.sha256()
    for f in ("tools/dev/ui-lint", "tools/dev/tsession", "tools/dev/fixture-home"):
        try:
            h.update(open(os.path.join(ROOT, f), "rb").read())
        except OSError:
            pass
    for b in (exe, "olo-app-server", "olo-fakesound"):
        h.update(stamp(os.path.join(TARGET, PROFILE, b)).encode())
    h.update(f"{screen}|{scales}|{show_review}|{tiles}|{PROFILE}".encode())
    return h.hexdigest()


def load_cache():
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return {}


def cache_key(app, screen, scales, show_review, tiles):
    """An app's results for one way of running it: each kept apart (one
    entry an app, the pre-push hook's runs on five screens put each
    other's out, and every app was run again every time)."""
    return f"{app}|{screen}@{scales}|{'tiles' if tiles else ''}|{'review' if show_review else ''}|{PROFILE}"


def save_cache(entries):
    """`entries` added to what's kept, read again first under a lock (a
    run beside this one keeps its own meanwhile)."""
    import fcntl
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # (Entries from before they were kept apart, by the app alone: gone.)
        cache = {k: v for k, v in load_cache().items() if "|" in k}
        cache.update(entries)
        tmp = CACHE + ".new"
        json.dump(cache, open(tmp, "w"), indent=1)
        os.replace(tmp, CACHE)


def person_screens():
    """The person's screens as `WxH@S`: each one's size in pixels as it's
    turned, and its scale, from their session's app_server (`outputs`, at
    $OLO_SOCKET; only that is asked). None without a session."""
    path = os.environ.get("OLO_SOCKET")
    if not path:
        return []
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(3)
        s.connect(path)
        s.sendall(b'{"type":"outputs"}\n')
        reply = json.loads(s.makefile().readline())
        s.close()
    except (OSError, ValueError):
        return []
    out = []
    for o in reply.get("outputs") or []:
        mode = o.get("current_mode")
        if not mode:
            continue
        w, h = mode["width"], mode["height"]
        if o.get("rotation") in (90, 270):
            w, h = h, w
        item = f"{w}x{h}@{o.get('scale', 1):g}"
        if item not in out:
            out.append(item)
    return out


def gone(exe, home, within=5.0):
    """Wait for this run's `exe` to have quit (asked with SIGTERM): one
    still closing takes the next app's arguments (single-instance apps:
    Preferences), and its window never comes. Killed past `within`."""
    end = time.time() + within
    while time.time() < end:
        if not pids_of(exe, home):
            return
        time.sleep(0.1)
    for p in pids_of(exe, home):
        try:
            os.kill(p, 9)
        except OSError:
            pass
    time.sleep(0.2)


def set_look(name, theme, scale, look=None):
    """The session's look and scale, at once (as `tsession theme` and
    `scale` do, without their waits)."""
    st = ipc(name, {"type": "get_settings"})["settings"]
    st["appearance"]["theme"] = "dark" if theme == "night" else theme
    if look is not None:
        st["appearance"]["look"] = look
        st["appearance"]["night_light"]["mode"] = "on" if theme == "night" else "off"
    st["display"]["scale"] = scale
    for o in st["display"].get("outputs", {}).values():
        o.pop("scale", None)
    ipc(name, {"type": "set_settings", "settings": st})


def thread_waits(pid):
    """Seconds each live thread has spent runnable and waiting for a CPU."""
    waits = {}
    try:
        tids = os.listdir(f"/proc/{pid}/task")
    except OSError:
        return waits
    for tid in tids:
        try:
            with open(f"/proc/{pid}/task/{tid}/schedstat") as f:
                waits[tid] = int(f.read().split()[1]) / 1e9
        except (OSError, ValueError, IndexError):
            pass
    return waits


class Deadline:
    """Bound a wait for idle-priority processes. Their main threads can be
    asleep while a worker needs a CPU. Allow the longest measured runnable
    delay in each process, up to max_delay seconds in total."""

    def __init__(self, within, max_delay, *pids):
        self.nominal = time.monotonic() + within
        self.limit = self.nominal + max_delay
        self.check_at = self.nominal
        self.before = {pid: thread_waits(pid) for pid in pids if pid}
        self.delays = {}

    def reached(self, *launched):
        now = time.monotonic()
        if now < self.check_at:
            return False
        if now >= self.limit:
            return True
        # Charge simultaneous thread waits once per process. A thread that
        # exits later cannot take back an allowance already measured.
        for pid in (*self.before, *launched):
            before = self.before.get(pid, {})
            longest = max((w - before.get(t, 0.0) for t, w in thread_waits(pid).items()), default=0.0)
            self.delays[pid] = max(self.delays.get(pid, 0.0), longest)
        self.check_at = min(self.limit, self.nominal + sum(self.delays.values()))
        return now >= self.check_at


def drawn(pid, layers, scale=None, dark=None, within=6.0, *, server=None):
    """The app's review once its windows are drawn (at `scale`, in the look
    `dark` says, when given): asked again until they are, never waited
    for longer than it takes. A ready sample gets one confirmation. A deadline
    with replies but no settled review is a test-harness failure."""
    deadline = Deadline(within, 60, pid, server)
    last = None
    settled = None
    while True:
        final_check = deadline.reached()
        if final_check and settled is None:
            break
        wins = [w for w in (ask_app(pid, {"review": True}, timeout=8) or []) if layers or not w.get("layer")]
        if wins:
            last = wins
            # (Twice the same: a window that follows what it shows resizes
            # a frame after the scale changes, and is asked again.)
            sizes = sorted((w.get("layer") or w["title"], w["width"], w["height"]) for w in wins)
            # (Nor one on its way to another size, laid out for what it's
            # about to show: `resizing`. Twice the same size isn't enough
            # on a busy machine, where the new size is slow in coming.)
            if all((scale is None or abs(w.get("scale", 0) - scale) < 0.01) and (dark is None or w.get("dark", dark) == dark) and not w.get("resizing") for w in wins):
                if sizes == settled:
                    return [(w.get("layer") or w["title"], f) for w in wins for f in w["findings"]]
                settled = sizes
            else:
                settled = None
        else:
            settled = None
        if final_check:
            break
        time.sleep(0.05)
    if last is None and scale is None and dark is None:
        return None
    state = [(w.get("layer") or w["title"], w["width"], w["height"], w.get("scale"), w.get("dark"), w.get("resizing", False)) for w in (last or [])]
    raise TimeoutError(f"review did not settle for pid {pid} (scale={scale}, dark={dark}), last (title, width, height, scale, dark, resizing)={state}")


def click(name, x, y):
    """A click at (x, y), as `tsession click` makes it (two motions: the
    first after a popup's grab only ends it)."""
    ipc(name, {"type": "synthetic", "events": [{"type": "move", "x": x - 1, "y": y}]})
    ipc(name, {"type": "synthetic", "events": [{"type": "move", "x": x, "y": y}]})
    ipc(name, {"type": "synthetic", "events": [{"type": "button", "button": 0x110, "pressed": True}, {"type": "button", "button": 0x110, "pressed": False}]})


def escape(name):
    """Escape pressed: a menu a tab opened (Telegram's More) closed
    before the next is clicked or pictured."""
    ipc(name, {"type": "synthetic", "events": [{"type": "key", "key": 1, "pressed": True}, {"type": "key", "key": 1, "pressed": False}]})


def selected_tab(pid, title):
    """The tab shown in window `title`'s first tab view (None: it has
    none)."""
    for tree in ask_app(pid, {"tree": True}) or []:
        nodes = tree.get("nodes", [])
        if nodes and nodes[0].get("name") == title:
            return next((n.get("name") for n in nodes if n.get("role") == "Tab" and n.get("selected")), None)
    return None


def chosen(pid, tab, within=3.0):
    """Wait for `tab` to be the one shown."""
    end = time.time() + within
    while time.time() < end:
        for tree in ask_app(pid, {"tree": True}) or []:
            if any(n.get("role") == "Tab" and n.get("name") == tab and n.get("selected") for n in tree.get("nodes", [])):
                return True
        time.sleep(0.05)
    return False


# The layouts a tiling window is checked in (CLAUDE.md, "Every tiling
# layout"): parts of the display's tiling area (x, y, width, height).
LAYOUTS = [
    ("zoomed", (0.0, 0.0, 1.0, 1.0)),
    ("a vertical half", (0.0, 0.0, 0.5, 1.0)),
    ("a horizontal half", (0.0, 0.0, 1.0, 0.5)),
    ("a quarter", (0.0, 0.0, 0.5, 0.5)),
    ("a vertical third", (0.0, 0.0, 1.0 / 3.0, 1.0)),
    ("a horizontal third", (0.0, 2.0 / 3.0, 1.0, 1.0 / 3.0)),
]


def tiled(name, pid, wid, part, within=8.0, *, server=None):
    """Window `wid` tiled into `part` of its display's tiling area, as
    app_server's tiling puts it, and its frame once it has drawn there (or
    the size it keeps, its least): (frame, tile, least). None if app_server
    never had it settle."""
    area = ipc(name, {"type": "arrangement"}).get("area")
    if not area:
        return None
    ipc(name, {"type": "arrange", "windows": [{"id": wid, "x": part[0], "y": part[1], "w": part[2], "h": part[3]}]})
    tile = (area["x"] + area["width"] * part[0], area["y"] + area["height"] * part[1], area["width"] * part[2], area["height"] * part[3])
    deadline = Deadline(within, 30, pid, server)
    last, same = None, 0
    while not deadline.reached():
        w = next((w for w in windows_of(name, pid) if w["id"] == wid), None)
        if w and w.get("frame") and not w.get("settling"):
            f = w["frame"]
            now = (f["x"], f["y"], f["width"], f["height"])
            # (Twice the same, settled: there, or as near as its least
            # size lets it be.)
            same = same + 1 if now == last else 0
            last = now
            if same >= 2:
                return now, tile, w.get("least")
        time.sleep(0.05)
    return None


def picture(name, wid, scale, out):
    """A picture of window `wid` as it shows (its frame, tab and border
    with it), at `out`."""
    tmp = os.path.join(BASE, name, "tile-shot.png")
    r = ipc(name, {"type": "screenshot", "path": tmp})
    w = next((w for w in ipc(name, {"type": "list_windows"}).get("windows", []) if w["id"] == wid), None)
    if not r or r.get("type") != "ok" or not w or not w.get("frame"):
        return
    from PIL import Image
    f = w["frame"]
    box = tuple(round(v * scale) for v in (f["x"], f["y"], f["x"] + f["width"], f["y"] + f["height"]))
    Image.open(tmp).crop(box).save(out)


def slug(text):
    return "".join(c if c.isalnum() else "-" for c in text.lower()).strip("-")


def lint_one(spec, slot, master, screen, scales, show_review, work, all_themes=False, tiles=False, shots=None, where=""):
    """One app, in a headless session of its own (a copy of the made-up
    home, its own sound server): what it found, as (errors, reviews, lines
    to print). `where`: the screen it's on, said after its name."""
    app, _, env, layers = spec
    home = os.path.join(work, f"home{slot}")
    name = f"uilint{os.getpid() % 100000}s{slot}"
    subprocess.run(["cp", "-a", "--reflink=auto", master, home], check=True)
    # (The made-up home's paths in the app's arguments, this copy's.)
    argv = [a.replace(master, home) for a in spec[1]]
    env = {k: v.replace(master, home) for k, v in env.items()}
    pulse = os.path.join(work, f"pulse{slot}.sock")
    fakesound = subprocess.Popen([os.path.join(TARGET, PROFILE, "olo-fakesound"), pulse], env=dict(os.environ, FAKESOUND_AIRPODS="AA:BB:CC:DD:EE:FF"),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    lines = []
    fake = None
    try:
        # (--owner: the session ends with this run, killed or not.)
        # (At 2×, as most screens are; at the first scale asked for when
        # 2× isn't one, so the screen is the size asked at it: 1280x800 at
        # 1× opened at 2× was 640 × 400 points, and the windows opened on
        # it stayed that cramped at 1×.)
        first = "2" if 2 in scales else f"{scales[0]:g}"
        sh("start", name, screen, "--light", "--scale", first, "--home", home, "--owner", str(os.getpid()), check=True)
        if "@session-bus" in env.values():
            bus = f"unix:path={BASE}/{name}/bus"
            env = {k: (bus if v == "@session-bus" else v) for k, v in env.items()}
            fake = subprocess.Popen([os.path.join(TARGET, PROFILE, "dnf-fake"), "--address", bus], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            # (On the bus before the app asks for it.)
            try:
                import dbus
                b = dbus.bus.BusConnection(bus)
                end = time.time() + 5
                while time.time() < end and not b.name_has_owner("org.rpm.dnf.v0"):
                    time.sleep(0.05)
            except Exception:
                time.sleep(0.5)
        sh("run", name, f"HOME={home}", f"PULSE_SERVER=unix:{pulse}", "OLO_NO_FINGERPRINT=1", "OLO_ACTIVITY_HELPER=off", "OLO_DOCTOR_HELPER=off", *[f"{k}={v}" for k, v in env.items()], *argv)
        exe = argv[0]
        pid = None
        # 20 s for its window, not counting what the app and the
        # session's window server spent waiting for a processor (two
        # minutes of that at most).
        try:
            with open(os.path.join(BASE, name, "env.json")) as f:
                server = json.load(f).get("pid")
        except (OSError, ValueError):
            server = None
        deadline = Deadline(20, 120, server)
        while True:
            ps = pids_of(exe, home)
            # Its windows on screen, as app_server has them: drawn, and no
            # new size on its way (`settling`). An app answers the review
            # for the size it has drawn itself before app_server has its
            # first frame; the look changed then, Disk Usage was reviewed
            # at another size (tools/dev/first-frame-check).
            shown = [w for w in windows_of(name, ps[0]) if (w.get("content") or {}).get("width", 0) > 0] if ps and not layers else []
            if ps and (layers or (shown and not any(w.get("settling") for w in shown))):
                pid = ps[0]
                break
            if deadline.reached(*ps[:1]):
                break
            time.sleep(0.1)
        if pid is None or drawn(pid, layers, server=server) is None:
            alive = pids_of(exe, home)
            log = os.path.join(BASE, name, f"{os.path.basename(exe)}.log")
            try:
                said = [l.rstrip() for l in open(log, errors="replace") if "resvg" not in l][-6:]
            except OSError:
                said = []
            lines.append(f"{app}{where}: no window came up ({'running: ' + ', '.join(map(str, alive)) if alive else 'not running'})")
            lines += [f"    {l[:200]}" for l in said]
            return 1, 0, lines
        # Each finding once, with the looks it came up in.
        seen = {}
        theme_ids = [None]
        if all_themes:
            theme_ids = [item["id"] for item in ipc(name, {"type": "looks"})["themes"]]
        for look, theme in ((look, mode) for look in theme_ids for mode in (("light", "dark", "night") if all_themes else ("light", "dark"))):
            for scale in scales:
                set_look(name, theme, scale, look)
                looks = [(None, drawn(pid, layers, scale, theme != "light", server=server))]
                for title, tab, x, y in tabs(name, pid):
                    click(name, x, y)
                    chosen(pid, tab)
                    looks.append((tab, drawn(pid, layers, scale, theme != "light", server=server)))
                for tab, found in looks:
                    if found is None:
                        raise RuntimeError(f"{look or 'default'} {theme} {scale:g}×: no review returned")
                    for window, f in found:
                        key = (f["level"], window, tab, f["kind"], f["text"])
                        seen.setdefault(key, []).append(f"{look + ' ' if look else ''}{theme} {scale:g}×")
        # Each window that tiles, in each layout (`--tiles`): reviewed
        # there, every tab, at the first scale, light.
        tiled_windows = []
        if tiles and not layers:
            # (At the scale the session started at, so the screen is the
            # size in points asked for: 2560x1600 at 2× is the smallest,
            # 1280 × 800.)
            scale = float(first)
            set_look(name, "light", scale)
            drawn(pid, layers, scale, False, server=server)
            for w in windows_of(name, pid):
                if w.get("floating") or w.get("floats_always"):
                    continue
                tiled_windows.append(w["title"])
                for layout, part in LAYOUTS:
                    got = tiled(name, pid, w["id"], part, server=server)
                    if got is None:
                        seen.setdefault(("Error", w["title"], None, "tiling", f"never settled in {layout}"), []).append(f"{scale:g}×")
                        continue
                    frame, tile, least = got
                    # Its least size (its frame's, tab and border with it)
                    # more than the tile: kept bigger than it, or squeezed
                    # under what it says it needs (app_server gives it the
                    # tile either way, and what it draws is cut).
                    over = frame[2] > tile[2] + 2 or frame[3] > tile[3] + 2
                    if over or (least and (least[0] > frame[2] or least[1] > frame[3])):
                        what = f"its least size, {least[0]} × {least[1]}," if least else "it"
                        key = ("Error", w["title"], None, "tile-fit", f"{what} is more than {layout}'s tile, {min(frame[2], tile[2]):.0f} × {min(frame[3], tile[3]):.0f}")
                        seen.setdefault(key, []).append(f"{scale:g}×")
                    looks = [(None, drawn(pid, layers, scale, False, server=server))]
                    shot = lambda tab: shots and picture(name, w["id"], scale, os.path.join(shots, f"{slug(app)}-{slug(layout)}{'-' + slug(tab) if tab else ''}.png"))
                    shot(shots and selected_tab(pid, w["title"]))
                    for title, tab, x, y in tabs(name, pid):
                        if title != w["title"]:
                            continue
                        click(name, x, y)
                        chosen(pid, tab)
                        looks.append((tab, drawn(pid, layers, scale, False, server=server)))
                        shot(tab)
                        escape(name)
                    for tab, found in looks:
                        for window, f in found or []:
                            key = (f["level"], window, tab, f["kind"], f["text"])
                            seen.setdefault(key, []).append(f"{layout}")
        app_errors = [k for k in seen if k[0].lower() == "error"]
        app_reviews = [k for k in seen if k[0].lower() != "error"]
        lines.append(f"{app}{where}: {len(app_errors)} errors" + (f", {len(app_reviews)} to look at" if show_review else "")
                     + (f" (tiled in each layout: {', '.join(tiled_windows) or 'none, as its windows float'})" if tiles and not layers else ""))
        for key in app_errors + (app_reviews if show_review else []):
            level, window, tab, kind, text = key
            lines.append(f"  - {level.lower()} {kind} in {window}{' ▸ ' + tab if tab else ''}: {text} ({', '.join(seen[key])})")
        return len(app_errors), len(app_reviews), lines
    except Exception as x:
        # (What it left is kept, and said: the session is gone after this.)
        x.add_note(f"what its session left is kept in {keep_failed(name, home)}")
        raise
    finally:
        try:
            sh("stop", name, check=True)
        finally:
            fakesound.terminate()
            if fake:
                fake.terminate()
        # (Its session folder too: /tmp is memory.)
        subprocess.run(["rm", "-rf", home, os.path.join(BASE, name)])


# One allowance of waiting for room for the whole run, a quarter of an
# hour, taken by whichever sessions wait (one at a time: the next looks
# when the one before it goes on).
ROOM = threading.Lock()
ROOM_WAITED = [0.0]
ROOM_ALLOWED = 900.0


def processors_short():
    """How short the machine's processors are: the kernel's own count
    (/proc/pressure/cpu), the share of the last ten seconds in which
    something waited for one, in percent; none where it doesn't say."""
    try:
        return float(open("/proc/pressure/cpu").readline().split("avg10=")[1].split()[0])
    except (OSError, IndexError, ValueError):
        return None


def wait_for_room(what, short=processors_short, sleep=time.sleep):
    """Waits to begin a session until the machine has room for it: while
    its processors are short (for a quarter of the last ten seconds
    something waited for one), then goes on. Idle priority keeps a
    session's processor time behind everyone's, but not its drawing: the
    GPU is shared with the person's desktop, and what waits there is
    theirs.

    The whole run waits a quarter of an hour at most, all its sessions
    together, and then goes on at whatever pace the machine gives it. It
    was a quarter of an hour before *each* session: with the machine kept
    busy all day by other work (a load of 30 to 80, 2026-11-21 and 22), a
    push's lint of a dozen apps had no bound short of hours (2442 s, then
    a session timed out)."""
    with ROOM:
        said = False
        while ROOM_WAITED[0] < ROOM_ALLOWED:
            avg10 = short()
            if avg10 is None or avg10 < 25.0:
                return
            if not said and ROOM_WAITED[0] == 0.0:
                print(f"ui-lint: waiting for the machine to have room before {what} (processors short {avg10:.0f}% of the last 10 s)", file=sys.stderr, flush=True)
            said = True
            sleep(5)
            ROOM_WAITED[0] += 5
            if ROOM_WAITED[0] >= ROOM_ALLOWED:
                print(f"ui-lint: waited {ROOM_ALLOWED / 60:.0f} minutes in all for room; going on without (the sessions are at idle priority)", file=sys.stderr, flush=True)


def main():
    a = sys.argv[1:]
    show_review = "--review" in a
    keep = "--keep" in a
    use_cache = "--no-cache" not in a
    scales = [float(s) for s in (a[a.index("--scales") + 1].split(",") if "--scales" in a else ["1", "1.5", "2"])]
    tiles = "--tiles" in a
    if "--person-screens" in a:
        print(",".join(person_screens()))
        return 0
    shots = os.path.abspath(a[a.index("--shots") + 1]) if "--shots" in a else None
    if shots:
        os.makedirs(shots, exist_ok=True)
    screen = a[a.index("--screen") + 1] if "--screen" in a else "3024x1964"
    # The screens each app is run on, each with its scales: --screens'
    # (each at its own scale), else --screen at --scales.
    runs = [(screen, tuple(scales))]
    if "--screens" in a:
        runs = []
        for item in a[a.index("--screens") + 1].split(","):
            size, _, at = item.strip().partition("@")
            if not size:
                continue
            run = (size, (float(at or 2),))
            if run not in runs:
                runs.append(run)
    where = lambda run: f" on {run[0]} at {run[1][0]:g}×" if len(runs) > 1 else ""
    jobs = int(a[a.index("--jobs") + 1]) if "--jobs" in a else max(2, min(4, (os.cpu_count() or 4) // 4))
    # Background work beside the person's desktop: the lint and every
    # session it starts at idle priority (they inherit it), so they take
    # only the processor time nothing else wants. Run by the pre-push
    # hook, a dozen sessions at once loaded the computer while the person
    # worked (2026-11-15: app_server was ended mid-lint, its realtime
    # loop past rtkit's hard limit, the likeliest cause; HACKING, "Fast
    # and light").
    try:
        os.nice(19)
        os.sched_setscheduler(0, os.SCHED_IDLE, os.sched_param(0))
    except (OSError, AttributeError):
        pass
    picked = [x for i, x in enumerate(a) if not x.startswith("--") and (i == 0 or a[i - 1] not in ("--scales", "--screen", "--screens", "--jobs", "--shots"))]
    work = f"/var/tmp/olo-live-lint-{os.getpid()}"
    master = os.path.join(work, "home")
    specs = apps(master)
    if "--list" in a:
        print("\n".join(s[0] for s in specs))
        return 0
    if picked:
        # ("Disk Usage", "disk-usage" and "diskusage" are one.)
        norm = lambda x: "".join(c for c in x.lower() if c.isalnum() or c == ":")
        want = {norm(p) for p in picked}
        specs = [s for s in specs if norm(s[0]) in want]
        if not specs:
            print("ui-lint: none of those has a window to lint")
            return 0
    # Those whose build and lint are as when they came out clean: not again.
    all_themes = "--all-themes" in a
    cache = load_cache() if use_cache and not all_themes and not shots else {}
    # (Each app on each screen, a job.)
    jobs_all = [(s, run) for run in runs for s in specs]
    keys = {(s[0], run): cache_key(s[0], run[0], ",".join(f"{x:g}" for x in run[1]), show_review, tiles) for s, run in jobs_all}
    sigs = {(s[0], run): signature(s[1][0], run[0], ",".join(f"{x:g}" for x in run[1]), show_review, tiles) for s, run in jobs_all}
    fresh = [(s, run) for s, run in jobs_all if cache.get(keys[(s[0], run)], {}).get("sig") == sigs[(s[0], run)] and cache[keys[(s[0], run)]].get("errors") == 0]
    for s, run in fresh:
        print(f"{s[0]}{where(run)}: 0 errors (unchanged since it was clean)", flush=True)
    todo = [j for j in jobs_all if j not in fresh]
    if not todo:
        print("ui-lint: 0 errors (every app unchanged since it was clean)")
        return 0
    # (Made only now: --list and an empty pick leave nothing behind.
    # fixture-home's pictures need the system's Python, which has PIL. Made
    # once; each app's session gets a copy, reflinked.)
    os.makedirs(work, exist_ok=True)
    env = dict(os.environ, PATH="/usr/bin:" + os.environ.get("PATH", ""))
    made = subprocess.run([os.path.join(ROOT, "tools/dev/fixture-home"), master], capture_output=True, text=True, env=env)
    if made.returncode:
        subprocess.run(["rm", "-rf", work])
        sys.exit(f"tools/dev/fixture-home failed: {made.stderr}")
    # Every app at once, `jobs` at a time, each in a session of its own
    # (a MacBook's screen by default: 1512 × 982 points at 2×).
    import concurrent.futures
    errors, reviews = 0, 0
    lock = threading.Lock()
    # (Pictures from several screens: a folder for each.)
    shots_of = lambda run: shots and (os.path.join(shots, f"{run[0]}@{run[1][0]:g}") if len(runs) > 1 else shots)
    for run in runs:
        if shots_of(run):
            os.makedirs(shots_of(run), exist_ok=True)
    def lint_one_when_room(spec, *rest):
        wait_for_room(spec[0])
        return lint_one(spec, *rest)

    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(jobs, len(todo))) as pool:
            futures = {pool.submit(lint_one_when_room, spec, slot, master, run[0], list(run[1]), show_review, work, all_themes, tiles, shots_of(run), where(run)): (spec, run)
                       for slot, (spec, run) in enumerate(todo)}
            for done in concurrent.futures.as_completed(futures):
                spec, run = futures[done]
                try:
                    e, r, lines = done.result()
                except Exception as x:
                    # (Where in the lint, and what the session left: "the
                    # lint failed: [Errno 2]" told nobody anything.)
                    import traceback
                    at = traceback.extract_tb(x.__traceback__)[-1]
                    e, r, lines = 1, 0, [f"{spec[0]}{where(run)}: the lint failed: {x} (ui-lint, line {at.lineno}, in {at.name})"] + [f"    {note}" for note in getattr(x, "__notes__", [])]
                with lock:
                    errors += e
                    reviews += r
                    for line in lines:
                        print(line, flush=True)
                    save_cache({keys[(spec[0], run)]: {"sig": sigs[(spec[0], run)], "errors": e}})
    finally:
        if not keep:
            subprocess.run(["rm", "-rf", work])
    print(f"ui-lint: {errors} errors" + (f", {reviews} to look at" if show_review else ""))
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
