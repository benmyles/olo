#!/usr/bin/python3
"""The layout lint of every Olo app, live: each app with a window opened
in a headless session of its own (a made-up home, demo data where the
app has it, its own D-Bus), every window and every tab of its tab views
reviewed (`{"review":true}` on the app's socket: the checks of
crates/kit-base/src/layout_review.rs) at 1×, 1.5× and 2×, light and dark.
Sound comes from olo-fakesound (a speaker, AirPods and a microphone), so
Preferences ▸ Sound shows its devices, not its empty state.
Errors fail it; review findings (look closely) are listed with --review.

  tools/dev/ui-lint [--review] [--keep] [--no-cache] [--jobs N] [--scales 1,1.5,2] [--screen WxH] [APP...]

Every app at once, each in a headless session of its own (a copy of the
made-up home, its own sound server), --jobs at a time (three quarters of
the processors by default); the look and scale are changed and the app
asked again until it has drawn them, never waited for longer.

Results are kept (~/.cache/olo-dev/ui-lint.json): an app whose build and
whose lint are as when it last came out clean isn't run again (its
binary's, app_server's and the fake sound server's size, time and inode,
which cargo changes whenever it links them again; this script's,
tsession's and fixture-home's text; the screen, scales and --review). An
app that had errors always runs. --no-cache runs every one.

APP picks some (by name, as listed with --list, or its directory in apps/
as "disk-usage", or "prefs:PANEL"; case and spaces don't count). It
runs release builds: `cargo build --release --workspace` first. Run by
the pre-push hook when UI code changed (tools/hooks), and by
tools/install-session.sh. See "The layout lint" in docs/HACKING.md.
"""
import hashlib, json, os, socket, subprocess, sys, threading, time

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
TSESSION = os.path.join(ROOT, "tools/dev/tsession")
BASE = "/tmp/olo-dev"
RUNTIME = f"/run/user/{os.getuid()}"

# Preferences' panels (Bluetooth stays out of test runs; AirPods needs
# its fake device).
PANELS = ["ai", "appearance", "backgrounds", "backup", "datetime", "default-apps", "display", "gpus", "integrations", "keyboard", "network", "notifications",
          "performance", "power", "screensaver", "security", "sound", "terminal", "themes", "touchid", "touchpad", "tracker", "windows", "workspaces", "about"]


def apps(home):
    """(name, argv, env, layers): every app with a window, and how to start
    it safely in a test session."""
    tg = os.path.join(home, ".telegram-demo")
    out = [
        ("Activity", ["olo-activity"], {"OLO_ACTIVITY_HELPER": "off"}, False),
        ("Browser", ["olo-browser", "about:engine"], {}, False),
        ("DeskCalc", ["olo-deskcalc"], {}, False),
        ("Disk Usage", ["olo-disk-usage", home], {}, False),
        ("Doctor", ["olo-doctor"], {"OLO_DOCTOR_HELPER": "off"}, False),
        ("Logs", ["olo-logs"], {}, False),
        ("Passwords", ["olo-passwords"], {"OLO_PASSWORDS_KEYFILE": os.path.join(home, ".pw-key")}, False),
        ("StyledEdit", ["olo-styled-edit", os.path.join(home, "README.md")], {}, False),
        ("Telegram", ["olo-telegram"], {"OLO_TELEGRAM_DEMO": "4", "OLO_TELEGRAM_CACHE": tg + "/cache", "OLO_TELEGRAM_SECRETS": tg + "/secrets"}, False),
        ("Terminal", ["olo-terminal"], {}, False),
        ("Tracker", ["olo-tracker", home], {}, False),
        ("Viewer", ["olo-viewer", os.path.join(home, "Pictures/holiday.png")], {}, False),
        ("Deskbar", ["olo-deskbar"], {}, True),
    ]
    out += [(f"prefs:{p}", ["olo-preferences", p], {}, False) for p in PANELS]
    return out


def sh(*args, check=False):
    env = dict(os.environ)
    for k in ("WAYLAND_DISPLAY", "OLO_SOCKET", "OLO_SESSION", "OLO_SESSION_PID", "OLO_REAL_SESSION"):
        env.pop(k, None)
    env["TSESSION_PROFILE"] = "release"
    r = subprocess.run(["/usr/bin/python3", TSESSION, *args], capture_output=True, text=True, env=env)
    if check and r.returncode:
        sys.exit(f"tsession {' '.join(args)}: {r.stderr or r.stdout}")
    return r.stdout


def session_env(name):
    return json.load(open(os.path.join(BASE, name, "env.json")))


def ipc(name, req):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(5)
    s.connect(session_env(name)["OLO_SOCKET"])
    s.sendall((json.dumps(req) + "\n").encode())
    a = s.makefile().readline()
    s.close()
    return json.loads(a or "{}")


def ask_app(pid, req, timeout=6):
    path = os.path.join(RUNTIME, f"olo-menus-{pid}.sock")
    if not os.path.exists(path):
        return None
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(timeout)
    try:
        s.connect(path)
        s.sendall((json.dumps(req) + "\n").encode())
        return json.loads(s.makefile().readline() or "null")
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def ours(pid, home):
    """A process of this run's (its HOME is ours): the only kind killed."""
    try:
        return f"HOME={home}" in open(f"/proc/{pid}/environ").read().split("\0")
    except OSError:
        return False


def pids_of(exe, home):
    out = []
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                if os.path.basename(os.readlink(f"/proc/{p}/exe")) == exe and ours(int(p), home):
                    out.append(int(p))
            except OSError:
                pass
    return out


def windows_of(name, pid):
    return [w for w in ipc(name, {"type": "list_windows"}).get("windows", []) if w.get("pid") == pid]


def review(pid, layers):
    found = []
    for w in ask_app(pid, {"review": True}, timeout=8) or []:
        if w.get("layer") and not layers:
            continue
        for f in w["findings"]:
            found.append((w.get("layer") or w["title"], f))
    return found


def tabs(name, pid):
    """Each window's tabs not shown: (window title, tab name, x, y) in
    global logical coordinates, to click."""
    out = []
    wins = {w["title"]: w for w in windows_of(name, pid)}
    for tree in ask_app(pid, {"tree": True}) or []:
        nodes = tree.get("nodes", [])
        title = nodes[0].get("name") if nodes else None
        w = wins.get(title)
        if not w:
            continue
        for n in nodes:
            if n.get("role") == "Tab" and not n.get("selected") and n.get("clickable"):
                out.append((title, n.get("name"), w["content"]["x"] + n["x"] + n["width"] / 2, w["content"]["y"] + n["y"] + n["height"] / 2))
    return out


CACHE = os.path.join(os.path.expanduser("~"), ".cache/olo-dev/ui-lint.json")


def stamp(path):
    """A build's identity without reading it: cargo writes a new file (a
    new inode and time) whenever it links it again."""
    try:
        st = os.stat(path)
        return f"{st.st_size}:{st.st_mtime_ns}:{st.st_ino}"
    except OSError:
        return "missing"


def signature(exe, screen, scales, show_review):
    """What an app's lint depends on: its build, app_server's, the fake
    sound server's, the lint's own scripts and how it's run."""
    h = hashlib.sha256()
    for f in ("tools/dev/ui-lint", "tools/dev/tsession", "tools/dev/fixture-home"):
        try:
            h.update(open(os.path.join(ROOT, f), "rb").read())
        except OSError:
            pass
    for b in (exe, "olo-app-server", "olo-fakesound"):
        h.update(stamp(os.path.join(ROOT, "target/release", b)).encode())
    h.update(f"{screen}|{scales}|{show_review}".encode())
    return h.hexdigest()


def load_cache():
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return {}


def save_cache(cache):
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".new"
    json.dump(cache, open(tmp, "w"), indent=1)
    os.replace(tmp, CACHE)


def gone(exe, home, within=5.0):
    """Wait for this run's `exe` to have quit (asked with SIGTERM): one
    still closing takes the next app's arguments (single-instance apps:
    Preferences), and its window never comes. Killed past `within`."""
    end = time.time() + within
    while time.time() < end:
        if not pids_of(exe, home):
            return
        time.sleep(0.1)
    for p in pids_of(exe, home):
        try:
            os.kill(p, 9)
        except OSError:
            pass
    time.sleep(0.2)


def set_look(name, theme, scale):
    """The session's look and scale, at once (as `tsession theme` and
    `scale` do, without their waits)."""
    st = ipc(name, {"type": "get_settings"})["settings"]
    st["appearance"]["theme"] = theme
    st["display"]["scale"] = scale
    for o in st["display"].get("outputs", {}).values():
        o.pop("scale", None)
    ipc(name, {"type": "set_settings", "settings": st})


def drawn(pid, layers, scale=None, dark=None, within=6.0):
    """The app's review once its windows are drawn (at `scale`, in the look
    `dark` says, when given): asked again until they are, never waited
    for longer than it takes. None if they never are."""
    end = time.time() + within
    last = None
    settled = None
    while time.time() < end:
        wins = [w for w in (ask_app(pid, {"review": True}, timeout=8) or []) if layers or not w.get("layer")]
        if wins:
            last = wins
            # (Twice the same: a window that follows what it shows resizes
            # a frame after the scale changes, and is asked again.)
            sizes = sorted((w.get("layer") or w["title"], w["width"], w["height"]) for w in wins)
            if all((scale is None or abs(w.get("scale", 0) - scale) < 0.01) and (dark is None or w.get("dark", dark) == dark) for w in wins):
                if sizes == settled:
                    return [(w.get("layer") or w["title"], f) for w in wins for f in w["findings"]]
                settled = sizes
            else:
                settled = None
        time.sleep(0.05)
    return None if last is None else [(w.get("layer") or w["title"], f) for w in last for f in w["findings"]]


def click(name, x, y):
    """A click at (x, y), as `tsession click` makes it (two motions: the
    first after a popup's grab only ends it)."""
    ipc(name, {"type": "synthetic", "events": [{"type": "move", "x": x - 1, "y": y}]})
    ipc(name, {"type": "synthetic", "events": [{"type": "move", "x": x, "y": y}]})
    ipc(name, {"type": "synthetic", "events": [{"type": "button", "button": 0x110, "pressed": True}, {"type": "button", "button": 0x110, "pressed": False}]})


def chosen(pid, tab, within=3.0):
    """Wait for `tab` to be the one shown."""
    end = time.time() + within
    while time.time() < end:
        for tree in ask_app(pid, {"tree": True}) or []:
            if any(n.get("role") == "Tab" and n.get("name") == tab and n.get("selected") for n in tree.get("nodes", [])):
                return True
        time.sleep(0.05)
    return False


def lint_one(spec, slot, master, screen, scales, show_review, work):
    """One app, in a headless session of its own (a copy of the made-up
    home, its own sound server): what it found, as (errors, reviews, lines
    to print)."""
    app, _, env, layers = spec
    home = os.path.join(work, f"home{slot}")
    name = f"uilint{os.getpid() % 100000}s{slot}"
    subprocess.run(["cp", "-a", "--reflink=auto", master, home], check=True)
    # (The made-up home's paths in the app's arguments, this copy's.)
    argv = [a.replace(master, home) for a in spec[1]]
    env = {k: v.replace(master, home) for k, v in env.items()}
    pulse = os.path.join(work, f"pulse{slot}.sock")
    fakesound = subprocess.Popen([os.path.join(ROOT, "target/release/olo-fakesound"), pulse], env=dict(os.environ, FAKESOUND_AIRPODS="AA:BB:CC:DD:EE:FF"),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    lines = []
    try:
        # (--owner: the session ends with this run, killed or not.)
        # (At 2×, as most screens are; at the first scale asked for when
        # 2× isn't one, so the screen is the size asked at it: 1280x800 at
        # 1× opened at 2× was 640 × 400 points, and the windows opened on
        # it stayed that cramped at 1×.)
        first = "2" if 2 in scales else f"{scales[0]:g}"
        sh("start", name, screen, "--light", "--scale", first, "--home", home, "--owner", str(os.getpid()), check=True)
        sh("run", name, f"HOME={home}", f"PULSE_SERVER=unix:{pulse}", "OLO_NO_FINGERPRINT=1", "OLO_ACTIVITY_HELPER=off", "OLO_DOCTOR_HELPER=off", *[f"{k}={v}" for k, v in env.items()], *argv)
        exe = argv[0]
        pid = None
        end = time.time() + 20
        while time.time() < end:
            ps = pids_of(exe, home)
            if ps and (layers or windows_of(name, ps[0])):
                pid = ps[0]
                break
            time.sleep(0.1)
        if pid is None or drawn(pid, layers) is None:
            alive = pids_of(exe, home)
            log = os.path.join(BASE, name, f"{os.path.basename(exe)}.log")
            try:
                said = [l.rstrip() for l in open(log, errors="replace") if "resvg" not in l][-6:]
            except OSError:
                said = []
            lines.append(f"{app}: no window came up ({'running: ' + ', '.join(map(str, alive)) if alive else 'not running'})")
            lines += [f"    {l[:200]}" for l in said]
            return 1, 0, lines
        # Each finding once, with the looks it came up in.
        seen = {}
        for theme in ("light", "dark"):
            for scale in scales:
                set_look(name, theme, scale)
                looks = [(None, drawn(pid, layers, scale, theme == "dark") or [])]
                for title, tab, x, y in tabs(name, pid):
                    click(name, x, y)
                    chosen(pid, tab)
                    looks.append((tab, drawn(pid, layers, scale, theme == "dark") or []))
                for tab, found in looks:
                    for window, f in found:
                        key = (f["level"], window, tab, f["kind"], f["text"])
                        seen.setdefault(key, []).append(f"{theme} {scale:g}×")
        app_errors = [k for k in seen if k[0].lower() == "error"]
        app_reviews = [k for k in seen if k[0].lower() != "error"]
        lines.append(f"{app}: {len(app_errors)} errors" + (f", {len(app_reviews)} to look at" if show_review else ""))
        for key in app_errors + (app_reviews if show_review else []):
            level, window, tab, kind, text = key
            lines.append(f"  - {level.lower()} {kind} in {window}{' ▸ ' + tab if tab else ''}: {text} ({', '.join(seen[key])})")
        return len(app_errors), len(app_reviews), lines
    finally:
        sh("stop", name)
        fakesound.terminate()
        # (Its session folder too: /tmp is memory.)
        subprocess.run(["rm", "-rf", home, os.path.join(BASE, name)])


def main():
    a = sys.argv[1:]
    show_review = "--review" in a
    keep = "--keep" in a
    use_cache = "--no-cache" not in a
    scales = [float(s) for s in (a[a.index("--scales") + 1].split(",") if "--scales" in a else ["1", "1.5", "2"])]
    screen = a[a.index("--screen") + 1] if "--screen" in a else "3024x1964"
    jobs = int(a[a.index("--jobs") + 1]) if "--jobs" in a else max(2, (os.cpu_count() or 4) * 3 // 4)
    picked = [x for i, x in enumerate(a) if not x.startswith("--") and (i == 0 or a[i - 1] not in ("--scales", "--screen", "--jobs"))]
    work = f"/var/tmp/olo-ui-lint-{os.getpid()}"
    master = os.path.join(work, "home")
    specs = apps(master)
    if "--list" in a:
        print("\n".join(s[0] for s in specs))
        return 0
    if picked:
        # ("Disk Usage", "disk-usage" and "diskusage" are one.)
        norm = lambda x: "".join(c for c in x.lower() if c.isalnum() or c == ":")
        want = {norm(p) for p in picked}
        specs = [s for s in specs if norm(s[0]) in want]
        if not specs:
            print("ui-lint: none of those has a window to lint")
            return 0
    # Those whose build and lint are as when they came out clean: not again.
    cache = load_cache() if use_cache else {}
    sigs = {s[0]: signature(s[1][0], screen, ",".join(f"{x:g}" for x in scales), show_review) for s in specs}
    fresh = [s for s in specs if cache.get(s[0], {}).get("sig") == sigs[s[0]] and cache[s[0]].get("errors") == 0]
    for s in fresh:
        print(f"{s[0]}: 0 errors (unchanged since it was clean)", flush=True)
    specs = [s for s in specs if s not in fresh]
    if not specs:
        print("ui-lint: 0 errors (every app unchanged since it was clean)")
        return 0
    # (Made only now: --list and an empty pick leave nothing behind.
    # fixture-home's pictures need the system's Python, which has PIL. Made
    # once; each app's session gets a copy, reflinked.)
    os.makedirs(work, exist_ok=True)
    env = dict(os.environ, PATH="/usr/bin:" + os.environ.get("PATH", ""))
    made = subprocess.run([os.path.join(ROOT, "tools/dev/fixture-home"), master], capture_output=True, text=True, env=env)
    if made.returncode:
        subprocess.run(["rm", "-rf", work])
        sys.exit(f"tools/dev/fixture-home failed: {made.stderr}")
    # Every app at once, `jobs` at a time, each in a session of its own
    # (a MacBook's screen by default: 1512 × 982 points at 2×).
    import concurrent.futures
    errors, reviews = 0, 0
    lock = threading.Lock()
    slots = list(range(len(specs)))
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(jobs, len(specs))) as pool:
            futures = {pool.submit(lint_one, spec, slot, master, screen, scales, show_review, work): spec for spec, slot in zip(specs, slots)}
            for done in concurrent.futures.as_completed(futures):
                spec = futures[done]
                try:
                    e, r, lines = done.result()
                except Exception as x:
                    e, r, lines = 1, 0, [f"{spec[0]}: the lint failed: {x}"]
                with lock:
                    errors += e
                    reviews += r
                    for line in lines:
                        print(line, flush=True)
                    cache[spec[0]] = {"sig": sigs[spec[0]], "errors": e}
                    save_cache(cache)
    finally:
        if not keep:
            subprocess.run(["rm", "-rf", work])
    print(f"ui-lint: {errors} errors" + (f", {reviews} to look at" if show_review else ""))
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
