#!/bin/bash
# A second investigator for a bug that won't give up its cause: Codex
# (gpt-6.2-astra, its most reasoning, no questions asked of anyone),
# given a written brief, working by itself, answering in a file.
#
#   tools/dev/codex-help BRIEF.md [DIR]
#
# BRIEF.md: what's wrong and everything known (the olo-debug-help skill,
# .claude/skills/olo-debug-help/SKILL.md, says what a good one holds).
# DIR (the brief's folder by default; somewhere of yours under /var/tmp):
# the helper's scratch, where `answer.md` (its findings) and `log.txt`
# (what it did) are written. Runs until it's done, which can be an
# hour: start it in the background and take its end, don't wait on it.
#
# The helper looks and tries things; it doesn't change the working
# tree, commit, push or touch the person's session (the rules below go
# in front of every brief). What it says is a lead to check, not a fact.
set -u
brief=${1:-}
if [ -z "$brief" ] || [ ! -s "$brief" ]; then
    echo "usage: tools/dev/codex-help BRIEF.md [DIR]   (the brief: a file that says what's wrong and what's known)" >&2
    exit 2
fi
# (A subagent doesn't start agents: CLAUDE.md, "Subagents".)
if [ -n "${OLO_SUBAGENT:-}" ]; then
    echo "codex-help: you are a subagent; ask the lead (write your question as your reply) instead" >&2
    exit 2
fi
# (A helper doesn't ask for a helper.)
if [ -n "${OLO_CODEX_HELP:-}" ]; then
    echo "codex-help: this is already the helper; find it yourself, or say you couldn't" >&2
    exit 2
fi
export OLO_CODEX_HELP=1
repo=$(cd "$(dirname "$0")/../.." && pwd)
dir=$(cd "${2:-$(dirname "$brief")}" && pwd) || exit 2
case "$dir" in
    /tmp/*) echo "codex-help: $dir is in RAM (/tmp); use a folder under /var/tmp" >&2; exit 2 ;;
esac
if ! command -v codex > /dev/null; then
    echo "codex-help: no codex on PATH (the Codex CLI, signed in)" >&2
    exit 2
fi
{
    cat <<RULES
You are helping another coding agent find the root cause of a bug in Olo
(a BeOS-inspired Wayland desktop written in Rust; the repository is your
working directory). It has tried and is stuck; its brief follows these
rules. Find the cause, with evidence. Nobody can answer questions: decide
and go on.

Rules (they are the repository's, CLAUDE.md, read it and docs/HACKING.md's
parts on what you touch):
- Don't change the working tree: no edits to tracked files, no commits,
  no pushes, no git stash or checkout. The other agent is working in it
  now. To try a change, say what to change in your answer; if you must
  build one, do it in a git worktree under $dir with
  CARGO_TARGET_DIR under $dir too (never /tmp: it is RAM).
- Leave the person's session alone: never reload, upgrade or install
  into it, never open a window on their display, never move their
  pointer or type. Test in a headless session of your own
  (tools/dev/tsession, run with /usr/bin/python3; a name beginning
  "codex-"), and stop it when you're done. Never run a GUI program from
  your shell. Never play sound. Reading the person's session is fine
  (its logs: target/release/olo-logs --print …; read-only IPC; /proc).
  Don't attach to its running programs: no perf record, breakpoints,
  ptrace, gdb, strace or bpftrace on their processes (a stopped or
  slowed window server is the person's desktop stopped). Reproduce in
  your own session and trace that.
- Scratch files go in $dir. Kill only processes you started, by PID
  (never pkill -f / pgrep -f patterns).
- Don't send the person's name, email or files to any outside service.
- You are the helper: don't start another (tools/dev/codex-help, the
  olo-debug-help skill), nor any other agent.
- Measure, don't guess: a cause is found when you can make the bug
  happen and stop happening, or can show the faulty step in the code
  with the values that reach it. Say which of the two you have.

Write your answer as Markdown: the cause (file:line), the evidence (what
you ran and what it printed), how sure you are and what would settle it
if you aren't, what you ruled out, and the fix you'd make as a diff (not
applied). If you didn't find it, say so plainly, and what you learned.
Your last message is your answer: it is saved as $dir/answer.md, in
place of any file of that name you wrote (a long write-up there, then a
short last message, lost the write-up twice). So make your last message
the whole answer, every finding in full, not a summary of it; put what
is too long for it (a diff, a long log) in other files in $dir and name
them in it.

And keep notes as you go, in $dir/notes.md: each thing you find, as you
find it, in a line or two with its file:line and what showed it. A run
can end before its last message (your service stopping it, a limit, a
crash), and then the notes are all that is left of the work (nine
minutes of a review's findings were lost so, 2026-11-20).

The brief:

RULES
    cat "$brief"
} | codex exec -m gpt-6.2-astra -c 'model_reasoning_effort="max"' --approve-for-me -C "$repo" --add-dir "$dir" --color never -o "$dir/answer.md" - > "$dir/log.txt" 2>&1
rc=$?
echo "codex-help: ended with $rc; the answer is $dir/answer.md, what it did $dir/log.txt"
# A run that ended badly or without an answer: why, in the log's own
# words (an empty answer.md and a bare "ended with 1" said nothing of a
# service's refusal, the log's last lines), and what it noted on the way.
if [ "$rc" -ne 0 ] || [ ! -s "$dir/answer.md" ]; then
    why=$(grep -a -E '^(ERROR|error):' "$dir/log.txt" | tail -n 2 | cut -c1-400)
    [ -n "$why" ] && echo "codex-help: its log ends with: $why"
    [ -s "$dir/answer.md" ] || echo "codex-help: it left no answer"
    [ -s "$dir/notes.md" ] && echo "codex-help: what it noted before it ended is in $dir/notes.md"
    [ "$rc" -eq 0 ] && rc=1
fi
exit $rc
