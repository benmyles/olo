def guest(script, arg, kos, mem=2048):
    with tempfile.TemporaryDirectory(prefix="olo-gpu-pages-", dir="/var/tmp") as work:
        path = os.path.join(work, "script")
        with open(path, "w") as f:
            f.write(script)
        cmd = GUEST + ["--quiet", "--bin", "base64", "--module", "ttm", "--cpus", "2", "--mem", str(mem), "--timeout", "240", "--append", "panic_on_warn=1 oops=panic"]
        for ko in kos:
            cmd += ["--ko", ko]
        out = subprocess.run(cmd + [path, arg], capture_output=True, text=True)
    return out.returncode, out.stdout, out.stderr


def sections(text):
    """The guest's lines by the step they came under: {step: {"": value, "log": [...], "trial": code}}."""
    steps, now = {}, None
    for line in text.splitlines():
        if "|" not in line:
            continue
        key, value = line.split("|", 1)
        if key in ("log", "trial") and now:
            if key == "log":
                steps[now]["log"].append(value)
            else:
                steps[now]["trial"] = value
        else:
            now = key
            steps.setdefault(key, {"": value, "log": [], "trial": None})
            steps[key][""] = value
    return steps


def sizes(step):
    """A trial's sizes as it logged them: {order: {asked, waiting, refused, pieces, compacted, reclaimed, flags}}."""
    found = {}
    for line in step["log"]:
        m = re.search(r"order=(\d+) asked=(\d+) waiting=(\d+) refused=(\d+) pieces=(\d+) compacted=(\d+) reclaimed=(\d+) flags=(0x[0-9a-f]+)", line)
        if m:
            found[int(m.group(1))] = dict(zip(("asked", "waiting", "refused", "pieces", "compacted", "reclaimed"), map(int, m.groups()[1:7])), flags=int(m.group(8), 16))
    return found


def timing(step):
    m = next((re.search(r"middle_ns=(\d+) p99_ns=(\d+) longest_ns=(\d+)", line) for line in step["log"] if "middle_ns" in line), None)
    return tuple(int(x) for x in m.groups()) if m else None


