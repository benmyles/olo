#!/usr/bin/env python3
"""Windowing modes fuzzer: drive app_server's Standard, Auto-Tiling and
Focus modes (each display's, on each workspace) with random mode
changes, activations (Deskbar's, an app brought forward by launching it
again, ⌘Tab), windows opening and closing, workspaces and displays, on
real apps, and check after each step that each mode's rules hold.

  mode-fuzz NAME [--seed N] [--steps N] [--only OPS] [--keep-going] [--quiet]
  mode-fuzz NAME --matrix [--chrome] [--only WORDS]

NAME is a tsession with the shell (two displays find more), e.g.

  tsession start mz 1920x1200,1440x900 --session --shell
  tools/dev/mode-fuzz mz --steps 300

It opens and closes windows of olo-terminal, olo-styled-edit and
olo-tracker itself. A run is reproducible from its seed (printed first)
as long as the session starts the same way; --only mode,activate runs
just those steps (the `op_` methods).

What is checked, after every step once the windows have settled:

  * wm-fuzz's sanity checks: app_server answers within a second, one
    shown window has the keyboard (and it's a shown one), groups hold
    together, zoomed windows stay in the tiling area, app_server never
    panics (its log is watched: the lock checker's aborts included);
  * on a display in Focus: of the windows that would be tiles (not
    floating, rolled up or hidden), exactly one, with its group, shows;
    every other is covered; the one showing is zoomed (its group's front
    at least); the window with the keyboard, if it's one of them, is the
    one showing;
  * on a display in Standard or Auto-Tiling: nothing is covered;
  * an activated window (Deskbar's, or brought forward by launching its
    app again) has the keyboard and shows, in every mode, on its own
    display, workspace and in front of its group, and activating doesn't
    move other windows;
  * a Focus round trip (Standard, then Focus with activations in it,
    then Standard again) puts every window back in its own frame.

--matrix runs the same checks deterministically instead, on windows of
its own: in each mode (every display in it), a Tracker window behind the
Terminal with the keyboard, hidden, on the other display and on another
workspace is brought forward each way (as Deskbar does, with no token;
by launching Tracker on its folder again, with the token it asks
app_server for; and again with a token in its environment that isn't
for it, a link's opener's), and has the keyboard, shows, is in front on
its display (`WindowInfo::stack`) and moves nothing else. Tracker shows
a folder in a window of the workspace in use: launched for one on the
other display or workspace, it opens one here, on the display in use.
--chrome does it all with Olo's Chrome's window too (a program not
Olo's own, which app_server brings forward only for a token that says
so: a link opened from a click), on a profile of its own with no network
(a copy of the installed Chrome is put in the session's home); --only
chrome,focus runs just the cases whose names have all those words in
them. It prints a table of the cases, then what failed.
"""
import importlib.machinery, json, os, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
wm = importlib.machinery.SourceFileLoader("wm_fuzz", os.path.join(HERE, "wm-fuzz")).load_module()
fr, Failure = wm.fr, wm.Failure

MODES = ["standard", "auto_tiling", "focus"]
# (The Tab key: ⌘Tab.)
TAB = 15


class ModeFuzz(wm.Fuzz):
    # ---- the modes as app_server has them ----

    def modes(self):
        """Each display's mode on the workspace it shows."""
        r = self.req({"type": "windowing_mode"})
        return {d["output"]: d["mode"] for d in r.get("displays", [])}

    def set_mode(self, mode, output):
        self.req({"type": "set_windowing_mode", "mode": mode, "output": output})

    def units(self, wins, output, cur):
        """What Focus would show one of on `output`: each window that would
        be a tile there (a group's windows together), front first as
        app_server stacks them (we can't see the stacking: by group)."""
        out = {}
        for i, w in sorted(wins.items()):
            if w.get("output") != output or w["minimized"] or not self.here(w, cur) or not fr(w):
                continue
            if w.get("floating") or w.get("rolled"):
                continue
            key = ("g", w["group"]) if w.get("group") is not None else ("w", i)
            out.setdefault(key, []).append(i)
        return out

    # ---- checks ----

    def check_modes(self, what, wins):
        cur = self.showing()
        modes = self.modes()
        for output, mode in modes.items():
            on = {i: w for i, w in wins.items() if w.get("output") == output and self.here(w, cur) and not w["minimized"]}
            if mode != "focus":
                covered = [i for i, w in on.items() if w.get("covered")]
                if covered:
                    self.fail(f"{what}: {output} is in {mode}, yet {covered} are covered\n  {wm.state(wins)}")
                continue
            units = self.units(wins, output, cur)
            if not units:
                continue
            showing = [k for k, ids in units.items() if any(not wins[i].get("covered") for i in ids)]
            if len(showing) != 1:
                self.fail(f"{what}: {output} is in Focus and shows {len(showing)} of its windows ({showing}), not one\n  {self.focus_state(wins, units)}")
                continue
            ids = units[showing[0]]
            front = [i for i in ids if not wins[i].get("behind")]
            if not any(wins[i].get("zoomed") for i in front):
                self.fail(f"{what}: {output} is in Focus and shows {front}, not zoomed\n  {self.focus_state(wins, units)}")
            focused = [i for i, w in on.items() if w["focused"] and not w.get("floating")]
            for f in focused:
                if f not in ids and any(f in u for u in units.values()):
                    self.fail(f"{what}: on {output} in Focus, {f} has the keyboard but {ids} shows\n  {self.focus_state(wins, units)}")

    def focus_state(self, wins, units):
        return "; ".join(
            f"{k[0]}{k[1]}: " + ",".join(f"{i}{' covered' if wins[i].get('covered') else ''}{' behind' if wins[i].get('behind') else ''}{' zoomed' if wins[i].get('zoomed') else ''}{' *' if wins[i]['focused'] else ''}" for i in ids)
            for k, ids in units.items()
        )

    def check_shows(self, what, w, after):
        """`w` was just brought forward: it has the keyboard, and shows."""
        a = after.get(w)
        if a is None:
            return
        if not a["focused"]:
            self.fail(f"{what}: {w} ({a['app_id']}) doesn't have the keyboard\n  {wm.state(after)}")
        if a.get("covered"):
            self.fail(f"{what}: {w} ({a['app_id']}) has been brought forward, but Focus covers it\n  {wm.state(after)}")
        if a.get("behind"):
            self.fail(f"{what}: {w} ({a['app_id']}) is still behind in its group")
        if a["minimized"] or not self.here(a, self.showing()):
            self.fail(f"{what}: {w} ({a['app_id']}) isn't on the workspace its display shows")

    def after(self, what, timeout=5.0):
        wins = self.settle(timeout)
        self.check_sane(wins)
        self.check_modes(what, wins)
        self.check_log()
        return wins

    # ---- steps ----

    def run_step(self):
        self.step += 1
        self.step_trail, self.step_t0 = [], time.time()
        wins = self.windows()
        shown = self.shown(wins)
        ops = [(5, self.op_mode), (3, self.op_focus_trip), (6, self.op_activate), (3, self.op_relaunch),
               (3, self.op_open), (2, self.op_close), (4, self.op_twitch), (2, self.op_workspace_trip),
               (2, self.op_hide_show), (2, self.op_to_display)]
        if self.only:
            ops = [(w, op) for w, op in ops if op.__name__[3:] in self.only]
        if len(wins) < 4:
            ops = [(1, self.op_open)]
        total = sum(w for w, _ in ops)
        n = self.rng.uniform(0, total)
        for weight, op in ops:
            n -= weight
            if n <= 0:
                break
        op(wins, shown)

    def op_mode(self, wins, shown):
        output = self.rng.choice(self.outputs)
        mode = self.rng.choice(MODES)
        self.log(f"{output} to {mode}")
        self.set_mode(mode, output)
        self.after(f"{output} to {mode}")

    def op_focus_trip(self, wins, shown):
        """Standard, Focus with a few activations, Standard again: every
        window back in its own frame."""
        output = self.rng.choice(self.outputs)
        self.log(f"a Focus round trip on {output}")
        self.set_mode("standard", output)
        before = self.after(f"{output} to standard first")
        cur = self.showing()
        mine = [i for i, w in before.items() if w.get("output") == output and self.here(w, cur) and not w["minimized"] and fr(w)]
        self.set_mode("focus", output)
        now = self.after(f"{output} to focus")
        for _ in range(self.rng.randint(0, 3)):
            w = self.pick(mine)
            if w is None or w not in now:
                break
            self.log(f"  activate {w} ({now[w]['app_id']}) in Focus")
            self.req({"type": "activate", "id": w})
            now = self.after(f"activating {w} in Focus")
            self.check_shows(f"activating {w} in Focus", w, now)
        self.set_mode("standard", output)
        after = self.after(f"{output} back to standard")
        for i in mine:
            if i in after and not before[i].get("zoomed") and fr(after[i]) != fr(before[i]) and after[i]["workspace"] == before[i]["workspace"]:
                self.fail(f"Focus round trip on {output}: {i} ({before[i]['app_id']}) was {fr(before[i])}, now {fr(after[i])}")

    def op_activate(self, wins, shown):
        w = self.pick(wins)
        if w is None:
            return
        self.log(f"activate {w} ({wins[w]['app_id']}{', hidden' if wins[w]['minimized'] else ''}, ws {wins[w]['workspace']}, {wins[w].get('output')})")
        cur = self.showing()
        self.req({"type": "activate", "id": w})
        after = self.after(f"activating {w}")
        if self.here(wins[w], cur):
            self.check_unchanged(f"activating {w}", wins, after, skip={w} | self.mates(after, w))
        self.check_shows(f"activating {w}", w, after)

    def op_relaunch(self, wins, shown):
        """An app launched again with its window open brings that window
        forward itself (xdg-activation, from the app). Tracker shows a
        folder in a window on the workspace in use (the active display's):
        one it has there comes forward, else it opens one there."""
        trackers = [i for i, w in wins.items() if w["app_id"] == "olo.tracker" and w.get("title")]
        known = {"/": "/", "usr": "/usr", "etc": "/etc", "tmp": "/tmp", "share": "/usr/share", "var": "/var"}
        pick = [(i, known[wins[i]["title"]]) for i in trackers if wins[i]["title"] in known]
        if not pick:
            return self.op_open(wins, shown)
        w, folder = self.rng.choice(sorted(pick))
        title = wins[w]["title"]
        focused = [i for i, x in wins.items() if x["focused"]]
        active = wins[focused[0]].get("output") if focused else None
        cur = self.showing()
        here = [i for i in trackers if wins[i]["title"] == title and wins[i].get("output") == active and self.here(wins[i], cur)]
        self.log(f"olo-tracker {folder} again ({w} has it{'' if here or active is None else ', on another workspace'})")
        self.spawn("olo-tracker", [folder])
        what = f"launching Tracker on {folder} again"
        self.wait_for(lambda now: any(x["focused"] and x.get("title") == title for x in now.values()))
        after = self.after(what)
        now = [i for i, x in after.items() if x["focused"] and x["app_id"] == "olo.tracker" and x.get("title") == title]
        if not now:
            return self.check_shows(what, (here or [w])[0], after)
        w = now[0]
        if here and w not in here:
            self.fail(f"{what}: Tracker opened {w} for it, though {here} shows it on the workspace in use\n  {wm.state(after)}")
        if not here and active is not None and after[w].get("output") != active:
            self.fail(f"{what}: Tracker's window for it, {w}, is on {after[w].get('output')}, not {active}, the display in use")
        self.check_shows(what, w, after)

    def op_twitch(self, wins, shown):
        if len(shown) < 2:
            return
        n = self.rng.randint(1, 3)
        self.log(f"⌘Tab ×{n}")
        self.twitch(TAB, n, False)
        after = self.after(f"⌘Tab ×{n}")
        focused = [i for i, w in after.items() if w["focused"]]
        if focused:
            self.check_shows(f"⌘Tab ×{n}", focused[0], after)

    def op_open(self, wins, shown):
        app = self.rng.choice(wm.APPS)
        args = self.rng.choice(wm.LAUNCH[app])
        self.log(f"open {' '.join([app, *args])}")
        self.spawn(app, args)
        t0 = time.time()
        while time.time() - t0 < 4 and not (set(self.windows()) - set(wins)):
            time.sleep(0.01)
        after = self.after(f"opening {app}")
        new = set(after) - set(wins)
        for n in new:
            self.check_shows(f"opening {app}", n, after)
        if not new:
            focused = [i for i, w in after.items() if w["focused"]]
            if focused:
                self.check_shows(f"launching {app} again", focused[0], after)

    def op_close(self, wins, shown):
        if len(wins) <= 4:
            return
        w = self.pick(shown)
        if w is None:
            return
        self.log(f"close {w} ({wins[w]['app_id']})")
        self.req({"type": "close", "id": w})
        self.after(f"closing {w}")

    def op_workspace_trip(self, wins, shown):
        self.log("to workspace 2 and back")
        self.shortcut("workspace-2")
        self.after("to workspace 2")
        self.shortcut("workspace-1")
        self.after("back to workspace 1")

    def op_hide_show(self, wins, shown):
        w = self.pick(shown)
        if w is None:
            return
        self.log(f"hide {w} ({wins[w]['app_id']}), then bring it back")
        self.shortcut("hide-window", w)
        self.after(f"hiding {w}")
        self.req({"type": "activate", "id": w})
        after = self.after(f"bringing {w} back")
        self.check_shows(f"bringing {w} back", w, after)

    def op_to_display(self, wins, shown):
        if len(self.outputs) < 2:
            return
        w = self.pick(shown)
        if w is None:
            return
        self.log(f"{w} ({wins[w]['app_id']}) to the next display")
        self.shortcut("next-display", w)
        self.after(f"{w} to the next display")

    # ---- the matrix: each mode, each way, each place ----

    # Where the window brought forward is, seen from the one with the
    # keyboard (a Terminal on the first display, on the workspace it
    # shows): behind it, hidden there, on the other display, on another
    # workspace of the same display.
    PLACES = ["behind", "hidden", "other display", "other workspace"]
    # How: as Deskbar does (no token), its app launched again (a token it
    # asks app_server for), and launched again with a token in its
    # environment that isn't for it (its opener's: a link clicked in an
    # app that passes its own on).
    WAYS = ["deskbar", "relaunch", "opener's token"]

    def spawn_env(self, app, args, env):
        subprocess.run([wm.TSESSION, "run", self.name, app, *args], env=dict(os.environ, **env), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    def wait_for(self, cond, timeout=4.0):
        t0 = time.time()
        while time.time() - t0 < timeout:
            if cond(self.windows()):
                return True
            time.sleep(0.02)
        return False

    def open_one(self, app, args, timeout=8.0):
        before = set(self.windows())
        self.spawn(app, args)
        self.wait_for(lambda wins: set(wins) - before, timeout)
        after = self.after(f"opening {app}")
        new = sorted(set(after) - before)
        if not new:
            raise Failure(f"{app} {' '.join(args)} opened no window")
        return new[-1]

    def put(self, w, place, a, b):
        """`w` where `place` says."""
        i = self.windows().get(w)
        if i is None:
            raise Failure(f"{w} has gone")
        out, ws = {"other display": (b, 0), "other workspace": (a, 1)}.get(place, (a, 0))
        if i["minimized"] and place != "hidden":
            self.req({"type": "activate", "id": w})
            i = self.after(f"bringing {w} back")[w]
        if i.get("output") != out or i["workspace"] != ws:
            self.req({"type": "move_to_workspace", "id": w, "index": ws, "output": out})
            i = self.after(f"{w} to workspace {ws + 1} of {out}")[w]
        if place == "hidden" and not i["minimized"]:
            self.shortcut("hide-window", w)
            self.after(f"hiding {w}")

    def check_in_front(self, what, w, after):
        """Nothing on `w`'s display is over it (but what floats over
        everything, its own dialogs, and its group, which it leads)."""
        a = after.get(w)
        if a is None or a.get("stack") is None:
            return
        over = [i for i, x in after.items() if i != w and x.get("output") == a.get("output") and x.get("stack") is not None
                and x["stack"] < a["stack"] and not x.get("floating") and not x.get("covered") and not x.get("behind")
                and i not in self.mates(after, w)]
        if over:
            self.fail(f"{what}: {w} ({a['app_id']}) has the keyboard, but {over} are over it\n  {wm.state(after)}")

    def case(self, what, mode, place, way, w, front, app, a, b):
        """`app` (Tracker's folder, or Chrome) brings `w` forward from
        `place`, `way`."""
        self.put(w, place, a, b)
        self.req({"type": "activate", "id": front})
        before = self.after(f"{what}: the Terminal forward")
        chrome = isinstance(app, ChromeApp)
        if way == "deskbar":
            self.req({"type": "activate", "id": w})
        else:
            env = {"XDG_ACTIVATION_TOKEN": "from-the-opener"} if way == "opener's token" else {}
            if chrome:
                self.spawn_env("olo-chrome", app.args + [f"data:text/html,{self.step}"], env)
            else:
                self.spawn_env("olo-tracker", [app], env)
        title = None if chrome else os.path.basename(app)
        self.wait_for(lambda wins: any(x["focused"] and (x["app_id"] == app.app_id if chrome else x.get("title") == title) for x in wins.values()))
        after = self.after(what)
        # Tracker brings forward its window for the folder on the workspace
        # in use (the active display's), else opens one there: one on the
        # other display or workspace stays where it is. (Chrome opens the
        # link in its window, wherever that is.)
        new = not chrome and place in ("other display", "other workspace") and way != "deskbar"
        if new:
            opened = [i for i, x in after.items() if i not in before and x.get("title") == title]
            if not opened:
                return self.fail(f"{what}: Tracker brought {w} forward, on {place}, not a window here for {app}\n  {wm.state(after)}")
            if after[opened[0]].get("output") != a:
                self.fail(f"{what}: Tracker's new window for {app} opened on {after[opened[0]].get('output')}, not {a}, the display in use")
            w = opened[0]
        self.check_shows(what, w, after)
        self.check_in_front(what, w, after)
        # Nothing else moves (but auto-tiling's tiles, for a window back
        # in one, or a new one).
        if not new and not (mode == "auto_tiling" and place == "hidden"):
            self.check_unchanged(what, before, after, skip={w} | self.mates(after, w))

    def set_up_chrome(self, root):
        """Olo's Chrome for the matrix: in the session's home (a copy of
        the person's install, reflinked, kept from updating itself), on a
        profile of its own under `root`, with no network (a proxy that
        isn't there). None if it isn't installed."""
        env = json.load(open(os.path.join("/tmp/olo-dev", self.name, "env.json")))
        dest = os.path.join(env.get("HOME") or os.path.expanduser("~"), ".local/share/olo/chrome")
        if not os.path.exists(os.path.join(dest, "current/google-chrome")):
            src = os.path.realpath(os.path.expanduser("~/.local/share/olo/chrome/current"))
            if not os.path.exists(os.path.join(src, "google-chrome")):
                return None
            os.makedirs(dest, exist_ok=True)
            subprocess.run(["cp", "-a", "--reflink=auto", src, os.path.join(dest, os.path.basename(src))], check=True)
            os.symlink(os.path.basename(src), os.path.join(dest, "current"))
        open(os.path.join(dest, ".checked"), "w").close()
        return ChromeApp(os.path.join(root, "chrome"))

    def matrix(self, with_chrome=False):
        """Every mode, on every display, by every way, a window in every
        place brought forward: it has the keyboard, shows, in front, and
        nothing else moves. Prints the table; failures as the fuzz's."""
        self.keep_going = True
        root = f"/var/tmp/olo-mode-matrix-{self.name}"
        folders = {p: os.path.join(root, p.replace(" ", "-")) for p in self.PLACES}
        for f in folders.values():
            os.makedirs(f, exist_ok=True)
        print(f"mode-fuzz {self.name}: the matrix", flush=True)
        for o in self.outputs:
            self.set_mode("standard", o)
        self.after("every display in Standard")
        # (A Terminal left by a run before, if one was: it may not close.)
        had = [i for i, x in self.windows().items() if x["app_id"] == "olo.terminal"]
        front = had[0] if had else self.open_one("olo-terminal", [])
        a = self.windows()[front].get("output")
        b = next((o for o in self.outputs if o != a), None)
        places = [p for p in self.PLACES if b is not None or p != "other display"]
        # Each app's window for each place, and what it is launched on.
        targets = {}
        for p in places:
            self.req({"type": "activate", "id": front})
            self.after("the Terminal forward")
            # (Its window from a run before, if one was left open.)
            title = os.path.basename(folders[p])
            had = [i for i, x in self.windows().items() if x["app_id"] == "olo.tracker" and x.get("title") == title]
            targets[("tracker", p)] = (had[0] if had else self.open_one("olo-tracker", [folders[p]]), folders[p])
        chrome = self.set_up_chrome(root) if with_chrome else None
        if with_chrome and chrome is None:
            print("(no Chrome installed: the matrix goes on without it)")
        if chrome:
            self.req({"type": "activate", "id": front})
            self.after("the Terminal forward")
            # (A new profile's first window takes Chrome most of a minute.)
            had = [i for i, x in self.windows().items() if x["app_id"].startswith("google-chrome")]
            w = had[0] if had else self.open_one("olo-chrome", chrome.args + ["about:blank"], 120.0)
            chrome.app_id = self.windows()[w]["app_id"]
            for p in places:
                targets[("chrome", p)] = (w, chrome)
        apps = ["tracker"] + (["chrome"] if chrome else [])
        keep = set(self.windows())
        results = {}
        for mode in MODES:
            for o in self.outputs:
                self.set_mode(mode, o)
            self.after(f"every display in {mode}")
            for app in apps:
                for way in self.WAYS:
                    for p in places:
                        self.step += 1
                        what = f"{app}, {mode}, {p}, {way}"
                        if not all(o in what for o in self.only):
                            continue
                        self.log(what)
                        n = len(self.failures)
                        w, on = targets[(app, p)]
                        try:
                            self.case(what, mode, p, way, w, front, on, a, b)
                        except Failure as e:
                            self.failures.append(str(e))
                        results[(app, mode, way, p)] = len(self.failures) == n
                        # (Tracker's new windows closed: each case starts alike.)
                        for i in set(self.windows()) - keep:
                            self.req({"type": "close", "id": i})
                        self.wait_for(lambda wins: not (set(wins) - keep))
        for o in self.outputs:
            self.set_mode("standard", o)
        for i in sorted({w for w, _ in targets.values()} | {front}):
            self.req({"type": "close", "id": i})
        if chrome:
            chrome.stop()
        width = max(len(p) for p in places) + 2
        print(f"\n{'':8}{'':14}{'':16}" + "".join(f"{p:{width}}" for p in places))
        for app in apps:
            for mode in MODES:
                for way in self.WAYS:
                    if any((app, mode, way, p) in results for p in places):
                        print(f"{app:8}{mode:14}{way:16}" + "".join(f"{({True: 'ok', False: 'FAIL'}).get(results.get((app, mode, way, p)), '-'):{width}}" for p in places))
        import shutil
        shutil.rmtree(root, ignore_errors=True)
        for f in self.failures:
            print(f"\nFAIL {f}")
        print(f"\n{len(self.failures)} failures" if self.failures else f"\nok: {len(results)} cases")
        return 1 if self.failures else 0


class ChromeApp:
    """Olo's Chrome as the matrix runs it: its own profile, no network."""

    def __init__(self, profile):
        self.profile = profile
        self.args = [f"--user-data-dir={profile}", "--proxy-server=127.0.0.1:9", "--no-first-run", "--no-default-browser-check", "--password-store=basic", "--disable-sync"]
        self.app_id = "google-chrome"

    def stop(self):
        """What is left of it (its window closed, it quits; else its
        processes, found by its profile, are told to)."""
        import signal
        arg = f"--user-data-dir={self.profile}".encode()
        for _ in range(50):
            pids = []
            for pid in os.listdir("/proc"):
                try:
                    if pid.isdigit() and arg in open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0"):
                        pids.append(int(pid))
                except OSError:
                    pass
            if not pids:
                return
            if _ == 20:
                for pid in pids:
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except OSError:
                        pass
            time.sleep(0.1)


def main():
    a = sys.argv[1:]
    if not a or a[0].startswith("-"):
        sys.exit(__doc__)
    import random
    seed = int(a[a.index("--seed") + 1]) if "--seed" in a else random.randrange(1 << 30)
    steps = int(a[a.index("--steps") + 1]) if "--steps" in a else 200
    fuzz = ModeFuzz(a[0], seed, "--quiet" in a)
    if "--only" in a:
        fuzz.only = set(a[a.index("--only") + 1].split(","))
    if "--matrix" in a:
        sys.exit(fuzz.matrix("--chrome" in a))
    sys.exit(fuzz.run(steps, "--keep-going" in a))


if __name__ == "__main__":
    main()
