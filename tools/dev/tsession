#!/usr/bin/env python3
"""Headless Tabula sessions for development and automated UI checks.

  tsession start NAME [WxH[,WxH…]] [--light|--dark] [--session [--shell]] [--home DIR]
                                               start a headless app_server (--session:
                                               under tabula-session, so `reload` works;
                                               --shell also starts Deskbar and the desktop;
                                               --home: HOME for the session and its apps,
                                               so tests that save files stay out of yours)
  tsession reload NAME                         restart app_server in place (session only)
  tsession run NAME [VAR=VAL...] CMD [ARGS...] start a client in it (log: DIR/<cmd>.log);
                                               VAR=VAL set after sudo (e.g. HOME=/tmp/fixture)
  tsession shot NAME OUT.png [X Y W H] [--output HEADLESS-2] [--pointer]
                                               screenshot (optional crop, logical px)
  tsession zoom NAME OUT.png X Y W H [N]       crop (logical px) and magnify N× (default 4)
  tsession click NAME X Y [right]              synthetic click (logical px)
  tsession tap NAME X Y                        press and release at once, as a touchpad tap
  tsession move NAME X Y | down NAME X Y [right] | up NAME [right]
  tsession drag NAME X1 Y1 X2 Y2
  tsession key NAME CODE [CODE...]             evdev codes pressed together (29=Ctrl, 42=Shift)
  tsession type NAME TEXT                      type ASCII text
  tsession wheel NAME NOTCHES [H-NOTCHES]      turn a mouse wheel (positive: down)
  tsession scroll NAME DX DY                  (0 0: the fingers lift)
  tsession flick NAME DY                       a fast two-finger scroll that glides on
  tsession theme NAME light|dark
  tsession ipc NAME JSON                       raw IPC request
  tsession env NAME                            print env to source
  tsession stop NAME | list

Sessions live in /tmp/tabula-dev/NAME. Output is 2× scale by default, so
screenshots are in device pixels and coordinates are logical (pixels / 2).
Runs as the repo owner when invoked as root.
"""
import glob, json, os, pwd, re, signal, socket, subprocess, sys, time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
BASE = "/tmp/tabula-dev"
OWNER = pwd.getpwuid(os.stat(ROOT).st_uid)
RUNTIME = f"/run/user/{OWNER.pw_uid}"
TARGET = os.environ.get("CARGO_TARGET_DIR", os.path.join(ROOT, "target"))

def as_owner(cmd, **kw):
    if os.getuid() == 0 and OWNER.pw_uid != 0:
        cmd = ["sudo", "-u", OWNER.pw_name, "--preserve-env=WAYLAND_DISPLAY,TABULA_SOCKET,XDG_RUNTIME_DIR,XDG_CONFIG_HOME,RUST_LOG,TABULA_THEME,TABULA_DATA,TABULA_SESSION,TABULA_SESSION_PID,HOME,PATH,PULSE_SERVER,TABULA_PAM_CONFDIR,TABULA_PAM_SERVICE,TABULA_PASSWORDS_KEYFILE"] + cmd
    return cmd

def sdir(name):
    return os.path.join(BASE, name)

def ident(path):
    try:
        st = os.stat(path)
        return [st.st_dev, st.st_ino]
    except OSError:
        return None

def load_env(name, check=True):
    try:
        e = json.load(open(os.path.join(sdir(name), "env.json")))
    except FileNotFoundError:
        sys.exit(f"no session {name!r}; run: tsession start {name}")
    # The runtime directory is emptied at logout, and a later session (the
    # user's own!) may get the same wayland-N: never talk to that.
    if check and "sockets" in e and [ident(os.path.join(RUNTIME, e["WAYLAND_DISPLAY"])), ident(e["TABULA_SOCKET"])] != e["sockets"]:
        sys.exit(f"session {name!r} is gone (its sockets are missing or now another session's); "
                 f"start it again (tsession stop {name} only forgets it)")
    return e

def ipc(name, req):
    env = load_env(name)
    s = socket.socket(socket.AF_UNIX)
    s.connect(env["TABULA_SOCKET"])
    s.sendall((json.dumps(req) + "\n").encode())
    line = s.makefile().readline()
    s.close()
    return json.loads(line) if line else None

def synth(name, events):
    return ipc(name, {"type": "synthetic", "events": events})

def start(name, args):
    size = next((a for a in args if re.fullmatch(r"\d+x\d+(,\d+x\d+)*", a)), "2560x1600")
    theme = "dark" if "--dark" in args else "light"
    d = sdir(name)
    if os.path.exists(os.path.join(d, "env.json")):
        stop(name)
    os.makedirs(os.path.join(d, "config", "tabula"), exist_ok=True)
    os.chmod(BASE, 0o1777)
    # Nothing locks, blanks or sleeps a test session: its lock screen checks
    # passwords with the real PAM, and keystrokes meant for apps would go there.
    cfg = {"appearance": {"theme": theme},
           "power": {"display_off_minutes": 0, "sleep_minutes": 0, "lock_on_display_off": False},
           "screen_saver": {"enabled": False, "lock": False}}
    # TSESSION_SETTINGS: a JSON file whose top-level keys go over these
    # (a display layout to test, say).
    if os.environ.get("TSESSION_SETTINGS"):
        cfg.update(json.load(open(os.environ["TSESSION_SETTINGS"])))
    json.dump(cfg, open(os.path.join(d, "config", "tabula", "app_server.json"), "w"))
    subprocess.run(["chown", "-R", f"{OWNER.pw_uid}:{OWNER.pw_gid}", d]) if os.getuid() == 0 else None
    env = dict(os.environ, XDG_RUNTIME_DIR=RUNTIME, XDG_CONFIG_HOME=os.path.join(d, "config"), RUST_LOG=os.environ.get("RUST_LOG", "info"))
    open(os.path.join(d, "no-sound"), "a").close()
    env["PULSE_SERVER"] = "unix:" + os.path.join(d, "no-sound")
    # Passwords keeps its vault key in the session, never in the real
    # login keyring (which the session bus would reach).
    env["TABULA_PASSWORDS_KEYFILE"] = os.path.join(d, "passwords.key")
    env.pop("WAYLAND_DISPLAY", None)
    env.pop("TABULA_SOCKET", None)
    log = open(os.path.join(d, "app_server.log"), "w")
    session = "--session" in args
    # sudo resets HOME, so a sandbox home goes in through env(1).
    home = next((args[i + 1] for i, a in enumerate(args[:-1]) if a == "--home"), None)
    if home:
        os.makedirs(home, exist_ok=True)
        subprocess.run(["chown", f"{OWNER.pw_uid}:{OWNER.pw_gid}", home]) if os.getuid() == 0 else None
    if session:
        # TSESSION_SESSION_EXE: an installed tabula-session instead (upgrade tests).
        exe = [os.environ.get("TSESSION_SESSION_EXE", os.path.join(TARGET, "debug", "tabula-session")), "--headless", size] + ([] if "--shell" in args else ["--no-shell"])
    else:
        exe = [os.path.join(TARGET, "debug", "tabula-app-server"), "--headless", size]
    if home:
        exe = ["env", f"HOME={os.path.abspath(home)}"] + exe
    if os.environ.get("TABULA_UPGRADE_FROM"):
        exe = ["env", "TABULA_UPGRADE_FROM=" + os.environ["TABULA_UPGRADE_FROM"]] + exe
    p = subprocess.Popen(as_owner(exe), env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(100):
        time.sleep(0.1)
        text = re.sub(r"\x1b\[[0-9;]*m", "", open(os.path.join(d, "app_server.log")).read())
        if session:
            m = re.search(r"session: WAYLAND_DISPLAY=(\S+)", text)
            i = re.search(r"session: \S+ TABULA_SOCKET=(\S+)", text)
            ready = "IPC listening" in text
        else:
            m = re.search(r'Listening on wayland socket name="([^"]+)"', text)
            i = re.search(r"IPC listening path=(\S+)", text)
            ready = True
        if m and i and ready:
            e = {"WAYLAND_DISPLAY": m.group(1), "TABULA_SOCKET": i.group(1), "XDG_RUNTIME_DIR": RUNTIME,
                 "XDG_CONFIG_HOME": os.path.join(d, "config"), "pid": p.pid}
            if home:
                e["HOME"] = os.path.abspath(home)
            if session:
                e["TABULA_SESSION"] = "1"
                pidfile = os.path.join(RUNTIME, f"tabula-session-{m.group(1)}.pid")
                e["TABULA_SESSION_PID"] = open(pidfile).read().strip()
            e["sockets"] = [ident(os.path.join(RUNTIME, e["WAYLAND_DISPLAY"])), ident(e["TABULA_SOCKET"])]
            json.dump(e, open(os.path.join(d, "env.json"), "w"))
            print(f"{name}: {e['WAYLAND_DISPLAY']} ({size}, {theme})")
            return
        if p.poll() is not None:
            break
    sys.exit(f"app_server failed to start; see {d}/app_server.log")

def stop(name):
    d = sdir(name)
    try:
        e = json.load(open(os.path.join(d, "env.json")))
        if "sockets" in e and [ident(os.path.join(RUNTIME, e["WAYLAND_DISPLAY"])), ident(e["TABULA_SOCKET"])] != e["sockets"]:
            print(f"{name}: its sockets are gone or another session's; forgetting it without touching them")
        os.killpg(e["pid"], signal.SIGTERM)
    except (FileNotFoundError, ProcessLookupError, PermissionError, KeyError):
        pass
    for f in glob.glob(os.path.join(d, "*.pid")):
        try:
            os.killpg(int(open(f).read()), signal.SIGTERM)
        except Exception:
            pass
        os.remove(f)
    try:
        os.remove(os.path.join(d, "env.json"))
    except FileNotFoundError:
        pass

def run(name, cmd):
    e = load_env(name)
    assigns = []
    while cmd and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", cmd[0]):
        assigns.append(cmd.pop(0))
    if "HOME" in e and not any(a.startswith("HOME=") for a in assigns):
        assigns.append(f"HOME={e['HOME']}")
    if not any(a.startswith("TABULA_PASSWORDS_KEYFILE=") for a in assigns):
        assigns.append(f"TABULA_PASSWORDS_KEYFILE={os.path.join(BASE, name, 'passwords.key')}")
    env = dict(os.environ, **{k: v for k, v in e.items() if k not in ("pid", "sockets")}, RUST_LOG=os.environ.get("RUST_LOG", "warn"))
    # Headless sessions are silent: point the sound server at a plain file
    # (connecting fails) rather than the user's real speakers.
    mute = os.path.join(BASE, name, "no-sound")
    open(mute, "a").close()
    env["PULSE_SERVER"] = "unix:" + mute
    exe = cmd[0]
    if "/" not in exe:
        for cand in (os.path.join(TARGET, "debug", exe), os.path.join(TARGET, "debug", "examples", exe)):
            if os.path.exists(cand):
                exe = cand
                break
    env["PATH"] = os.path.join(TARGET, "debug") + ":" + env.get("PATH", "")
    base = os.path.basename(exe)
    log = open(os.path.join(sdir(name), base + ".log"), "w")
    argv = (["env"] + assigns if assigns else []) + [exe] + cmd[1:]
    p = subprocess.Popen(as_owner(argv), env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    open(os.path.join(sdir(name), f"{base}.{p.pid}.pid"), "w").write(str(p.pid))
    print(f"started {base} pid {p.pid}")

def shot(name, out, crop=None, zoom=1, output=None, pointer=False):
    out = os.path.abspath(out)
    tmp = os.path.join(sdir(name), "shot.png")
    req = {"type": "screenshot", "path": tmp}
    if output:
        req["output"] = output
    if pointer:
        req["pointer"] = True
    r = ipc(name, req)
    if not r or r.get("type") != "ok":
        sys.exit(f"screenshot failed: {r}")
    from PIL import Image
    im = Image.open(tmp)
    if crop:
        x, y, w, h = (int(float(v) * 2) for v in crop)
        im = im.crop((x, y, x + w, y + h))
    if zoom > 1:
        im = im.resize((im.width * zoom, im.height * zoom), Image.NEAREST)
    im.save(out)
    print(out, im.size)

KEYS = {c: k for k, c in enumerate("1234567890-=", 2)}
KEYS.update({c: 16 + i for i, c in enumerate("qwertyuiop[]")})
KEYS.update({c: 30 + i for i, c in enumerate("asdfghjkl;'")})
KEYS.update({c: 44 + i for i, c in enumerate("zxcvbnm,./")})
KEYS.update({" ": 57, "\n": 28, "\t": 15, "`": 41, "\\": 43})
SHIFTED = {'!': '1', '@': '2', '#': '3', '$': '4', '%': '5', '^': '6', '&': '7', '*': '8', '(': '9', ')': '0',
           '_': '-', '+': '=', '{': '[', '}': ']', ':': ';', '"': "'", '<': ',', '>': '.', '?': '/', '~': '`', '|': '\\'}

def press(name, codes):
    synth(name, [{"type": "key", "key": c, "pressed": True} for c in codes])
    time.sleep(0.02)
    synth(name, [{"type": "key", "key": c, "pressed": False} for c in reversed(codes)])
    time.sleep(0.02)

def move(name, x, y):
    # Two motions: the first after a popup grab ends only clears the grab.
    synth(name, [{"type": "move", "x": x - 1, "y": y}])
    time.sleep(0.02)
    synth(name, [{"type": "move", "x": x, "y": y}])
    time.sleep(0.04)

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd = sys.argv[1]
    if cmd == "list":
        for d in sorted(glob.glob(os.path.join(BASE, "*", "env.json"))):
            print(os.path.basename(os.path.dirname(d)), json.load(open(d))["WAYLAND_DISPLAY"])
        return
    name, a = sys.argv[2], sys.argv[3:]
    if cmd == "start":
        start(name, a)
    elif cmd == "stop":
        stop(name)
    elif cmd == "reload":
        os.kill(int(load_env(name)["TABULA_SESSION_PID"]), signal.SIGHUP)
    elif cmd == "run":
        run(name, a)
    elif cmd == "env":
        for k, v in load_env(name).items():
            if k != "pid":
                print(f"export {k}={v}")
    elif cmd == "shot":
        output = a[a.index("--output") + 1] if "--output" in a else None
        pointer = "--pointer" in a
        a = [v for i, v in enumerate(a) if v not in ("--output", "--pointer") and (i == 0 or a[i - 1] != "--output")]
        shot(name, a[0], a[1:5] if len(a) >= 5 else None, output=output, pointer=pointer)
    elif cmd == "zoom":
        shot(name, a[0], a[1:5], int(a[5]) if len(a) > 5 else 4)
    elif cmd == "move":
        move(name, float(a[0]), float(a[1]))
    elif cmd in ("click", "down"):
        b = 0x111 if len(a) > 2 and a[2] == "right" else 0x110
        move(name, float(a[0]), float(a[1]))
        synth(name, [{"type": "button", "button": b, "pressed": True}])
        if cmd == "click":
            time.sleep(0.04)
            synth(name, [{"type": "button", "button": b, "pressed": False}])
        time.sleep(0.15)
    elif cmd == "tap":
        move(name, float(a[0]), float(a[1]))
        synth(name, [{"type": "button", "button": 0x110, "pressed": True}, {"type": "button", "button": 0x110, "pressed": False}])
        time.sleep(0.15)
    elif cmd == "wheel":
        synth(name, [{"type": "wheel", "dx": int(a[1]) if len(a) > 1 else 0, "dy": int(a[0])}])
        time.sleep(0.05)
    elif cmd == "up":
        b = 0x111 if a and a[0] == "right" else 0x110
        synth(name, [{"type": "button", "button": b, "pressed": False}])
    elif cmd == "drag":
        x1, y1, x2, y2 = map(float, a[:4])
        move(name, x1, y1)
        synth(name, [{"type": "button", "button": 0x110, "pressed": True}])
        for i in range(1, 11):
            time.sleep(0.02)
            synth(name, [{"type": "move", "x": x1 + (x2 - x1) * i / 10, "y": y1 + (y2 - y1) * i / 10}])
        time.sleep(0.05)
        synth(name, [{"type": "button", "button": 0x110, "pressed": False}])
        time.sleep(0.15)
    elif cmd == "key":
        press(name, [int(c) for c in a])
        time.sleep(0.1)
    elif cmd == "type":
        for ch in " ".join(a):
            if ch.isupper():
                press(name, [42, KEYS[ch.lower()]])
            elif ch in SHIFTED:
                press(name, [42, KEYS[SHIFTED[ch]]])
            elif ch in KEYS:
                press(name, [KEYS[ch]])
        time.sleep(0.1)
    elif cmd == "flick":
        # Two fingers moving DY a step for 10 steps, then lifting: a glide.
        for _ in range(10):
            synth(name, [{"type": "scroll", "dx": 0.0, "dy": float(a[0])}])
            time.sleep(0.008)
        synth(name, [{"type": "scroll", "dx": 0.0, "dy": 0.0}])
    elif cmd == "scroll":
        synth(name, [{"type": "scroll", "dx": float(a[0]), "dy": float(a[1])}])
        time.sleep(0.15)
    elif cmd == "theme":
        st = ipc(name, {"type": "get_settings"})["settings"]
        st["appearance"]["theme"] = a[0]
        print(ipc(name, {"type": "set_settings", "settings": st}))
        time.sleep(0.4)
    elif cmd == "ipc":
        print(json.dumps(ipc(name, json.loads(a[0]))))
    else:
        sys.exit(f"unknown command {cmd}")

if __name__ == "__main__":
    main()
