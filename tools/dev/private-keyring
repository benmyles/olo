#!/bin/bash
# A private session bus (busd) with its own gnome-keyring (login keyring
# unlocked with "test"), for tests of the Secret Service client and of
# Passwords' vault key. Never touches the real session or keyring.
#
#   tools/dev/private-keyring start   # prints the variables to export
#   tools/dev/private-keyring stop
set -e
DIR=/tmp/olo-dev/keyring
case "$1" in
start)
    "$0" stop >/dev/null 2>&1 || true
    mkdir -p "$DIR/home/.local/share" "$DIR/run"
    chmod 700 "$DIR/run"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$DIR/bus" HOME="$DIR/home" \
        XDG_DATA_HOME="$DIR/home/.local/share" XDG_RUNTIME_DIR="$DIR/run"
    # Nothing it starts (the bus activating GNOME Keyring, gcr's prompter
    # if no test prompter answers) may reach the person's display.
    unset GNOME_KEYRING_CONTROL WAYLAND_DISPLAY DISPLAY
    # A bus of its own: busd if installed (`cargo install busd --root
    # /tmp/olo-dev/busd`), else dbus-daemon with the session's rules
    # (dbus-broker needs a systemd user manager).
    BUSD=${BUSD:-/tmp/olo-dev/busd/bin/busd}
    if [ -x "$BUSD" ]; then
        setsid "$BUSD" --address "unix:path=$DIR/bus" >"$DIR/bus.log" 2>&1 < /dev/null &
        echo $! > "$DIR/bus.pid"
    else
        dbus-daemon --config-file=/usr/share/dbus-1/session.conf --address="unix:path=$DIR/bus" --fork --print-pid > "$DIR/bus.pid"
    fi
    for _ in $(seq 50); do [ -S "$DIR/bus" ] && break; sleep 0.1; done
    printf test | gnome-keyring-daemon --unlock --components=secrets --daemonize > "$DIR/keyring.env"
    # The daemon claims org.freedesktop.secrets a moment after it starts.
    for _ in $(seq 50); do [ -S "$DIR/run/keyring/control" ] && break; sleep 0.1; done
    sleep 0.5
    echo "export DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
    ;;
stop)
    # Only daemons started for this directory (by their environment);
    # never the real keyring.
    for pid in $(pgrep -u "$(id -u)" -x gnome-keyring-d); do
        tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx "XDG_RUNTIME_DIR=$DIR/run" && kill "$pid"
    done
    [ -f "$DIR/bus.pid" ] && kill "$(cat "$DIR/bus.pid")" 2>/dev/null || true
    rm -rf "$DIR"
    ;;
*) echo "usage: $0 start|stop" >&2; exit 2 ;;
esac
