#!/usr/bin/python3
"""What tells of a screenshot or a recording saved (apps/screenshot saved.rs,
through apps/notifications), tried in a headless desktop of its own with the
notifications service on that desktop's own bus.

  shot-note-check [N]

  a shot by the shortcut's command (`olo-screenshot --silent`) is told of in a
  notification in the screen's lower right: Screenshot's, its picture the file
  (`x-olo-file`), each action saying what it runs once Screenshot has gone
  (`x-olo-runs`: `--saved ACTION PATH RECEIPT`, the receipt the very file
  saved), Delete set apart;
  N more shots in a row (12 if not said), each while the banner of the one
  before is up: none has that banner in its picture, and each is told of;
  with another app's notification up too: the next picture has that one and
  not Screenshot's;
  `--no-notification` takes the picture, puts the banner before it away and
  tells nothing;
  the banner's picture (found where the notifications' agent tree says it is)
  pressed and dragged onto a Tracker window is the file there, whole, and the
  note is read and off the screen; pressed and let go of where it was, it's a
  click: the file opened in the person's viewer (the test's own, chosen for
  a PNG in its home), the note read and off the screen, no file dragged
  anywhere; a right click on its Delete opens the card's menu (its actions,
  Delete last) and deletes nothing (and leaves the note as it was);
  its actions once Screenshot has gone (the clipboard it held taken): Copy
  holds the file (a program of its own: the path on the clipboard), Delete
  puts the file in the Trash, the note read and off the screen after each;
  the next picture given the deleted one's name, the first's Delete chosen
  again leaves it alone (its receipt is the first file's): the helper the
  centre starts waited for until it says how it ended (the centre runs from
  a folder of the run's own, Screenshot's program there a wrapper that keeps
  that), and Screenshot asked directly with that very action;
  a note anyone may send saying it's Screenshot's: one with no file of its
  own keeps none of its actions (the centre drops them, and one that is
  another of Screenshot's modes); one naming a file Screenshot never saved
  as its own, with that file's real receipt, keeps its Delete, which deletes
  nothing (chosen once the note is no longer open at its sender, so that
  what's run is what it says; the helper waited for until it says so), and
  Screenshot asked so directly says so;
  a recording made as a GIF is told of with its picture and its length, the
  GIF the file, on the screen (the recording over); put away, its note is no
  longer shown (its recorder long gone);
  the History window in Cards: a card's picture dragged onto Tracker is the
  file there;
  on an Agent Screen (OLO_SCREEN) a shot tells nothing.

Needs olo-app-server, olo-bus, olo-notifications, olo-screenshot, olo-tracker
and olo-pb built in the profile it runs (dev; TSESSION_PROFILE=release for
release), and gdbus. /usr/bin/python3: it compares pictures (PIL).
SHOT_NOTE_NAME is a prefix for its desktop's name (a helper's own; the run's
own number follows it); SHOT_NOTE_SCRATCH a folder in which it makes one of
its own for what it makes (only that one is ever removed: when every check
passes; kept when one fails, for looking at). Its programs keep their state,
caches and data in its own home there, whatever the environment says.
"""
import glob, json, os, secrets, shlex, shutil, socket, subprocess, sys, tempfile, time
from PIL import Image, ImageChops

TREE = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
N = int(sys.argv[1]) if len(sys.argv) > 1 else 12
TS = ["/usr/bin/python3", os.path.join(TREE, "tools/dev/tsession")]
NAME = f"{os.environ.get('SHOT_NOTE_NAME') or 'shotnote'}-{os.getpid()}-{secrets.token_hex(3)}"
BASE = os.environ.get("SHOT_NOTE_SCRATCH") or "/var/tmp"
os.makedirs(BASE, exist_ok=True)
# (A folder of this run's own, made new: whatever else is in BASE is never touched.)
SCRATCH = tempfile.mkdtemp(prefix="olo-shot-note-", dir=BASE)
HOME = os.path.join(SCRATCH, "home")
OUT = os.path.join(SCRATCH, "out")
PROFILE = "release" if os.environ.get("TSESSION_PROFILE") == "release" else "debug"
BUILT = os.path.join(os.environ.get("CARGO_TARGET_DIR", os.path.join(TREE, "target")), PROFILE)
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
SCREEN = (1280, 800)
# The notifications' banners stand this far from the screen's right and bottom (`GAP`).
GAP = 10
# The screen's lower right, where banners stand (points, scale 1).
CORNER = (900, 300, 380, 500)
# What the programs of this run keep, where (its home's, never the caller's: an exported XDG_STATE_HOME
# would have had the test's record of what Screenshot saved, its posters and its Trash in the caller's).
XDG = {"XDG_STATE_HOME": f"{HOME}/.local/state", "XDG_CACHE_HOME": f"{HOME}/.cache", "XDG_DATA_HOME": f"{HOME}/.local/share"}
# (Olo's icons and words where the programs are built away from the tree.)
ENV = [f"OLO_DATA={TREE}/data", *(f"{k}={v}" for k, v in XDG.items())]
# The folder the notifications centre runs from (`centre_folder`), what Screenshot's helpers it started said
# as they ended (a line each: the exit status and the arguments), and what the test's viewer was given.
BIN = os.path.join(SCRATCH, "bin")
HELPED = os.path.join(SCRATCH, "helped.txt")
OPENED = os.path.join(SCRATCH, "opened.txt")


def centre_folder():
    """A folder of this run's own for the notifications centre to run from (`find_program` looks beside the
    program first): Screenshot's program there is a wrapper that keeps, for each action the centre starts (a
    saved picture's, once Screenshot has gone, or what says it runs on its own), how it ended and what it was
    asked, so that a check waits for the helper's own result, never a while; Olo's other programs are the
    built ones. Its path."""
    os.makedirs(BIN)
    for name in os.listdir(BUILT):
        src = os.path.join(BUILT, name)
        if name.startswith("olo-") and name not in ("olo-notifications", "olo-screenshot") and os.path.isfile(src) and os.access(src, os.X_OK):
            os.symlink(src, os.path.join(BIN, name))
    # (A file of its own, not a link: run through a link, it's the built one, and looks beside that.)
    centre = os.path.join(BIN, "olo-notifications")
    try:
        os.link(os.path.realpath(os.path.join(BUILT, "olo-notifications")), centre)
    except OSError:
        shutil.copy2(os.path.join(BUILT, "olo-notifications"), centre)
    q = shlex.quote
    wrapper = os.path.join(BIN, "olo-screenshot")
    with open(wrapper, "w") as f:
        # (A record a line: its exit status and its words, each after a tab, so a path with spaces is one.)
        f.write(f"#!/bin/sh\n{q(os.path.join(BUILT, 'olo-screenshot'))} \"$@\"\nrc=$?\n{{ printf '%s' \"$rc\"; for a in \"$@\"; do printf '\\t%s' \"$a\"; done; echo; }} >> {q(HELPED)}\nexit $rc\n")
    os.chmod(wrapper, 0o755)
    return centre


def helped_records():
    try:
        return [l.split("\t") for l in open(HELPED).read().split("\n") if l]
    except OSError:
        return []


def checkpoint():
    """Where the helpers' records are now: what's waited for after it is what ended since."""
    return len(helped_records())


def helped(action, path, receipt=None, since=0):
    """How a helper the centre started for exactly `--saved ACTION PATH [RECEIPT]` ended (its exit status),
    the last one since `checkpoint` `since`, once one has."""
    want = ["--saved", action, path] + ([receipt] if receipt else [])
    found = [r[0] for r in helped_records()[since:] if r[1:1 + len(want)] == want]
    return found[-1] if found else None


def viewer(config_home):
    """The person's own choice of what opens a PNG, where the desktop's programs read it (the session's own
    `XDG_CONFIG_HOME`, as tsession gives it): a viewer of the test's that keeps what it's given (`OPENED`),
    so a click on a screenshot's note is seen to open that file."""
    apps = os.path.join(HOME, ".local/share/applications")
    os.makedirs(apps, exist_ok=True)
    script = os.path.join(SCRATCH, "viewer.sh")
    with open(script, "w") as f:
        f.write(f"#!/bin/sh\nprintf '%s\\n' \"$1\" >> {shlex.quote(OPENED)}\n")
    os.chmod(script, 0o755)
    # (Its program quoted as a desktop entry quotes one: a scratch folder may have spaces in it.)
    exec_ = '"' + script.replace("\\", "\\\\").replace('"', '\\"').replace("`", "\\`").replace("$", "\\$") + '"'
    with open(os.path.join(apps, "shot-note-viewer.desktop"), "w") as f:
        f.write(f"[Desktop Entry]\nType=Application\nName=Shot Note Viewer\nExec={exec_} %f\nMimeType=image/png;\nNoDisplay=true\n")
    for home in {config_home, os.path.join(HOME, ".config")}:
        os.makedirs(os.path.join(home, "olo"), exist_ok=True)
        with open(os.path.join(home, "olo", "default-apps.list"), "w") as f:
            f.write("[Default Applications]\nimage/png=shot-note-viewer.desktop\n")


def opened():
    try:
        return open(OPENED).read().splitlines()
    except OSError:
        return []


def ts(*a, check=False):
    # (No call waits for ever: a desktop that doesn't answer is a failure.)
    r = subprocess.run(TS + list(a), capture_output=True, text=True, timeout=90)
    if check and r.returncode != 0:
        sys.exit(f"tsession {a}: {r.stdout}{r.stderr}")
    return r


def run(*cmd):
    """A program of this desktop's, started in it (its env this run's own); its pid."""
    out = ts("run", NAME, *ENV, *cmd, check=True).stdout
    return int(out.split("pid")[1].split()[0]) if "pid" in out else None


def until(what, is_it, secs=15):
    end = time.time() + secs
    while time.time() < end:
        got = is_it()
        if got:
            return got
        time.sleep(0.05)
    sys.exit(f"FAILED: waited {secs} s for {what}")


def corner(path):
    return Image.open(path).convert("RGB").crop((CORNER[0], CORNER[1], CORNER[0] + CORNER[2], CORNER[1] + CORNER[3]))


def screen_corner(name):
    path = os.path.join(OUT, name)
    ts("shot", NAME, path, *map(str, CORNER), check=True)
    return Image.open(path).convert("RGB")


def differs(a, b):
    return ImageChops.difference(a, b).getbbox() is not None


def shots():
    return sorted(glob.glob(os.path.join(HOME, "screenshot*.png")), key=os.path.getmtime)


def whole(path):
    def ok():
        try:
            return Image.open(path).size == SCREEN
        except Exception:
            return False
    until(f"{os.path.basename(path)} to be whole", ok, 10)
    return path


def shoot(*extra):
    """A shot by the shortcut's command; its file, whole."""
    had = set(shots())
    ts("run", NAME, *ENV, *extra, "olo-screenshot", "--silent", check=True)
    return whole(until("the picture", lambda: next((s for s in shots() if s not in had), None)))


class Desk:
    """The notifications service of this desktop: its bus, its process."""

    def __init__(self, bus, pid, session):
        self.bus, self.pid = bus, pid
        # (The desktop's own environment, as its programs have it: a helper asked directly reads its record,
        # its Trash and its choices where theirs are.)
        self.env = {**os.environ, **session, "HOME": HOME, **XDG}

    def cli(self, *a):
        return subprocess.run([os.path.join(BUILT, "olo-notifications"), "--bus", self.bus, *a], capture_output=True, text=True, timeout=30, env=self.env)

    def notes(self):
        """The notifications the service has (it answers: one that doesn't is a failure)."""
        end = time.time() + 10
        while time.time() < end:
            r = self.cli("--list", "--json")
            try:
                return json.loads(r.stdout)["notifications"]
            except (ValueError, KeyError):
                time.sleep(0.2)
        sys.exit(f"FAILED: the notifications service didn't say what it has: {r.stderr}")

    def note_of(self, path):
        return next((n for n in reversed(self.notes()) if n.get("look", {}).get("file") == path), None)

    def note_by_id(self, id):
        return next((n for n in reversed(self.notes()) if n["id"] == id), None)

    def told_since(self, before):
        """Notes that came since `before` (their ids). (Not "any about the file": a picture deleted and the
        next given its name, the first free one, has an old note about its path.)"""
        return [(n["id"], n["summary"]) for n in self.notes() if n["id"] not in before]

    def invoke(self, id, action):
        r = self.cli("--invoke", str(id), action)
        if r.returncode != 0:
            sys.exit(f"FAILED: choosing {action} on note {id} wasn't taken: {r.stdout}{r.stderr}")

    def put_away(self, app):
        r = subprocess.run(["gdbus", "call", "-a", self.bus, "-d", "org.freedesktop.Notifications", "-o", "/com/olodesktop/Notifications", "-m", "com.olodesktop.Notifications1.PutAway", app], capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            sys.exit(f"FAILED: PutAway({app}): {r.stderr}")

    def banner(self, name):
        """The agent-tree nodes of the banners' surface (in the screen's points), and the node whose name
        starts with `name`, if there is one. (The surface stands in the screen's lower right, `GAP` in.)"""
        for t in ask_app(self.pid, {"tree": True}) or []:
            if t.get("layer") != "notifications":
                continue
            x0, y0 = SCREEN[0] - GAP - t["width"], SCREEN[1] - GAP - t["height"]
            nodes = [dict(n, x=n["x"] + x0, y=n["y"] + y0) for n in t.get("nodes", [])]
            return next((n for n in nodes if (n.get("name") or "").startswith(name)), None)
        return None

    def menu_items(self):
        """The items of a menu of the service's that's up (a card's, opened with a right click), by name."""
        return [n.get("name") for t in ask_app(self.pid, {"tree": True}) or [] for n in t.get("nodes", []) if n.get("role") == "MenuItem"]

    def window(self, title, name):
        """A node of window `title`'s agent tree whose name starts with `name`, in the screen's points."""
        wins = {w.get("title"): w for w in ipc({"type": "list_windows"}).get("windows", []) if w.get("pid") == self.pid}
        for t in ask_app(self.pid, {"tree": True}) or []:
            w = wins.get(t.get("title"))
            if not w or t.get("layer"):
                continue
            for n in t.get("nodes", []):
                if (n.get("name") or "").startswith(name):
                    return dict(n, x=n["x"] + w["content"]["x"], y=n["y"] + w["content"]["y"])
        return None


def middle(n):
    return int(n["x"] + n["width"] / 2), int(n["y"] + n["height"] / 2)


def ask_app(pid, req, timeout=6):
    path = os.path.join(RUNTIME, f"olo-menus-{pid}.sock")
    if not os.path.exists(path):
        return None
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(timeout)
    try:
        s.connect(path)
        s.sendall((json.dumps(req) + "\n").encode())
        return json.loads(s.makefile().readline() or "null")
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def ipc(req):
    try:
        return json.loads(ts("ipc", NAME, json.dumps(req)).stdout or "{}")
    except ValueError:
        return {}


def gdbus_notify(bus, app, summary, body, actions, hints, timeout):
    r = subprocess.run(["gdbus", "call", "-a", bus, "-d", "org.freedesktop.Notifications", "-o", "/org/freedesktop/Notifications", "-m", "org.freedesktop.Notifications.Notify", "--", app, "0", "", summary, body, actions, hints, str(timeout)], capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        sys.exit(f"gdbus: {r.stderr}")
    return int(r.stdout.strip().strip("()").split()[1].rstrip(","))


def mine(flag):
    """Processes of this run (by their HOME) with `flag` among their arguments."""
    found = []
    for d in glob.glob("/proc/[0-9]*"):
        try:
            argv = open(d + "/cmdline", "rb").read().split(b"\0")
            env = open(d + "/environ", "rb").read().split(b"\0")
        except OSError:
            continue
        if flag.encode() in argv and f"HOME={HOME}".encode() in env:
            found.append(int(os.path.basename(d)))
    return found


def file_id(path):
    """The file's whole receipt as Olo makes it (`FileId`: `dev-ino-born`, born its birth, else its last
    change of content, in nanoseconds), from what `stat` says of it (Python's own has no birth time here)."""
    dev, ino, born, changed = subprocess.run(["stat", "-c", "%d %i %.9W %.9Y", path], capture_output=True, text=True, check=True, timeout=10).stdout.split()
    t = born if born.replace(".", "").strip("0") else changed
    return f"{dev}-{ino}-{int(t.replace('.', ''))}"


def receipt_of(path):
    """What Screenshot's notification's actions say of the file at `path` as it is: `dev-ino-born`,
    checked by its first two (the third, when it was made, has no stat here)."""
    st = os.stat(path)
    return f"{st.st_dev}-{st.st_ino}-"


def drag(frm, to, steps=10):
    ts("move", NAME, *map(str, frm), check=True)
    time.sleep(0.3)
    ts("down", NAME, *map(str, frm), check=True)
    for step in range(1, steps + 1):
        ts("move", NAME, str(frm[0] + (to[0] - frm[0]) * step // steps), str(frm[1] + (to[1] - frm[1]) * step // steps), check=True)
        time.sleep(0.05)


def main():
    missing = [p for p in ("olo-app-server", "olo-bus", "olo-notifications", "olo-screenshot", "olo-tracker", "olo-pbcopy", "olo-pbpaste") if not os.path.exists(os.path.join(BUILT, p))]
    if missing:
        sys.exit(f"shot-note-check: not built in {BUILT}: {', '.join(missing)} (jato build -p app_server -p olo-bus -p olo-notifications -p olo-screenshot -p olo-tracker -p olo-pb)")
    if not shutil.which("gdbus"):
        sys.exit("shot-note-check: needs gdbus (glib2)")
    os.makedirs(HOME)
    os.makedirs(OUT)
    ts("start", NAME, "1280x800", "--light", "--scale", "1", "--home", HOME, check=True)
    passed = False
    try:
        env = {l.split("=", 1)[0].removeprefix("export "): l.split("=", 1)[1] for l in ts("env", NAME, check=True).stdout.splitlines() if l.startswith("export ") and "=" in l}
        bus, display = env["DBUS_SESSION_BUS_ADDRESS"], env["WAYLAND_DISPLAY"]
        viewer(env.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"))
        desk = Desk(bus, run(centre_folder(), "--bus", bus), env)
        until("the notifications service on the desktop's bus", lambda: desk.cli("--list").returncode == 0)
        drop = os.path.join(HOME, "dropped")
        os.makedirs(drop)
        tracker = run("olo-tracker", drop)
        until("Tracker's window", lambda: any(w.get("pid") == tracker for w in ipc({"type": "list_windows"}).get("windows", [])), 15)
        time.sleep(1.0)
        tw = next(w for w in ipc({"type": "list_windows"})["windows"] if w.get("pid") == tracker)["content"]
        into_tracker = (int(tw["x"] + tw["width"] / 2), int(tw["y"] + tw["height"] * 0.6))
        ts("move", NAME, "640", "560")
        base = screen_corner("base.png")

        # 1. A shot is told of, in the lower right, as Screenshot's; its actions carry the very file saved.
        first = shoot()
        until("its banner on the screen", lambda: differs(screen_corner("first.png"), base))
        n = until("its notification", lambda: desk.note_of(first))
        look = n["look"]
        runs = {k: a for k, a in n.get("runs", [])}
        if not (n["app"] == "Screenshot" and n["desktop_entry"] == "olo-screenshot" and n["shown"] and look.get("image") == first and look.get("image_id") and look["image_id"] == look.get("file_id") and look.get("apart") == "delete"):
            sys.exit(f"FAILED: the notification isn't Screenshot's, its picture the file: {json.dumps(n)[:600]}")
        said = n.get("show") or []
        receipt = said[3] if len(said) == 4 else ""
        if said[:3] != ["--saved", "open", first] or not receipt.startswith(receipt_of(first)) or any(runs.get(k) != ["--saved", k, first, receipt] for k in ("copy", "show", "delete")):
            sys.exit(f"FAILED: its actions don't say what they run once Screenshot has gone, with the file's receipt: show {said}, runs {runs}")
        print(f"ok: {os.path.basename(first)} is told of in a notification in the lower right, Screenshot's, its picture the file, its actions its receipt ({receipt})")

        # 2. Shots in a row, each while the banner before it is up: none has it in its picture; each told of.
        for i in range(N):
            until("the banner of the one before on the screen", lambda: differs(screen_corner(f"before-{i}.png"), base), 10)
            newest = shoot()
            if differs(corner(newest), base):
                corner(newest).save(os.path.join(OUT, f"with-banner-{i}.png"))
                sys.exit(f"FAILED: {os.path.basename(newest)} has the banner of the one before in it (kept in {OUT})")
            until(f"{os.path.basename(newest)}'s own notification", lambda: desk.note_of(newest), 10)
        print(f"ok: {N} more shots, each taken while the banner before it was up: none has a banner in it, each told of")

        # 3. Another app's notification up too: the next picture has it, and not Screenshot's.
        # (The last one's banner up first: an app's new banners wait a moment after it puts its banners away,
        # its picture being taken; gone before it came up was no "gone by itself".)
        until("the last shot's banner on the screen", lambda: differs(screen_corner("last-up.png"), base), 10)
        until("Screenshot's banners gone by themselves", lambda: not differs(screen_corner("settled.png"), base), 20)
        other = gdbus_notify(bus, "Mail", "Lunch?", "With Ann at one", "[]", "{}", 0)
        time.sleep(1.0)
        with_other = screen_corner("with-other.png")
        if not differs(with_other, base):
            sys.exit("FAILED: another app's notification didn't show")
        shoot()
        until("Screenshot's banner beside the other", lambda: differs(screen_corner("both.png"), with_other), 10)
        newest = shoot()
        if differs(corner(newest), with_other):
            corner(newest).save(os.path.join(OUT, "stacked.png"))
            sys.exit(f"FAILED: with another app's notification up, {os.path.basename(newest)} isn't the screen with that one alone (kept in {OUT})")
        desk.cli("--dismiss", str(other))
        print("ok: with another app's notification up, the next picture has that one and not Screenshot's")

        # 4. `--no-notification`: a picture, the banner before it put away, and nothing told.
        until("the last banner up", lambda: differs(screen_corner("before-quiet.png"), base), 10)
        before = {n["id"] for n in desk.notes()}
        had = set(shots())
        ts("run", NAME, *ENV, "olo-screenshot", "--silent", "--no-notification", check=True)
        quiet = whole(until("the picture", lambda: next((s for s in shots() if s not in had), None)))
        if differs(corner(quiet), base):
            sys.exit("FAILED: the picture taken with --no-notification has a banner in it")
        time.sleep(1.0)
        if told := desk.told_since(before):
            sys.exit(f"FAILED: --no-notification told of the picture: {told}")
        print("ok: --no-notification takes the picture, puts the banner before it away, and tells nothing")

        # 5. The banner's picture (where the agent tree says) dragged onto Tracker's window: the file there,
        # whole; the note read and gone from the screen.
        until("no banner", lambda: not differs(screen_corner("clear.png"), base), 20)
        shot = shoot()
        picture = until("its banner's picture", lambda: desk.banner(f"Picture: {os.path.basename(shot)} (drag it out"), 10)
        drag(middle(picture), into_tracker)
        ts("shot", NAME, os.path.join(OUT, "dragging.png"), "--pointer")
        ts("up", NAME, check=True)
        there = os.path.join(drop, os.path.basename(shot))
        until("the file, whole, in the folder it was dropped on", lambda: os.path.exists(there) and os.path.getsize(there) == os.path.getsize(shot), 10)
        if open(there, "rb").read() != open(shot, "rb").read():
            sys.exit("FAILED: what was dropped is not the picture's file")
        until("its note read and off the screen", lambda: (lambda n: n and not n["unread"] and not n["shown"])(desk.note_of(shot)), 5)
        print(f"ok: the banner's picture dragged onto Tracker is the file there ({os.path.basename(shot)}), and its note is read and off the screen")

        # 5b. Pressed and let go of where it was: a click (its default, Open): the file opened in the person's
        # viewer (the test's own, for a PNG), the note read and off the screen, no file dragged.
        shot = shoot()
        picture = until("its banner's picture", lambda: desk.banner(f"Picture: {os.path.basename(shot)} (drag it out"), 10)
        held = set(os.listdir(drop))
        at = middle(picture)
        ts("move", NAME, *map(str, at), check=True)
        time.sleep(0.3)
        ts("down", NAME, *map(str, at), check=True)
        time.sleep(0.15)
        ts("up", NAME, check=True)
        until("its note read and off the screen, clicked", lambda: (lambda n: n and not n["unread"] and not n["shown"])(desk.note_of(shot)), 5)
        until(f"the viewer given {os.path.basename(shot)}", lambda: shot in opened(), 10)
        if set(os.listdir(drop)) != held:
            sys.exit(f"FAILED: a click on the picture dragged a file somewhere: {set(os.listdir(drop)) - held}")
        print("ok: pressed and let go of where it was, the picture is a click: the file opened in the viewer, the note read and off the screen, nothing dragged")

        # 5c. A right click on its Delete: the card's menu (its actions, Delete last), and nothing deleted.
        shot = shoot()
        delete = until("its banner's Delete", lambda: (lambda b: b and b.get("role") == "Button" and b)(desk.banner("Delete")), 10)
        ts("click", NAME, *map(str, middle(delete)), "right", check=True)
        items = until("the card's menu", lambda: desk.menu_items(), 5)
        ts("shot", NAME, os.path.join(OUT, "right-click-delete.png"), check=True)
        if not ("Copy" in items and items[-1] == "Delete"):
            sys.exit(f"FAILED: a right click on Delete didn't open the card's menu, its actions in it and Delete last: {items}")
        # (Escape: the menu goes, nothing chosen.)
        ts("key", NAME, "1")
        until("the menu gone", lambda: not desk.menu_items(), 5)
        if not os.path.exists(shot):
            sys.exit("FAILED: a right click on Delete deleted the file")
        n = desk.note_of(shot)
        if not n or not n["unread"]:
            sys.exit(f"FAILED: a right click on Delete did something to the note: {json.dumps(n)[:300]}")
        print(f"ok: a right click on a banner's Delete opens the card's menu ({', '.join(items)}) and deletes nothing")

        # 6. Its actions once Screenshot has gone: the clipboard it held taken, Copy is a program of its own
        # holding the file; Delete puts it in the Trash; the note read and off the screen.
        desk.put_away("olo-screenshot")
        shot = shoot()
        n = until("its notification", lambda: desk.note_of(shot))
        until("Screenshot holding the clipboard", lambda: mine("--silent"), 10)
        # (Something else copied in the desktop: what holds it is the desktop's, ended with it.)
        ts("run", NAME, "sh", "-c", f"printf 'something else' | {os.path.join(BUILT, 'olo-pbcopy')}", check=True)
        wl = dict(desk.env, WAYLAND_DISPLAY=display)
        until("Screenshot to end, its clipboard taken", lambda: not mine("--silent"), 10)
        until("its note no longer open at Screenshot", lambda: not (desk.note_of(shot) or {}).get("live", True), 10)
        desk.invoke(n["id"], "copy")
        paste = lambda: subprocess.run([os.path.join(BUILT, "olo-pbpaste")], capture_output=True, env=wl, timeout=30).stdout.decode().strip()
        until("Copy, a program of its own, holding the file (the path on the clipboard)", lambda: paste() == shot, 10)
        until("its note read and off the screen after Copy", lambda: (lambda n: n and not n["unread"] and not n["shown"])(desk.note_of(shot)), 5)
        desk.invoke(n["id"], "delete")
        trashed = os.path.join(HOME, ".local/share/Trash/files", os.path.basename(shot))
        until("the file in the Trash", lambda: os.path.exists(trashed) and not os.path.exists(shot), 10)
        print("ok: once Screenshot has gone, Copy holds the file (a program of its own) and Delete puts it in the Trash; the note read and off the screen")

        # 6b. The next picture given the deleted one's name: the first note's Delete, chosen again, leaves it alone.
        again = shoot()
        if again != shot:
            sys.exit(f"FAILED: the next picture wasn't given the deleted one's name ({os.path.basename(again)}, not {os.path.basename(shot)}): this check can't be made")
        # (Chosen through the centre: the helper it starts for exactly that Delete, its very receipt, after
        # this point, said how it ended, waited for: another helper ending meanwhile is no answer.)
        old = {k: a for k, a in n.get("runs", [])}["delete"]
        since = checkpoint()
        desk.invoke(n["id"], "delete")
        ended = until("the old note's Delete to have run", lambda: helped("delete", again, old[3], since), 15)
        if ended != "1" or not os.path.exists(again):
            sys.exit(f"FAILED: an old note's Delete moved the newer picture given its file's name to the Trash (it ended {ended})")
        # And asked directly with the old note's very action (its receipt the first file's, as it was saved).
        direct = subprocess.run([os.path.join(BUILT, "olo-screenshot"), *old], capture_output=True, text=True, timeout=30, env=desk.env)
        if old[:3] != ["--saved", "delete", again] or direct.returncode != 1 or "left alone" not in direct.stderr or not os.path.exists(again):
            sys.exit(f"FAILED: Screenshot asked to delete with the old file's receipt ({old}) said {direct.returncode}: {direct.stderr}")
        print("ok: the next picture given a deleted one's name is left alone by the old note's Delete (its receipt is the old file's), through the centre and asked directly")

        # 7. A note anyone sends saying it's Screenshot's: its Delete names a file Screenshot never saved, and
        # deletes nothing; another of Screenshot's modes as an action is dropped by the centre.
        precious = os.path.join(HOME, "precious.png")
        Image.new("RGB", (40, 30), (200, 30, 30)).save(precious)
        hints = "{'desktop-entry': <'olo-screenshot'>, 'x-olo-runs': <{'delete': ['--saved', 'delete', '%s', '1-2-3'], 'record': ['--toggle-record']}>}" % precious
        spoof = gdbus_notify(bus, "Screenshot", "Nothing to see", "", "['delete', 'Delete', 'record', 'Record']", hints, 0)
        # (Once it's no longer open at its sender, gdbus gone: what's chosen then is what its hint says. The
        # centre keeps none of it: a Screenshot action names the note's own file and its receipt, and this
        # note came with no file; and Record is another of Screenshot's modes.)
        sn = until("the spoofed note no longer open at its sender", lambda: (lambda n: n and not n["live"] and n)(desk.note_by_id(spoof)), 10)
        if sn.get("runs"):
            sys.exit(f"FAILED: the centre kept an action for a file the note didn't come with, or another of Screenshot's modes: {sn.get('runs')}")
        desk.cli("--dismiss", str(spoof))
        # One that names the file as its own, its receipt the file's very identity (anyone may stat it): the
        # centre keeps its Delete, and Screenshot, asked, leaves the file alone (it never saved it): its helper
        # waited for until it says so.
        fid = file_id(precious)
        hints = "{'desktop-entry': <'olo-screenshot'>, 'x-olo-file': <'%s'>, 'x-olo-file-id': <'%s'>, 'x-olo-runs': <{'delete': ['--saved', 'delete', '%s', '%s']}>}" % (precious, fid, precious, fid)
        named = gdbus_notify(bus, "Screenshot", "Nothing to see", "", "['delete', 'Delete']", hints, 0)
        nn = until("the note naming the file no longer open at its sender", lambda: (lambda n: n and not n["live"] and n)(desk.note_by_id(named)), 10)
        if [k for k, _ in nn.get("runs", [])] != ["delete"]:
            sys.exit(f"FAILED: the centre dropped a Delete naming the note's own file and its receipt ({fid}): this check can't be made: {nn.get('runs')}")
        since = checkpoint()
        desk.invoke(named, "delete")
        ended = until("its Delete to have run", lambda: helped("delete", precious, fid, since), 15)
        if ended != "1" or not os.path.exists(precious):
            sys.exit("FAILED: a note saying it was Screenshot's had Screenshot delete a file it never saved")
        direct = subprocess.run([os.path.join(BUILT, "olo-screenshot"), "--saved", "delete", precious, fid], capture_output=True, text=True, timeout=30, env=desk.env)
        if direct.returncode != 1 or "left alone" not in direct.stderr or not os.path.exists(precious):
            sys.exit(f"FAILED: Screenshot asked directly to delete a file it never saved said {direct.returncode}: {direct.stderr}")
        desk.cli("--dismiss", str(named))
        print("ok: a note saying it's Screenshot's deletes nothing Screenshot never saved, and can't start another of its modes")

        # 8. A recording made as a GIF: told of with its picture and its length, the GIF the file; put away
        # (its recorder long gone), no longer shown.
        gif = os.path.join(HOME, "demo.gif")
        status = os.path.join(RUNTIME, "olo-state", f"recording-{os.path.basename(display)}.json")
        run("olo-screenshot", "--toggle-record", "--as-gif", "--to", gif, "--countdown", "0")
        def recording():
            try:
                return json.load(open(status)).get("recording")
            except (OSError, ValueError):
                return False
        until("the recording to be going", recording, 20)
        time.sleep(1.0)
        for i in range(10):
            ts("move", NAME, str(400 + 20 * i), "300")
            time.sleep(0.12)
        ts("run", NAME, *ENV, "olo-screenshot", "--stop", check=True)
        until("the recorder to end", lambda: not mine("--toggle-record"), 60)
        n = until("the recording's notification", lambda: desk.note_of(gif), 10)
        # (On the screen, the recording over: Screenshot's are quiet while one goes.)
        if not n["shown"]:
            sys.exit(f"FAILED: the recording's notification went to the list alone, no banner: {json.dumps(n)[:400]}")
        poster = n["look"].get("image") or ""
        if not (os.path.isfile(poster) and poster != gif and n["look"].get("file_id") and n["look"].get("length") is not None):
            sys.exit(f"FAILED: the recording's notification has no picture of its own, no file or no length: {json.dumps(n['look'])}")
        until("the recorder gone, its note no longer open at it", lambda: not (desk.note_of(gif) or {}).get("live", True), 10)
        desk.put_away("olo-screenshot")
        until("the recording's note no longer shown once put away", lambda: (lambda n: n and not n["shown"])(desk.note_of(gif)), 5)
        print(f"ok: a recording made as a GIF is told of, its picture {os.path.basename(poster)} and its length, the GIF its file; put away, no longer shown")

        # 9. The History window in Cards: a card's picture dragged onto Tracker is the file there.
        conf = os.path.join("/var/tmp/olo-dev", NAME, "config", "olo", "notifications.json")
        settings = json.load(open(conf)) if os.path.exists(conf) else {}
        settings["view"] = "cards"
        os.makedirs(os.path.dirname(conf), exist_ok=True)
        json.dump(settings, open(conf, "w"))
        desk.cli("--history")
        latest = shots()[-1]
        card = until("a card's picture in the History window", lambda: desk.window("Notifications", f"Picture: {os.path.basename(latest)} (drag it out"), 15)
        gone = os.path.join(drop, os.path.basename(latest))
        if os.path.exists(gone):
            os.remove(gone)
        # (Onto Tracker where the History window doesn't cover it: where that window is once it has
        # settled there, the same twice running.)
        def history_at():
            return next((w["content"] for w in ipc({"type": "list_windows"}).get("windows", []) if w.get("pid") == desk.pid and w.get("title") == "Notifications"), None)
        def settled():
            a = history_at()
            time.sleep(0.3)
            return a if a and a.get("width", 0) > 0 and a == history_at() else None
        hist = until("the History window where it stays", settled, 10)
        covered = lambda x, y: hist["x"] <= x <= hist["x"] + hist["width"] and hist["y"] <= y <= hist["y"] + hist["height"]
        spots = [(int(tw["x"] + tw["width"] * fx), int(tw["y"] + tw["height"] * fy)) for fx in (0.15, 0.3, 0.5, 0.7, 0.85) for fy in (0.6, 0.8, 0.4)]
        onto = next((s for s in spots if not covered(*s)), None)
        if onto is None:
            sys.exit(f"FAILED: the History window covers Tracker's (History {hist}, Tracker {tw}): nowhere to drop")
        drag(middle(card), onto)
        ts("shot", NAME, os.path.join(OUT, "history-dragging.png"), "--pointer")
        ts("up", NAME, check=True)
        until(f"the card's file in the folder it was dropped on (from {middle(card)} to {onto})", lambda: os.path.exists(gone) and os.path.getsize(gone) == os.path.getsize(latest), 10)
        print(f"ok: a History card's picture dragged onto Tracker is the file there ({os.path.basename(latest)})")

        # 10. On an Agent Screen: the picture, and nothing told.
        before = {n["id"] for n in desk.notes()}
        shoot("OLO_SCREEN=check")
        time.sleep(1.5)
        if told := desk.told_since(before):
            sys.exit(f"FAILED: a shot on an Agent Screen was told of: {told}")
        print("ok: on an Agent Screen a shot tells nothing")
        passed = True
    finally:
        ts("stop", NAME)
        # (Its desktop's folder, logs and all, is this run's own, named for it: gone with the rest when
        # every check passed, kept beside what it saw when one didn't.)
        desk_dir = os.path.join("/var/tmp/olo-dev", NAME)
        if passed:
            shutil.rmtree(SCRATCH, ignore_errors=True)
            shutil.rmtree(desk_dir, ignore_errors=True)
        else:
            print(f"(what it saw is kept in {OUT}; its desktop's logs in {desk_dir})")


main()
