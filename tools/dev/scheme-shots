#!/usr/bin/python3
"""Every theme at a look: one headless session, a few apps in it
(Tracker on a sample home, Terminal showing its sixteen colours and some
text, Preferences ▸ Themes), and a picture of the screen in each theme
(`olo_theme::looks::THEMES`), light and dark. The pictures go in OUT
(THEME-MODE.png), with sheets of them at half size, three themes a
sheet (sheet-N.png).

  tools/dev/scheme-shots OUT [--scale N] [--only ID[,ID…]]

Needs a release build. Its session is its own (`tsession`), ended after.
"""
import json, os, subprocess, sys, time
from PIL import Image, ImageDraw

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
T = ["/usr/bin/python3", os.path.join(ROOT, "tools/dev/tsession")]
NAME = f"schemes-{os.getpid()}"
ENV = dict(os.environ, TSESSION_PROFILE="release")

# What Terminal shows: the sixteen as text and as grounds, a prompt, a
# listing, a diff: what colours are for in one.
SHOW = r'''
printf '\033[1m~/src/olo\033[0m \033[32mmain\033[0m \033[33m✗\033[0m ls -l\n'
printf '\033[34mdocs\033[0m  \033[34msrc\033[0m  \033[1;32mbuild.sh\033[0m  \033[36mlink\033[0m -> src  \033[35mphoto.png\033[0m  \033[31marchive.zip\033[0m  notes.txt\n'
printf '\033[32m+ added a line\033[0m\n\033[31m- removed a line\033[0m\n\033[36m@@ -1,4 +1,4 @@\033[0m\n'
printf '\033[33mwarning\033[0m: unused variable  \033[1;31merror\033[0m: mismatched types  \033[90m# a comment\033[0m\n'
for i in 0 1 2 3 4 5 6 7; do printf '\033[3%sm colour%s \033[0m' $i $i; done; printf '\n'
for i in 0 1 2 3 4 5 6 7; do printf '\033[9%sm bright%s \033[0m' $i $i; done; printf '\n'
for i in 0 1 2 3 4 5 6 7; do printf '\033[4%sm        \033[0m' $i; done; printf '\n'
for i in 0 1 2 3 4 5 6 7; do printf '\033[10%sm        \033[0m' $i; done; printf '\n'
printf '\033[7m selected text \033[0m  \033[4munderlined\033[0m  \033[1mbold\033[0m  \033[3mitalic\033[0m\n$ '
sleep 100000
'''


def t(*args, check=False):
    return subprocess.run(T + list(args), capture_output=True, text=True, env=ENV, cwd=ROOT, check=check).stdout


def ipc(msg):
    reply = json.loads(t("ipc", NAME, json.dumps(msg), check=True))
    if reply.get("type") == "error":
        raise RuntimeError(reply["message"])
    return reply


def main():
    a = sys.argv[1:]
    if not a or a[0].startswith("-"):
        sys.exit(__doc__)
    out = os.path.abspath(a.pop(0))
    opt = lambda k, d=None: a[a.index(k) + 1] if k in a else d
    scale, only = opt("--scale", "1"), opt("--only")
    os.makedirs(out, exist_ok=True)
    home = os.path.join(out, "home")
    subprocess.run([os.path.join(ROOT, "tools/dev/fixture-home"), home], check=True, capture_output=True)
    show = os.path.join(out, "show.sh")
    open(show, "w").write(SHOW)
    s = float(scale)
    t("start", NAME, f"{round(1600*s)}x{round(900*s)}", "--scale", scale, "--home", home, check=True)
    time.sleep(2)
    try:
        t("run", NAME, "target/release/olo-tracker", home)
        time.sleep(2.5)
        t("run", NAME, "target/release/olo-terminal", "-e", "/bin/sh", show)
        time.sleep(3)
        t("run", NAME, "target/release/olo-preferences", "themes")
        time.sleep(3.5)
        place = {"olo.tracker": (20, 30, 420, 300), "olo.terminal": (20, 380, 660, 400), "olo.preferences": (700, 30, 0, 0)}
        windows = ipc({"type": "list_windows"})["windows"]
        missing = place.keys() - {w.get("app_id") for w in windows}
        if missing:
            raise RuntimeError(f"Missing sample windows: {sorted(missing)}")
        for w in windows:
            if w.get("app_id") not in place:
                continue
            x, y, ww, hh = place[w["app_id"]]
            f = w["frame"]
            ipc({"type": "place", "id": w["id"], "frame": {"x": x, "y": y, "width": ww or f["width"], "height": hh or f["height"]}})
        time.sleep(1.5)
        looks = ipc({"type": "looks"})["themes"]
        settings = ipc({"type": "get_settings"})["settings"]
        themes = list(dict.fromkeys(["classic", "beos", "platinum"] + [t["id"] for t in looks]))
        if only:
            themes = [t for t in themes if t in only.split(",")]
        rows = []
        for theme in themes:
            row = []
            for mode in ("light", "dark", "night"):
                settings["appearance"].update({"look": theme, "theme": "dark" if mode == "night" else mode})
                settings["appearance"]["night_light"]["mode"] = "on" if mode == "night" else "off"
                settings["wallpaper"] = next((t["wallpaper"] for t in looks if t["id"] == theme), settings.get("wallpaper"))
                ipc({"type": "set_settings", "settings": settings})
                time.sleep(2.2)
                shot = os.path.join(out, f"{theme}-{mode}.png")
                ipc({"type": "screenshot", "path": shot, "as_shown": True})
                with Image.open(shot) as im:
                    row.append(im.convert("RGB").resize((800, 450), Image.Resampling.LANCZOS))
            rows.append((theme, row))
            print(theme, flush=True)
        # Sheets: a theme a row, light and dark side by side, halved;
        # three themes a sheet.
        for page in range(0, len(rows), 3):
            some = rows[page:page + 3]
            tw, th = some[0][1][0].size
            sheet = Image.new("RGB", (3 * (tw + 4) + 4, len(some) * (th + 26) + 4), "white")
            d = ImageDraw.Draw(sheet)
            for i, (theme, row) in enumerate(some):
                y = i * (th + 26) + 4
                d.text((6, y), theme, fill="black")
                for j, im in enumerate(row):
                    sheet.paste(im, (4 + j * (tw + 4), y + 16))
            sheet.save(os.path.join(out, f"sheet-{page // 3 + 1}.png"))
    finally:
        t("stop", NAME)


main()
