#!/usr/bin/python3
"""How far behind the microphone Olo Voice's source is, measured: a
private PipeWire graph of its own (no hardware: a timer driver, a test
microphone and speakers; its own WirePlumber with every monitor off, its
own runtime, config and state folders, no D-Bus), olo-voice --service in
it, speech played into the test microphone, and the microphone (left)
and Olo Voice's source (right) recorded side by side: the lag between the
two (cross-correlated) is what Olo Voice adds, nothing else's buffering
in it.

  tools/dev/voice-latency [--settings noise=off,…] [--seconds N] [--quantum N]
                          [--probe sync|async] [--signal speech|clicks] [--keep]

--settings: olo-voice --set pairs (default noise=off,echo=off,normalize=off:
only the buffering). --quantum: the graph's quantum another client asks for
(as a call app might), else what Olo Voice asks. --probe: what records
(sync, the default: a realtime filter, scheduled in the cycle as the apps
that record through Pulse are, Chrome's and every call app's; async:
pw-record, which PipeWire schedules asynchronously, so it reads any
source that isn't a device a cycle late, 10 ms at a call's quantum: not
Olo's). --signal: speech (the default; clicks in silence are what the
level stage boosts and limits, and a speech model takes for noise).
Release builds (cargo build --release -p olo-voice-service). Nothing of
the person's session is touched: every program runs with the private
folders, and they're removed after (--keep keeps them, in
/var/tmp/olo-pw)."""

import json, math, os, shutil, signal, struct, subprocess, sys, time, wave

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
BASE = "/var/tmp/olo-pw"
RATE = 48000

