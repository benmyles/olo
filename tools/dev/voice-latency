    { factory = adapter
        args = { factory.name = support.null-audio-sink node.name = test-mic node.description = "Test Microphone"
                 media.class = Audio/Source/Virtual audio.position = [ MONO ] node.driver = true priority.driver = 30000 } }
    { factory = adapter
