#!/usr/bin/python3
"""Reclaim kache's incremental compiler state ("managed graphs") that nothing
has used for a while, from one profile of a build folder, at a moment when no
Cargo command runs anywhere on the computer: what kache's own sweep does in
such a moment, for when you have one and it hasn't come round to it (it looks
hourly). 161 GB had piled up under target/debug in sixteen days
(docs/AGENT-NOTES.md, "Old builds"; kache's FORK.md).

  prune-graphs [PROFILE_DIR] [--days N]               what it would detach
  prune-graphs [PROFILE_DIR] [--days N] --really --kache-cache DIR
        PROFILE_DIR: target/debug of this repository unless given (the
        profile the graphs are in: with a split build folder, the
        intermediate one; `cargo check`'s are under target/check/debug);
        N: 3; DIR: the cache every Cargo shim and kache cleaner of this
        build folder uses (~/.cache/kache).

It takes kache's own lock for the whole computer (`target-use.lock` in the
cache, exclusively, without waiting) before it opens the build folder, so it
does nothing while any Cargo command through kache's shim runs, a `cargo
watch` among them: it is no way round that lock. An earlier form of this tool
was one, and was wrong. It went by Cargo's locks of the profile and each
unit's own, working through folder descriptors, and a review (Astra,
2026-11-21, with real Cargo) showed what that leaves open: a `cargo clean`
takes no lock, unlinks a unit's lock file and its graph, and if it stops
before removing the unit's folder a new build makes a new lock and graph in
the same folder: the sweep, still holding the old lock, then renamed away the
new graph under the new compiler's own lock (rustc: `ENOENT`, exit 101). It
ran once that way on this repository with nothing cleaning beside it (1,230
graphs, 131 GB); never again.

Under the lock: Cargo's three locks of the profile; each unit opened through
its parents' descriptors, its own lock taken, its state read as kache reads
it (a state that isn't whole and valid leaves the unit alone, as does one on
a filesystem that isn't known to be local); a graph unused for N days has its
donor marker removed, its `rustc` folder renamed into a folder of this tool's
own beside the units, its state removed; the unit's folder and lock stay.
What was detached is deleted after the locks are let go, through that
folder's descriptor, and a pass that was stopped before deleting is finished
by the next.

Nothing that removes or restores the build folder without kache's shim (a
bare `rm -rf`, a restore) may run during a pass: nothing keeps those out.
"""
import argparse
from contextlib import ExitStack
import fcntl
import json
import math
import os
from pathlib import Path
import re
import secrets
import shutil
import stat
import time

ROOT = Path(__file__).absolute().parents[2]
CARGO_LOCKS = (".cargo-lock", ".cargo-build-lock", ".cargo-artifact-lock")
HEX = re.compile("[0-9a-f]{64}")
DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE = os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
TRASH = ".olo-prune-graphs-v1"
TICKET = re.compile("[0-9a-f]{64}-[0-9a-f]{32}")
LOCAL = {"ext2", "ext3", "ext4", "btrfs", "xfs", "f2fs", "zfs", "tmpfs", "overlay"}


def opened(stack, name, flags, parent=None, mode=0o666):
    fd = os.open(name, flags, mode, dir_fd=parent)
    stack.callback(os.close, fd)
    return fd


def directory(stack, path):
    path = Path(path).absolute()
    fd = opened(stack, "/", DIR)
    for name in path.parts[1:]:
        if name == "..":
            raise ValueError("use a profile or cache path without '..'")
        fd = opened(stack, name, DIR, fd)
    return fd


def local(fd):
    with open(f"/proc/self/fdinfo/{fd}") as info:
        mount_id = next((s.split()[1] for s in info if s.startswith("mnt_id:")), None)
    with open("/proc/self/mountinfo") as mounts:
        return any(s.split(" ", 1)[0] == mount_id and s.split(" - ", 1)[1].split()[0] in LOCAL
                   for s in mounts)


def lock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def file_lock(stack, parent, name, *, create=False):
    flags = FILE | os.O_RDWR | (os.O_CREAT if create else 0)
    fd = opened(stack, name, flags, parent)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        raise ValueError(f"unexpected lock type for {name}")
    return lock(fd)


def uint(value, bits):
    return type(value) is int and 0 <= value < 1 << bits


def digest(value):
    return isinstance(value, str) and HEX.fullmatch(value) is not None


def unique_object(pairs):
    obj = dict(pairs)
    if len(obj) != len(pairs):
        raise ValueError("duplicate state field")
    return obj


def valid_state(s, key):
    if not isinstance(s, dict) or s.keys() - {
        "schema", "unit_key", "phase", "observation", "active_leases", "last_used_secs", "in_flight"
    }:
        return False
    if (not uint(s.get("schema"), 32) or s["schema"] != 1 or s.get("unit_key") != key
            or not uint(s.get("active_leases"), 8) or not uint(s.get("last_used_secs"), 64)
            or type(s.get("in_flight")) is not bool):
        return False
    obs = s.get("observation")
    if obs is not None:
        if not isinstance(obs, dict) or obs.keys() - {
            "cache_key", "stable", "sources_externs", "at_secs", "primary_source"
        }:
            return False
        if (not all(digest(obs.get(field)) for field in ("cache_key", "stable", "sources_externs"))
                or not uint(obs.get("at_secs"), 64)
                or (obs.get("primary_source") is not None and not digest(obs["primary_source"]))):
            return False
    phase = s.get("phase")
    if phase == "learning":
        return obs is not None or s["in_flight"]
    if phase == "seed":
        return obs is not None and s["in_flight"]
    return phase == "active" and obs is not None and s["active_leases"] <= 8


def last_used(unit, key):
    modified = os.fstat(unit).st_mtime
    try:
        fd = os.open("state.json", FILE | os.O_RDONLY, dir_fd=unit)
    except FileNotFoundError:
        return modified
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        return None
    with os.fdopen(fd, "rb") as state:
        data = state.read(65537)
    if len(data) > 65536:
        return None
    try:
        s = json.loads(data.decode("utf-8"), object_pairs_hook=unique_object)
    except (ValueError, RecursionError):
        return None
    return max(s["last_used_secs"], modified) if valid_state(s, key) else None


def detach(units, name, now, age, trash):
    if not HEX.fullmatch(name):
        return "not a unit"
    try:
        with ExitStack() as stack:
            unit = opened(stack, name, DIR, units)
            if not file_lock(stack, unit, "unit.lock"):
                return "busy"
            try:
                graph = os.stat("rustc", dir_fd=unit, follow_symlinks=False)
            except FileNotFoundError:
                return "no graph"
            if not stat.S_ISDIR(graph.st_mode):
                return "no graph"
            try:
                used = last_used(unit, name)
            except OSError:
                return "state unreadable"
            if used is None:
                return "state unreadable"
            if now - used < age:
                return "recent"
            if trash is not None:
                try:
                    os.unlink("worktree-seed-v1", dir_fd=unit)
                except FileNotFoundError:
                    pass
                os.rename("rustc", name + "-" + secrets.token_hex(16),
                          src_dir_fd=unit, dst_dir_fd=trash)
                try:
                    os.unlink("state.json", dir_fd=unit)
                except FileNotFoundError:
                    pass
                os.fsync(unit)
            return "detached"
    except FileNotFoundError:
        return "absent"
    except NotADirectoryError:
        return "not a unit"


def sweep(profile, days, really, now=None, out=print, *, cache=None):
    counts = {"detached": 0, "recent": 0, "no graph": 0, "busy": 0, "state unreadable": 0,
              "not a unit": 0, "absent": 0}
    if not math.isfinite(days) or days < 0:
        raise ValueError("days must be finite and nonnegative")
    if really and cache is None:
        raise ValueError("--really requires the effective --kache-cache directory")
    now = time.time() if now is None else now
    with ExitStack() as deletion:
        trash = None
        with ExitStack() as mutation:
            if really:
                cache_fd = directory(mutation, cache)
                if not local(cache_fd):
                    raise ValueError("cache must be on a known local filesystem")
                # Never manufacture a reservation in a guessed or unused cache.
                if not file_lock(mutation, cache_fd, "target-use.lock"):
                    out("kache target reservation busy; skipped")
                    return counts
            try:
                profile_fd = directory(mutation, profile)
                auto = opened(mutation, "incremental.kache-auto", DIR, profile_fd)
            except FileNotFoundError:
                out(f"no managed graphs under {profile}")
                return counts
            if really:
                if not local(profile_fd) or not local(auto):
                    raise ValueError("profile and managed graphs must be on a known local filesystem")
                for name in CARGO_LOCKS:
                    if not file_lock(mutation, profile_fd, name, create=True):
                        out(f"profile lock {name} busy; skipped")
                        return counts
                try:
                    os.mkdir(TRASH, mode=0o700, dir_fd=auto)
                except FileExistsError:
                    pass
                trash = opened(deletion, TRASH, DIR, auto)
                meta = os.fstat(trash)
                if meta.st_uid != os.geteuid() or stat.S_IMODE(meta.st_mode) != 0o700:
                    raise ValueError("unexpected owner or mode of private pruning directory")
                if not lock(trash):
                    out("previous pass is deleting its graphs; skipped")
                    return counts
                os.fsync(auto)
            try:
                units = opened(mutation, "v2", DIR, auto)
            except FileNotFoundError:
                units = None
            if units is not None:
                if really and not local(units):
                    raise ValueError("v2 must be on a known local filesystem")
                for name in os.listdir(units):
                    result = detach(units, name, now, days * 86400, trash)
                    counts[result] += 1
            if trash is not None:
                os.fsync(trash)
        if trash is not None:
            # Hold only this private directory's flock. A crash leaves whole
            # graphs in this namespace for the next pass. Keep the directory
            # itself: its public name may already designate another generation.
            # Open a fresh directory stream after the last rename. On Btrfs a
            # stream opened earlier can miss entries added since it opened.
            listing = opened(deletion, ".", DIR, trash)
            for name in os.listdir(listing):
                if TICKET.fullmatch(name):
                    try:
                        shutil.rmtree(name, dir_fd=trash)
                    except FileNotFoundError:
                        pass
            os.fsync(trash)
    out(f"{'detached' if really else 'would detach'} {counts}")
    return counts


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("profile", nargs="?", default=ROOT / "target" / "debug")
    parser.add_argument("--days", type=float, default=3)
    parser.add_argument("--really", action="store_true")
    parser.add_argument("--kache-cache", type=Path)
    args = parser.parse_args()
    try:
        sweep(args.profile, args.days, args.really, cache=args.kache_cache)
    except (OSError, ValueError) as e:
        parser.exit(1, f"prune-graphs: {e}\n")


if __name__ == "__main__":
    main()
