def session_groups():
    """What Olo's login does with a login session's scope, in a guest, as
    root, at each step the kernel's own answer."""
    rows = guest(SESSION_GROUPS, bins=("rmdir", "stat"), mem=1024, timeout=120)
    want = {
        ("not delegated", "prepare"): "refused: the session's scope isn't delegated",
        ("not delegated", "left in it"): "0 groups",
        ("not alone", "prepare"): "refused: the scope holds more than the login's worker",
        ("not alone", "left in it"): "0 groups",
        ("not placed", "prepare"): "made; the worker is in /user.slice/user-1000.slice/session-9.scope/leader",
        ("not placed", "the division abandoned"): "as asked: undone",
        ("not placed", "root taken back"): "no",
        ("not placed", "who"): "uid 1000 in /user.slice/user-1000.slice/session-9.scope",
        ("not placed", "found from desk"): "nothing",
        ("not placed", "left in it"): "0 groups, handing down []",
        ("a login's scope", "prepare"): "made; the worker is in /user.slice/user-1000.slice/session-7.scope/leader",
        ("a login's scope", "the session's first process placed"): "done",
        ("a login's scope", "root taken back"): "no",
        ("a login's scope", "who"): "uid 1000 in /user.slice/user-1000.slice/session-7.scope/olo/desk",
        ("a login without the choice", "prepare"): "made; the worker is in /user.slice/user-1000.slice/session-5.scope/leader",
        ("a login without the choice", "nothing handed on"): "all dropped, read back",
        ("a login without the choice", "root taken back"): "no",
        ("a login without the choice", "the session's first process"): "has none",
        ("a login without the choice", "its four sets as it starts"): "///",
        ("a login without the choice", "kept at rest"): "read back ///",
        ("a login without the choice", "a program it starts"): "has none",
        ("a login without the choice", "one started after"): "has none",
        ("a login's scope", "the session's first process"): "has the capability",
        ("a login's scope", "its four sets as it starts"): "800000/800000/800000/800000",
        ("a login's scope", "kept at rest"): "read back /800000/800000/",
        ("a login's scope", "found from desk"): "/cg/user.slice/user-1000.slice/session-7.scope/olo/desk and /cg/user.slice/user-1000.slice/session-7.scope/olo/bg",
        ("a login's scope", "itself to bg"): "done",
        ("a login's scope", "then in"): "/user.slice/user-1000.slice/session-7.scope/olo/bg",
        ("a login's scope", "itself back to desk"): "done",
        ("a login's scope", "and in"): "/user.slice/user-1000.slice/session-7.scope/olo/desk",
        ("a login's scope", "bg's allowance set"): "done",
        ("a login's scope", "bg's allowance reads"): "1073741824",
        ("a login's scope", "bg's allowance lifted"): "done",
        ("a login's scope", "bg idle on the processors"): "1",
        ("a login's scope", "the login's worker to bg"): "refused",
        ("a login's scope", "itself to the worker's group"): "refused",
        ("a login's scope", "itself to the scope's own group"): "refused",
        ("a login's scope", "desk's own allowance set"): "refused",
        ("a login's scope", "bg taken off idle"): "refused",
        ("a login's scope", "a group made in olo"): "refused",
        ("a login's scope", "its nice raised to -5"): "done",
        ("a login's scope", "a program it starts"): "has none",
        ("a login's scope", "the one it hands it to"): "has the capability",
        ("a login's scope", "one started after"): "has none",
        ("a login's scope", "controllers handed down"): "cpu memory / cpu memory",
        ("a login's scope", "whose"): "0 0 1000 1000 1000 0 0 0",
        ("a login's scope", "removed after"): "yes",
    }
    case, got, wrong = "", {}, 0
    for row in rows:
        if row[0] == "case":
            case = row[1]
            print(f"\n{case}:")
        elif row[0] == "check":
            # (A bare number comes back from `guest` as one.)
            said = str(row[2])
            got[(case, row[1])] = said
            expected = want.get((case, row[1]))
            if expected is None and case in ("not placed", "a login without the choice"):
                continue
            ok = expected is not None and said.startswith(expected)
            wrong += 0 if ok else 1
            print(f"  {'ok ' if ok else 'NOT'}  {row[1]}: {said}" + ("" if ok else f"   (wanted: {expected})"))
    for key in want:
        if key not in got:
            wrong += 1
            print(f"  NOT   {key[0]}: {key[1]}: never said (wanted: {want[key]})")
    print(f"\n{len(want) - wrong if wrong <= len(want) else 0} of {len(want)} as they should be" if wrong else f"\nAll {len(want)} as they should be.")
    if wrong:
        sys.exit(1)


def slow_disks():
    print("A removable disk's writes: 600 MB copied to a disk that takes 10 MB a second (2 GB of memory)\n")
    for mode, what in [("none", "as the kernel comes"), ("limit", "16 MB may wait")]:
        rows = {r[0]: r[-1] for r in guest(SLOW_DISK, args=[mode], bins=["/usr/sbin/mkfs.ext4"], disks=["2G", "2G,throttling.bps-write=10485760"])}
        fill, saves = rows["fill"], rows["saves"]
        print(f"  {what:20} the copy ended after {fill['write_secs']:5.1f} s with {fill['unwritten_mb_after']:4} MB still in memory; on the disk {fill['sync_secs']:5.1f} s later ({fill['write_secs'] + fill['sync_secs']:.1f} s in all);")
        print(f"  {'':20} saves to the fast disk meanwhile: 99 in 100 within {saves['ms_p99']:.1f} ms")
    print("\n  what the limit costs the disk's own speed (1,500 MB written and made durable), by how fast the disk is,")
    print("  with this computer quiet and with every processor of it busy (kbench spin, here, beside the guest):")
    for speed, what in [("400000000", "400 MB a second"), ("1000000000", "1 GB a second"), ("", "as fast as this computer's")]:
        for busy in (False, True):
            line = f"    {what:28} {'busy ' if busy else 'quiet'}"
            for cap in ("none", "16777216", "33554432", "67108864"):
                load = subprocess.Popen([KBENCH, "spin", "--threads", str(os.cpu_count()), "--secs", "15"], stdout=subprocess.DEVNULL) if busy else None
                fill = {r[0]: r[-1] for r in guest(FAST_DISK, args=[cap], bins=["/usr/sbin/mkfs.ext4", "rm", "sync"], disks=["4G" + (",throttling.bps-write=" + speed if speed else "")])}["fill"]
                if load:
                    load.wait(timeout=60)
                line += f"   {'no limit' if cap == 'none' else str(int(cap) >> 20) + ' MB'} {fill['write_secs'] + fill['sync_secs']:5.2f} s"
            print(line)
    print()


CRYPT = r"""
DEV=$1
[ $DEV = /dev/vda ] && dd if=/dev/urandom of=/dev/vda bs=1M count=3900 oflag=direct 2>/dev/null
SECT=$(cat /sys/block/${DEV##*/}/size)
KEY=$(head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n')
for how in queued direct; do
  [ $how = direct ] && flags="2 no_read_workqueue no_write_workqueue" || flags=
  echo "0 $SECT crypt aes-xts-plain64 $KEY 0 $DEV 0 $flags" | dmsetup create c || exit 1
  for spec in "4096 1" "4096 8" "1048576 1"; do
    set -- $1 $spec
    echo "$how|read|$2|$3|$(/bin/kbench io /dev/dm-0 --secs 3 --bs $2 --threads $3)"
    echo "$how|write|$2|$3|$(/bin/kbench io /dev/dm-0 --secs 3 --bs $2 --threads $3 --write)"
  done
  dmsetup remove c
done
"""

