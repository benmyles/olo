def left_alone():
    print("Measured and left as the kernel comes\n")
    print("  dm-crypt (an encrypted disk) with its work queues, and without (no_read_workqueue, no_write_workqueue):")
    for dev, what, opts in [("/dev/ram0", "a ramdisk", dict(modules=["brd rd_nr=1 rd_size=1048576", "dm_crypt"], mem=3072)), ("/dev/vda", "a disk (this computer's, through the guest)", dict(modules=["dm_crypt"], disks=["4G"], mem=3072))]:
        rows = guest(CRYPT, args=[dev], bins=["dmsetup", "od", "tr", "head", "dd"], **opts)
        print(f"    {what}:")
        by = {(r[0], r[1], r[2], r[3]): r[-1] for r in rows}
        for op in ("read", "write"):
            for bs, threads in (("4096", "1"), ("4096", "8"), ("1048576", "1")):
                q, d = by[("queued", op, bs, threads)], by[("direct", op, bs, threads)]
                size = "4 KB" if bs == "4096" else "1 MB"
                print(f"      {op + 's of ' + size + ', ' + threads + (' thread' if threads == '1' else ' threads'):28} queued {q['mb_per_sec']:8.1f} MB/s, one in {q['us_p50']:7.1f} us   without {d['mb_per_sec']:8.1f} MB/s, one in {d['us_p50']:7.1f} us   {d['mb_per_sec'] / q['mb_per_sec']:.2f}×")
    print("\n  memory asked for while it's full of files' cache (500 MB taken, three times), by vm.watermark_scale_factor:")
    for factor in ("10", "100"):
        rows = [r[-1] for r in guest(WATERMARK, args=[factor], bins=["/usr/sbin/mkfs.ext4", "dd"], disks=["2G"])]
        print(f"    {factor:>3}: a megabyte in {statistics.median(x['ms_p50'] for x in rows):.2f} ms; 99 in 100 within {statistics.median(x['ms_p99'] for x in rows):.2f}, worst {max(x['ms_max'] for x in rows):.1f}")
    print()


def main():
    # (Said as it goes, into a file or a pipe too: it runs for minutes.)
    sys.stdout.reconfigure(line_buffering=True)
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(__doc__)
        return
    if not os.path.exists(KBENCH):
        sys.exit("kernel-check: no kbench: cargo build --release -p olo-system --example kbench")
    ttl = int(args[args.index("--ttl") + 1]) if "--ttl" in args else None
    reps = int(args[args.index("--reps") + 1]) if "--reps" in args else (3 if ttl is None else 20)
    which = [a for a in args if not a.startswith("--") and not a.isdigit()] or ["preemption", "turns", "slow-disks", "swap", "thrashing", "left-alone"]
    for name in which:
        run = {"preemption": lambda: preemption(reps), "thrashing": lambda: thrashing(reps, ttl), "turns": lambda: turns(reps), "session-groups": session_groups, "groups": lambda: groups(reps), "groups-cold": lambda: groups_cold(reps), "slow-disks": slow_disks, "swap": lambda: swap(2 if "--reps" not in args else reps), "left-alone": left_alone}.get(name)
        if run is None:
            sys.exit(f"kernel-check: {name}? preemption, turns, thrashing, slow-disks, swap, groups or left-alone")
        run()


if __name__ == "__main__":
    main()
