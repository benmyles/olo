echo "+memory +cpu +pids" > /cg/cgroup.subtree_control
mkdir -p /cg$U; echo "+memory +cpu +pids" > /cg/user.slice/cgroup.subtree_control; echo "+memory +cpu +pids" > /cg$U/cgroup.subtree_control
