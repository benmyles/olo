#!/usr/bin/python3
"""Unit tests for `tools/dev/agents` and `tools/dev/agent-board`.

Covers the field reader, model/effort policy, minder/reviewer permissions and
Default-mode settings, clean PATH (including symlinked bridge dirs), multi-lead
isolation, parent-owned trusted metadata, trimmed ended-record sweeping,
collisions, scope overlap, collect_one hardening, git_bounded timeouts/stderr,
and `agent-board` rendering/updates/path safety. Nothing is started and nothing
is asked of any real agent.

  agents-check
"""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))

def load_script(name, mod_name):
    loader = importlib.machinery.SourceFileLoader(mod_name, os.path.join(HERE, name))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(mod_name, loader))
    loader.exec_module(mod)
    return mod

agents = load_script("agents", "agents_tool")
board = load_script("agent-board", "agent_board_tool")

R = "─" * 60
TRAY = f"● Read(x)\n{R}\n>\n{R}\n  ● [18:29:34] ls -la /var/tmp/x && ... running\n{R}\nesc to cancel            accept-edits · Gemini 4 Neon · xhigh · 1 task(s) · /tasks\n"
CASES = [
    ("agy at work, its tasks under an empty field", TRAY, ""),
    ("the same with words in its field", TRAY.replace(">\n", "> Read the brief and go on\n", 1), "Read the brief and go on"),
    ("agy at rest, its mode's hint in its field", f"{R}\n> Accept-edits mode: file edits auto-approved (shift+tab to cycle)\n{R}\n? for shortcuts\n", ""),
    ("agy, a draft of two lines", f"{R}\n> first line\n  second line\n{R}\n? for shortcuts\n", "first line second line"),
    ("Claude Code", f"● Done\n{R}\n❯ hello there\n{R}\n  ? for shortcuts\n", "hello there"),
    ("Claude Code, empty", f"● Done\n{R}\n❯ \n{R}\n  ? for shortcuts\n", ""),
    ("a rule in what it wrote, over its field", f"● A table:\n{R}\n  a | b\n{R}\n>\n{R}\n? for shortcuts\n", ""),
    ("no field at all", "just\ntext\n", ""),
]
wrong = [(what, agents.field_of(screen), want) for what, screen, want in CASES if agents.field_of(screen) != want]
for what, got, want in wrong:
    print(f"FAILED: {what}: its field read as {got!r}, not {want!r}")
if wrong:
    sys.exit(1)

# 1. Exact model / effort policy (Ben, 2026-11-27):
assert agents.MOST == 4, agents.MOST
assert agents.MINDER_MODEL == "gemini-4-neon-high", agents.MINDER_MODEL
assert agents.MINDER_EFFORT == "high", agents.MINDER_EFFORT
assert agents.BUILDER_MODEL == "gemini-4-neon-high", agents.BUILDER_MODEL
assert agents.BUILDER_EFFORT == "high", agents.BUILDER_EFFORT
assert agents.MODEL == "gemini-4-neon-xhigh", agents.MODEL
assert agents.ASTRA == "gpt-6.2-astra", agents.ASTRA
assert agents.ASTRA_EFFORT == "xhigh", agents.ASTRA_EFFORT
assert agents.OPUS == "claude-opus-5-5", agents.OPUS
assert agents.OPUS_EFFORT == "xhigh", agents.OPUS_EFFORT

# 2. Minder vs reviewer permissions, ancestor own-dir handling, Default mode, and agent-board allow:
with tempfile.TemporaryDirectory(dir="/var/tmp", prefix="olo-agents-settings-") as td:
    home_dir = os.path.join(td, "agents")
    minder_dir = os.path.join(home_dir, "minder")
    os.makedirs(minder_dir)
    ms = agents.settings(["/repo", home_dir, "/var/tmp/olo-reviews"], commands="minder", own=[minder_dir])
    assert ms["agentMode"] == "", f"minder must force Default mode: {ms.get('agentMode')!r}"
    assert "command(olo agent watch)" in ms["permissions"]["allow"]
    assert "command(olo agent start)" not in ms["permissions"]["allow"], "raw olo agent start must require approval"
    assert "command(tools/dev/astra-review)" in ms["permissions"]["allow"]
    assert "command(tools/dev/agy-review)" in ms["permissions"]["allow"]
    assert "command(tools/dev/agent-board)" in ms["permissions"]["allow"]
    assert "command(olo agent prune)" in ms["permissions"]["deny"]
    assert "command(git push)" in ms["permissions"]["deny"]
    assert "write_file(/repo)" in ms["permissions"]["deny"]
    assert "write_file(/var/tmp/olo-reviews)" in ms["permissions"]["deny"]
    assert f"write_file({home_dir})" not in ms["permissions"]["deny"], "ancestor of own dir must not be in deny"
    assert f"write_file({minder_dir})" in ms["permissions"]["allow"]
    assert f"write_file({minder_dir})" not in ms["permissions"]["deny"]
    for variant in (
        "tools/dev/agents minder",
        "./tools/dev/agents minder",
        f"{agents.ROOT}/tools/dev/agents minder",
        "/usr/bin/python3 tools/dev/agents minder",
        "/usr/bin/python3 ./tools/dev/agents minder",
        f"/usr/bin/python3 {agents.ROOT}/tools/dev/agents minder",
    ):
        assert f"command({variant})" in ms["permissions"]["deny"], f"missing deny for {variant}"

    bs = agents.settings(["/repo", minder_dir], commands=True, own=[minder_dir])
    assert "command(tools/dev/agent-board)" in bs["permissions"]["allow"]
    assert "agentMode" not in bs

rs = agents.settings(["/d", "/repo"], commands="review", own=["/d"])
assert rs["agentMode"] == "", "agy-review must force Default mode"
assert "command(git show)" in rs["permissions"]["allow"]
assert "command(mkdir)" not in rs["permissions"]["allow"], "review must not allow mkdir"
assert "command(touch)" not in rs["permissions"]["allow"], "review must not allow touch"
assert "write_file(/d)" in rs["permissions"]["allow"]
assert "write_file(/repo)" in rs["permissions"]["deny"]
assert not any("cargo" in x or "jato" in x for x in rs["permissions"]["allow"])

# 3. clean_path strips bridge dirs (trailing slash & symlinks) and relative entries while retaining real dirs:
with tempfile.TemporaryDirectory(dir="/var/tmp", prefix="olo-agents-path-") as td:
    real_bin = os.path.join(td, "bin")
    bridge_real = os.path.join(td, "olo", "rex", "bin")
    bridge_link = os.path.join(td, "link-to-bridge")
    os.makedirs(real_bin)
    os.makedirs(bridge_real)
    os.symlink(bridge_real, bridge_link)
    raw = f"/x/rex-commands:/x/rex-commands/:/x/olo/rex/bin:/x/olo/rex/bin/:{bridge_link}:relative/bin:{real_bin}:/usr/bin"
    cp = agents.clean_path(raw)
    parts = cp.split(":")
    assert "/x/rex-commands" not in parts, parts
    assert "/x/olo/rex/bin" not in parts, parts
    assert bridge_link not in parts, f"symlinked bridge dir must be stripped: {parts}"
    assert "relative/bin" not in parts, parts
    assert real_bin in parts, parts
    assert "/usr/bin" in parts, parts
    local_bin = os.path.normpath(os.path.expanduser("~/.local/bin"))
    if os.path.isdir(local_bin):
        assert local_bin in parts, f"expected {local_bin} in {parts}"

# 4. Multi-lead isolation, parent-owned trusted_meta, fail-closed ownership, collisions, overlap, state, collect_one:
orig_home = agents.HOME
orig_reviews = agents.REVIEWS
orig_olo = agents.olo
orig_rex = list(agents._REX)
orig_sub = agents._SUBTREE_IDS[0]
orig_live = agents.live
orig_state = agents.state
orig_at_rest = agents.at_rest
orig_env_sub = os.environ.get("OLO_SUBAGENT")
orig_env_minder = os.environ.get("OLO_MINDER")

def expect_exit(fn, substr):
    try:
        fn()
    except SystemExit as e:
        assert substr in str(e), f"expected {substr!r} in {str(e)!r}"
        return
    raise AssertionError(f"expected SystemExit containing {substr!r}")

try:
    os.environ.pop("OLO_SUBAGENT", None)
    os.environ.pop("OLO_MINDER", None)
    with tempfile.TemporaryDirectory(dir="/var/tmp", prefix="olo-agents-check-") as td:
        home = os.path.join(td, "agents")
        reviews = os.path.join(td, "reviews")
        os.makedirs(home)
        os.makedirs(reviews)
        open(os.path.join(home, "tmux.conf"), "w").write("set -g remain-on-exit on\n")

        agents.HOME = home
        agents.REVIEWS = reviews
        agents._REX[:] = [True]

        def make_helper(name, m, target_age=None, trusted=True):
            d = os.path.join(home, name)
            os.makedirs(d, exist_ok=True)
            json.dump(m, open(os.path.join(d, "meta.json"), "w"))
            if trusted:
                agents.save_trusted_meta(name, m)
            if target_age is not None:
                t = os.path.join(d, "target")
                os.makedirs(os.path.join(t, "debug"), exist_ok=True)
                open(os.path.join(t, "debug", "artifact"), "wb").write(b"x" * 4096)
                os.utime(os.path.join(t, "debug"), (target_age, target_age))
                os.utime(t, (target_age, target_age))

        make_helper("mine-live", {"via": "rex", "rex_id": "sa-mine", "owner_window": "win-lead-a", "root": agents.ROOT, "crate": "apps/rex", "worktree": agents.ROOT})
        make_helper("mine-trimmed", {"via": "rex", "rex_id": "sa-old", "owner_window": "win-lead-a", "root": agents.ROOT, "ended": 1000.0}, target_age=1000.0)
        make_helper("legacy-no-owner", {"via": "rex", "rex_id": "sa-old-unk", "root": agents.ROOT, "ended": 1000.0}, target_age=1000.0)
        make_helper("other-trimmed", {"via": "rex", "rex_id": "sa-old-b", "owner_window": "win-lead-b", "root": agents.ROOT, "ended": 1000.0}, target_age=1000.0)
        make_helper("foreign-tab", {"via": "rex", "rex_id": "sa-other", "owner_window": "win-lead-b", "root": agents.ROOT, "crate": "apps/rex", "worktree": agents.ROOT}, target_age=1000.0)
        make_helper("foreign-ended", {"via": "rex", "rex_id": "sa-other-done", "owner_window": "win-lead-b", "root": agents.ROOT, "ended": 1000.0})
        make_helper("foreign-repo", {"via": "rex", "rex_id": "sa-repo2", "owner_window": "win-lead-c", "root": "/var/tmp/other-checkout", "crate": "apps/rex"}, target_age=1000.0)
        make_helper("legacy-noroot", {"via": "tmux"}, target_age=1000.0)
        os.makedirs(os.path.join(home, "bare-dir"))

        agents.live = lambda n: n in ("mine-live", "foreign-tab", "foreign-repo")

        # Mock healthy `olo agent list --all --fast --json` with parent_certain=True:
        list_payload = json.dumps({
            "parent_certain": True,
            "parent_window_id": "win-lead-a",
            "subagents": [
                {"id": "sa-mine", "parent_window_id": "win-lead-a", "window_id": "win-mine", "state": "working"},
                {"id": "sa-other", "parent_window_id": "win-lead-b", "window_id": "win-other", "state": "working"},
                {"id": "sa-other-done", "parent_window_id": "win-lead-b", "window_id": "win-other-done", "state": "exited", "exited_at": 1000},
                {"id": "sa-repo2", "parent_window_id": "win-lead-c", "window_id": "win-repo2", "state": "working"},
            ],
        })
        agents.olo = lambda *a, **kw: subprocess.CompletedProcess(list(a), 0, list_payload, "")
        agents._SUBTREE_IDS[0] = None

        assert agents.is_ours("mine-live") is True
        assert agents.is_ours("mine-trimmed") is False, "trimmed ended helper must require allow_trimmed=True"
        assert agents.is_ours("mine-trimmed", allow_trimmed=True) is True
        assert agents.is_ours("legacy-no-owner", allow_trimmed=True) is False, "unknown owner_window must fail closed"
        assert agents.is_ours("other-trimmed", allow_trimmed=True) is False, "another lead's trimmed record must fail closed"

        # Tampering helper-writable meta.json cannot redirect child() to another Rex ID:
        json.dump({"via": "rex", "rex_id": "sa-hijack", "root": agents.ROOT}, open(os.path.join(home, "mine-live", "meta.json"), "w"))
        assert agents.child("mine-live") == "sa-mine", f"child() must prefer trusted_meta: {agents.child('mine-live')}"
        assert agents.is_ours("foreign-tab") is False
        assert agents.is_ours("foreign-repo") is False
        assert agents.is_ours("legacy-noroot") is False

        # sweep_builds on HOME only removes mine-trimmed/target, leaving foreign targets intact:
        swept = agents.sweep_builds(now=1e12, home=home, is_live=lambda n: n == "mine-live")
        assert [n for n, _ in swept] == ["mine-trimmed"], swept
        assert not os.path.exists(os.path.join(home, "mine-trimmed", "target"))
        assert os.path.exists(os.path.join(home, "other-trimmed", "target"))
        assert os.path.exists(os.path.join(home, "foreign-tab", "target"))
        assert os.path.exists(os.path.join(home, "foreign-repo", "target"))

        # Collision check refuses foreign active, foreign ended, and bare directories:
        expect_exit(lambda: agents.check_collision("foreign-tab"), "belongs to")
        expect_exit(lambda: agents.check_collision("foreign-ended"), "belongs to")
        expect_exit(lambda: agents.check_collision("foreign-repo"), "belongs to")
        expect_exit(lambda: agents.check_collision("bare-dir"), "without readable metadata")

        # Cross-tab crate overlap check blocks assigning apps/rex while foreign-tab holds it:
        expect_exit(lambda: agents.check_crate_overlap(agents.ROOT, "apps/rex", skip_name="mine-live"), "one agent to a crate")

        # Fail-closed when `olo agent list` fails or parent_certain is False:
        agents.olo = lambda *a, **kw: subprocess.CompletedProcess(list(a), 1, "", "service down")
        agents._SUBTREE_IDS[0] = None
        assert agents.is_ours("mine-live") is False
        assert agents.is_ours("mine-trimmed", allow_trimmed=True) is False
        assert agents.state("mine-live") == "unknown", "failed status must return unknown, not gone"

        uncertain_payload = json.dumps({"parent_certain": False, "parent_window_id": "win-lead-a", "subagents": []})
        agents.olo = lambda *a, **kw: subprocess.CompletedProcess(list(a), 0, uncertain_payload, "")
        agents._SUBTREE_IDS[0] = None
        assert agents.is_ours("mine-live") is False

        # agents_lock invalidates cached subtree_ids on entry:
        agents.olo = lambda *a, **kw: subprocess.CompletedProcess(list(a), 0, list_payload, "")
        with agents.agents_lock():
            assert agents.is_ours("mine-live") is True

        # Restore healthy lookup for collect_one tests:
        agents.state = lambda n: "idle"
        agents.at_rest = lambda n: True

        # Tampering with helper-writable meta.json cannot override parent-owned trusted_meta:
        evil = os.path.join(home, "agyrev-deadbeef00")
        os.makedirs(evil, exist_ok=True)
        open(os.path.join(evil, "review.md"), "w").write("review")
        legit_kept = os.path.join(reviews, "agyrev-deadbeef00", "agy-review.md")
        agents.save_trusted_meta("agyrev-deadbeef00", {
            "via": "rex", "rex_id": "sa-mine", "owner_window": "win-lead-a", "root": agents.ROOT, "kind": "review",
            "done": os.path.join(evil, "review.md"),
            "kept": os.path.join(agents.ROOT, "CLAUDE.md"),
        })
        json.dump({
            "via": "rex", "rex_id": "sa-mine", "root": agents.ROOT, "kind": "review",
            "done": os.path.join(evil, "review.md"),
            "kept": legit_kept,
        }, open(os.path.join(evil, "meta.json"), "w"))
        expect_exit(lambda: agents.collect_one("agyrev-deadbeef00"), "untrusted result path")

        # Review kept outside REVIEWS is refused:
        agents.save_trusted_meta("agyrev-deadbeef00", {
            "via": "rex", "rex_id": "sa-mine", "owner_window": "win-lead-a", "root": agents.ROOT, "kind": "review",
            "done": os.path.join(evil, "review.md"),
            "kept": os.path.join(td, "escape.md"),
        })
        expect_exit(lambda: agents.collect_one("agyrev-deadbeef00"), "outside")

        # Unknown state refuses collect_one:
        agents.save_trusted_meta("agyrev-deadbeef00", {
            "via": "rex", "rex_id": "sa-mine", "owner_window": "win-lead-a", "root": agents.ROOT, "kind": "review",
            "done": os.path.join(evil, "review.md"),
            "kept": legit_kept,
        })
        agents.state = lambda n: "unknown"
        expect_exit(lambda: agents.collect_one("agyrev-deadbeef00"), "temporarily unavailable")
        agents.state = lambda n: "idle"

        # Nested subagent cannot call collect_one:
        os.environ["OLO_SUBAGENT"] = "builder-1"
        try:
            expect_exit(lambda: agents.collect_one("agyrev-deadbeef00"), "you are a subagent")
        finally:
            os.environ.pop("OLO_SUBAGENT", None)

        # collect_one validates name BEFORE creating any lock file and does not create lock files for visual looks:
        expect_exit(lambda: agents.collect_one("astra-bad/name"), "helper's name")
        assert not os.path.exists(os.path.join(reviews, ".astra-bad")), "invalid name must not create lock dirs"
        expect_exit(lambda: agents.collect_one("astra-visual-shots"), "does not belong")
        assert not os.path.exists(os.path.join(reviews, ".astra-visual-shots.lock")), "visual look must not create code-review lock"

        # Lock-order observation: collect_one acquires per-review lock BEFORE agents_lock:
        lock_order = []
        orig_open_lock = agents._open_lock
        orig_agents_lock = agents.agents_lock
        def obs_open_lock(p):
            lock_order.append(("review_lock", os.path.basename(p)))
            return orig_open_lock(p)
        @agents.contextlib.contextmanager
        def obs_agents_lock():
            lock_order.append(("agents_lock", ".agents.lock"))
            with orig_agents_lock():
                yield
        agents._open_lock = obs_open_lock
        agents.agents_lock = obs_agents_lock
        try:
            expect_exit(lambda: agents.collect_one("agyrev-1234567890"), "does not belong")
        finally:
            agents._open_lock = orig_open_lock
            agents.agents_lock = orig_agents_lock
        assert lock_order[:2] == [("review_lock", ".agyrev-1234567890.lock"), ("agents_lock", ".agents.lock")], lock_order

        # Corrupt trusted_meta fails closed instead of falling back to untrusted meta.json:
        corrupt_h = "corrupt-helper"
        make_helper(corrupt_h, {"via": "rex", "rex_id": "sa-mine", "owner_window": "win-lead-a", "root": agents.ROOT}, trusted=True)
        open(agents.trusted_meta_path(corrupt_h), "w").write("{corrupt")
        assert agents.is_ours(corrupt_h) is False, "corrupt trusted_meta must fail closed"
        expect_exit(lambda: agents.child(corrupt_h), "unreadable/corrupt")

        # end() records verified olo cli_session_id directly into trusted_meta even when meta.json is deleted,
        # and ignores fake cli_session planted in meta.json:
        end_h = "end-verify"
        make_helper(end_h, {"via": "rex", "rex_id": "sa-mine", "owner_window": "win-lead-a", "root": agents.ROOT, "started": 1234.5}, trusted=True)
        os.remove(os.path.join(home, end_h, "meta.json"))
        orig_olo_end = agents.olo
        orig_st_end = agents.state
        try:
            def fake_end_olo(*a, **kw):
                if a[0] == "status":
                    return subprocess.CompletedProcess(list(a), 0, json.dumps({"state": "working", "cli_session_id": "verified-sess-9"}), "")
                if a[0] == "stop":
                    return subprocess.CompletedProcess(list(a), 0, json.dumps({"ended": True, "cli_session_id": "verified-sess-9"}), "")
                return orig_olo_end(*a, **kw)
            agents.olo = fake_end_olo
            agents.state = lambda n: "idle"
            assert agents.end(end_h, sessions=False) is True
            tm_after = agents.trusted_meta(end_h)
            assert tm_after.get("ended") and tm_after.get("cli_session") == "verified-sess-9", tm_after
            # state() must read ended from trusted_meta even when meta.json is absent:
            agents.state = orig_state
            agents.olo = lambda *a, **kw: subprocess.CompletedProcess(list(a), 0, json.dumps({"state": "exited", "running": False}), "")
            assert agents.state(end_h) == "gone", f"expected gone via trusted_meta, got {agents.state(end_h)}"
        finally:
            agents.olo = orig_olo_end
            agents.state = orig_st_end

        # Crate containment blocks escaping `--tree` even if target has a Cargo.toml:
        tree_a = os.path.join(td, "tree-a")
        tree_b = os.path.join(td, "tree-b")
        os.makedirs(tree_a)
        os.makedirs(tree_b)
        open(os.path.join(tree_b, "Cargo.toml"), "w").write('[package]\nname = "evil"\n')
        brief_p = os.path.join(td, "brief.md")
        open(brief_p, "w").write("do thing\n")
        expect_exit(lambda: agents.start("escape", "../tree-b", brief_p, tree=tree_a), "resolves outside")

        # Scope overlap covers root ".", "./", trailing slashes, and nested crates:
        assert agents.scopes_overlap(".", "crates/rex") is True
        assert agents.scopes_overlap("./", "crates/rex") is True
        assert agents.scopes_overlap("crates/rex/", "crates/rex/src") is True
        assert agents.scopes_overlap("crates/rex", "crates/rex-link") is False

        # git_bounded drains stdout & stderr concurrently under deadline and caps stdout:
        data = agents.git_bounded(agents.ROOT, ["rev-parse", "HEAD"], 1024, timeout_secs=10)
        assert len(data.strip()) == 40, data
        expect_exit(lambda: agents.git_bounded(agents.ROOT, ["rev-parse", "HEAD"], 8, timeout_secs=10), "exceeds")
        expect_exit(lambda: agents.git_bounded("/nonexistent-olo-dir", ["status"], 1024, timeout_secs=5), "git status")

        # Exercise >64 KiB stderr without pipe deadlock and deadline expiry using a stub git on PATH:
        stub_bin = os.path.join(td, "stub-bin")
        os.makedirs(stub_bin)
        stub_git = os.path.join(stub_bin, "git")
        open(stub_git, "w").write(
            "#!/usr/bin/python3\n"
            "import sys, time\n"
            "if 'noisy' in sys.argv:\n"
            "    sys.stderr.write('E' * (128 * 1024)); sys.stderr.flush()\n"
            "    sys.stdout.write('ok-after-stderr\\n'); sys.stdout.flush()\n"
            "elif 'hang' in sys.argv:\n"
            "    time.sleep(30)\n"
        )
        os.chmod(stub_git, 0o755)
        orig_path = os.environ.get("PATH", "")
        try:
            os.environ["PATH"] = f"{stub_bin}:{orig_path}"
            out_noisy = agents.git_bounded(td, ["noisy"], 1024, timeout_secs=5)
            assert out_noisy == b"ok-after-stderr\n", out_noisy
            expect_exit(lambda: agents.git_bounded(td, ["hang"], 1024, timeout_secs=0.4), "hadn't answered")
        finally:
            os.environ["PATH"] = orig_path
finally:
    agents.HOME = orig_home
    agents.REVIEWS = orig_reviews
    agents.olo = orig_olo
    agents._REX[:] = orig_rex
    agents._SUBTREE_IDS[0] = orig_sub
    agents.live = orig_live
    agents.state = orig_state
    agents.at_rest = orig_at_rest
    if orig_env_sub is not None:
        os.environ["OLO_SUBAGENT"] = orig_env_sub
    else:
        os.environ.pop("OLO_SUBAGENT", None)
    if orig_env_minder is not None:
        os.environ["OLO_MINDER"] = orig_env_minder
    else:
        os.environ.pop("OLO_MINDER", None)

# 5. Verify launch_opus passes --trust and launch_agy_review/launch_minder use --no-auto (never invalid `--mode default`):
src = open(os.path.join(HERE, "agents")).read()
assert '"--trust", "--prompt", first' in src.split("def launch_opus")[1].split("def launch_astra")[0], "launch_opus missing --trust"
