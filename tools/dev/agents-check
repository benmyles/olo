#!/usr/bin/python3
"""What tools/dev/agents reads off a helper's screen, tried on screens that
have fooled it. Nothing is started and nothing is asked of any agent: the
tool's own readers, given text.

  agents-check

A helper's field (`field_of`): agy with its running tasks drawn under its
field (a rule under them: "the last two rules" were not the field, `say`
found it never empty, pressed Enter four times and said the words were
still there, 2026-11-27); its mode's hint; Claude Code's; a screen with no
field.
"""
import importlib.machinery, importlib.util, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader("agents_tool", os.path.join(HERE, "agents"))
agents = importlib.util.module_from_spec(importlib.util.spec_from_loader("agents_tool", loader))
loader.exec_module(agents)

R = "─" * 60
TRAY = f"● Read(x)\n{R}\n>\n{R}\n  ● [18:29:34] ls -la /var/tmp/x && ... running\n{R}\nesc to cancel            accept-edits · Gemini 4 Neon · xhigh · 1 task(s) · /tasks\n"
CASES = [
    ("agy at work, its tasks under an empty field", TRAY, ""),
    ("the same with words in its field", TRAY.replace(">\n", "> Read the brief and go on\n", 1), "Read the brief and go on"),
    ("agy at rest, its mode's hint in its field", f"{R}\n> Accept-edits mode: file edits auto-approved (shift+tab to cycle)\n{R}\n? for shortcuts\n", ""),
    ("agy, a draft of two lines", f"{R}\n> first line\n  second line\n{R}\n? for shortcuts\n", "first line second line"),
    ("Claude Code", f"● Done\n{R}\n❯ hello there\n{R}\n  ? for shortcuts\n", "hello there"),
    ("Claude Code, empty", f"● Done\n{R}\n❯ \n{R}\n  ? for shortcuts\n", ""),
    ("a rule in what it wrote, over its field", f"● A table:\n{R}\n  a | b\n{R}\n>\n{R}\n? for shortcuts\n", ""),
    ("no field at all", "just\ntext\n", ""),
]
wrong = [(what, agents.field_of(screen), want) for what, screen, want in CASES if agents.field_of(screen) != want]
for what, got, want in wrong:
    print(f"FAILED: {what}: its field read as {got!r}, not {want!r}")
if wrong:
    sys.exit(1)

# Verify exact model / effort policy (Ben, 2026-11-27):
# - Minders: agy Neon 4 high
# - Builders & agy reviewers: agy Neon 4 xhigh
# - Codex code reviewers: Astra 6.2 xhigh
# - Claude visual design reviewers: Opus 5.5 xhigh
assert agents.MINDER_MODEL == "gemini-4-neon-high", agents.MINDER_MODEL
assert agents.MINDER_EFFORT == "high", agents.MINDER_EFFORT
assert agents.MODEL == "gemini-4-neon-xhigh", agents.MODEL
assert agents.ASTRA == "gpt-6.2-astra", agents.ASTRA
assert agents.ASTRA_EFFORT == "xhigh", agents.ASTRA_EFFORT
assert agents.OPUS == "claude-opus-5-5", agents.OPUS
assert agents.OPUS_EFFORT == "xhigh", agents.OPUS_EFFORT

# Verify minder vs subagent permissions and nesting boundaries:
ms = agents.settings(["/repo", "/d"], commands="minder", own=["/d"])
assert "command(olo agent watch)" in ms["permissions"]["allow"]
assert "command(tools/dev/astra-review)" in ms["permissions"]["allow"]
assert "command(tools/dev/agy-review)" in ms["permissions"]["allow"]
assert "command(olo agent prune)" in ms["permissions"]["deny"]
assert "command(git push)" in ms["permissions"]["deny"]
assert "command(tools/dev/agents minder)" in ms["permissions"]["deny"]

rs = agents.settings(["/d", "/repo"], commands="review", own=["/d"])
assert "command(git show)" in rs["permissions"]["allow"]
assert "write_file(/d)" in rs["permissions"]["allow"]
assert not any("cargo" in x or "jato" in x for x in rs["permissions"]["allow"])

# Verify sweep_builds ignores non-helper files such as tmux.conf without raising:
import tempfile
with tempfile.TemporaryDirectory(dir="/var/tmp", prefix="olo-agents-check-") as td:
    open(os.path.join(td, "tmux.conf"), "w").write("set -g remain-on-exit on\n")
    assert agents.sweep_builds(now=1e12, home=td, is_live=lambda _: False) == []

print(f"ok: field reader ({len(CASES)} screens), model/effort policy, minder/reviewer permissions, and sweep isolation")
