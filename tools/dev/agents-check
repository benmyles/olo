    # Live `show()` subprocess: deterministic select()-driven synchronization verifying
    # initial frame, SIGWINCH redraw, inotify redraw, and clean SIGTERM exit:
    import select as _sel, signal as _sig, time as _time
    show_proc = subprocess.Popen(
        ["/usr/bin/python3", os.path.join(HERE, "agent-board"), "show", bp],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=clean_env,
    )
    os.set_blocking(show_proc.stdout.fileno(), False)
    buf = bytearray()
    def wait_for(cond, timeout_s=5.0):
        dl = _time.monotonic() + timeout_s
        while _time.monotonic() < dl:
            if cond(buf):
                return True
            r, _, _ = _sel.select([show_proc.stdout], [], [], max(0.02, min(0.1, dl - _time.monotonic())))
            if r:
                chunk = os.read(show_proc.stdout.fileno(), 65536)
                if not chunk:
                    break
                buf.extend(chunk)
        return cond(buf)
    try:
        CLEAR = b"\x1b[H\x1b[2J\x1b[3J"
        assert wait_for(lambda b: b.count(CLEAR) >= 1 and b"live" in b), f"missed initial frame: {bytes(buf)!r}"
        c1 = buf.count(CLEAR)
        show_proc.send_signal(_sig.SIGWINCH)
        assert wait_for(lambda b: b.count(CLEAR) >= c1 + 1), "show() missed SIGWINCH redraw"
        c2 = buf.count(CLEAR)
        subprocess.run(["/usr/bin/python3", os.path.join(HERE, "agent-board"), "update", "--file", bp, "--now", "inotify-live-marker"], capture_output=True, text=True, check=True, env=clean_env)
        assert wait_for(lambda b: b.count(CLEAR) >= c2 + 1 and b"inotify-live-marker" in b), "show() missed inotify redraw"
        show_proc.send_signal(_sig.SIGTERM)
        rest_out, err_b = show_proc.communicate(timeout=3)
        assert show_proc.returncode == 0, (show_proc.returncode, err_b)
    finally:
        if show_proc.poll() is None:
            show_proc.kill()
            show_proc.wait()

