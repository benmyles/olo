#!/usr/bin/python3
"""Olo's word list and its translations (crates/kit-base/words).

  words gather [--write] [--no-lints]
      Every word Olo asks for that isn't in en.txt yet: both layout lints
      run in English with OLO_WORDS_SEEN (`cargo ui-lint`: Preferences',
      DiskBackup's and the kit's windows; `tools/dev/ui-lint`: every
      app's, its menus too), and the literals handed to widgets in the
      apps' code that no window either opens shows (`Button::new("…")`,
      `.note("…")`, `.item("…", …)`, `tr!("…")` and the like; ids, a
      service's log words and tests left out). Printed for a look; with
      --write, added to en.txt. Never takes a word out. --no-lints reads
      the lints' last lists (in /var/tmp/olo-words) instead of running them.

  words unasked [--no-lint]
      What Olo shows that never went through the words layer, so no
      language can reach it: the live lint run in English with
      OLO_WORDS_UNSEEN, each program's windows written down as the kit
      is handed them (`words::of` given a `String`) or draws them (an
      app's own `style::label`), less what the layer made (`tr!`,
      `count`). By program, plain data (paths, numbers, addresses) left
      out; a file's name or a person's words are still among them, to be
      told apart by eye. Each one shown is a `format!` to make a `tr!`, a
      literal copied into a `String` to hand on as the literal, or a
      helper taking `&str` to make `&'static str`.

  words sweep [--dry] FILE…
      FILE's words made at run time put through the words layer: a
      `format!` sentence (a phrase in it) becomes `olo_kit::tr!` (its
      number formats moved into its parts), a literal of two words or
      more copied into a String (`.into()`, `.to_owned()`,
      `.to_string()`) becomes `olo_kit::words::tr("…")` copied. Never in
      a test module, a log line, an id, or a name (capitalized words
      with a digit). Prints each change; --dry only prints. Read the
      result as a diff: a command it runs, a file's or a keyring item's
      name, a fixture's data or an agent's command-line output must stay
      as they were (`format!`, the literal). Then `words gather --write`.

  words missing LANG
      The words of en.txt LANG's catalog doesn't have yet, one a line.

  words pairs LANG
      LANG's catalog as pairs: "English ||| translation", a counting
      entry's forms apart by " ¦ ".

  words merge LANG PAIRS… [--header "# …"]
      LANG's catalog again, its own entries with PAIRS' over them (a
      pair for a word it has puts the new translation in), written in
      en.txt's order. Each line of PAIRS: the English exactly as en.txt
      has it, " ||| " (or a tab), its translation; "=" for one that stays
      as it is (a name, a path); a counting entry ({n}) its forms, each
      "one: …", "few: …", "many: …" or "other: …", apart by " ¦ ". Refuses
      unless every word of en.txt is there, nothing else is, and each
      translation keeps its English's {} and {n} parts. French has a
      narrow no-break space put before : ; ? ! and no-break spaces inside
      « », as French type sets them (write plain spaces). A language
      without a catalog yet needs --header (its first line).

Translating: `words missing fr > /var/tmp/…/todo.txt`, write the pairs,
`words merge fr PAIRS`, then `cargo test -p olo-kit-base words`, and the
lints in the language (`OLO_LANGUAGE=fr cargo ui-lint --no-fail-fast`;
`OLO_LANGUAGE=fr tools/dev/ui-lint --no-cache`), saying in fewer words
what runs past its room. See "Words in the person's language" in
docs/HACKING.md.
"""
import glob, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
WORDS = os.path.join(ROOT, "crates/kit-base/words")
SCRATCH = "/var/tmp/olo-words"


def english():
    return [w for w in open(os.path.join(WORDS, "en.txt")).read().split("\n") if w]


def catalog(lang):
    """LANG's entries: English → translation (forms apart by " ¦ ")."""
    path = os.path.join(WORDS, lang + ".txt")
    if not os.path.exists(path):
        return {}, None
    text = open(path).read()
    header = next((l for l in text.split("\n") if l.startswith("#")), None)
    out = {}
    for block in text.split("\n\n"):
        lines = [l for l in block.split("\n") if l and not l.startswith("#")]
        if len(lines) < 2:
            continue
        en, rest = lines[0], lines[1:]
        out[en] = " ¦ ".join(rest) if rest[0].startswith(("one:", "few:", "many:", "other:")) else rest[0]
    return out, header


# Literals handed to the kit's widgets (and `tr!`), the first string
# argument after at most one plain one (`ui.check(id, "…")`).
CALLS = (r"(?:Button::new|\.label|\.title|\.item|\.check|\.note|StringView::new|\.hint|\.tip|tr!|words::tr|words::of_text|words::of|en!|words::en|\.bbox|"
         r"Column::new|\.submenu|RadioButton::new|CheckBox::new|\.placeholder|\.heading|\.empty_text|\.empty|alert|"
         r"\.choose|LinkButton::new|Menu::new|\.button|\.default_button|\.cancel_button|\.message|\.explain|\.radio|"
         r"\.group|\.section)")
LITERAL = re.compile(CALLS + r'\(\s*(?:[a-z_&.]+,\s*)?"((?:[^"\\]|\\.)+)"')
# Words asked for by name (`tr!`, `words::tr`, `en!`…): words, however
# they look ("tidying" alone too, which a widget's literal wouldn't be).
ASKED = re.compile(r'(?:\b(?:tr!|words::tr|words::of_text|en!|words::en)|(?<![\w:])tr)\(\s*"((?:[^"\\]|\\.)+)"')
# A sentence that counts is known by its other form, the last of a
# call's two words with `{n}` in it (`words::count(n, "1 window", "{n}
# windows")`, `count(` brought in by a `use`, an app's own `counted(`).
COUNTING = re.compile(r'\b\w+\([^"]*"(?:[^"\\]|\\.)*",\s*"((?:[^"\\]|\\.)*\{n\}(?:[^"\\]|\\.)*)"\s*\)')
# Programs without windows: their words are a log's.
SERVICES = ("apps/chime/", "apps/fans/")


def in_code():
    """The words in the code, and of them those asked for by name."""
    found, asked = set(), set()
    for path in sorted(glob.glob(os.path.join(ROOT, "apps/*/src/**/*.rs"), recursive=True) + glob.glob(os.path.join(ROOT, "crates/kit/src/**/*.rs"), recursive=True)):
        rel = os.path.relpath(path, ROOT)
        if rel.startswith(SERVICES) or rel.endswith("lint.rs"):
            continue
        src = open(path, errors="replace").read()
        cut = src.find("#[cfg(test)]\nmod tests")
        if cut >= 0:
            src = src[:cut]
        # (An app's own `words::count` without `{n}` is its own helper.)
        for m in list(LITERAL.finditer(src)) + [m for m in COUNTING.finditer(src) if "{n}" in m.group(1)] + list(ASKED.finditer(src)):
            s = re.sub(r"\\u\{([0-9a-fA-F]+)\}", lambda m: chr(int(m.group(1), 16)), m.group(1))
            # (Asked for by name, a unit alone is a word, "{} h", and so is
            # punctuation that languages set apart: "{}: {}", French's
            # "{} : {}".)
            if "\\" in s or not re.search(r"[A-Za-z]{2}" if m.re is not ASKED else r"[A-Za-z:;?!]", s):
                continue
            found.add(s)
            if m.re is ASKED:
                asked.add(s)
    return found, asked


def without_test_blocks(src):
    """`src` less what only tests take: the item after each `#[cfg(test)]`
    (a module of whatever name, a function; `mod lint;` to its `;`) and
    each `if cfg!(test)…` block (its fixtures' data)."""
    out, i = [], 0
    while True:
        found = [a for a in (src.find("if cfg!(test)", i), src.find("#[cfg(test)]", i)) if a >= 0]
        if not found:
            out.append(src[i:])
            return "".join(out)
        at = min(found)
        brace = src.find("{", at)
        semi = src.find(";", at) if src.startswith("#[cfg(test)]", at) else -1
        if 0 <= semi and (brace < 0 or semi < brace):
            out.append(src[i:at])
            i = semi + 1
            continue
        if brace < 0:
            out.append(src[i:])
            return "".join(out)
        depth, j = 0, brace
        while j < len(src):
            c = src[j]
            if c == '"':
                j += 1
                while j < len(src) and src[j] != '"':
                    j += 2 if src[j] == "\\" else 1
            elif c == "{":
                depth += 1
            elif c == "}":
                depth -= 1
                if depth == 0:
                    break
            j += 1
        out.append(src[i:at])
        i = j + 1


def literals():
    """Every string the code holds as a literal, outside its tests."""
    held = set()
    for path in sorted(glob.glob(os.path.join(ROOT, "apps/*/src/**/*.rs"), recursive=True) + glob.glob(os.path.join(ROOT, "crates/*/src/**/*.rs"), recursive=True)):
        # (Nor the settings index, written from what the lint drew.)
        if path.endswith("lint.rs") or path.endswith("crates/xdg/src/settings.rs"):
            continue
        src = open(path, errors="replace").read()
        cut = src.find("#[cfg(test)]\nmod tests")
        if cut >= 0:
            src = src[:cut]
        # (Not a block only tests and demos take: `if cfg!(test) || …demo…
        # { …fixtures… }`.)
        src = without_test_blocks(src)
        for lit in rust_strings(src):
            s = re.sub(r"\\u\{([0-9a-fA-F]+)\}", lambda m: chr(int(m.group(1), 16)), lit)
            held.add(s.replace('\\"', '"').replace("\\n", "\n"))
    return held


def rust_strings(src):
    """The string literals of Rust source, as written (escapes kept), less
    comments, character literals and lifetimes; a raw string whole."""
    i, n = 0, len(src)
    while i < n:
        c = src[i]
        if src.startswith("//", i):
            i = src.find("\n", i)
            i = n if i < 0 else i
        elif src.startswith("/*", i):
            i = src.find("*/", i + 2)
            i = n if i < 0 else i + 2
        elif c == "'":
            # A character ('a', '\'', '\u{2026}'), or a lifetime ('a).
            m = re.match(r"'(?:\\u\{[0-9a-fA-F]+\}|\\.|[^\\'\n])'", src[i:i + 12])
            i += len(m.group(0)) if m else 1
        elif c == "r" and re.match(r'r#*"', src[i:i + 8]) and (i == 0 or not (src[i - 1].isalnum() or src[i - 1] == "_")):
            hashes = len(re.match(r'r(#*)"', src[i:i + 8]).group(1))
            end = src.find('"' + "#" * hashes, i + 2 + hashes)
            end = n if end < 0 else end
            yield src[i + 2 + hashes:end]
            i = end + 1 + hashes
        elif c == '"':
            j = i + 1
            while j < n and src[j] != '"':
                j += 2 if src[j] == "\\" else 1
            yield src[i + 1:j]
            i = j + 1
        else:
            i += 1


def a_word(s):
    """Not an id ("caff:off", "widget-hue"), a number or a lone lower-case
    token: words have a space, or are a name or a label."""
    if re.fullmatch(r"[\d\s.,:%+()-]+", s):
        return False
    if " " in s:
        return True
    if s.islower():
        return s in ("on", "off")
    return not re.search(r"[-:_./]", s) or s.endswith((":", "…", ".")) or s in ("Objective-C", "TCP/IP")


def gather(write, lints):
    os.makedirs(SCRATCH, exist_ok=True)
    unit, live = os.path.join(SCRATCH, "seen-unit.txt"), os.path.join(SCRATCH, "seen-live.txt")
    if lints:
        env = {k: v for k, v in os.environ.items() if k != "OLO_LANGUAGE"}
        for path in (unit, live):
            if os.path.exists(path):
                os.remove(path)
        print("words: the layout lint (cargo ui-lint)…", file=sys.stderr)
        subprocess.run(["cargo", "ui-lint", "--no-fail-fast"], cwd=ROOT, env=dict(env, OLO_WORDS_SEEN=unit), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("words: the live lint (tools/dev/ui-lint, every app)…", file=sys.stderr)
        subprocess.run([sys.executable, os.path.join(ROOT, "tools/dev/ui-lint"), "--no-cache"], cwd=ROOT, env=dict(env, OLO_WORDS_SEEN=live), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    seen = set()
    for path in (unit, live):
        if os.path.exists(path):
            seen |= {l.replace("\\n", "\n") for l in open(path).read().split("\n") if l}
    known = set(english())
    found, asked = in_code()
    # (A word only seen as the lints ran is one of Olo's if the code holds
    # it as a literal, outside its tests: what this computer shows the
    # lints (its displays, its graphics, its networks) isn't.)
    held = literals()
    seen = {w for w in seen if w in held}
    new = sorted((w for w in (seen | found) - known if (w in asked or a_word(w)) and "\n" not in w), key=lambda w: w.encode())
    for w in new:
        print(w)
    print(f"words: {len(new)} not in en.txt ({len(known)} there)", file=sys.stderr)
    if write and new:
        words = sorted(known | set(new), key=lambda w: w.encode())
        open(os.path.join(WORDS, "en.txt"), "w").write("\n".join(words) + "\n")
        print(f"words: en.txt has {len(words)}", file=sys.stderr)


def unasked(lint):
    os.makedirs(SCRATCH, exist_ok=True)
    path = os.path.join(SCRATCH, "unasked.txt")
    if lint:
        if os.path.exists(path):
            os.remove(path)
        env = {k: v for k, v in os.environ.items() if k != "OLO_LANGUAGE"}
        print("words: the live lint (tools/dev/ui-lint, every app), finding words never asked for…", file=sys.stderr)
        subprocess.run([sys.executable, os.path.join(ROOT, "tools/dev/ui-lint"), "--no-cache"], cwd=ROOT, env=dict(env, OLO_WORDS_UNSEEN=path), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not os.path.exists(path):
        sys.exit("words: nothing written down (no lint run yet: leave out --no-lint)")
    data = re.compile(r"^[\w.+-]+@[\w.-]+$|^[~/][^ ]*$|^[\w.-]+\.[a-z0-9]{1,5}$|^[\d\s.,:%°/+-]+[a-zA-Z]{0,3}$|^[0-9a-f:]{6,}$")
    by = {}
    for line in open(path).read().split("\n"):
        if "\t" not in line:
            continue
        program, text = line.split("\t", 1)
        if data.match(text.strip()):
            continue
        by.setdefault(program, set()).add(text)
    total = 0
    for program in sorted(by, key=lambda p: -len(by[p])):
        print(f"== {program} ({len(by[program])})")
        for t in sorted(by[program]):
            print(f"  {t}")
        total += len(by[program])
    print(f"words: {total} shown, never asked for, in {len(by)} programs", file=sys.stderr)


# `words sweep`: a file's run-time words through the layer.
SENTENCE = re.compile(r"[A-Za-z’']{2,}[,.;:]? +[A-Za-z’'(]")


def words_in(text):
    return len(re.findall(r"[A-Za-z’']{2,}", re.sub(r"\{[^}]*\}", " ", text)))


def a_name(text):
    """A product's or a place's name: every word capitalized, a digit in it
    ("Kingston DataTraveler 3.0")."""
    ws = re.findall(r"[A-Za-z][A-Za-z’']*", text)
    return bool(re.search(r"\d", text)) and ws and all(w[0].isupper() for w in ws)


def scan_string(src, i):
    """src[i] is a '"': the end index (after the closing quote) of the literal."""
    j = i + 1
    while j < len(src):
        if src[j] == "\\":
            j += 2
            continue
        if src[j] == '"':
            return j + 1
        j += 1
    raise ValueError("unterminated string")


def scan_args(src, i):
    """src[i] is just after the format string: the arguments up to the closing ')' (split at top-level commas), and the index after ')'."""
    depth, j, start, args = 0, i, i, []
    while j < len(src):
        c = src[j]
        if c == '"':
            j = scan_string(src, j)
            continue
        if c == "'" and re.match(r"'(\\.|[^\\'])'", src[j:j + 4]):
            j = src.index("'", j + 1) + 1
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            if depth == 0:
                if src[start:j].strip():
                    args.append(src[start:j].strip())
                return args, j + 1
            depth -= 1
        elif c == "," and depth == 0:
            if src[start:j].strip():
                args.append(src[start:j].strip())
            start = j + 1
        j += 1
    raise ValueError("unterminated format!")


def convert_format(fmt, args):
    """fmt: the literal's contents. Returns (pattern, new args) or None."""
    named = {}
    positional = []
    for a in args:
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.+)$", a, re.S)
        if m and not a.startswith(("==",)):
            named[m.group(1)] = m.group(2)
        else:
            positional.append(a)
    out, new, nxt, i = [], [], 0, 0
    while i < len(fmt):
        c = fmt[i]
        if fmt.startswith("{{", i) or fmt.startswith("}}", i):
            out.append(fmt[i:i + 2])
            i += 2
            continue
        if c == "{":
            close = fmt.index("}", i)
            spec = fmt[i + 1:close]
            name, _, form = spec.partition(":")
            if name == "":
                if nxt >= len(positional):
                    return None
                expr = positional[nxt]
                nxt += 1
            elif name.isdigit():
                expr = positional[int(name)]
            elif name in named:
                expr = named[name]
            elif re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
                expr = name
            else:
                return None
            if form:
                expr = f'format!("{{:{form}}}", {expr})'
            new.append(expr)
            out.append("{}")
            i = close + 1
            continue
        out.append(c)
        i += 1
    return "".join(out), new


# (A thread's name, a log line, a command's arguments, an id: not words a
# person reads.)
SKIP_LINE = re.compile(r"tracing::|eprintln!|println!|log::|warn!|info!|debug!|error!|trace!|panic!|assert|expect\(|unreachable!|todo!|\.id\(|Command::new|\.arg\(|\.env\(|header|Header|tr!\(|words::|en!\(|\.name\(|Builder::new")


def sweep(path, dry):
    src = open(path).read()
    test = src.find("#[cfg(test)]\nmod tests")
    end = test if test >= 0 else len(src)
    out, i, changes = [], 0, []
    while i < end:
        m = re.compile(r'format!\(\s*"').search(src, i, end)
        n = re.compile(r'"((?:[^"\\\n]|\\.){2,})"\.(into|to_owned|to_string)\(\)').search(src, i, end)
        nxt = min([x for x in (m, n) if x], key=lambda x: x.start(), default=None)
        if nxt is None:
            break
        line_start = src.rfind("\n", 0, nxt.start()) + 1
        line_end = src.find("\n", nxt.start())
        line = src[line_start:line_end]
        out.append(src[i:nxt.start()])
        if nxt is m:
            q = src.index('"', m.start())
            q_end = scan_string(src, q)
            fmt = src[q + 1:q_end - 1]
            try:
                args, after = scan_args(src, q_end)
            except ValueError:
                out.append(src[nxt.start():q_end]); i = q_end; continue
            # (The comma before the first argument.)
            if args and args[0] == "":
                args = args[1:]
            conv = None
            bare = re.sub(r"\{[^}]*\}", " ", fmt)
            if re.search(r"[A-Za-z]{3,}", bare) and re.search(r"[A-Za-z’']+ +[A-Za-z’']+", bare) and not SKIP_LINE.search(line) and "\\n" not in fmt and not a_name(bare):
                conv = convert_format(fmt, args)
            if conv:
                pattern, new = conv
                text = f'olo_kit::tr!("{pattern}"' + "".join(f", {a}" for a in new) + ")"
                out.append(text)
                changes.append((src.count("\n", 0, nxt.start()) + 1, src[nxt.start():after].replace("\n", " ")[:110], text[:110]))
                i = after
            else:
                out.append(src[nxt.start():after])
                i = after
        else:
            lit, how = n.group(1), n.group(2)
            if words_in(lit) >= 2 and SENTENCE.search(lit) and not SKIP_LINE.search(line) and "{" not in lit and not a_name(lit):
                text = f'olo_kit::words::tr("{lit}").{how}()'
                out.append(text)
                changes.append((src.count("\n", 0, nxt.start()) + 1, n.group(0)[:110], text[:110]))
            else:
                out.append(n.group(0))
            i = n.end()
    out.append(src[i:])
    new_src = "".join(out)
    for line, a, b in changes:
        print(f"{path}:{line}: {a}\n    → {b}")
    if not dry and new_src != src:
        open(path, "w").write(new_src)
    return len(changes)


def french(t):
    for mark in (":", ";", "?", "!"):
        t = t.replace(" " + mark, "\u202f" + mark)
    return t.replace("« ", "«\u00a0").replace(" »", "\u00a0»")


def parts(text):
    return sorted(re.findall(r"\{[^}]*\}", text))


def same_parts(english, said):
    """Whether a translation has the English's parts: the same, or its
    `{}` numbered by place to put them in its own order (`{1} … {0}`),
    or a count's form without its number ("Every day" for "Every {n}
    days")."""
    want, got = parts(english), parts(said)
    if got == want or got == [p for p in want if p != "{n}"]:
        return True
    plain = [p for p in want if p == "{}"]
    numbered = sorted(p for p in got if re.fullmatch(r"\{\d+\}", p))
    rest_want = [p for p in want if p != "{}"]
    rest_got = [p for p in got if not re.fullmatch(r"\{\d+\}", p)]
    return bool(numbered) and numbered == sorted(f"{{{i}}}" for i in range(len(plain))) and rest_got in (rest_want, [p for p in rest_want if p != "{n}"])


def merge(lang, files, header):
    pairs, own_header = catalog(lang)
    header = header or own_header
    if not header:
        sys.exit(f"words: {lang} has no catalog yet: give it a --header \"# …\"")
    words = english()
    problems = []
    given = set()
    for path in files:
        for n, line in enumerate(open(path).read().split("\n"), 1):
            if not line.strip():
                continue
            sep = "\t" if "\t" in line else (" ||| " if " ||| " in line else None)
            if sep is None:
                problems.append(f"{path}:{n}: no tab or ' ||| ': {line[:60]}")
                continue
            en, tr = line.split(sep, 1)
            if en in given:
                problems.append(f"{path}:{n}: twice: {en[:60]}")
            given.add(en)
            # (A word that ends with a space, "About ", keeps its own.)
            tr = tr.lstrip() if en != en.rstrip() else tr.strip()
            if tr == "=":
                tr = en
            elif lang == "fr":
                tr = french(tr)
            pairs[en] = tr
    known = set(words)
    for w in words:
        if w not in pairs:
            problems.append(f"missing: {w[:80]}")
    for w in given - known:
        problems.append(f"not in en.txt: {w[:80]}")
    blocks = []
    for w in words:
        if w not in pairs:
            continue
        tr = pairs[w]
        if "{n}" in w:
            forms = [f.strip() for f in tr.split("¦")]
            for f in forms:
                if not re.match(r"^(one|few|many|other): ", f):
                    problems.append(f"a form without its name: {w} → {f[:60]}")
                elif not same_parts(w, f.split(": ", 1)[1]):
                    problems.append(f"parts differ: {w} → {f}")
            blocks.append(w + "\n" + "\n".join(forms))
        else:
            if not same_parts(w, tr):
                problems.append(f"parts differ: {w[:60]} → {tr[:60]}")
            blocks.append(w + "\n" + tr)
    if problems:
        print("\n".join(problems[:60]))
        sys.exit(f"words: {len(problems)} problems; nothing written")
    with open(os.path.join(WORDS, lang + ".txt"), "w") as f:
        f.write(header.rstrip("\n") + "\n# Every word of en.txt; those the same as in English (names, paths) as themselves.\n\n" + "\n\n".join(blocks) + "\n")
    print(f"words: {lang}.txt, {len(blocks)} entries", file=sys.stderr)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    cmd = a.pop(0)
    if cmd == "gather":
        gather("--write" in a, "--no-lints" not in a)
    elif cmd == "sweep" and a:
        dry = "--dry" in a
        total = sum(sweep(f, dry) for f in a if f != "--dry")
        print(f"words: {total} changed{' (dry)' if dry else ''}", file=sys.stderr)
    elif cmd == "unasked":
        unasked("--no-lint" not in a)
    elif cmd == "missing" and a:
        have, _ = catalog(a[0])
        for w in english():
            if w not in have:
                print(w)
    elif cmd == "pairs" and a:
        have, _ = catalog(a[0])
        for en, tr in have.items():
            print(f"{en} ||| {tr}")
    elif cmd == "merge" and len(a) >= 2:
        header = None
        if "--header" in a:
            i = a.index("--header")
            header = a[i + 1]
            del a[i:i + 2]
        merge(a[0], a[1:], header)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
