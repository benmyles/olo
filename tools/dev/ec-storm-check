#!/usr/bin/python3
"""olo_ec_storm (kernel/ec-storm), checked as far as it can be without a
controller that floods:

  tools/dev/ec-storm-check              its counting, its build, its refusal
  tools/dev/ec-storm-check --series v7.4   and the driver in that kernel series

- **Its counting** (kernel/ec-storm/check.c: the module's own lines for it,
  run from many threads): the method never twice at once, a run after
  the last event, a flood coalesced, keys one at a time each run.
- **Its build** against the running kernel's headers (in /var/tmp).
- **Its refusal** in a KVM guest running this kernel (tools/dev/kvm-guest;
  QEMU has no embedded controller): "No such device", the kernel none
  the worse. What it does with a real controller's events can only be
  seen on a computer that has one, with its owner's word.
- **The driver** (`--series TAG`): the functions of drivers/acpi/ec.c and
  the declarations of drivers/acpi/internal.h the module depends on, as
  torvalds/linux has them at TAG, compared with those it was written
  against (kernel/ec-storm/driver.checked). The same: add the series to
  kernel/ec-storm/CHECKED. Different: read them before anything else.
"""
import os, re, subprocess, sys, tempfile, urllib.request
ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
SRC = os.path.join(ROOT, "kernel", "ec-storm")
FUNCTIONS = ["acpi_ec_get_query_handler_by_value", "acpi_ec_add_query_handler", "acpi_ec_remove_query_handlers", "acpi_ec_remove_query_handler", "acpi_ec_event_processor", "acpi_ec_submit_query", "acpi_ec_register_query_methods"]
DECLARATIONS = [r"extern struct acpi_ec \*first_ec;", r"typedef int \(\*acpi_ec_query_func\) ?\(void \*data\);", r"int acpi_ec_add_query_handler\([^;]*\);", r"void acpi_ec_remove_query_handler\([^;]*\);"]

def function(text, name):
    m = re.search(r"\n[^\n;{}]*\b%s\([^;{]*\)\s*\{" % name, text)
    if not m:
        return None
    i = text.index("{", m.start()); depth = 0; j = i
    while True:
        depth += {"{": 1, "}": -1}.get(text[j], 0)
        if depth == 0:
            break
        j += 1
    return re.sub(r"\s+", " ", text[m.start():j + 1]).strip()

def driver(tag):
    get = lambda path: urllib.request.urlopen("https://raw.githubusercontent.com/torvalds/linux/%s/%s" % (tag, path), timeout=40).read().decode()
    ec, internal = get("drivers/acpi/ec.c"), get("drivers/acpi/internal.h")
    out = []
    for name in FUNCTIONS:
        out.append("%s: %s" % (name, function(ec, name) or "MISSING"))
    for d in DECLARATIONS:
        m = re.search(d, internal)
        out.append("declared: %s" % (re.sub(r"\s+", " ", m.group(0)) if m else "MISSING: " + d))
    return "\n".join(out) + "\n"

def main():
    a = sys.argv[1:]
    ok = True
    if a[:1] == ["--write-driver"] and len(a) == 2:
        open(os.path.join(SRC, "driver.checked"), "w").write(driver(a[1]))
        print("kernel/ec-storm/driver.checked written from", a[1])
        return 0
    work = tempfile.mkdtemp(prefix="olo-ec-storm-check-", dir="/var/tmp")
    try:
        exe = os.path.join(work, "check")
        r = subprocess.run(["cc", "-O2", "-pthread", "-Wall", "-Werror", "-o", exe, os.path.join(SRC, "check.c")], capture_output=True, text=True)
        r = r if r.returncode else subprocess.run([exe], capture_output=True, text=True, timeout=120)
        good = r.returncode == 0
        print("  %s its counting (%s)" % ("ok " if good else "NOT", (r.stdout.strip().splitlines() or [r.stderr.strip()[:200]])[-1]))
        ok &= good
        for name in ("Kbuild", "olo_ec_storm.c", "olo_ec_storm_count.h"):
            open(os.path.join(work, name), "w").write(open(os.path.join(SRC, name)).read())
        release = os.uname().release
        r = subprocess.run(["make", "-C", "/lib/modules/%s/build" % release, "M=" + work, "modules"], capture_output=True, text=True)
        ko = os.path.join(work, "olo_ec_storm.ko")
        good = r.returncode == 0 and os.path.isfile(ko) and "warning" not in (r.stdout + r.stderr).lower()
        print("  %s it builds for %s%s" % ("ok " if good else "NOT", release, "" if good else ": " + (r.stderr.strip().splitlines() or ["?"])[-1][:200]))
        ok &= good
        if good:
            script = 'insmod /ko/olo_ec_storm.ko 2>&1; echo "insmod|$?"; echo "controllers|$(ls /sys/bus/acpi/devices | grep -c PNP0C09)"; echo "alive|$(cat /proc/sys/kernel/osrelease)"'
            r = subprocess.run([os.path.join(ROOT, "tools/dev/kvm-guest"), "--timeout", "120", "--quiet", "--ko", ko, "-c", script], capture_output=True, text=True)
            said = dict(l.split("|", 1) for l in r.stdout.splitlines() if "|" in l)
            good = said.get("controllers") == "0" and said.get("insmod") == "1" and "No such device" in r.stdout and said.get("alive") == release
            print("  %s with no controller (a guest) it's refused, and the kernel is none the worse (%s)" % ("ok " if good else "NOT", "insmod %s" % said.get("insmod")))
            ok &= good
        if a[:1] == ["--series"] and len(a) == 2:
            now, was = driver(a[1]), open(os.path.join(SRC, "driver.checked")).read()
            good = now == was
            print("  %s the driver in %s is as the module was written against" % ("ok " if good else "NOT", a[1]))
            if not good:
                for x, y in zip(was.splitlines(), now.splitlines()):
                    if x != y:
                        print("      was: %s\n      now: %s" % (x[:160], y[:160]))
            ok &= good
    finally:
        subprocess.run(["rm", "-rf", work])
    print("passed" if ok else "FAILED")
    return 0 if ok else 1

if __name__ == "__main__":
    sys.exit(main())
