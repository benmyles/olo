#!/usr/bin/env python3
"""Coding agents' tab titles, end to end, as each agent reaches the tool.

  agent-title-check

Starts a headless session of its own ("agtitle", HOME a folder of its own
under /var/tmp) with Terminal in it, Preferences ▸ Terminal's agent
settings on, its tab in that HOME, and the tab title service
(`olo-terminal --mcp-service`, title_service.rs) on a port of its own,
from a copy of the build. Then sets the tab's title over HTTP the way
each agent does:

  Codex:        from outside the tab's processes (as Codex's daemon), the
                tab found by the folder it gives.
  Claude Code:  from under the tab's shell (the tab found from the
                process that connected, and its ancestors), across an
                upgrade (the copy replaced and SIGURG sent, as
                olo-session does: the same process becomes the new file,
                the socket handed over) and across a crash (the service
                killed and started again, as olo-session does: the next
                request is answered).

and checks the window's title each time.
"""
import json, os, shutil, signal, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
TS = [sys.executable, os.path.join(ROOT, "tools/dev/tsession")]
N = "agtitle"
SCRATCH = f"/var/tmp/olo-agent-title-{os.getpid()}"
HOME = os.path.join(SCRATCH, "home")
BIN = os.path.join(ROOT, "target/release/olo-terminal")
COPY = os.path.join(SCRATCH, "olo-terminal")
# (Not the session's 17893.)
PORT = 17993


def ts(*a):
    return subprocess.run(TS + list(a), capture_output=True, text=True, env=dict(os.environ, TSESSION_PROFILE="release"))


def ipc(r):
    return json.loads(ts("ipc", N, json.dumps(r)).stdout or "{}")


def titles():
    return [w["title"] for w in ipc({"type": "list_windows"}).get("windows", [])]


def wait_title(want, within=5.0):
    end = time.time() + within
    while time.time() < end:
        if any(want in t for t in titles()):
            return True
        time.sleep(0.2)
    return False


# A client of the service, as an agent is: each request on a connection of
# its own. `title` sets that title (cwd: the folder given); prints the
# tool's answer.
CLIENT = r'''
import http.client, json, os, sys
port, title = int(sys.argv[1]), sys.argv[2]
def ask(i, method, params=None):
    c = http.client.HTTPConnection("127.0.0.1", port, timeout=20)
    c.request("POST", "/mcp", json.dumps({"jsonrpc": "2.0", "id": i, "method": method, "params": params or {}}), {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"})
    r = c.getresponse()
    return json.loads(r.read())
assert ask(1, "initialize", {"protocolVersion": "2025-06-18"})["result"]["serverInfo"]["name"] == "olo-terminal"
r = ask(2, "tools/call", {"name": "set_tab_title", "arguments": {"title": title, "cwd": os.getcwd()}})
print(r["result"]["content"][0]["text"])
'''


def main():
    if not os.path.exists(BIN):
        sys.exit("build first: cargo build --release -p olo-terminal")
    os.makedirs(HOME, exist_ok=True)
    subprocess.run(["cp", "--reflink=auto", BIN, COPY], check=True)
    client = os.path.join(SCRATCH, "client.py")
    open(client, "w").write(CLIENT)
    failures = []

    def check(ok, what):
        print(("  ok  " if ok else "  FAIL ") + what)
        if not ok:
            failures.append(what)

    try:
        print(ts("start", N, "1600x1000", "--home", HOME).stdout.strip())
        s = ipc({"type": "get_settings"})["settings"]
        s["terminal"]["agent_titles"] = True
        s["terminal"]["agent_context"] = True
        ipc({"type": "set_settings", "settings": s})
        ts("run", N, BIN, "-w", HOME)
        ok = False
        for _ in range(40):
            time.sleep(0.25)
            snap_path = f"{os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')}/olo-terminal-groups-{json.load(open(f'/var/tmp/olo-dev/{N}/env.json'))['WAYLAND_DISPLAY']}.json"
            if os.path.exists(snap_path) and any(t.get("cwd") == HOME for t in json.load(open(snap_path))["tabs"]):
                ok = True
                break
        check(ok, "Terminal's tab is in the agents' snapshot")

        service = subprocess.Popen([COPY, "--mcp-service"], env=dict(os.environ, OLO_TERMINAL_MCP_PORT=str(PORT)), stdin=subprocess.DEVNULL)
        time.sleep(0.5)
        check(service.poll() is None, "the service listens")

        print("Codex (outside the tab, by folder):")
        # (Reparented away from this process tree, as under Codex's daemon:
        # else the tab found would be the one this runs in.)
        out = os.path.join(SCRATCH, "codex.txt")
        subprocess.run(["bash", "-c", f"( cd {HOME} && exec {sys.executable} {client} {PORT} 'Review PR 412' > {out} 2>&1 & )"])
        check(wait_title("Review PR 412", 8), "the tab titled for an agent outside it")
        print("     ", open(out).read().strip() if os.path.exists(out) else "")

        print("Claude Code (under the tab's shell):")
        ts("type", N, f"{sys.executable} {client} {PORT} 'Fix login redirect'")
        ts("key", N, "28")
        check(wait_title("Fix login redirect", 8), "the tab titled for an agent under its shell")

        print("An upgrade (the file replaced, SIGURG):")
        shutil.copyfile(COPY, COPY + ".new")
        os.chmod(COPY + ".new", 0o755)
        os.rename(COPY + ".new", COPY)
        os.kill(service.pid, signal.SIGURG)
        time.sleep(0.5)
        exe = os.readlink(f"/proc/{service.pid}/exe")
        check(service.poll() is None and not exe.endswith("(deleted)"), f"the same process became the new file ({exe})")
        ts("type", N, f"{sys.executable} {client} {PORT} 'Write the tests'")
        ts("key", N, "28")
        check(wait_title("Write the tests", 8), "titled again by the new version")

        print("A crash (killed, started again):")
        service.kill()
        service.wait()
        service = subprocess.Popen([COPY, "--mcp-service"], env=dict(os.environ, OLO_TERMINAL_MCP_PORT=str(PORT)), stdin=subprocess.DEVNULL)
        time.sleep(0.5)
        ts("type", N, f"{sys.executable} {client} {PORT} 'Ship it'")
        ts("key", N, "28")
        check(wait_title("Ship it", 8), "titled again by the service started again")
        service.kill()
        service.wait()
    finally:
        ts("stop", N)
        shutil.rmtree(SCRATCH, ignore_errors=True)
    if failures:
        sys.exit(f"{len(failures)} failed")
    print("all as they should be")


if __name__ == "__main__":
    main()
