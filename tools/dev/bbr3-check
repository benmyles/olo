#!/usr/bin/python3
"""Olo's BBRv3 module (kernel/bbr3, tcp_bbr3) checked, in a KVM guest that
runs this computer's own kernel: nothing of the running system is
touched, and no root is needed (tools/dev/kvm-guest).

  tools/dev/bbr3-check [--quick]            the self-check; exit status 1 if it fails
  tools/dev/bbr3-check --timing             what the module's own work costs
  tools/dev/bbr3-check --compare [--reference BZIMAGE] [--against cubic,bbr] [--reps N]

The module makes, from what a congestion control is given, what Google's
BBRv3 gets from patches to TCP: the packets in flight and the packets
lost so far when each packet was sent, each lost packet, each loss a
tail probe repaired. The self-check runs a build of it that also takes
the true figures, with a probe where the patched kernel records them
(kernel/bbr3/bbr3_selfcheck.h), over links made in the guest (three
network namespaces: a sender, a router whose link on is the bottleneck
(tbf for the rate, cutting TSO packets to the wire's size; netem for the
queue and the loss), a receiver; the round trip's delay on the way
back), and says for each link how every figure looked up compared with
the true one, whether every loss TCP counted was told to the module, and
whether the tail-probe recoveries it told are the kernel's own count. It
fails unless all are the same, the module unloads at the end (nothing
left holding it), and the kernel logged no warning. The links: plain, a
shallow and a deep queue, random loss under and over BBR's 2%, slow,
fast, a long round trip, the fq qdisc, two flows, beside CUBIC, the
application holding back, bursts with gaps, small writes, a blackout (a
timeout), the rate changing, tail losses, reordering; then the accepting
side's flows, loopback, 1,200 short connections with every socket's
figures being read meanwhile (`ss`), and connections that begin with no
memory for their state.

--timing: the same build with its checks off and its own work timed by
the processor's cycle counter, per ACK, per burst sent, per loss.

--compare: the module as installed (no checks), flow by flow beside
other congestion controls on the same links, --reps (3) times each:
--against's (the stock kernel's own: cubic, and bbr, which is BBRv1),
and Google's real BBRv3 where --reference names a kernel built with its
patches (kernel/bbr3/README.md, "The real one to compare with", has how
to build one): each on its own guest.

Needs: this kernel's headers, make and the compiler (as the module's
service does), qemu-system-x86_64 with /dev/kvm, and tcp-flow
(`cargo build --release -p olo-net --example tcp-flow`).
"""

import glob
import json
import os
import re
import shutil
import statistics
import subprocess
import sys
import tempfile

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
SOURCE = os.path.join(ROOT, "kernel/bbr3")
FLOW = os.path.join(ROOT, "target/release/examples/tcp-flow")
GUEST = ["/usr/bin/python3", os.path.join(ROOT, "tools/dev/kvm-guest")]
MODULES = ["veth", "sch_netem", "sch_tbf", "sch_fq", "tcp_bbr"]

LIB = r"""
CHECK=/sys/module/tcp_bbr3/parameters/selfcheck
# net_up RATE_MBIT RTT_MS QUEUE_PACKETS LOSS_PERCENT SENDER_QDISC
net_up() {
  local rate=$1 rtt=$2 queue=$3 loss=$4 qdisc=$5
  for n in c r s; do ip netns add $n; ip -n $n link set lo up; done
  ip link add c0 netns c type veth peer name r0 netns r
  ip link add s0 netns s type veth peer name r1 netns r
  ip -n c addr add 10.0.1.2/24 dev c0; ip -n r addr add 10.0.1.1/24 dev r0
  ip -n s addr add 10.0.2.2/24 dev s0; ip -n r addr add 10.0.2.1/24 dev r1
  for d in c:c0 r:r0 r:r1 s:s0; do ip -n ${d%%:*} link set ${d##*:} up; done
  ip -n c route add default via 10.0.1.1; ip -n s route add default via 10.0.2.1
  ip netns exec r sysctl -qw net.ipv4.ip_forward=1
  ip netns exec r tc qdisc add dev r1 root handle 1: tbf rate ${rate}mbit burst 3100 limit 1000000
  if [ "$loss" = 0 ]; then ip netns exec r tc qdisc add dev r1 parent 1:1 handle 10: netem limit $queue $NETEM
  else ip netns exec r tc qdisc add dev r1 parent 1:1 handle 10: netem limit $queue loss ${loss}% $NETEM; fi
  ip netns exec r tc qdisc add dev r0 root netem delay ${rtt}ms limit 1000000
  [ "$qdisc" = none ] || ip netns exec c tc qdisc add dev c0 root $qdisc
  ip netns exec s /bin/tcp-flow sink 10.0.2.2:5001 &
  SINK=$!
  sleep 0.2
}
net_down() {
  kill $SINK 2>/dev/null; wait $SINK 2>/dev/null
  for n in c r s; do ip netns del $n; done
  sleep 0.1
}
ended() {
  sleep 0.3
  echo "D|$(ip netns exec r tc -s qdisc show dev r1 2>/dev/null | grep -A1 'qdisc netem' | grep -o 'dropped [0-9]*' | head -1 | cut -d' ' -f2)|$(ip netns exec c awk '/^TcpExt:/ { if (!h) { for (i=1;i<=NF;i++) n[i]=$i; h=1 } else { for (i=1;i<=NF;i++) if (n[i]=="TCPLossProbeRecovery") print $i } }' /proc/net/netstat 2>/dev/null)"
  [ -e $CHECK ] && sed 's/^/C|/' $CHECK
}
event() {
  local what=$1 queue=$2 loss=$3
  case $what in
    blackout) ip netns exec r tc qdisc change dev r1 parent 1:1 handle 10: netem limit $queue loss 100% ;;
    restore) if [ "$loss" = 0 ]; then ip netns exec r tc qdisc change dev r1 parent 1:1 handle 10: netem limit $queue; else ip netns exec r tc qdisc change dev r1 parent 1:1 handle 10: netem limit $queue loss ${loss}%; fi ;;
    rate=*) ip netns exec r tc qdisc change dev r1 root handle 1: tbf rate ${what#rate=}mbit burst 3100 limit 1000000 ;;
  esac
}
# run NAME RATE RTT QUEUE LOSS QDISC EVENTS tcp-flow-send-args…
run() {
  local name=$1 rate=$2 rtt=$3 queue=$4 loss=$5 qdisc=$6 events=$7; shift 7
  net_up $rate $rtt $queue $loss $qdisc
  [ -e $CHECK ] && echo 0 > $CHECK
  local pids=""
  if [ "$events" != - ]; then
    for e in $events; do ( sleep ${e%%:*}; event ${e#*:} $queue $loss ) & pids="$pids $!"; done
  fi
  echo "S|$name|$rate Mbit/s, $rtt ms, queue $queue, loss $loss%$([ $qdisc = none ] || echo ", $qdisc")"
  ip netns exec c /bin/tcp-flow send 10.0.2.2:5001 "$@" --label "$name"
  [ -n "$pids" ] && wait $pids
  ended
  net_down
}
"""

# name, rate (Mbit/s), round trip (ms), queue (packets), loss (%), the sender's qdisc, events, tcp-flow's arguments
