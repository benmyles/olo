END = r"""
dmesg | grep -E "WARNING:|BUG:|Oops|Call Trace|general protection|tcp_bbr3:" | grep -v "loading out-of-tree\|module verification" | sed 's/^/K|/'
sleep 1
if [ -e /sys/module/tcp_bbr3 ]; then rmmod tcp_bbr3 && echo "R|unloaded" || echo "R|still in use"; fi
exit 0
"""


def build(selfcheck):
    """The module built from the repository's source, in a folder of its own."""
    release = os.uname().release
    headers = f"/lib/modules/{release}/build"
    if not os.path.isfile(os.path.join(headers, "Makefile")):
        sys.exit(f"bbr3-check: this kernel's headers aren't installed (the kernel-devel package for {release})")
    work = tempfile.mkdtemp(prefix="olo-bbr3-check-", dir="/var/tmp")
    for name in ("tcp_bbr3.c", "bbr3_olo.h", "bbr3_selfcheck.h", "Kbuild"):
        shutil.copy(os.path.join(SOURCE, name), work)
    made = subprocess.run(["make", "-C", headers, f"M={work}", "modules"] + (["BBR3_SELFCHECK=y"] if selfcheck else []), capture_output=True, text=True)
    ko = os.path.join(work, "tcp_bbr3.ko")
    if made.returncode != 0 or not os.path.isfile(ko):
        shutil.rmtree(work, ignore_errors=True)
        sys.exit("bbr3-check: the module didn't build:\n" + made.stderr[-3000:])
    warnings = [l for l in made.stderr.splitlines() if "warning:" in l and "BTF" not in l]
    return work, ko, warnings


def guest(script, ko=None, kernel=None, timeout=1800):
    """`script` run in a guest; its output, and the guest's exit status."""
    with tempfile.NamedTemporaryFile("w", suffix=".sh", dir="/var/tmp", delete=False) as f:
        f.write(script)
    try:
        cmd = GUEST + ["--quiet", "--timeout", str(timeout), "--bin", FLOW]
        if kernel:
            cmd += ["--kernel", kernel]
        else:
            for m in MODULES:
                cmd += ["--module", m]
        if ko:
            cmd += ["--ko", ko]
        ran = subprocess.run(cmd + [f.name], capture_output=True, text=True)
        return ran.stdout, ran.returncode, ran.stderr
    finally:
        os.unlink(f.name)


def links(which, cc):
    return "".join(f'run "{name}" {rate} {rtt} {queue} {loss} {qdisc} "{events}" {flow.format(cc=cc)}\n' for name, rate, rtt, queue, loss, qdisc, events, flow in which)


def parse(out):
    """The guest's output as runs: {name, net, flows, extra, dropped, tlp, check, time}, and what else it said."""
    runs, cur, kernel, module = [], None, [], None
    for line in out.splitlines():
        kind, _, rest = line.partition("|")
        if kind == "S":
            name, _, net = rest.partition("|")
            cur = {"name": name, "net": net, "flows": [], "extra": None, "dropped": "", "tlp": "", "check": {}, "conns": None, "time": {}}
            runs.append(cur)
        elif line.startswith("{") and cur is not None:
            cur["flows"] = json.loads(line)["flows"]
        elif kind == "X" and cur is not None:
            cur["extra"] = rest
        elif kind == "D" and cur is not None:
            cur["dropped"], _, cur["tlp"] = rest.partition("|")
        elif kind == "C" and cur is not None:
            m = re.match(r"(sample new|sample retransmitted|lost new|lost retransmitted): lookups (\d+) unknown (\d+) no_truth (\d+) in_flight exact (\d+) within1 (\d+) within3 (\d+) more (\d+) max (\d+) lost same (\d+) wrong (\d+) max (\d+)", rest)
            if m:
                cur["check"][m[1]] = dict(zip(("lookups", "unknown", "no_truth", "exact", "within1", "within3", "more", "max", "lost_same", "lost_wrong", "lost_max"), map(int, m.groups()[1:])))
            m = re.match(r"connections (\d+) with_every_loss_told (\d+) lost_told (\d+) lost_true (\d+) tlp_recoveries_told (\d+)", rest)
            if m:
                cur["conns"] = dict(zip(("n", "all_told", "told", "true", "tlp"), map(int, m.groups())))
            m = re.match(r"time (\w+): (\d+) calls, (\d+) ns each", rest)
            if m:
                cur["time"][m[1]] = (int(m[2]), int(m[3]))
        elif kind == "K":
            kernel.append(rest)
        elif kind == "R":
            module = rest
    return runs, kernel, module


def flow_line(f):
    if "error" in f:
        return f"   {f['cc']}: {f['error']}"
    b = f.get("bbr")
    return f"   {f['cc']:6} {f['mbps']:8.2f} Mbit/s  retransmitted {f['retrans_pct']:5.2f}% ({f['total_retrans']})  timeouts {f['total_rto']}  round trip mean {f['rtt_ms_mean']:.1f}, 95th percentile {f['rtt_ms_p95']:.1f}, least {f['min_rtt_ms']:.1f} ms" + (f"  model {b['bw_mbps']:.1f} Mbit/s, {b['phase']}" if b else "")


def selfcheck(quick):
    work, ko, warnings = build(True)
    try:
        which = [l for l in LINKS + CHECKED_TOO if not quick or l[0] in QUICK]
        script = LIB + "insmod /ko/tcp_bbr3.ko || exit 1\n" + links(which, "bbr3") + ("" if quick else SPECIAL) + END
        out, status, console = guest(script, ko)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    runs, kernel, module = parse(out)
    wrong = [f"the build warned: {w}" for w in warnings]
    if status != 0:
        wrong.append(f"the guest ended {status}")
        sys.stderr.write(console[-4000:])
    compared = 0
    for r in runs:
        print(f"\n== {r['name']}: {r['net']}" + (f"; the bottleneck dropped {r['dropped']}" if r["dropped"] else ""))
        if r["extra"]:
            print("   " + r["extra"])
        for f in r["flows"]:
            print(flow_line(f))
            if "error" in f:
                wrong.append(f"{r['name']}: a flow failed: {f['error']}")
        for what, c in r["check"].items():
            if not c["lookups"]:
                continue
            n = c["lookups"] - c["unknown"] - c["no_truth"]
            compared += n
            print(f"   {what:21}: {c['lookups']:7} looked up, {c['unknown']} not known, {n} compared: in flight the same {c['exact']}, within 1 {c['within1']}, within 3 {c['within3']}, further {c['more']}; lost so far the same {c['lost_same']}, not {c['lost_wrong']}")
            if c["exact"] != n or c["lost_same"] != n:
                wrong.append(f"{r['name']}: {what}: {n - c['exact']} of {n} in-flight figures and {c['lost_wrong']} lost-so-far figures weren't the true ones (furthest {c['max']} and {c['lost_max']})")
            # (Not known: only what was sent before a connection had its
            # state, or a retransmission cut again since. A link where most
            # isn't known is one where the log isn't working.)
            if c["unknown"] * 20 > c["lookups"] and "no memory" not in r["name"]:
                wrong.append(f"{r['name']}: {what}: {c['unknown']} of {c['lookups']} not known")
        c = r["conns"]
        if c:
            print(f"   connections {c['n']}: every loss told in {c['all_told']} ({c['told']} told, TCP counted {c['true']}); tail-probe recoveries told {c['tlp']}" + (f", the kernel's count {r['tlp']}" if r["tlp"] else ""))
            if c["all_told"] != c["n"] or c["told"] != c["true"]:
                wrong.append(f"{r['name']}: {c['told']} losses told, TCP counted {c['true']}")
            if r["tlp"] and int(r["tlp"]) != c["tlp"] and r["name"] not in ("accepted connections",):
                wrong.append(f"{r['name']}: {c['tlp']} tail-probe recoveries told, the kernel counted {r['tlp']}")
    for k in kernel:
        print("kernel:", k)
        wrong.append(f"the kernel logged: {k}")
    if module != "unloaded":
        wrong.append(f"the module didn't unload at the end ({module})")
    expected = len(which) + (0 if quick else 6)
    if len(runs) != expected:
        wrong.append(f"{len(runs)} of {expected} links ran")
    told = [r for r in runs if r["name"] == "tail losses"]
    if told and (not told[0]["conns"] or told[0]["conns"]["tlp"] == 0):
        wrong.append("tail losses: no tail-probe recovery happened to check (run it again)")
    print(f"\n{compared} figures compared with the true ones over {len(runs)} links; the module {module}")
    for w in wrong:
        print("NOT SO:", w)
    print("BBRv3's module is as it should be" if not wrong else f"{len(wrong)} wrong")
    return 1 if wrong else 0


def timing():
    work, ko, _ = build(True)
    try:
        which = [l for l in LINKS if l[0] in ("plain", "loss 1%", "fast", "fq")]
        loop = '/bin/tcp-flow sink 127.0.0.1:5003 & LS=$!; sleep 0.2\necho 0 > $CHECK\necho "S|loopback|as fast as it goes"\n/bin/tcp-flow send 127.0.0.1:5003 --cc bbr3 --secs 3 --label loopback\nkill $LS; wait $LS 2>/dev/null\nended\n'
        out, status, console = guest(LIB + "insmod /ko/tcp_bbr3.ko timing=1 || exit 1\n" + links(which, "bbr3") + loop + END, ko)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    if status != 0:
        sys.stderr.write(console[-4000:])
    names = {"ack": "an ACK, all of it", "ack_bbr_main": "  of which BBR's own", "ack_begins": "an ACK begins", "burst": "a burst of sending begins", "lost": "a lost packet", "retransmission": "a retransmission"}
    for r in parse(out)[0]:
        print(f"\n== {r['name']}: {r['net']}")
        for f in r["flows"]:
            print(flow_line(f))
            secs = f.get("secs", 1)
        for key, label in names.items():
            if key in r["time"]:
                n, ns = r["time"][key]
                print(f"   {label:26} {ns:5} ns, {n / secs:9.0f} a second")
        t = r["time"]
        if "ack" in t:
            total = sum(n * ns for k, (n, ns) in t.items() if k != "ack_bbr_main")
            print(f"   in all {total / secs / 1e6:.2f} ms of a second ({total / secs / 1e7:.3f}% of a core), {(total - t['ack_bbr_main'][0] * t['ack_bbr_main'][1]) / secs / 1e6:.2f} ms of it Olo's side")
    return status


def compare(reference, against, reps):
    work, ko, _ = build(False)
    out_dir = tempfile.mkdtemp(prefix="olo-bbr3-compare-", dir="/var/tmp")
    try:
        sets = [("bbr3 (Olo's module)", "bbr3", ko, None)]
        if reference:
            sets.append(("bbr (BBRv3, Google's kernel)", "bbr", None, reference))
        sets += [(f"{cc} (this kernel's)", cc, None, None) for cc in against]
        results = {label: {} for label, *_ in sets}
        for rep in range(reps):
            procs = []
            for label, cc, module, kernel in sets:
                script = LIB + ("insmod /ko/tcp_bbr3.ko || exit 1\n" if module else "") + links(LINKS, cc) + "exit 0\n"
                path = os.path.join(out_dir, f"{cc}-{'ref' if kernel else 'stock'}-{rep}.sh")
                open(path, "w").write(script)
                cmd = GUEST + ["--quiet", "--timeout", "1800", "--bin", FLOW]
                cmd += ["--kernel", kernel] if kernel else [a for m in MODULES for a in ("--module", m)]
                cmd += ["--ko", module] if module else []
                procs.append((label, subprocess.Popen(cmd + [path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)))
            for label, p in procs:
                out = p.communicate()[0]
                for r in parse(out)[0]:
                    results[label].setdefault(r["name"], []).append(r["flows"])
            print(f"run {rep + 1} of {reps} done", file=sys.stderr)
    finally:
        shutil.rmtree(work, ignore_errors=True)
        shutil.rmtree(out_dir, ignore_errors=True)

    def cell(vals, fmt):
        if not vals:
            return "-"
        return (fmt % statistics.mean(vals)) + (" ±" + (fmt % statistics.pstdev(vals)).strip() if len(vals) > 1 else "")

    print(f"{'link':28} {'flow':30} | {'Mbit/s':>15} | {'retransmitted %':>15} | {'round trip, mean ms':>19} | {'95th percentile':>15}")
    for name, rate, rtt, queue, loss, qdisc, events, flow in LINKS:
        net = f"{rate} Mbit/s, {rtt} ms, queue {queue}" + (f", loss {loss}%" if loss else "")
        print(f"\n{name}: {net}")
        flows = max((len(r[0]) for label in results for r in [results[label].get(name, [[]])]), default=0)
        for i in range(flows):
            for label, cc, *_ in sets:
                fl = [r[i] for r in results[label].get(name, []) if i < len(r) and "error" not in r[i]]
                who = label if i == 0 or fl and fl[0]["cc"] == cc else f"  cubic beside {cc}"
                print(f"{'':28} {who:30} | " + " | ".join([f"{cell([f['mbps'] for f in fl], '%.2f'):>15}", f"{cell([f['retrans_pct'] for f in fl], '%.2f'):>15}", f"{cell([f['rtt_ms_mean'] for f in fl], '%.1f'):>19}", f"{cell([f['rtt_ms_p95'] for f in fl], '%.1f'):>15}"]))
    return 0


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__)
        return 0
    if not os.path.isfile(FLOW):
        sys.exit("bbr3-check: build tcp-flow first (cargo build --release -p olo-net --example tcp-flow)")
    opt = lambda flag, default: args[args.index(flag) + 1] if flag in args else default
    if "--timing" in args:
        return timing()
    if "--compare" in args:
        reference = opt("--reference", None)
        if reference and not os.path.isfile(reference):
            sys.exit(f"bbr3-check: no kernel at {reference}")
        return compare(reference, [c for c in opt("--against", "cubic,bbr").split(",") if c], int(opt("--reps", 3)))
    return selfcheck("--quick" in args)


if __name__ == "__main__":
    sys.exit(main())
