    ("small writes", 50, 40, 170, 1, "none", "-", "--cc {cc} --secs 8 --chunk 300 --nodelay --rate 5"),
    ("blackout", 50, 40, 170, 0, "none", "3:blackout 4.5:restore", "--cc {cc} --secs 9"),
