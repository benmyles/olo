#!/usr/bin/python3
"""Sweep: remove the build artifacts no recent build used, so target/
stays about one build's size instead of growing with every edit.

  tools/dev/sweep [--days N] [--wait SECONDS] [--dry-run] [--install] [DIR...]

Cargo never deletes anything: each edit, flag or dependency change
leaves the previous crate's rlib, binary and incremental state behind
under a new hash, and this workspace's target/ reached 435 GB that way
(2026-11-01). Each profile directory (target/debug, target/release, a
custom profile, target/<triple>/<profile>) keeps a fingerprint for every
unit it built (.fingerprint/<unit>-<hash>/). A unit is last used when a
build last considered it: cargo reads its fingerprint's files then
(lib-NAME, dep-lib-NAME, output-lib-NAME), whether or not it recompiles
it, so their access time moves on (at least once a day, `relatime`);
invoked.timestamp is written only when it's compiled. (Taken for the
other, the stamp left every crate from outside the workspace, compiled
once and fresh ever since, looking unused after two days: 4,284 live
release units went at 00:37 on 2026-11-18, under a build that then
failed to link. On a `noatime` mount the stamp is all there is.) A unit
last used more than --days (2) ago is one no build has wanted since; its
fingerprint, and everything in deps/, build/, examples/ and incremental/
named with its hash, go. Outputs without a hash
(target/release/olo-deskcalc, lib*.rlib) are the uplifted copies, hard
links of the live units, and stay.

Cargo 1.100's layout keeps each unit in a folder of its own instead,
build/<package>/<hash>/ (its fingerprint/, its out/, a build script's
run/): the old sweep didn't see those, and target/ grew to 564 GB
(2026-11-15). A unit is swept the same way in either layout: stale when
its stamp is older than --days, or when it was built by another compiler
and last used before the compiler that builds here now first did (each
fingerprint names its compiler: after a toolchain change, nothing the
old one built is used again, however recent; Ben, 2026-11-15: "clean up
the old builds too to recover the disk space"). A unit still being
built (no stamp, no fingerprint yet) is judged by its folder's age.

With no DIR it sweeps this workspace's target directory (or
$CARGO_TARGET_DIR) and its rust-analyzer one. A directory is only swept
when it has cargo's CACHEDIR.TAG, so nothing else can be hit by a typo.
A profile is only swept holding its build locks (.cargo-lock,
.cargo-build-lock, .cargo-artifact-lock: a build holds them while it
runs), so never under a build; one held for half an hour (--wait) is
left for the next sweep, and said so.

--install puts a timer in the person's systemd (user) that runs this
sweep every day; tools/setup.sh does the same. --dry-run only reports.
"""
import argparse, fcntl, json, os, re, shutil, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
HASHED = re.compile(r"^(?:lib)?(.+?)-([0-9a-f]{16})(?:[.-].*)?$")
# What cargo writes under a profile directory, named by the unit's hash.
HASHED_DIRS = ("deps", "build", "examples", "incremental")
# A unit's own folder in cargo's new layout: build/<package>/<hash>/.
NEW_UNIT = re.compile(r"^[0-9a-f]{16}$")


def unit_hash(name):
    """The 16-hex unit hash in an artifact's name, or None."""
    m = HASHED.match(name)
    return m.group(2) if m else None


def size_of(path):
    """Bytes a file or tree frees once removed (a hard link's other names keep theirs)."""
    try:
        st = os.lstat(path)
    except OSError:
        return 0
    if not os.path.isdir(path) or os.path.islink(path):
        return st.st_size if st.st_nlink <= 1 else 0
    total = 0
    for dirpath, _, files in os.walk(path):
        for f in files:
            try:
                s = os.lstat(os.path.join(dirpath, f))
            except OSError:
                continue
            if s.st_nlink <= 1:
                total += s.st_size
    return total


def profile_dirs(target):
    """Every profile directory under TARGET (profiles, and triples'
    profiles): one with an old-layout .fingerprint or a build/."""
    found = []

    def is_profile(path):
        return os.path.isdir(os.path.join(path, ".fingerprint")) or os.path.isdir(os.path.join(path, "build"))

    for depth1 in sorted(os.scandir(target), key=lambda e: e.name):
        if not depth1.is_dir(follow_symlinks=False):
            continue
        if is_profile(depth1.path):
            found.append(depth1.path)
            continue
        try:
            for depth2 in os.scandir(depth1.path):
                if depth2.is_dir(follow_symlinks=False) and is_profile(depth2.path):
                    found.append(depth2.path)
        except OSError:
            pass
    return found


class Unit:
    """A unit cargo built: its hash, when a build last wanted it (`used`),
    the compiler that built it (None: not known yet), and what's its."""

    def __init__(self, h, stamp, rustc, made, paths):
        self.hash, self.stamp, self.rustc, self.made, self.paths = h, stamp, rustc, made, paths


def fingerprint_of(fp_dir, fallback):
    """(when a build last used it, compiler, when its fingerprint was
    written) of a unit's fingerprint folder: the later of its stamp
    (invoked.timestamp, written when it's compiled; `fallback`'s mtime if
    it has none) and when cargo last read its fingerprint's own files
    (lib-NAME, dep-lib-NAME, output-lib-NAME: read by every build that
    considers it). Not the .json's reading: this sweep reads that."""
    try:
        stamp = os.stat(os.path.join(fp_dir, "invoked.timestamp")).st_mtime
    except OSError:
        try:
            stamp = os.stat(fallback).st_mtime
        except OSError:
            stamp = 0.0
    try:
        for e in os.scandir(fp_dir):
            if e.name != "invoked.timestamp" and not e.name.endswith(".json"):
                try:
                    stamp = max(stamp, e.stat(follow_symlinks=False).st_atime)
                except OSError:
                    pass
    except OSError:
        pass
    rustc, made = None, 0.0
    try:
        for e in os.scandir(fp_dir):
            if e.name.endswith(".json"):
                try:
                    with open(e.path) as f:
                        rustc = json.load(f).get("rustc")
                    made = e.stat().st_mtime
                except (OSError, ValueError):
                    pass
                break
    except OSError:
        pass
    return stamp, rustc, made


def units_of(profile):
    """Every unit of PROFILE, by its hash: the old layout's
    (.fingerprint/<name>-<hash>, its files named with the hash in deps/,
    build/, examples/, incremental/) and the new one's
    (build/<package>/<hash>/, all of it in the one folder)."""
    units = {}
    fingerprints = os.path.join(profile, ".fingerprint")
    if os.path.isdir(fingerprints):
        for entry in os.scandir(fingerprints):
            h = unit_hash(entry.name)
            if h is None or not entry.is_dir(follow_symlinks=False):
                continue
            stamp, rustc, made = fingerprint_of(entry.path, entry.path)
            u = units.get(h)
            # (A hash with several fingerprints: the one used last speaks.)
            if u is None or stamp > u.stamp:
                units[h] = Unit(h, stamp, rustc, made, u.paths if u else [])
            units[h].paths.append(entry.path)
        for sub in HASHED_DIRS:
            d = os.path.join(profile, sub)
            if not os.path.isdir(d):
                continue
            for entry in os.scandir(d):
                h = unit_hash(entry.name)
                if h in units:
                    units[h].paths.append(entry.path)
    build = os.path.join(profile, "build")
    if os.path.isdir(build):
        for package in os.scandir(build):
            # (Old-layout names here are "<name>-<hash>", above.)
            if not package.is_dir(follow_symlinks=False) or unit_hash(package.name):
                continue
            for entry in os.scandir(package.path):
                if not NEW_UNIT.match(entry.name) or not entry.is_dir(follow_symlinks=False):
                    continue
                stamp, rustc, made = fingerprint_of(os.path.join(entry.path, "fingerprint"), entry.path)
                key = (package.name, entry.name)
                units[key] = Unit(entry.name, stamp, rustc, made, [entry.path])
    return units


def current_compiler(units):
    """The compiler building here now (the newest fingerprint's), and when
    it first did (the earliest fingerprint it wrote)."""
    newest = max((u for u in units if u.rustc is not None), key=lambda u: u.made, default=None)
    if newest is None:
        return None, 0.0
    first = min(u.made for u in units if u.rustc == newest.rustc)
    return newest.rustc, first


def stale_units(units, cutoff, rustc, since):
    """The units no build wants: unused since CUTOFF, or built by another
    compiler than RUSTC and last used before it first built here (SINCE).
    A hash any live unit has stays."""
    stale = [u for u in units.values() if u.stamp < cutoff or (rustc is not None and u.rustc is not None and u.rustc != rustc and u.stamp < since)]
    live = {u.hash for u in units.values()} - {u.hash for u in stale}
    # (The old layout: a hash still live anywhere keeps its files.)
    return [u for u in stale if u.hash not in live]


def sweep_profile(units, cutoff, dry_run, compiler):
    """Removes those of a profile's UNITS no build wants; returns (units,
    bytes)."""
    rustc, since = compiler
    stale = stale_units(units, cutoff, rustc, since)
    freed = 0
    for u in stale:
        for path in u.paths:
            freed += size_of(path)
            if dry_run:
                continue
            try:
                if os.path.isdir(path) and not os.path.islink(path):
                    shutil.rmtree(path)
                else:
                    os.remove(path)
            except FileNotFoundError:
                pass
            except OSError as e:
                print(f"sweep: {path}: {e}", file=sys.stderr)
    return len(stale), freed


LOCKS = (".cargo-lock", ".cargo-build-lock", ".cargo-artifact-lock")


def locked(profile, wait):
    """PROFILE's build locks, all of them held (open files, to close when
    done), else None once `wait` seconds have gone by with a build holding
    one. Each taken without waiting, all or none, and tried again every
    10 s: never stuck behind cargo, and cargo never behind half of them."""
    deadline = time.monotonic() + wait
    while True:
        held = []
        try:
            for name in LOCKS:
                path = os.path.join(profile, name)
                if not os.path.exists(path):
                    continue
                f = open(path, "a")
                held.append(f)
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return held
        except BlockingIOError:
            for f in held:
                f.close()
        if time.monotonic() >= deadline:
            return None
        time.sleep(min(10.0, max(0.0, deadline - time.monotonic())))


def sweep(target, days, dry_run, wait=1800):
    if not os.path.isfile(os.path.join(target, "CACHEDIR.TAG")):
        print(f"sweep: {target}: not a cargo target directory (no CACHEDIR.TAG); left alone", file=sys.stderr)
        return 0
    cutoff = time.time() - days * 86400
    profiles = profile_dirs(target)
    # The compiler building here now, from every profile's units: a
    # profile not yet built by it (debug, after a release build) still has
    # what the old one built swept.
    found = {p: units_of(p) for p in profiles}
    compiler = current_compiler([u for units in found.values() for u in units.values()])
    total = 0
    for profile in profiles:
        # (Never under a build: its locks held while this profile is swept,
        # what's in it read again then.)
        held = [] if dry_run else locked(profile, wait)
        if held is None:
            print(f"sweep: {os.path.relpath(profile)}: a build has held it for {int(wait // 60)} minutes; left for the next sweep", file=sys.stderr)
            continue
        try:
            units, freed = sweep_profile(units_of(profile), cutoff, dry_run, compiler)
        finally:
            for f in held:
                f.close()
        total += freed
        if units:
            verb = "would free" if dry_run else "freed"
            print(f"{os.path.relpath(profile)}: {units} units unused for {days} days or built by another compiler, {verb} {freed / 1e9:.1f} GB")
    return total


def install_timer():
    """A daily sweep of this workspace from the person's systemd (user)."""
    unit_dir = os.path.expanduser("~/.config/systemd/user")
    os.makedirs(unit_dir, exist_ok=True)
    me = os.path.abspath(__file__)
    with open(os.path.join(unit_dir, "olo-sweep.service"), "w") as f:
        f.write(f"""[Unit]
Description=Sweep Olo's build directory of artifacts no recent build used

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 {me}
""")
    with open(os.path.join(unit_dir, "olo-sweep.timer"), "w") as f:
        f.write("""[Unit]
Description=Daily sweep of Olo's build directory

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
""")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "olo-sweep.timer"], check=True)
    print("olo-sweep.timer: a daily sweep of", os.path.join(ROOT, "target"))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--days", type=float, default=2, help="keep units a build used within this many days (2)")
    ap.add_argument("--wait", type=float, default=1800, help="seconds to wait for a build holding a profile's locks (1800)")
    ap.add_argument("--dry-run", "-n", action="store_true", help="report, remove nothing")
    ap.add_argument("--install", action="store_true", help="put a daily sweep in systemd (user)")
    ap.add_argument("dirs", nargs="*", help="target directories (default: this workspace's)")
    args = ap.parse_args()
    if args.install:
        install_timer()
        return
    dirs = args.dirs or [
        os.environ.get("CARGO_TARGET_DIR") or os.path.join(ROOT, "target"),
        os.path.join(ROOT, "target", "rust-analyzer"),
    ]
    total = 0
    for d in dirs:
        if os.path.isdir(d):
            total += sweep(d, args.days, args.dry_run, args.wait)
    print(f"{'would free' if args.dry_run else 'freed'} {total / 1e9:.1f} GB in all")


if __name__ == "__main__":
    main()
