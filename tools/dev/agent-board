#!/usr/bin/python3
"""Live standup & goal board in a Rex split pane to the right of a subagent.

Opens a right-hand Rex split pane (`rex split --split=right --focus=false`)
running an inotify + signal-wakeup-pipe renderer (0% CPU at rest, instant
redraw on update or terminal resize, clean exit on SIGTERM/SIGHUP). Agents
initialize it once with a plain-English 1-2 paragraph goal + initial standup
and todo list, then call `update` supplying ONLY the fields that changed.

  agent-board init [--open] [--file PATH] --title TITLE --goal TEXT [...]
  agent-board update [--open] [--file PATH] [--status S] [--phase P]
                     [--progress 0..100] [--goal TEXT]
                     [--did TEXT ...] [--now TEXT] [--next TEXT ...]
                     [--add-todo TEXT ...] [--start-todo MATCH ...]
                     [--check-todo MATCH ...] [--block-todo MATCH ...]
                     [--drop-todo MATCH ...] [--set-todos ITEM ...]
                     [--note TEXT | --clear-note]
  agent-board open [--file PATH] [--block BLOCK] [--ratio 38]
  agent-board show PATH
  agent-board preview [--file PATH] [--width 64] [--height 0]
  agent-board path
"""
