def clean_text(s, keep_newlines=False):
    """Strip ANSI escape sequences, control characters, and unpaired UTF-16
    surrogates from user text."""
    t = str(s or "").encode("utf-8", "replace").decode("utf-8")
    t = ANSI_RE.sub("", t)
    t = t.replace("\r\n", "\n").replace("\r", "\n")
    if not keep_newlines:
        t = t.replace("\n", " ")
    t = t.replace("\t", " ")
    return CTRL_RE.sub("", t)


def char_width(ch):
    cat = unicodedata.category(ch)
    if cat in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def vis_len(s):
    return sum(char_width(ch) for ch in ANSI_RE.sub("", s))


def truncate_plain(s, max_cols):
    """Truncate plain (non-ANSI) text to fit within `max_cols` display cells."""
    if max_cols <= 0:
        return ""
    if vis_len(s) <= max_cols:
        return s
    if max_cols == 1:
        return "…"
    out, w = [], 0
    for ch in s:
        cw = char_width(ch)
        if w + cw > max_cols - 1:
            break
        out.append(ch)
        w += cw
    return "".join(out) + "…"


def pad_vis(s, width):
    gap = width - vis_len(s)
    return s + (" " * max(0, gap))


def _inside(path, root):
    rp = os.path.realpath(path)
    rr = os.path.realpath(root)
    return rp == rr or rp.startswith(rr + os.sep)


def _agents_home():
    return os.environ.get("OLO_AGENTS_DIR") or AGENTS_HOME


def _raw_caller_marker():
    return os.environ.get("OLO_SUBAGENT") or os.environ.get("OLO_MINDER")


def _caller_identity():
    who = _raw_caller_marker()
    if who and re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", who):
        return who
    return None


def default_path():
    home = _agents_home()
    raw_who = _raw_caller_marker()
    who = _caller_identity()
    if raw_who and not who:
        sys.exit(f"agent-board: invalid caller identity marker ({raw_who!r})")
    if who:
        return os.path.join(home, who, "board.json")
    return os.path.join(home, "board.json")


def _open_verified_parent_dirfd(path, create=False):
    """Walk from `/var/tmp` to `os.path.dirname(path)` component-by-component
    with `O_DIRECTORY | O_NOFOLLOW` so a symlink parent swap cannot redirect
    lock, temp-file, or rename operations outside the verified directory."""
    var_tmp = os.path.realpath("/var/tmp")
    parent = os.path.dirname(os.path.abspath(path))
    if not (parent == var_tmp or parent.startswith(var_tmp + os.sep)):
        sys.exit(f"agent-board: parent directory must live under /var/tmp (refused {parent})")
    rel = os.path.relpath(parent, var_tmp)
    parts = [] if rel == "." else rel.split(os.sep)
    dir_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        cur = os.open(var_tmp, dir_flags)
    except OSError as e:
        sys.exit(f"agent-board: cannot open /var/tmp: {e}")
    try:
        for seg in parts:
            if not seg or seg in (".", ".."):
                sys.exit(f"agent-board: invalid path component in {parent}")
            try:
                nxt = os.open(seg, dir_flags, dir_fd=cur)
            except FileNotFoundError:
                if not create:
                    raise
                try:
                    os.mkdir(seg, 0o755, dir_fd=cur)
                except FileExistsError:
                    pass
                nxt = os.open(seg, dir_flags, dir_fd=cur)
            os.close(cur)
            cur = nxt
        return cur
    except BaseException:
        with contextlib.suppress(OSError):
            os.close(cur)
        raise


def safe_path(path, for_write=False):
    """Allowlist board paths strictly under `/var/tmp` (never `/tmp`, never
    inside `REPO_ROOT`, never inside `<agents_home>/.meta`). When invoked by
    a subagent or minder for mutation (`for_write=True`), fail closed on
    invalid caller markers and confine writes strictly inside that agent's
    own folder under `<agents_home>/<name>` (without symlink components)."""
    p = os.path.abspath(path or default_path())
    rp = os.path.realpath(p)
    if os.path.islink(p):
        sys.exit(f"agent-board: refusing symlink board path ({p})")
    if os.path.isdir(p) or os.path.isdir(rp):
        sys.exit(f"agent-board: {p} is a directory; pass a file path like /var/tmp/olo-agents/<name>/board.json")
    if _inside(rp, REPO_ROOT):
        sys.exit(f"agent-board: refusing to write board inside repository ({p}); use /var/tmp/olo-agents/<name>/board.json")
    var_tmp = os.path.realpath("/var/tmp")
    if not (rp.startswith(var_tmp + os.sep) and p.startswith("/var/tmp" + os.sep)):
        sys.exit(f"agent-board: board path must live under /var/tmp (refused {p})")
    meta_dir = os.path.join(_agents_home(), ".meta")
    if _inside(rp, meta_dir):
        sys.exit(f"agent-board: refusing protected metadata path ({p})")
    # Reject any existing symlink component along the path under /var/tmp.
    probe = var_tmp
    for seg in os.path.relpath(p, var_tmp).split(os.sep):
        probe = os.path.join(probe, seg)
        if os.path.islink(probe):
            sys.exit(f"agent-board: refusing symlink component in board path ({probe})")
    if for_write:
        raw_who = _raw_caller_marker()
        who = _caller_identity()
        if raw_who and not who:
            sys.exit(f"agent-board: invalid caller identity marker ({raw_who!r}); refusing mutation")
        if who:
            agents_root = os.path.realpath(_agents_home())
            own_raw = os.path.join(agents_root, who)
            if os.path.islink(own_raw):
                sys.exit(f"agent-board: refusing symlink agent directory ({own_raw})")
            own_dir = os.path.realpath(own_raw)
            if not rp.startswith(own_dir + os.sep):
                sys.exit(f"agent-board: subagent `{who}` may only write its own board under {own_dir} (refused {p})")
    return p


@contextlib.contextmanager
def board_lock(path, timeout=LOCK_TIMEOUT_SECS, suffix=".lock"):
    """Acquire an exclusive lock on `<name><suffix>` inside the verified
    parent directory descriptor without truncating or following symlinks."""
    dfd = _open_verified_parent_dirfd(path, create=True)
    lock_name = f"{os.path.basename(path)}{suffix}"
    flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        try:
            fd = os.open(lock_name, flags, 0o600, dir_fd=dfd)
        except OSError as e:
            sys.exit(f"agent-board: cannot open lock {path}{suffix}: {e}")
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                sys.exit(f"agent-board: lock path {path}{suffix} is not a regular file")
            deadline = time.monotonic() + timeout
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        sys.exit(f"agent-board: timed out after {timeout:.0f}s waiting for lock on {path}")
                    time.sleep(0.05)
            yield dfd
        finally:
            with contextlib.suppress(OSError):
                fcntl.flock(fd, fcntl.LOCK_UN)
            with contextlib.suppress(OSError):
                os.close(fd)
    finally:
        with contextlib.suppress(OSError):
            os.close(dfd)


def default_board_data():
    who = _caller_identity() or "agent"
    is_minder = bool(os.environ.get("OLO_MINDER")) and not bool(os.environ.get("OLO_SUBAGENT"))
    return {
        "title": who,
        "role": "Minder" if is_minder else "Builder",
        "crate": "",
        "status": "working",
        "phase": "",
        "progress": None,
        "goal": "",
        "did": [],
        "now": "",
        "next": [],
        "todos": [],
        "note": "",
        "updated_at": time.strftime("%H:%M:%S UTC", time.gmtime()),
        "updates": 0,
    }


def _finite_pct(val):
    if isinstance(val, bool) or not isinstance(val, (int, float)):
        return None
    if isinstance(val, float) and not math.isfinite(val):
        return None
    return max(0, min(100, int(val)))


def normalize_board(raw):
    """Coerce a parsed board dict into safe renderer/updater types so
    malformed external edits never crash `update` or kill `show()`."""
    base = default_board_data()
    if not isinstance(raw, dict):
        return base
    for k in ("title", "role", "crate", "status", "phase", "goal", "now", "note", "updated_at"):
        v = raw.get(k)
        if v is not None:
            base[k] = clean_text(v, keep_newlines=(k in ("goal", "now", "note")))
    if base["status"].lower() not in STATUS_META:
        base["status"] = "working"
    else:
        base["status"] = base["status"].lower()
    base["progress"] = _finite_pct(raw.get("progress"))
    upd = raw.get("updates")
    base["updates"] = int(upd) if isinstance(upd, int) and not isinstance(upd, bool) and upd >= 0 else 0

    did_raw = raw.get("did")
    if isinstance(did_raw, list):
        did_out = []
        for entry in did_raw[-MAX_DID:]:
            if isinstance(entry, dict):
                txt = clean_text(entry.get("text") or "").strip()
                ts = truncate_plain(clean_text(entry.get("at") or "").strip(), 12)
                if txt:
                    did_out.append({"at": ts, "text": txt})
            elif entry is not None:
                txt = clean_text(entry).strip()
                if txt:
                    did_out.append({"at": "", "text": txt})
        base["did"] = did_out

    nxt_raw = raw.get("next")
    if isinstance(nxt_raw, list):
        base["next"] = [clean_text(x).strip() for x in nxt_raw if x is not None and clean_text(x).strip()]

    todos_raw = raw.get("todos")
    if isinstance(todos_raw, list):
        todos_out = []
        for t in todos_raw:
            if isinstance(t, dict):
                st = str(t.get("state") or "todo").lower()
                if st not in ("todo", "now", "done", "blocked"):
                    st = "todo"
                txt = clean_text(t.get("text") or "").strip()
                if txt:
                    todos_out.append({"state": st, "text": txt})
            elif isinstance(t, str):
                parsed = parse_todo_str(t)
                if parsed is not None:
                    todos_out.append(parsed)
        base["todos"] = todos_out
    return base


def _reject_nonfinite_json(tok):
    raise ValueError(f"non-finite JSON constant: {tok}")


def read_regular_json(path, max_bytes=MAX_BOARD_BYTES, dir_fd=None):
    """Read and parse a regular, non-symlink JSON file with O_NONBLOCK so a
    FIFO or oversized file can never hang or exhaust memory. Returns
    `(exists, obj, err_str)`."""
    flags = os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    target = os.path.basename(path) if dir_fd is not None else path
    try:
        fd = os.open(target, flags, dir_fd=dir_fd)
    except FileNotFoundError:
        return False, None, None
    except OSError as e:
        return True, None, str(e)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return True, None, f"{path} is not a regular file"
        chunks, total = [], 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                return True, None, f"{path} exceeds {max_bytes} byte board limit"
            chunks.append(chunk)
    except OSError as e:
        return True, None, str(e)
    finally:
        with contextlib.suppress(OSError):
            os.close(fd)
    try:
        obj = json.loads(b"".join(chunks).decode("utf-8"), parse_constant=_reject_nonfinite_json)
    except (UnicodeDecodeError, ValueError) as e:
        return True, None, f"invalid JSON in {path}: {e}"
    if not isinstance(obj, dict):
        return True, None, f"{path} does not contain a JSON object"
    return True, obj, None


def load_board_raw(path, strict=False, dir_fd=None):
    exists, obj, err = read_regular_json(path, dir_fd=dir_fd)
    if not exists:
        return None
    if err is not None:
        if strict:
            sys.exit(f"agent-board: refusing to overwrite corrupt/unreadable board ({err}); fix or re-run `init`")
        return None
    return obj


def load_board(path, strict=False, dir_fd=None):
    exists, obj, err = read_regular_json(path, dir_fd=dir_fd)
    if not exists:
        return default_board_data()
    if err is not None:
        if strict:
            sys.exit(f"agent-board: refusing to overwrite corrupt/unreadable board ({err}); fix or re-run `init`")
        fallback = default_board_data()
        fallback["status"] = "blocked"
        fallback["now"] = f"Board unreadable: {err}"
        return fallback
    return normalize_board(obj)


def save_json_atomic(path, data, dir_fd=None):
    owned_dfd = None
    if dir_fd is None:
        owned_dfd = _open_verified_parent_dirfd(path, create=True)
        dir_fd = owned_dfd
    try:
        name = os.path.basename(path)
        try:
            st = os.lstat(name, dir_fd=dir_fd)
            if stat.S_ISLNK(st.st_mode):
                sys.exit(f"agent-board: refusing to replace symlink ({path})")
        except FileNotFoundError:
            pass
        payload = (json.dumps(data, indent=2, allow_nan=False) + "\n").encode("utf-8")
        if len(payload) > MAX_BOARD_BYTES:
            sys.exit(f"agent-board: serialized board exceeds {MAX_BOARD_BYTES} byte limit")
        tmp_name = f"{name}.tmp.{os.getpid()}.{secrets.token_hex(4)}"
        fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), 0o600, dir_fd=dir_fd)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(payload)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp_name, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        except BaseException:
            with contextlib.suppress(OSError):
                os.unlink(tmp_name, dir_fd=dir_fd)
            raise
    finally:
        if owned_dfd is not None:
            with contextlib.suppress(OSError):
                os.close(owned_dfd)


def parse_todo_str(raw):
    s = clean_text(raw).strip()
    for prefix, st in (("[x]", "done"), ("[X]", "done"), ("[>]", "now"), ("[!]", "blocked"), ("[ ]", "todo")):
        if s.startswith(prefix):
            text = s[3:].strip()
            return {"state": st, "text": text} if text else None
    return {"state": "todo", "text": s} if s else None


def match_todo(todos, needle):
    """Match a todo by strict 1-based ASCII integer index or case-insensitive
    substring. Out-of-range numeric indices never fall through to substring."""
    q = clean_text(needle).strip()
    if not q:
        return None
    if q.isascii() and q.isdigit():
        idx = int(q) - 1
        return idx if 0 <= idx < len(todos) else None
    low = q.lower()
    for i, t in enumerate(todos):
        if low == t["text"].lower():
            return i
    for i, t in enumerate(todos):
        if low in t["text"].lower():
            return i
    return None


def compute_progress(data):
    todos = data.get("todos") or []
    done = sum(1 for t in todos if t.get("state") == "done")
    active = sum(1 for t in todos if t.get("state") == "now")
    total = len(todos)
    explicit = _finite_pct(data.get("progress"))
    if explicit is not None:
        pct = explicit
    elif total > 0:
        pct = int(round((done + 0.35 * active) * 100.0 / total))
        if done == total:
            pct = 100
        elif pct == 100:
            pct = 99
    elif data.get("status") == "done":
        pct = 100
    else:
        pct = 0
    return pct, done, active, total


def progress_bar(pct, done, active, total, max_width, explicit=False):
    """Render a 2-tone progress bar guaranteed to fit within `max_width` cells.
    Respects explicit `--progress` overrides consistently with `pct`."""
    long_cnt = f" ({done}/{total} todos)" if total > 0 else ""
    short_cnt = f" ({done}/{total})" if total > 0 else ""
    pct_plain = f" {pct:3d}%"
    if max_width - (2 + len(pct_plain) + len(long_cnt)) >= 10:
        cnt_plain = long_cnt
    elif max_width - (2 + len(pct_plain) + len(short_cnt)) >= 6:
        cnt_plain = short_cnt
    else:
        cnt_plain = ""
    bar_w = max(2, min(36, max_width - 2 - len(pct_plain) - len(cnt_plain)))
    filled = int(round(bar_w * pct / 100.0))
    if explicit or total == 0:
        done_cells = filled
        act_cells = 0
    else:
        done_cells = min(bar_w, int(round(bar_w * done / total)))
        act_cells = min(bar_w - done_cells, max(1 if active and done_cells < bar_w else 0, filled - done_cells))
    rem_cells = max(0, bar_w - done_cells - act_cells)
    done_str = f"{B_GREEN}{'█' * done_cells}{RESET}" if done_cells else ""
    act_str = f"{B_YELLOW}{'▓' * act_cells}{RESET}" if act_cells else ""
    rem_str = f"{DIM}{'░' * rem_cells}{RESET}" if rem_cells else ""
    pct_col = B_GREEN if pct >= 100 else B_CYAN if pct >= 50 else B_YELLOW
    cnt_str = f"{DIM}{cnt_plain}{RESET}" if cnt_plain else ""
    return f"{DIM}▐{RESET}{done_str}{act_str}{rem_str}{DIM}▌{RESET} {BOLD}{pct_col}{pct:3d}%{RESET}{cnt_str}"


def _wrap_para_cells(para, max_cols):
    """Cell-width-aware word wrapper so wide CJK/emoji text never exceeds `max_cols`."""
    max_cols = max(8, max_cols)
    words = para.split()
    if not words:
        return []
    out, cur, cur_w = [], [], 0

    def flush():
        nonlocal cur, cur_w
        if cur:
            out.append(" ".join(cur))
            cur, cur_w = [], 0

    for word in words:
        ww = vis_len(word)
        if ww <= max_cols:
            if not cur:
                cur, cur_w = [word], ww
            elif cur_w + 1 + ww <= max_cols:
                cur.append(word)
                cur_w += 1 + ww
            else:
                flush()
                cur, cur_w = [word], ww
        else:
            flush()
            piece, pw = [], 0
            for ch in word:
                cw = char_width(ch)
                if pw + cw > max_cols and piece:
                    out.append("".join(piece))
                    piece, pw = [], 0
                piece.append(ch)
                pw += cw
            if piece:
                cur, cur_w = ["".join(piece)], pw
    flush()
    return out


def wrap_lines(text, width):
    width = max(8, width)
    out = []
    for para in clean_text(text, keep_newlines=True).splitlines():
        p = para.strip()
        if not p:
            if out and out[-1] != "":
                out.append("")
            continue
        out.extend(_wrap_para_cells(p, width))
    return out


def section_header(icon, title, color, total_w):
    max_title = max(2, total_w - 6)
    shown = truncate_plain(title, max_title)
    label = f" {icon} {shown} "
    dash_n = max(0, total_w - vis_len(label) - 1)
    return f"{color}{BOLD}─{label}{RESET}{DIM}{'─' * dash_n}{RESET}"


def render(data, cols=68, rows=None):
    data = normalize_board(data)
    cols = max(18, min(140, int(cols)))
    inner = cols - 2
    status = data["status"]
    badge_txt, badge_bg, accent, art = STATUS_META[status]

    title = data["title"] or "Subagent"
    role = data["role"]
    crate = data["crate"]
    phase = data["phase"]
    updated = data["updated_at"]
    updates = data["updates"]
    explicit_prog = data["progress"] is not None
    pct, done, active, total = compute_progress(data)

    lines = []
    lines.append(f"{accent}╭{'─' * inner}╮{RESET}")

    meta_bits = [b for b in (role, crate) if b]
    meta_line = " · ".join(meta_bits) or "Olo Agent Standup Board"

    show_art = cols >= 50
    art_w = 9 if show_art else 0
    left_w = inner - 2 - art_w

    title_shown = truncate_plain(title, left_w)
    meta_shown = truncate_plain(meta_line, left_w)
    badge_shown = truncate_plain(f" {badge_txt} ", left_w)
    badge = f"{badge_bg}{BOLD}{badge_shown}{RESET}"
    phase_room = left_w - vis_len(badge) - 2
    if phase and phase_room >= 4:
        phase_s = f"  {accent}{truncate_plain(phase, phase_room)}{RESET}"
    else:
        phase_s = ""

    hdr_rows = [
        f"{BOLD}{B_WHITE}{title_shown}{RESET}",
        f"{DIM}{meta_shown}{RESET}",
        f"{badge}{phase_s}",
    ]
    for i, row in enumerate(hdr_rows):
        if show_art:
            art_s = f"{accent}{BOLD}{art[i]}{RESET}"
            content = " " + pad_vis(row, left_w) + " " + art_s + " "
        else:
            content = " " + pad_vis(row, inner - 2) + " "
        lines.append(f"{accent}│{RESET}{content}{accent}│{RESET}")

    lines.append(f"{accent}├{'─' * inner}┤{RESET}")
    bar = progress_bar(pct, done, active, total, inner - 2, explicit=explicit_prog)
    lines.append(f"{accent}│{RESET} {pad_vis(bar, inner - 2)} {accent}│{RESET}")
    lines.append(f"{accent}╰{'─' * inner}╯{RESET}")

    # Goal section (1-2 easy-to-understand paragraphs)
    goal = data["goal"].strip()
    goal_lines = [f"{section_header('◎', 'GOAL', B_CYAN, cols)}"]
    if goal:
        for gl in wrap_lines(goal, cols - 4):
            if gl == "":
                goal_lines.append(f" {CYAN}┃{RESET}")
            else:
                goal_lines.append(f" {CYAN}┃{RESET} {gl}")
    else:
        goal_lines.append(f" {DIM}┃ {truncate_plain('(goal not set yet)', cols - 4)}{RESET}")

    # Standup: Doing Now
    now = data["now"].strip()
    note = data["note"].strip()
    now_lines = [section_header("▸", "DOING NOW", B_YELLOW, cols)]
    if now:
        for idx, nl in enumerate(wrap_lines(now, cols - 5)):
            lead = f"{B_YELLOW}▸{RESET}" if idx == 0 else " "
            now_lines.append(f" {YELLOW}┃{RESET} {lead} {BOLD}{B_WHITE}{nl}{RESET}")
    else:
        now_lines.append(f" {DIM}┃ {truncate_plain('(waiting for next step)', cols - 4)}{RESET}")
    if note:
        for nl in wrap_lines(note, cols - 6):
            now_lines.append(f" {MAGENTA}┃{RESET} {B_MAGENTA}★ {nl}{RESET}")

    # On short panes, crop long Goal paragraphs first so Doing Now stays visible.
    if rows is not None and rows >= 10:
        header_count = len(lines)
        min_for_now = 1 + 2  # blank + DOING NOW header + at least 1 content line
        max_goal_lines = max(2, rows - 2 - 1 - header_count - 1 - min_for_now)
        if len(goal_lines) > max_goal_lines:
            omitted_g = len(goal_lines) - (max_goal_lines - 1)
            goal_lines = goal_lines[:max_goal_lines - 1] + [
                f" {DIM}┃ {truncate_plain(f'… (+{omitted_g} goal lines)', cols - 4)}{RESET}"
            ]
    lines.append("")
    lines.extend(goal_lines)
    lines.append("")
    lines.extend(now_lines)

    # Standup: Recently Did
    did_rows = [(e.get("at", ""), e.get("text", "")) for e in data["did"][-MAX_DID:] if e.get("text")]
    lines.append("")
    lines.append(section_header("✓", "RECENTLY DID", B_GREEN, cols))
    if did_rows:
        for ts, txt in did_rows:
            ts_clean = truncate_plain(ts, 12)
            ts_w = vis_len(ts_clean)
            use_ts = bool(ts_clean) and (cols - 3 - (ts_w + 3)) >= 8
            tag = f"{DIM}[{ts_clean}]{RESET} " if use_ts else ""
            indent = ts_w + 3 if use_ts else 0
            wlines = wrap_lines(txt, cols - 3 - indent)
            for i, wl in enumerate(wlines):
                if i == 0:
                    lines.append(f" {B_GREEN}✓{RESET} {tag}{wl}")
                else:
                    lines.append(f"   {' ' * indent}{wl}")
    else:
        lines.append(f" {DIM}· {truncate_plain('just getting started', cols - 3)}{RESET}")

    # Standup: Up Next
    nxt = data["next"]
    lines.append("")
    lines.append(section_header("→", "UP NEXT", B_BLUE, cols))
    if nxt:
        for item in nxt[:5]:
            for i, wl in enumerate(wrap_lines(item, cols - 3)):
                lead = f"{B_BLUE}→{RESET}" if i == 0 else " "
                lines.append(f" {lead} {wl}")
    else:
        lines.append(f" {DIM}· {truncate_plain('wrap up and report', cols - 3)}{RESET}")

    # Todo Checklist
    todos = data["todos"]
    lines.append("")
    todo_hdr = f"TODO ({done}/{total})" if total else "TODO"
    lines.append(section_header("☑", todo_hdr, B_MAGENTA, cols))
    if todos:
        num_w = max(2, len(str(len(todos))))
        prefix_w = 5 + num_w
        cont_pad = " " * prefix_w
        for idx, t in enumerate(todos, 1):
            st = t["state"]
            txt = t["text"]
            if st == "done":
                mark, style = f"{B_GREEN}✓{RESET}", DIM
            elif st == "now":
                mark, style = f"{B_YELLOW}▸{RESET}", f"{BOLD}{B_YELLOW}"
            elif st == "blocked":
                mark, style = f"{B_RED}✕{RESET}", f"{BOLD}{B_RED}"
            else:
                mark, style = f"{WHITE}○{RESET}", WHITE
            num = f"{DIM}{idx:{num_w}d}.{RESET}"
            for i, wl in enumerate(wrap_lines(txt, cols - prefix_w)):
                if i == 0:
                    lines.append(f" {mark} {num} {style}{wl}{RESET}")
                else:
                    lines.append(f"{cont_pad}{style}{wl}{RESET}")
    else:
        lines.append(f" {DIM}· {truncate_plain('no checklist items yet', cols - 3)}{RESET}")

    # Footer
    foot_l = f"Updated {updated or 'now'}" + (f" · #{updates}" if updates else "")
    foot_r = "live · inotify"
    fl_w, fr_w = vis_len(foot_l), vis_len(foot_r)
    if fl_w + 1 + fr_w <= cols:
        gap = cols - fl_w - fr_w
        foot_line = f"{DIM}{foot_l}{' ' * gap}{foot_r}{RESET}"
    else:
        foot_line = f"{DIM}{truncate_plain(foot_l, cols)}{RESET}"
    footer = [f"{DIM}{'─' * cols}{RESET}", foot_line]

    if rows is not None:
        rows = max(1, int(rows))
        if rows < 10:
            return "\n".join(lines[:rows])
        if len(lines) + 1 + len(footer) > rows:
            # Keep the header box, Goal, and Doing Now pinned at the top of short panes.
            body_keep = max(7, rows - len(footer) - 1)
            hidden = len(lines) - body_keep
            lines = lines[:body_keep]
            lines.append(f"{DIM}{truncate_plain(f'… +{hidden} more lines (enlarge pane to see all)', cols)}{RESET}")
            lines.extend(footer)
            return "\n".join(lines)
        lines.append("")
        lines.extend(footer)
        return "\n".join(lines)
    lines.append("")
    lines.extend(footer)
    return "\n".join(lines) + "\n"


def draw_screen(path):
    sz = shutil.get_terminal_size((68, 36))
    try:
        data = load_board(path, strict=False)
        out = render(data, cols=sz.columns, rows=sz.lines)
    except Exception as e:
        out = f"{B_RED}agent-board render error: {clean_text(e)}{RESET}\n"
    sys.stdout.write("\x1b[H\x1b[2J\x1b[3J")
    sys.stdout.write(out)
    sys.stdout.flush()


def _init_inotify():
    libc = ctypes.CDLL(None, use_errno=True)
    libc.inotify_init1.argtypes = [ctypes.c_int]
    libc.inotify_init1.restype = ctypes.c_int
    libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    libc.inotify_add_watch.restype = ctypes.c_int
    libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
    libc.inotify_rm_watch.restype = ctypes.c_int
    return libc


def show(path):
    path = safe_path(path, for_write=False)
    folder, name = os.path.split(path)
    if not os.path.isdir(folder):
        sys.exit(f"agent-board: directory {folder} does not exist; run `init` first")
    libc = _init_inotify()
    fd = libc.inotify_init1(0x80000 | 0x800)  # IN_CLOEXEC | IN_NONBLOCK
    if fd < 0:
        sys.exit(f"agent-board: inotify_init1 failed: errno {ctypes.get_errno()}")
    wd = libc.inotify_add_watch(fd, folder.encode(), WATCH_MASK)
    if wd < 0:
        os.close(fd)
        sys.exit(f"agent-board: can't watch {folder}: errno {ctypes.get_errno()}")

    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_r, False)
    os.set_blocking(wake_w, False)
    prev_wake = signal.set_wakeup_fd(wake_w, warn_on_full_buffer=False)

    resized = [False]
    stopping = [False]

    def on_winch(_sig, _frame):
        resized[0] = True

    def on_stop(_sig, _frame):
        stopping[0] = True

    signal.signal(signal.SIGWINCH, on_winch)
    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGHUP, on_stop)
    try:
        sys.stdout.write("\x1b[?25l")
        draw_screen(path)
        while not stopping[0]:
            try:
                rlist, _, _ = select.select([fd, wake_r], [], [])
            except InterruptedError:
                continue
            if wake_r in rlist:
                with contextlib.suppress(BlockingIOError, OSError):
                    while os.read(wake_r, 256):
                        pass
            if stopping[0]:
                break
            redraw = False
            if resized[0]:
                resized[0] = False
                redraw = True
            if fd in rlist:
                try:
                    buf = os.read(fd, 8192)
                except BlockingIOError:
                    buf = b""
                i = 0
                rewatch = False
                moved_self = False
                while i + 16 <= len(buf):
                    ev_wd, mask, _cookie, length = struct.unpack_from("iIII", buf, i)
                    ev_name = buf[i + 16:i + 16 + length].rstrip(b"\0").decode(errors="replace")
                    i += 16 + length
                    if mask & IN_Q_OVERFLOW:
                        redraw = True
                    if ev_wd == wd and (mask & (IN_IGNORED | IN_DELETE_SELF | IN_MOVE_SELF)):
                        rewatch = True
                        if mask & IN_MOVE_SELF:
                            moved_self = True
                        redraw = True
                    elif ev_wd == wd and ev_name == name:
                        redraw = True
                if rewatch:
                    if moved_self:
                        libc.inotify_rm_watch(fd, wd)
                    if os.path.isdir(folder):
                        new_wd = libc.inotify_add_watch(fd, folder.encode(), WATCH_MASK)
                        if new_wd < 0:
                            break
                        wd = new_wd
                    else:
                        break
            if redraw:
                draw_screen(path)
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    except OSError as e:
        if e.errno not in (errno.EPIPE, errno.EIO):
            raise
    finally:
        with contextlib.suppress(OSError, ValueError):
            signal.set_wakeup_fd(prev_wake)
        with contextlib.suppress(OSError):
            os.close(wake_r)
        with contextlib.suppress(OSError):
            os.close(wake_w)
        with contextlib.suppress(OSError):
            sys.stdout.write("\x1b[?25h")
            sys.stdout.flush()
        with contextlib.suppress(OSError):
            os.close(fd)


def board_meta_path(path):
    return f"{path}.meta.json"


def _run_rex_bounded(cmd, timeout=10, max_bytes=MAX_REX_OUTPUT_BYTES):
    """Run a Rex CLI command draining stdout/stderr with a hard byte cap and
    monotonic deadline so a large session listing cannot exhaust memory."""
    import selectors
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)
    except OSError as e:
        return None, "", str(e)
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ, "out")
    sel.register(proc.stderr, selectors.EVENT_READ, "err")
    out_chunks, err_chunks = [], []
    out_n = err_n = 0
    overflow = False
    deadline = time.monotonic() + timeout
    try:
        while sel.get_map():
            rem = deadline - time.monotonic()
            if rem <= 0:
                proc.kill()
                proc.wait()
                return None, "", f"timed out after {timeout}s"
            for key, _ in sel.select(min(0.25, rem)):
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    sel.unregister(key.fileobj)
                    key.fileobj.close()
                    continue
                if key.data == "out":
                    if out_n + len(chunk) > max_bytes:
                        overflow = True
                        proc.kill()
                        proc.wait()
                        return None, "", f"rex output exceeded {max_bytes} byte limit"
                    out_chunks.append(chunk)
                    out_n += len(chunk)
                else:
                    if err_n < 65536:
                        take = chunk[:65536 - err_n]
                        err_chunks.append(take)
                        err_n += len(take)
        rc = proc.wait(timeout=max(0.1, deadline - time.monotonic()))
    except (OSError, subprocess.SubprocessError) as e:
        with contextlib.suppress(OSError):
            proc.kill()
            proc.wait()
        return None, "", str(e)
    finally:
        for key in list(sel.get_map().values()):
            with contextlib.suppress(OSError):
                key.fileobj.close()
        sel.close()
    if overflow:
        return None, "", f"rex output exceeded {max_bytes} byte limit"
    return rc, b"".join(out_chunks).decode("utf-8", "replace"), b"".join(err_chunks).decode("utf-8", "replace")


def resolve_rex_target(rex_bin, explicit_block=None):
    """Return `(session, block, window_id, err)` for a Rex pane. Inside
    `--desktop none` subagents, `REX_SESSION` is stripped while `REX_BLOCK`
    remains set — discover `session_id` and `window_id` directly from
    `rex block inspect <block> --json`."""
    block = explicit_block or os.environ.get("REX_BLOCK")
    if not block:
        return None, None, None, None
    session = os.environ.get("REX_SESSION") if not explicit_block else None
    window_id = None
    cmd = [rex_bin, "block", "inspect", block, "--json"]
    if session:
        cmd[3:3] = ["-s", session]
    rc, stdout, stderr = _run_rex_bounded(cmd, timeout=10)
    if rc == 0:
        try:
            said = json.loads(stdout)
        except ValueError:
            said = None
        if isinstance(said, dict):
            blk = said.get("block") if isinstance(said.get("block"), dict) else {}
            session = session or said.get("session_id") or blk.get("session_id")
            window_id = blk.get("window_id") or said.get("window_id")
            return session, block, window_id, None
        return session, block, None, "malformed rex block inspect JSON"
    err = (stderr or stdout or f"exit {rc}").strip()
    return session, block, window_id, err


def find_existing_standup_pane(rex_bin, session, pane_id=None, window_id=None, path=None):
    """Query Rex for a live placed Standup pane. Returns `(ok, block_id_or_none)`
    so a transient Rex query error (`ok=False`) never triggers a duplicate split."""
    rc, stdout, _stderr = _run_rex_bounded(
        [rex_bin, "block", "list", "-s", session, "--short=false", "--json"],
        timeout=10,
    )
    if rc != 0:
        return False, None
    try:
        said = json.loads(stdout)
    except ValueError:
        return False, None
    if isinstance(said, dict):
        blocks = said.get("blocks")
        if not isinstance(blocks, list):
            return False, None
    elif isinstance(said, list):
        blocks = said
    else:
        return False, None
    for b in blocks:
        if not isinstance(b, dict) or b.get("placement") != "placed":
            continue
        bid = b.get("block_id")
        if pane_id and bid == pane_id:
            if window_id and b.get("window_id") and b.get("window_id") != window_id:
                continue
            return True, bid
    if window_id:
        for b in blocks:
            if not isinstance(b, dict) or b.get("placement") != "placed" or b.get("window_id") != window_id:
                continue
            if b.get("label") != "Standup":
                continue
            # If the pane exposes its command/args, require matching board path when multiple boards share a window.
            cmd_info = b.get("command") or b.get("argv") or b.get("cmdline")
            if path and cmd_info:
                joined = " ".join(str(x) for x in cmd_info) if isinstance(cmd_info, list) else str(cmd_info)
                if path not in joined:
                    continue
            return True, b.get("block_id")
    return True, None


def extract_split_block_id(stdout):
    """Parse the newly created pane ID from `rex split --json` (`.block_ids[0]`,
    with legacy fallbacks)."""
    try:
        said = json.loads(stdout)
    except ValueError:
        return stdout.strip()
    if isinstance(said, dict):
        bids = said.get("block_ids")
        if isinstance(bids, list) and bids and isinstance(bids[0], str) and bids[0]:
            return bids[0]
        blk = said.get("block") if isinstance(said.get("block"), dict) else {}
        return str(said.get("block_id") or said.get("id") or blk.get("block_id") or blk.get("id") or "")
    return ""


def open_pane(path, ratio=38, explicit_block=None, after_save=False):
    path = safe_path(path, for_write=True)
    if _raw_caller_marker() and explicit_block and explicit_block != os.environ.get("REX_BLOCK"):
        sys.exit("agent-board: subagents may only split their own $REX_BLOCK")
    ratio = max(20, min(65, int(ratio)))
    rex_bin = shutil.which("rex") or "/usr/bin/rex"
    session, block, window_id, inspect_err = resolve_rex_target(rex_bin, explicit_block=explicit_block)
    if not block:
        note = f"board saved at {path}" if after_save else f"board path is {path}"
        print(f"agent-board: not in a Rex pane; {note}")
        return
    if not session:
        hint = f" (board update was already saved; retry with `tools/dev/agent-board open --file {path}`)" if after_save else ""
        sys.exit(f"agent-board: could not inspect Rex pane {block}: {inspect_err or 'no session returned'}{hint}")
    meta_p = board_meta_path(path)
    # Use a separate pane lock so a slow `rex split` never times out concurrent `update` calls.
    with board_lock(path, suffix=".pane.lock") as dfd:
        exists, bm, _err = read_regular_json(meta_p, max_bytes=65536, dir_fd=dfd)
        if not exists or not isinstance(bm, dict):
            bm = {}
        saved_pane = bm.get("pane_block") if (bm.get("anchor_block") == block and bm.get("path") == path) else None
        ok_list, existing = find_existing_standup_pane(rex_bin, session, pane_id=saved_pane, window_id=window_id, path=path)
        if not ok_list:
            hint = f" (board update was already saved; retry with `tools/dev/agent-board open --file {path}`)" if after_save else ""
            sys.exit(f"agent-board: could not list Rex panes for {session} (Rex busy); skipping duplicate split{hint}")
        if existing:
            try:
                save_json_atomic(meta_p, {"anchor_block": block, "pane_block": existing, "session": session, "window_id": window_id, "path": path}, dir_fd=dfd)
            except OSError as e:
                print(f"agent-board: warning: could not update {meta_p}: {e}", file=sys.stderr)
            print(f"agent-board: already open in {existing} ({path})")
            return
        with board_lock(path) as data_dfd:
            ex_board, _, _ = read_regular_json(path, dir_fd=data_dfd)
            if not ex_board:
                save_json_atomic(path, default_board_data(), dir_fd=data_dfd)
        me = os.path.abspath(__file__)
        rc, stdout, stderr = _run_rex_bounded(
            [
                rex_bin, "split", "-s", session, "-b", block,
                "--split=right", f"--ratio={ratio}", "--focus=false",
                "--shell=none", "--label", "Standup", "--json",
                "--", "/usr/bin/python3", "-I", me, "show", path,
            ],
            timeout=30,
        )
        if rc != 0:
            hint = f" (board update was already saved; retry with `tools/dev/agent-board open --file {path}`)" if after_save else ""
            sys.exit(f"agent-board: rex split failed: {(stderr or stdout or 'error').strip()}{hint}")
        pane_id = extract_split_block_id(stdout)
        if not pane_id and window_id:
            _ok, found = find_existing_standup_pane(rex_bin, session, window_id=window_id, path=path)
            pane_id = found or ""
        try:
            save_json_atomic(meta_p, {"anchor_block": block, "pane_block": pane_id, "session": session, "window_id": window_id, "path": path}, dir_fd=dfd)
        except OSError as e:
            print(f"agent-board: warning: could not save {meta_p}: {e}", file=sys.stderr)
    print(f"agent-board: opened right split pane {pane_id or '(ok)'} watching {path}")


def add_common_flags(p):
    p.add_argument("--file", dest="file", default=None, help="Path to board.json (defaults to /var/tmp/olo-agents/$OLO_SUBAGENT/board.json)")
    p.add_argument("--open", action="store_true", help="Open the right-hand Rex split pane if not already open")
    p.add_argument("--block", default=None, help="Explicit Rex block ID to split beside (defaults to $REX_BLOCK)")
    p.add_argument("--ratio", type=int, default=38, help="Split pane width percentage (20..65, default 38)")
    p.add_argument("--title", default=None)
    p.add_argument("--role", default=None)
    p.add_argument("--crate", default=None)
    p.add_argument("--status", choices=sorted(STATUS_META), default=None)
    p.add_argument("--phase", default=None)
    p.add_argument("--progress", type=int, default=None, help="Explicit 0-100 progress override (-1 clears override to auto)")
    p.add_argument("--goal", default=None, help="1-2 plain-English paragraphs summarizing the goal/brief")
    p.add_argument("--now", default=None, help="What you are doing right now")
    p.add_argument("--did", action="append", default=[], help="Append an accomplishment to Recently Did (repeatable)")
    p.add_argument("--set-did", action="append", default=None, help="Replace Recently Did list (repeatable)")
    p.add_argument("--next", action="append", default=None, help="Replace Up Next list (repeatable)")
    p.add_argument("--add-next", action="append", default=[], help="Append to Up Next (repeatable)")
    p.add_argument("--todo", "--add-todo", dest="add_todo", action="append", default=[], help="Add a todo item (repeatable)")
    p.add_argument("--set-todos", action="append", default=None, help="Replace entire todo list; items may start with [x], [>], [!], [ ]")
    p.add_argument("--start-todo", action="append", default=[], help="Mark matching todo (1-based index or substring) as in-progress [>]")
    p.add_argument("--check-todo", action="append", default=[], help="Mark matching todo (1-based index or substring) as done [x]")
    p.add_argument("--block-todo", action="append", default=[], help="Mark matching todo (1-based index or substring) as blocked [!]")
    p.add_argument("--drop-todo", action="append", default=[], help="Remove matching todo (1-based index or substring)")
    p.add_argument("--log-checked", action="store_true", help="Also append checked todos to Recently Did")
    p.add_argument("--note", default=None, help="Set highlight/metric/blocker note")
    p.add_argument("--clear-note", action="store_true", help="Clear highlight note")


def apply_updates(data, args, is_init=False, raw_doc=None):
    now_hm = time.strftime("%H:%M", time.gmtime())
    if is_init:
        base = default_board_data()
        if isinstance(data, dict):
            base["title"] = data.get("title") or base["title"]
            base["role"] = data.get("role") or base["role"]
        data = base
    else:
        data = normalize_board(data)

    for k in ("title", "role", "crate", "status", "phase", "goal", "now"):
        v = getattr(args, k)
        if v is not None:
            data[k] = clean_text(v, keep_newlines=(k in ("goal", "now")))
    if args.progress is not None:
        data["progress"] = None if args.progress < 0 else max(0, min(100, args.progress))
    if args.clear_note:
        data["note"] = ""
    elif args.note is not None:
        data["note"] = clean_text(args.note, keep_newlines=True)

    if args.set_did is not None:
        data["did"] = [{"at": now_hm, "text": clean_text(x).strip()} for x in args.set_did if clean_text(x).strip()][-MAX_DID:]
    for item in args.did:
        t = clean_text(item).strip()
        if t:
            data["did"].append({"at": now_hm, "text": t})
            data["did"] = data["did"][-MAX_DID:]

    if args.next is not None:
        data["next"] = [clean_text(x).strip() for x in args.next if clean_text(x).strip()]
    for item in args.add_next:
        t = clean_text(item).strip()
        if t:
            data["next"].append(t)

    todos = list(data["todos"])
    if args.set_todos is not None:
        todos = [p for x in args.set_todos if (p := parse_todo_str(x)) is not None]
    for item in args.add_todo:
        p = parse_todo_str(item)
        if p is not None:
            todos.append(p)
    for needle in args.start_todo:
        idx = match_todo(todos, needle)
        if idx is not None:
            todos[idx]["state"] = "now"
    for needle in args.check_todo:
        idx = match_todo(todos, needle)
        if idx is not None:
            todos[idx]["state"] = "done"
            if args.log_checked:
                data["did"].append({"at": now_hm, "text": todos[idx]["text"]})
                data["did"] = data["did"][-MAX_DID:]
    for needle in args.block_todo:
        idx = match_todo(todos, needle)
        if idx is not None:
            todos[idx]["state"] = "blocked"
    if args.drop_todo:
        # Resolve all drop selectors against the pre-drop snapshot, then delete descending.
        drop_idxs = {idx for needle in args.drop_todo if (idx := match_todo(todos, needle)) is not None}
        for idx in sorted(drop_idxs, reverse=True):
            todos.pop(idx)
    data["todos"] = todos

    data["updated_at"] = time.strftime("%H:%M:%S UTC", time.gmtime())
    data["updates"] = int(data.get("updates") or 0) + 1
    if not is_init and isinstance(raw_doc, dict):
        merged = dict(raw_doc)
        merged.update(data)
        return merged
    return data


def main():
    parser = argparse.ArgumentParser(prog="agent-board", description="Live standup & goal board in a right-hand Rex split pane")
    sub = parser.add_subparsers(dest="cmd")

    p_init = sub.add_parser("init", help="Initialize board and optionally open right split pane")
    add_common_flags(p_init)

    p_upd = sub.add_parser("update", help="Incrementally update only changed fields")
    add_common_flags(p_upd)

    p_open = sub.add_parser("open", help="Open right-hand Rex split pane for board")
    p_open.add_argument("--file", default=None)
    p_open.add_argument("--block", default=None)
    p_open.add_argument("--ratio", type=int, default=38)

    p_show = sub.add_parser("show", help="Live inotify renderer (run inside split pane)")
    p_show.add_argument("path")

    p_prev = sub.add_parser("preview", help="Render board once to stdout")
    p_prev.add_argument("--file", default=None)
    p_prev.add_argument("--width", type=int, default=68)
    p_prev.add_argument("--height", type=int, default=0, help="Optional max terminal rows (0 = unconstrained)")

    sub.add_parser("path", help="Print default board path for this agent")

    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        return
    if args.cmd == "path":
        print(safe_path(None, for_write=False))
    elif args.cmd == "show":
        show(args.path)
    elif args.cmd == "open":
        open_pane(args.file, ratio=args.ratio, explicit_block=args.block)
    elif args.cmd == "preview":
        p = safe_path(args.file, for_write=False)
        rows = args.height if args.height and args.height > 0 else None
        out = render(load_board(p, strict=False), cols=args.width, rows=rows)
        sys.stdout.write(out if out.endswith("\n") else out + "\n")
    elif args.cmd in ("init", "update"):
        is_init = args.cmd == "init"
        p = safe_path(args.file, for_write=True)
        with board_lock(p) as dfd:
            raw_doc = load_board_raw(p, strict=not is_init, dir_fd=dfd)
            existing = (normalize_board(raw_doc) if raw_doc is not None else default_board_data()) if is_init else load_board(p, strict=True, dir_fd=dfd)
            data = apply_updates(existing, args, is_init=is_init, raw_doc=raw_doc)
            save_json_atomic(p, data, dir_fd=dfd)
        if args.open:
            open_pane(p, ratio=args.ratio, explicit_block=args.block, after_save=True)
        pct, done, _act, total = compute_progress(data)
        print(f"agent-board: updated {p} ({data['status']}, {pct}%, {done}/{total} todos)")


if __name__ == "__main__":
    main()
