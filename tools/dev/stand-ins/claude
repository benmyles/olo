#!/bin/bash
# A stand-in for Claude Code, for Olo's tests (run it by its path, `tools/dev/stand-ins/claude RECORD`: its name
# is what tells it apart): it draws Claude Code's screens (working, asking leave to run a command with "1. Yes"
# chosen, at its own prompt), and writes into RECORD what it is answered ("answer:[]" is Return) and told. No
# agent, no account.
# In Rex, whose server names a script's program by its interpreter, run it under a copy of bash named for the
# agent (`cp /usr/bin/bash DIR/claude; DIR/claude tools/dev/stand-ins/claude RECORD`, as try.py agents does).
out=$1
RULE=$(printf '─%.0s' $(seq 70))
pad() { for _ in $(seq 70); do echo; done; }
working() { pad; printf '> Do what the brief says.\n● Read(brief.md)\n✻ Thinking… (12s · esc to interrupt)\n'; }
asking() { pad; printf "● Bash(touch one.txt)\n\n Do you want to proceed?\n ❯ 1. Yes\n   2. Yes, and don't ask again for this command\n   3. No, and tell Claude what to do differently (esc)\n"; }
idle() { pad; printf '● Done with this part.\n\n%s\n❯ \n%s\n  ? for shortcuts\n' "$RULE" "$RULE"; }
working; sleep 3
asking; IFS= read -rsn1 key; printf 'answer:[%s]\n' "$key" >> "$out"
working; sleep 2
idle; IFS= read -r line; printf 'said:[%s]\n' "$line" >> "$out"
working; sleep 2
idle; IFS= read -r line; printf 'said again:[%s]\n' "$line" >> "$out"
