#!/bin/bash
# A stand-in for Codex, for Olo's tests (run it by its path, `tools/dev/stand-ins/codex RECORD`: its name is what
# tells it apart): it draws Codex's screens (working, asking leave to run a command with "1. Yes" chosen, at its
# own prompt), and writes into RECORD what it is answered ("answer:[]" is Return) and told (reads.sh: it reads as
# the agent reads; with `two` after RECORD, a second question after the first). No agent, no account.
# In Rex, whose server names a script's program by its interpreter, run it under a copy of bash named for the
# agent (`cp /usr/bin/bash DIR/codex; DIR/codex tools/dev/stand-ins/codex RECORD`, as try.py agents does).
out=$1
. "${BASH_SOURCE%/*}/reads.sh"
pad() { for _ in $(seq 70); do echo; done; }
working() { pad; printf '› Do what the brief says.\n\n• Working (12s • esc to interrupt)\n'; }
asking() { pad; printf "Would you like to run the following command?\n\n  Reason: Do you want to create the file?\n\n  \$ touch $1.txt\n\n› 1. Yes, proceed (y)\n  2. Yes, and don't ask again for this command (a)\n  3. No, and tell Codex what to do differently (esc)\n\n  Press enter to confirm or esc to cancel\n"; }
idle() { pad; printf '• Done with this part.\n\n› \n\n  ? for shortcuts\n'; }
full_screen; asks_for_the_mouse
working; sleep 3
asking one; answer
# (`two`: a second question, of another command, for what is tried at a question beside its answer.)
if [ "${2:-}" = two ]; then working; sleep 1; asking two; answer; fi
working; sleep 2
idle; told; printf 'said:[%s]\n' "$line" >> "$out"
working; sleep 2
idle; told; printf 'said again:[%s]\n' "$line" >> "$out"
