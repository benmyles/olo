#!/usr/bin/python3
"""Whether any of the files named on stdin (paths from the repository's
root, one a line) is in something the layout lint builds: the packages
`cargo ui-lint` tests and every workspace package they depend on, as
cargo says (so nobody keeps a list). Exits 0 if so, 1 if not: a commit of
an app the lint doesn't build (Token Pool, a daemon) isn't held up for
it. Anything that isn't in a package (Cargo.lock, .cargo/) counts.

  git diff --cached --name-only | tools/hooks/lint-covers
"""
import json, os, subprocess, sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", ".."))
# (What `ui-lint` in .cargo/config.toml names.)
LINTED = ["olo-kit", "olo-preferences", "olo-diskbackup-app"]


def main():
    files = [l.strip() for l in sys.stdin if l.strip()]
    # (Our own packages and the paths between them, no more: the whole
    # graph, `cargo metadata` without --no-deps, wants every dependency's
    # manifest, a platform's never built here among them, and offline on a
    # computer that never fetched them it failed, so that every commit,
    # the docs' too, ran the lint: the dev server, 2026-11-24.)
    try:
        meta = json.loads(subprocess.run(["cargo", "metadata", "--format-version", "1", "--no-deps", "--offline"], cwd=ROOT, capture_output=True, text=True, check=True).stdout)
    except Exception:
        return 0  # (Can't tell: lint.)
    by_dir = {os.path.dirname(p["manifest_path"]): p for p in meta["packages"]}
    todo = [p for p in meta["packages"] if p["name"] in LINTED]
    seen = set()
    while todo:
        p = todo.pop()
        here = os.path.dirname(p["manifest_path"])
        if here in seen:
            continue
        seen.add(here)
        todo += [by_dir[d["path"]] for d in p["dependencies"] if d.get("path") in by_dir]
    # Every package of ours the lint builds, by its folder.
    dirs = sorted(os.path.relpath(d, ROOT) + "/" for d in seen)
    all_dirs = sorted((os.path.relpath(d, ROOT) + "/" for d in by_dir), key=len, reverse=True)
    for f in files:
        owner = next((d for d in all_dirs if f.startswith(d)), None)
        # (Docs, tools and the like build nothing.)
        if owner is None:
            if f.endswith((".md", ".py", ".sh", ".png", ".svg", ".txt")) or f.startswith(("docs/", "tools/", ".claude/")):
                continue
            return 0
        if owner in dirs:
            return 0
    return 1


sys.exit(main())
