#!/bin/bash
# Before each commit (installed by tools/hooks/install, from tools/setup.sh):
#  1. Rust staged is formatted (rustfmt, each file by the rustfmt.toml
#     nearest it: Olo's wide style, upstream's in smithay/) and
#     staged again, so the repo stays formatted without anyone asking.
#  2. When something the lint builds is staged (Preferences, DiskBackup,
#     the kits and what they're built on), the layout lint runs
#     headless (`cargo ui-lint`: every Preferences panel and the kit's
#     forms at 1, 1.5 and 2×, light and dark) and a finding stops the
#     commit. docs/HACKING.md, "The layout lint". It lints what is
#     committed: where the working tree differs from it in what the lint
#     builds (another's work beside, a subagent mid-edit in a crate the
#     lint builds, 2026-11-25), in a checkout of HEAD with what is staged
#     (tools/hooks/checkout-at, /var/tmp/olo-precommit/tree, its builds
#     kept between commits); else in place.
# OLO_SKIP_UI_LINT=1 skips the lint (not the formatting), for a commit
# that can't wait; say why in its message.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mapfile -t rust < <(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' | grep -v '^vendor/' || true)
if [ ${#rust[@]} -gt 0 ]; then
    # (Partly staged files are formatted whole: say so rather than mix
    # unstaged work into the commit.)
    partial=$(git diff --name-only -- "${rust[@]}" || true)
    # (Each file's edition from the rustfmt.toml nearest it, as `cargo
    # fmt` takes it from its crate: Blade's are 2021.)
    rustfmt "${rust[@]}"
    if [ -n "$partial" ]; then
        echo "pre-commit: formatted, but these have unstaged changes too; check and stage them: $partial" >&2
        exit 1
    fi
    git add -- "${rust[@]}"
fi
# (Only for what the lint builds, as cargo says: `lint-covers`. An app it
# doesn't draw, a daemon, the docs: nothing to wait for.)
if [ "${OLO_SKIP_UI_LINT:-}" != 1 ] && git diff --cached --name-only | tools/hooks/lint-covers; then
    echo "pre-commit: UI code changed; the layout lint (cargo ui-lint)…" >&2
    began=$SECONDS
    trap 'echo "pre-commit: the layout lint took $((SECONDS - began)) s" >&2' EXIT
    # (Through Jato where it's there, which keeps builds it has made:
    # the alias's own words, `cargo ui-lint`, as .cargo/config.toml has
    # them. Ben, 2026-11-24: "for builds moving forward please use
    # jato".)
    if command -v jato > /dev/null 2>&1; then
        lint=(jato test -p olo-kit -p olo-preferences -p olo-diskbackup-app --features olo-kit/lint --tests ui_lint)
    else
        lint=(cargo ui-lint)
    fi
    # (What is committed, where the working tree holds more of what the
    # lint builds: HEAD and what is staged, in a checkout of its own. Git
    # gives a hook its index's path: never to a git run in another tree.)
    where=.
    if git diff --name-only | tools/hooks/lint-covers; then
        echo "pre-commit: the working tree has more than is staged of what the lint builds: linting what is staged, in a checkout of its own" >&2
        where=$(env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE tools/hooks/checkout-at HEAD "${OLO_PRECOMMIT_TREE:-/var/tmp/olo-precommit/tree}")
        git diff --cached --binary | env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE git -C "$where" apply --whitespace=nowarn
    fi
    if ! out=$(cd "$where" && env -u WAYLAND_DISPLAY -u OLO_SOCKET -u GIT_INDEX_FILE "${lint[@]}" 2>&1); then
        echo "$out" | grep -E "^  (light|dark) at|panicked|^error" >&2 || echo "$out" | tail -30 >&2
        echo "pre-commit: the layout lint found the above; fix it (or OLO_SKIP_UI_LINT=1, saying why)." >&2
        exit 1
    fi
fi
