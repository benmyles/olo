#!/bin/bash
# Before each push (installed by tools/hooks/install): Git LFS's own push
# step, then, when UI code is among what's pushed, the live layout lint of
# every Olo app that changed (tools/dev/ui-lint: each app opened in a
# headless session, every window and tab reviewed at 1, 1.5 and 2×, light
# and dark), then each of its windows that tiles tiled into every layout
# (CLAUDE.md, "Every tiling layout") on the smallest screen and on each of
# the person's, on release builds made first; and, when what keeps a
# desktop at rest is among it (the kits, Terminal, Deskbar, the widgets'
# providers), tools/dev/rest-check: a desktop with one thing in it that
# keeps changing must stay at rest but for who shows it. A finding stops
# the push, as does a working tree that isn't what's pushed (the build
# reads the tree). OLO_SKIP_UI_LINT=1 skips the lint and the check.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# What's pushed, one "LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA" a line
# (read once: Git LFS reads it too).
pushed=$(cat)
if command -v git-lfs > /dev/null 2>&1; then
    began=$SECONDS
    printf '%s\n' "$pushed" | git lfs pre-push "$@"
    echo "pre-push: git-lfs took $((SECONDS - began)) s" >&2
fi
[ "${OLO_SKIP_UI_LINT:-}" = 1 ] && exit 0
remote_ref=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo origin/main)
changed=$(git diff --name-only "$remote_ref"...HEAD 2>/dev/null || true)
echo "$changed" | grep -qE '^(apps/|crates/(kit|interface|kit-base|theme|preview)/|vendor/)' || exit 0
# Which apps: all of them when the kits (or what they're built on) changed,
# else those touched.
picked=()
if ! echo "$changed" | grep -qE '^(crates/(kit|interface|kit-base|theme|preview)/|vendor/)'; then
    for app in $(echo "$changed" | sed -nE 's#^apps/([^/]+)/.*#\1#p' | sort -u); do
        # (ui-lint takes apps/' directory names: "disk-usage" is Disk Usage.)
        case $app in
            preferences) picked+=($(/usr/bin/python3 tools/dev/ui-lint --list | grep '^prefs:')) ;;
            *) picked+=("$app") ;;
        esac
    done
    [ ${#picked[@]} -eq 0 ] && exit 0
    # None of them has a window the lint opens (Token Pool, a daemon):
    # nothing to build for it.
    lintable=$(/usr/bin/python3 tools/dev/ui-lint --list | tr -d ' ' | tr 'A-Z' 'a-z')
    any=0
    for p in "${picked[@]}"; do
        echo "$lintable" | grep -qxF "$(echo "$p" | tr -d ' -' | tr 'A-Z' 'a-z')" && any=1
    done
    [ $any -eq 0 ] && exit 0
fi
# The build and the lint read the working tree: it must be what's pushed,
# or they check something else (2026-11-15: edits begun after a commit
# failed the push of that commit, which built; a fix not yet committed
# would as easily pass a broken one).
head=$(git rev-parse HEAD)
while read -r _ sha _ _; do
    if [ -n "$sha" ] && [ "$sha" != 0000000000000000000000000000000000000000 ] && [ "$sha" != "$head" ]; then
        echo "pre-push: pushing $sha, but $head is checked out: the build would check that instead. Check out what's pushed, then push." >&2
        exit 1
    fi
done <<< "$pushed"
if ! git diff --quiet HEAD --; then
    echo "pre-push: there are changes not committed (git status), and the build would check them, not what's pushed. Commit them or set them aside, then push." >&2
    exit 1
fi
echo "pre-push: UI code changed; release build, then the live layout lint…" >&2
began=$SECONDS
env -u WAYLAND_DISPLAY -u OLO_SOCKET cargo build --release --workspace >&2
echo "pre-push: the release build took $((SECONDS - began)) s" >&2
began=$SECONDS
trap 'echo "pre-push: the live layout lint took $((SECONDS - began)) s" >&2' EXIT
if ! env -u WAYLAND_DISPLAY -u OLO_SOCKET /usr/bin/python3 tools/dev/ui-lint "${picked[@]}" >&2; then
    echo "pre-push: the live layout lint found the above; fix it (or OLO_SKIP_UI_LINT=1, saying why)." >&2
    exit 1
fi
# Tiled: zoomed, in halves, a quarter and thirds, on the smallest screen
# (1280 × 800 points) and each of the person's, their sizes and scales
# read from their session (only those; the lint runs in its own).
screens=2560x1600@2
person=$(/usr/bin/python3 tools/dev/ui-lint --person-screens 2> /dev/null || true)
[ -n "$person" ] && screens="$screens,$person"
if ! env -u WAYLAND_DISPLAY -u OLO_SOCKET /usr/bin/python3 tools/dev/ui-lint --tiles --screens "$screens" "${picked[@]}" >&2; then
    echo "pre-push: the live layout lint, tiled, found the above; fix it (or OLO_SKIP_UI_LINT=1, saying why)." >&2
    exit 1
fi
# At rest: a spinner in a tab's title, and what waits in an app changing,
# on the release builds just made (2026-11-21: each had kept three
# displays drawing and five programs busy, with nobody at the computer).
if echo "$changed" | grep -qE '^(crates/(kit|interface|kit-base)/|apps/(terminal|deskbar|calendar|notifications|todo|weather)/|tools/dev/rest-check$)'; then
    rest=$SECONDS
    if ! env -u WAYLAND_DISPLAY -u OLO_SOCKET TSESSION_PROFILE=release /usr/bin/python3 tools/dev/rest-check >&2; then
        echo "pre-push: the desktop didn't stay at rest (above); fix it (or OLO_SKIP_UI_LINT=1, saying why)." >&2
        exit 1
    fi
    echo "pre-push: the rest check took $((SECONDS - rest)) s" >&2
fi
# (Changed while it built and looked: what it checked may not be what's
# pushed. 2026-11-15: edits begun mid-push were half in its build.)
if ! git diff --quiet HEAD --; then
    echo "pre-push: the tree changed while it built and looked, so that isn't what's pushed. Push again once the changes are committed or set aside." >&2
    exit 1
fi
