#!/bin/bash
# Before each push (installed by tools/hooks/install): Git LFS's own push
# step, then the checks of the commit pushed (tools/hooks/prepush-checks:
# the live layout lint of the apps it changes, tiled too, on release
# builds, and the rest check where it applies). A commit tools/dev/push
# checked before connecting passes at once: git runs this hook with the
# remote's connection open, and checks that take minutes on a busy
# computer lost two pushes on 2026-11-24 when GitHub closed it
# ("Connection to github.com closed by remote host", exit 141).
# OLO_SKIP_UI_LINT=1 skips the checks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# What's pushed, one "LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA" a line
# (read once: Git LFS reads it too).
pushed=$(cat)
if command -v git-lfs > /dev/null 2>&1; then
    began=$SECONDS
    printf '%s\n' "$pushed" | git lfs pre-push "$@"
    echo "pre-push: git-lfs took $((SECONDS - began)) s" >&2
fi
[ "${OLO_SKIP_UI_LINT:-}" = 1 ] && exit 0
# The commit pushed (a branch deleted pushes none).
sha=""
while read -r _ local _ _; do
    if [ -n "$local" ] && [ "$local" != 0000000000000000000000000000000000000000 ]; then
        if [ -n "$sha" ] && [ "$sha" != "$local" ]; then
            echo "pre-push: pushing two commits ($sha and $local): push one at a time, so each is checked." >&2
            exit 1
        fi
        sha=$local
    fi
done <<< "$pushed"
[ -n "$sha" ] || exit 0
base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2> /dev/null || echo origin/main)
# Checked already, over the same base, by these same checks (their hash),
# before connecting.
since=$(git merge-base "$base" "$sha" 2> /dev/null || echo none)
hash=$(sha256sum tools/hooks/prepush-checks | cut -c1-16)
if grep -qxF "$sha $since $hash" "$(git rev-parse --absolute-git-dir)/olo-prepush-passed" 2> /dev/null; then
    echo "pre-push: ${sha:0:9} passed its checks before connecting (tools/dev/push)" >&2
    exit 0
fi
began=$SECONDS
tools/hooks/prepush-checks "$sha" "$base"
if [ $((SECONDS - began)) -ge 240 ]; then
    echo "pre-push: the checks took $((SECONDS - began)) s with the remote's connection open; if it was closed meanwhile, push again (the commit passed, so at once), and push with tools/dev/push, which checks before connecting" >&2
fi
