// Olo: the person at the computer (a local, active session) may start
// olo-power-now@reboot.service and olo-power-now@poweroff.service without
// a password: the power button held restarts or shuts down at once
// (Preferences ▸ Keyboard). Nothing else is let. Installed by Olo Doctor.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" &&
        (action.lookup("unit") == "olo-power-now@reboot.service" ||
         action.lookup("unit") == "olo-power-now@poweroff.service") &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
