[Unit]
Description=Olo's login screen
Documentation=https://github.com/benmyles/olo/blob/main/docs/HACKING.md

# In the console's place on the first terminal.
Conflicts=getty@tty1.service
After=getty@tty1.service
# The boot's splash handed over as GDM does: olo-login tells Plymouth to
# let go of the screen and, once the login screen shows, to quit leaving
# its picture there (so no console flashes between); Plymouth's own quit
# isn't run. Gone either way if olo-login fails.
Conflicts=plymouth-quit.service
After=plymouth-quit.service
After=rc-local.service plymouth-start.service systemd-user-sessions.service
OnFailure=plymouth-quit.service

[Service]
ExecStart=/usr/local/libexec/olo/olo-login --daemon --programs /usr/local/libexec/olo --vt 1
KillMode=mixed
Restart=always
IgnoreSIGPIPE=no
EnvironmentFile=-/etc/locale.conf
KeyringMode=shared

[Install]
Alias=display-manager.service
