@@ -2059,12 +2062,20 @@ _kgspRpcDrainEvents
 {
     NV_STATUS nvStatus = NV_OK;
     OBJRPC *pRpc = GPU_GET_RPC(pGpu);
+    NvU32 drained = 0;
+    NvBool pmPoll = rpcHandlerContext != KGSP_RPC_EVENT_HANDLER_CONTEXT_INTERRUPT &&
+                    rmapiInRtd3PmPath();
 
     while (nvStatus == NV_OK)
     {
         nvStatus = _kgspRpcDrainOneEvent(pGpu, pRpc, expectedFunc, expectedSequence, rpcHandlerContext,
                                          pConditionFunc, pConditionData);
         kgspDumpGspLogs(pKernelGsp, NV_FALSE);
+
+        // Give the outer poller a chance to check its existing deadline and
+        // the mailbox even when unrelated events keep arriving.
+        if (pmPoll && ++drained == 32)
+            break;
     }
 
     // If GSP-RM has died, the GPU will need to be reset
