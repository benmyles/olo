Subject: [PATCH] modeset: retain the GPU reference and its close stack at open

PCI remove unpublishes the ID before waiting for this referenced object.
All three kinds of modeset opens now pair with a put on that same object.
The old close also silently skipped the put on stack allocation failure.
Keep the existing versioned rm_ops table its original size. Use distinct
exported symbols so the new modeset cannot bind to an old RM provider.
Allow partially constructed KAPI devices to unwind without a spurious put.

diff --git a/kernel-open/common/inc/nv-modeset-interface.h b/kernel-open/common/inc/nv-modeset-interface.h
index 2b96ba5a4085a8d9954eda30f0fa441c85886fe2..bbfdc27f27cc05cdc7e3ded156c37e5c508480be 100644
--- a/kernel-open/common/inc/nv-modeset-interface.h
+++ b/kernel-open/common/inc/nv-modeset-interface.h
@@ -123,6 +123,11 @@ typedef struct {
 
 } nvidia_modeset_rm_ops_t;
 
+/* New symbols keep both generations of the fixed-size rm_ops ABI compatible. */
+struct nvkms_gpu_ref;
+struct nvkms_gpu_ref *nvidia_modeset_get_gpu_ref(NvU32 gpu_id, NvBool reset_aware);
+void nvidia_modeset_put_gpu_ref(struct nvkms_gpu_ref *ref);
+
 NV_STATUS nvidia_get_rm_ops(nvidia_modeset_rm_ops_t *rm_ops);
 
 #endif /* _NV_MODESET_INTERFACE_H_ */
diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
index 62986c40f5ff9779666a7acde26cfa1743cf9de4..85b5b52a81032376eb36b2a27e516a7d00f1dfaf 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
@@ -1241,33 +1241,14 @@ done:
     return ret;
 }
 
-NvBool nvkms_open_gpu(NvU32 gpuId, NvBool reset_aware)
+struct nvkms_gpu_ref *nvkms_open_gpu(NvU32 gpuId, NvBool reset_aware)
 {
-    nvidia_modeset_stack_ptr stack = NULL;
-    NvBool ret;
-
-    if (__rm_ops.alloc_stack(&stack) != 0) {
-        return NV_FALSE;
-    }
-
-    ret = __rm_ops.open_gpu(gpuId, stack, reset_aware) == 0;
-
-    __rm_ops.free_stack(stack);
-
-    return ret;
+    return nvidia_modeset_get_gpu_ref(gpuId, reset_aware);
 }
 
-void nvkms_close_gpu(NvU32 gpuId, NvBool reset_aware)
+void nvkms_close_gpu(struct nvkms_gpu_ref *ref)
 {
-    nvidia_modeset_stack_ptr stack = NULL;
-
-    if (__rm_ops.alloc_stack(&stack) != 0) {
-        return;
-    }
-
-    __rm_ops.close_gpu(gpuId, stack, reset_aware);
-
-    __rm_ops.free_stack(stack);
+    nvidia_modeset_put_gpu_ref(ref);
 }
 
 NvU32 nvkms_enumerate_gpus(nv_gpu_info_t *gpu_info)
diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
index dc33314bd399658cc7d0cec887b238813ba31f0a..2e570b55417801b381f5bef2cd6f107173b76394 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
@@ -314,8 +314,9 @@ void* nvkms_get_per_open_data(int fd);
 /*!
