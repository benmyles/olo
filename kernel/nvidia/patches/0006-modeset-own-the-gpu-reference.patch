  */
-NvBool nvkms_open_gpu(NvU32 gpuId, NvBool reset_aware);
-void nvkms_close_gpu(NvU32 gpuId, NvBool reset_aware);
+struct nvkms_gpu_ref;
+struct nvkms_gpu_ref *nvkms_open_gpu(NvU32 gpuId, NvBool reset_aware);
+void nvkms_close_gpu(struct nvkms_gpu_ref *ref);
 
 
 /*!
diff --git a/kernel-open/nvidia/nv.c b/kernel-open/nvidia/nv.c
index 2c08cba726e260ed44973e7b0752956c6bc5a5d4..745fa90c6904a07c83b0412a9f3855885709356e 100644
--- a/kernel-open/nvidia/nv.c
+++ b/kernel-open/nvidia/nv.c
@@ -32,6 +32,7 @@
 #include "nvmisc.h"
 #include "os-interface.h"
 #include "nv-linux.h"
+#include "nv-modeset-interface.h"
 #include "nv-p2p.h"
 #include "nv-reg.h"
 #include "nv-msi.h"
@@ -5525,6 +5526,90 @@ void nvidia_dev_put(NvU32 gpu_id, nvidia_stack_t *sp, NvBool reset_aware)
     up(&nvl->ldata_lock);
 }
 
+/*
+ * Modeset owns the reference until close, including after PCI remove has
+ * unpublished the GPU ID. Reserve the teardown stack at open so memory
+ * pressure cannot turn a put into a leaked reference.
+ */
+struct nvkms_gpu_ref
+{
+    nv_linux_state_t *nvl;
+    nvidia_stack_t *sp;
+    NvBool reset_aware;
+};
+
+struct nvkms_gpu_ref *nvidia_modeset_get_gpu_ref(NvU32 gpu_id, NvBool reset_aware)
+{
+    struct nvkms_gpu_ref *ref;
+    nv_linux_state_t *nvl;
+    nv_state_t *nv;
+
+    ref = kzalloc(sizeof(*ref), GFP_KERNEL);
+    if (ref == NULL)
+        return NULL;
+
+    if (nv_kmem_cache_alloc_stack(&ref->sp) != 0)
+        goto free_ref;
+
+    nvl = find_gpu_id(gpu_id);
+    if (nvl == NULL)
+        goto free_stack;
+
+    nv = NV_STATE_PTR(nvl);
+    if (nv_open_device(nv, ref->sp) != 0)
+        goto unlock;
+
+    if (!reset_aware &&
+        rm_set_external_kernel_client_count(ref->sp, nv, NV_TRUE) != NV_OK)
+    {
+        nv_close_device(nv, ref->sp);
+        goto unlock;
+    }
+
+    ref->nvl = nvl;
+    ref->reset_aware = reset_aware;
+    up(&nvl->ldata_lock);
+    return ref;
+
+unlock:
+    up(&nvl->ldata_lock);
+free_stack:
+    nv_kmem_cache_free_stack(ref->sp);
+free_ref:
+    kfree(ref);
+    return NULL;
+}
+NV_EXPORT_SYMBOL(nvidia_modeset_get_gpu_ref);
+
+void nvidia_modeset_put_gpu_ref(struct nvkms_gpu_ref *ref)
+{
+    nv_linux_state_t *nvl;
+    nv_state_t *nv;
+
+    if (ref == NULL)
+        return;
+    nvl = ref->nvl;
+    nv = NV_STATE_PTR(nvl);
+    down(&nvl->ldata_lock);
+    if (!nv->removed && !ref->reset_aware)
+        WARN_ON(rm_set_external_kernel_client_count(ref->sp, nv, NV_FALSE) != NV_OK);
+
+    nv_close_device(nv, ref->sp);
+    if (nv->removed && atomic64_read(&nvl->usage_count) == 0)
+    {
+        /* Same last-owner handoff as nvidia_close_callback after eGPU removal. */
+        nv_lock_destroy_locks(ref->sp, nv);
+        NV_KFREE(nvl, sizeof(*nvl));
+    }
+    else
+    {
+        up(&nvl->ldata_lock);
+    }
+    nv_kmem_cache_free_stack(ref->sp);
+    kfree(ref);
+}
+NV_EXPORT_SYMBOL(nvidia_modeset_put_gpu_ref);
+
 /*
  * Like nvidia_dev_get but uses UUID instead of gpu_id. Note that this may
  * trigger initialization and teardown of unrelated devices to look up their
