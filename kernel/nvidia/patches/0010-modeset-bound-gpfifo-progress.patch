@@ -252,6 +260,7 @@ static const NvPushImports NvKmsNvPushImports = {
 #if defined(DEBUG)
     NvPushImportLogNvDiss,             /* logNvDiss */
 #endif
+    NvPushDeviceUnavailable,           /* deviceUnavailable */
 };
 
 NvBool nvAllocNvPushDevice(NVDevEvoPtr pDevEvo)
