Subject: [PATCH] pm: quarantine an ambiguous runtime transition and propagate its errors

Distinguish an aborted preflight from a partly unloaded device. Preserve
the mailbox error; stop resume after an inaccessible BAR or failed GPU
resume. Leave Linux's fatal PM error latched until actual recovery. Block
new device opens, lost-device paths and GSP RPCs; expose the per-probe
failure in the cached power report. This is admission and error handling,
not a DMA-quiescence guarantee or permission to force a PCI reset.

diff --git a/kernel-open/common/inc/nv-linux.h b/kernel-open/common/inc/nv-linux.h
index 60e18bef0ac7bb34c998ec3721d4f699f1b381be..792facb038fef5910e127fe81894efb7453422b0 100644
--- a/kernel-open/common/inc/nv-linux.h
+++ b/kernel-open/common/inc/nv-linux.h
@@ -1634,7 +1634,7 @@ static inline struct kmem_cache *nv_kmem_cache_create(const char *name, unsigned
  */
 static inline NV_STATUS nv_check_gpu_state(nv_state_t *nv)
 {
-    if (NV_IS_DEVICE_IN_SURPRISE_REMOVAL(nv))
+    if (NV_IS_DEVICE_IN_SURPRISE_REMOVAL(nv) || READ_ONCE(nv->rtd3_restart_required))
     {
         return NV_ERR_GPU_IS_LOST;
     }
diff --git a/kernel-open/common/inc/nv.h b/kernel-open/common/inc/nv.h
index 2731195befc8fb1098cd6cedd51b1be5be4b82f0..611d3aed5bb3730eee4c9b64de02317672c15c2b 100644
--- a/kernel-open/common/inc/nv.h
+++ b/kernel-open/common/inc/nv.h
@@ -655,6 +655,8 @@ typedef struct nv_state_t
      * deprecated in the future.
      */
     NvBool cached_persistence_mode;
+    /* Sticky host admission state for this probe; published under the GPU lock. */
+    NvU32 rtd3_restart_required;
 } nv_state_t;
 
 #define NVFP_TYPE_NONE       ((NvU32)0x0)
diff --git a/kernel-open/nvidia/nv-procfs.c b/kernel-open/nvidia/nv-procfs.c
index c5fea174e1ca754f57c8e4ac2115d15c113e3efc..a4da261ecca5efb63ae217ebe0a0c8bf3b8e43e0 100644
--- a/kernel-open/nvidia/nv-procfs.c
+++ b/kernel-open/nvidia/nv-procfs.c
@@ -202,6 +202,12 @@ nv_procfs_read_power(
     nvidia_stack_t *sp = NULL;
     nv_power_info_t power_info;
 
+    if (READ_ONCE(nv->rtd3_restart_required))
+    {
+        seq_puts(s, "Runtime D3 status:          Error (GPU restart required)\n");
+        return 0;
+    }
+
     if (nv_kmem_cache_alloc_stack(&sp) != 0)
     {
         return 0;
diff --git a/kernel-open/nvidia/nv.c b/kernel-open/nvidia/nv.c
index a9562b3b87e4fd2e1ac42ad32d0e11507dc62d63..2c08cba726e260ed44973e7b0752956c6bc5a5d4 100644
--- a/kernel-open/nvidia/nv.c
+++ b/kernel-open/nvidia/nv.c
@@ -1793,6 +1793,9 @@ static int nv_open_device(nv_state_t *nv, nvidia_stack_t *sp)
     int rc;
     NV_STATUS status;
 
+    if (READ_ONCE(nv->rtd3_restart_required))
+        return -EIO;
+
     if ((nv->flags & NV_FLAG_EXCLUDE) != 0)
     {
         char *uuid = rm_get_gpu_uuid(sp, nv);
@@ -5248,6 +5251,9 @@ nvidia_transition_dynamic_power(
     NvBool bTryAgain = NV_FALSE;
     NV_STATUS status;
 
+    if (READ_ONCE(nv->rtd3_restart_required))
+        return -EIO;
+
     if ((nv->flags & (NV_FLAG_INITIALIZED | NV_FLAG_PERSISTENT_SW_STATE)) == 0)
     {
         return 0;
diff --git a/src/nvidia/arch/nvalloc/unix/include/nv.h b/src/nvidia/arch/nvalloc/unix/include/nv.h
index ba72129e1b99e95d1802448d10057132702373a1..9007a3012a59104ecbb59000e9b0439d033858c8 100644
--- a/src/nvidia/arch/nvalloc/unix/include/nv.h
