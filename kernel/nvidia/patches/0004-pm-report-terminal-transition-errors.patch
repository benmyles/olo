diff --git a/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c b/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
index 3894a0e4327036fc4dbb7254dca9d4e933591d45..c532509df1b1d76182b097e49e489fe7cd97f5a9 100644
--- a/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
+++ b/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
@@ -21,6 +21,7 @@
  * DEALINGS IN THE SOFTWARE.
  */
 
+#include "gpu/gsp/kernel_gsp.h"
 #include <rmconfig.h>
 
 /*
@@ -2372,7 +2373,13 @@ RmPowerManagement(
                 }
                 else
                 {
-                    gpuResumeFromStandby(pGpu);
+                    NV_STATUS resumeStatus = gpuResumeFromStandby(pGpu);
+                    if (rmapiInRtd3PmPath() && IS_GSP_CLIENT(pGpu) && resumeStatus != NV_OK)
+                    {
+                        rmStatus = resumeStatus;
+                        gpumgrSetBcEnabledStatus(pGpu, bcState);
+                        break;
+                    }
                 }
                 intrSetIntrEn(pIntr, nvp->pm_state.IntrEn);
                 gpumgrSetBcEnabledStatus(pGpu, bcState);
@@ -2605,7 +2612,8 @@ NV_STATUS RmGcxPowerManagement(
         if (pGpu->getProperty(pGpu, PDB_PROP_GPU_GCOFF_STATE_ENTERED))
         {
             status = RmPowerManagement(pGpu, NV_PM_ACTION_RESUME);
-            pGpu->setProperty(pGpu, PDB_PROP_GPU_GCOFF_STATE_ENTERED, NV_FALSE);
+            if (status == NV_OK || !bIsDynamicPM || !IS_GSP_CLIENT(pGpu))
+                pGpu->setProperty(pGpu, PDB_PROP_GPU_GCOFF_STATE_ENTERED, NV_FALSE);
             if (!pMemoryManager->bUseVirtualCopyOnSuspend)
             {
                 pKernelMemorySystem->bPreserveComptagBackingStoreOnSuspend = nv->preserve_vidmem_allocations;
@@ -2775,6 +2783,19 @@ static NV_STATUS RmTransitionDynamicPower(
 
     status = RmGcxPowerManagement(pGpu, bEnter, NV_TRUE, bTryAgain);
 
+    if (status != NV_OK && !*bTryAgain && IS_GSP_CLIENT(pGpu))
+    {
+        KernelGsp *pKernelGsp = GPU_GET_KERNEL_GSP(pGpu);
+
+        // A partially transferred device cannot safely service new work.
+        // The GSP RPC gate is checked before queuing, even for a control fd.
+        pKernelGsp->bFatalError = NV_TRUE;
+        portAtomicSetU32(&nv->rtd3_restart_required, 1);
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "RTD3 %s failed (status 0x%x, depth %u); GPU restart required\n",
+                      bEnter ? "suspend" : "resume", status, pGpu->powerManagementDepth);
+    }
+
     if (!bEnter && status == NV_OK)
     {
         nv_idle_holdoff(nv);
diff --git a/src/nvidia/src/kernel/gpu/gpu_suspend.c b/src/nvidia/src/kernel/gpu/gpu_suspend.c
index 94bc3665b8a9ed733bcb5cdd28bc2ea2998b1f81..1e4a52040dbfb719b9524312829ad26c889c8bb1 100644
--- a/src/nvidia/src/kernel/gpu/gpu_suspend.c
+++ b/src/nvidia/src/kernel/gpu/gpu_suspend.c
@@ -600,6 +600,9 @@ gpuEnterStandby_IMPL(OBJGPU *pGpu)
         return suspendStatus;
     }
 
+    if (suspendStatus != NV_OK && rmapiInRtd3PmPath() && IS_GSP_CLIENT(pGpu))
+        return suspendStatus;
+
     pGpu->setProperty(pGpu, PDB_PROP_GPU_IN_STANDBY, NV_TRUE);
     pGpu->bInD3Cold = NV_TRUE;
 
@@ -648,10 +651,15 @@ gpuResumeFromStandby_IMPL(OBJGPU *pGpu)
     if (resumeStatus != NV_OK)
     {
         NV_PRINTF(LEVEL_ERROR, "Polling BAR0 or BAR firewall timeout\n");
+        if (rmapiInRtd3PmPath() && IS_GSP_CLIENT(pGpu))
+            goto failed_resume;
     }
 
     resumeStatus = gpuPowerManagementResume(pGpu, state, GPU_STATE_FLAGS_PM_SUSPEND);
 
+    if (resumeStatus != NV_OK && rmapiInRtd3PmPath() && IS_GSP_CLIENT(pGpu))
+        goto failed_resume;
+
     pGpu->setProperty(pGpu, PDB_PROP_GPU_IN_STANDBY, NV_FALSE);
     pGpu->bInD3Cold = NV_FALSE;
     pGpu->setProperty(pGpu, PDB_PROP_GPU_IN_PM_CODEPATH, NV_FALSE);
@@ -674,6 +682,10 @@ gpuResumeFromStandby_IMPL(OBJGPU *pGpu)
     gpuNotifySubDeviceEvent(pGpu, NV2080_NOTIFIERS_POWER_RESUME, NULL, 0, 0, 0);
 
     return resumeStatus;
+
+failed_resume:
+    pGpu->setProperty(pGpu, PDB_PROP_GPU_IN_PM_RESUME_CODEPATH, NV_FALSE);
+    return resumeStatus;
 }
 
 NV_STATUS gpuEnterHibernate_IMPL(OBJGPU *pGpu)
