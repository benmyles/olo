{
  "manifest_version": 3,
  "name": "Olo Desktop",
  "version": "1.4.0",
  "description": "Fills logins and one-time codes from Olo's Passwords, offers to save the ones you use, and shows agents what is on the page.",
  "minimum_chrome_version": "120",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Passwords",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
